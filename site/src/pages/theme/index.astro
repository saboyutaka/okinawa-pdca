---
// くらしのテーマ（このサイト独自の分類）の一覧。ヘッダーのナビの「テーマ」から入る。トップの節（/#themes）はテーマを選んで入るための名前の札だけにし、
// ここはテーマどうしを見比べるための一覧にする: テーマごとのカードに、名前と施策の数（棒の分母。テーマの大きさが分かるように）、その下に施策の判定の内訳の棒を置く。
// 成果指標・取組の数はテーマのページの頭にあるので出さない（5つの将来像のページの行と同じ考え方）。施策の数はテーマのページの頭と同じ（lib/heads.ts の themeHead）。
// 並びは themes.json の順（良い・悪いで並べ替えない）。決め方の言葉も各テーマのページの頭にあるので、ここには出さない。
// 「表で見る」は付けない（判定の内訳はテーマのページにあり、棒の読み上げには件数と割合がある）。
// 凡例の箱は置かず、棒の左の「判定」を押すと短い説明と区分の一覧を出す（components/KeyBrief.astro。将来像のページの基本施策の行の「順調」と同じ）
import Base from '../../layouts/Base.astro';
import StatusBar from '../../components/StatusBar.astro';
import ThemeIcon from '../../components/ThemeIcon.astro';
import KeyBrief from '../../components/KeyBrief.astro';
import Term from '../../components/Term.astro';
import { LATEST, countBy } from '../../lib/data.ts';
import { getThemes, unthemed } from '../../lib/themes.ts';
import { themeHead } from '../../lib/heads.ts';
import { JUDGE_GROUPS, judgeGroupOf } from '../../lib/icons.ts';
import { fmt } from '../../lib/format.ts';

const keys = JUDGE_GROUPS.map((g) => g.key);
const themes = getThemes().map((t) => {
  const head = themeHead(t);
  return {
    ...t,
    judges: countBy(head.shisaku, (s) => judgeGroupOf(s.judges[LATEST])?.key ?? 'なし', keys),
  };
});
const rest = unthemed();
// 区分の一覧に出すのは、どれかのテーマで使っている区分
const judgeUsed = keys.filter((key) => themes.some((t) => (t.judges[key] || 0) > 0));
---
<Base title="くらしのテーマ" description="子ども・子育て、観光、交通など、くらしのテーマごとに沖縄県PDCAの施策・取組・成果指標を見られます（このサイト独自の分類）。">
  {/* 「このサイト独自の分類」の印は、押すと分け方の説明（lib/terms.ts の「くらしのテーマ」）が出る用語のボタンにし、リード文では分け方を説明しない */}
  <h1>くらしのテーマ<Term word="くらしのテーマ" label="このサイト独自の分類" note="テーマごとの言葉は、各テーマのページの頭にあります。" class="own" /></h1>
  {/* 何が分かるか → どう進むかを書く */}
  <p class="secondary lead">くらしに身近な{fmt(themes.length)}のテーマごとに、県の施策が計画どおりに進んでいるかを見比べられます。気になるテーマを押すと、そのテーマの施策・取組・成果指標をくわしく見られます。</p>
  <KeyBrief kind="judge" used={judgeUsed} />

  {/* カードの中は、1行目に名前と施策の数、2行目に「判定」と棒。名前はどれも1行に入る幅にして、どのカードでも棒が同じ高さに来るようにする（目線がばらつかないように） */}
  <ul class="themes">
    {themes.map((t) => (
      <li class="sticker theme-card" id={t.id}>
        <div class="nm"><span class="ico" aria-hidden="true"><ThemeIcon id={t.id} /></span><a class="name-link" href={`/theme/${t.id}/`}>{t.label.split(/(?<=・)/).map((w) => <span class="nw">{w}</span>)}</a></div>
        <span class="cnt num">{fmt(t.ids.length)}施策</span>
        <div class="j-row">
          <span class="j-l"><Term word="推進状況" label="判定" brief="key-judge" /></span>
          <StatusBar categories={JUDGE_GROUPS} counts={t.judges} unit="施策" context={`${t.label}の施策の判定 `} size="mini" />
        </div>
      </li>
    ))}
  </ul>

  {rest.length > 0 && (
    <details class="rest">
      <summary>どのテーマにも入らない施策（{fmt(rest.length)}）</summary>
      <ul>
        {rest.map((s) => <li><a class="name-link" href={`/shisaku/${s.id}/`}>{s.name}</a> <span class="code-no">{s.code}</span></li>)}
      </ul>
    </details>
  )}
</Base>

<style>
  /* カードは、一番長い名前（スタートアップ・起業）と施策の数が1行に入る幅（310px）より狭くしない（画面がそれより狭いときは画面の幅）。PC では3列 */
  .themes { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(310px, 100%), 1fr)); }
  .theme-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px 12px; padding: 12px 16px 14px; scroll-margin-top: 16px; }
  .j-row { grid-column: 1 / -1; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 8px; }
  /* 「判定」は、将来像のページの基本施策の行の「順調」（components/KeyNum.astro）と同じ小さな灰色の字 */
  .j-l { font-size: 0.75rem; font-weight: 700; color: var(--ink-2); line-height: 1.2; }
  .nm { display: flex; align-items: center; gap: 10px; min-width: 0; font-size: 1.05rem; line-height: 1.35; }
  .nw { white-space: nowrap; } /* 名前は、入りきらない狭い画面でだけ「・」の後ろで折り返す（トップのテーマの札と同じ） */
  .ico { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--pink); }
  .ico :global(.theme-ic) { width: 21px; height: 21px; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* 施策の数は棒の分母として添えるだけなので、棒の図の右の件数（StatusChart）と同じく小さな灰色の字 */
  .cnt { font-size: 0.875rem; color: var(--ink-2); white-space: nowrap; }
  .rest { margin-top: 24px; }
  .rest ul { columns: 2 20em; font-size: 0.9375rem; }
</style>
