---
// 基本施策1つのページ。施策のページと同じ並び: 頭（目指す姿）→ 目次 → 主要指標 → 施策 → 主な取組の進捗 → 県のふりかえり → シェア → 出典
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import StatusChart from '../../components/StatusChart.astro';
import Crumbs from '../../components/Crumbs.astro';
import ShareBox from '../../components/ShareBox.astro';
import { shareText } from '../../lib/iken.ts';
import Term from '../../components/Term.astro';
import ShisakuItem from '../../components/ShisakuItem.astro';
import JudgeLegend from '../../components/JudgeLegend.astro';
import ShuyouCard from '../../components/ShuyouCard.astro';
import ExtLink from '../../components/ExtLink.astro';
import { oneLine } from '../../lib/text.ts';
import { HYOKA, KANKO, hyokaOf, planSourceLink, kankoOfPdcaShisaku } from '../../lib/plans.ts';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, statusOf, countBy,
  getKihonList, getShouraizou, getShisakuList, shuyouRows, sourceLink,
} from '../../lib/data.ts';

export function getStaticPaths() {
  return getKihonList().map((k) => ({ params: { id: k.id }, props: { k } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { k } = Astro.props;
const shou = getShouraizou().find((x) => x.id === k.shouraizou);
const shisaku = getShisakuList().filter((s) => s.kihon_id === k.id);
const statusKeys = STATUSES.map((x) => x.key);
const src = k.source && sourceLink(k.source, k.page);

// 主要指標（年度をまたいだ指標ごと）。最新の報告で使われなくなった指標は、施策ページの成果指標と同じく畳んで後ろに置く
const shuyou = shuyouRows(k.id);
const shuyouLatest = shuyou.filter((r) => r.latest.year === LATEST);
const shuyouPast = shuyou.filter((r) => r.latest.year !== LATEST);
// 図を描ける部分があるときだけ凡例を出す（ゴールの丸は、目標値が数で読める部分があるときだけ）
const parts = shuyou.flatMap((r) => r.parts);
const drawable = parts.some((p) => p.drawable);
const goal = parts.some((p) => p.drawable && p.goal);

const tenkai = [...new Map(shisaku.map((s) => [s.tenkai_id, s.tenkai_name])).entries()];
const progressRows = YEARS.map((y) => ({
  label: yearLabel(y),
  counts: countBy(shisaku.flatMap((s) => s.torikumi.filter((t) => t.year === y)), statusOf, statusKeys),
}));
// 評価検証報告書（R4〜R6）の基本施策ごとの成果と課題
const h = hyokaOf(k.id);
const hSrc = h && planSourceLink('hyoka', h.source, h.page);
// この基本施策の取組が観光ロードマップでも評価されている施策の数
const rmCount = new Set(shisaku.flatMap((s) => kankoOfPdcaShisaku(s).map((r) => r.id))).size;
---
<Base title={`${k.name}（基本施策）`} description={`沖縄県PDCA: 基本施策「${k.name}」の主要指標と施策の推進状況`}>
  <Crumbs items={[{ href: `/future/${k.shouraizou}/`, label: `将来像${k.shouraizou}`, sz: k.shouraizou }, { label: k.name }]} share={{ text: shareText('基本施策', k.name), label: 'この基本施策を SNS でシェア' }} />
  <header class="sticker lift k-head">
    <span class="code-no code-corner" title="県の報告書での番号">基本施策 {k.code}</span>
    <div class="kind">将来像{k.shouraizou}「{shou?.name}」の<Term word="基本施策" /></div>
    <h1>{k.name}</h1>
    {k.mezasu && (
      <div class="bubble-row says">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <div class="small secondary label">目指す姿（県の報告書から）</div>
          <p class="first">{oneLine(k.mezasu)}</p>
        </div>
      </div>
    )}
  </header>

  <nav class="toc" aria-label="このページの内容">
    <div class="toc-links" data-scroll-hint>
      <a href="#shuyou">主要指標</a>
      <a href="#list">施策</a>
      <a href="#progress">取組の進捗</a>
      {h && <a href="#hyoka">県のふりかえり</a>}
      <a href="#source">出典</a>
    </div>
    <button type="button" class="button" data-open-all="#main" aria-pressed="false" hidden>すべて開く</button>
  </nav>

  <section aria-labelledby="shuyou">
    <h2 id="shuyou" class="anchor"><Term word="主要指標" />：ゴールまでの道のり</h2>
    <p class="small secondary lead">スタートの基準値からゴールの目標値へ、青い点の実績値がどこまで進んだかを見ます。</p>
    {drawable && (
      <ul class="chart-key" aria-hidden="true">
        {goal && <li><span class="k-ring"></span>ゴールの目標値</li>}
        <li><span class="k-dot" style="--k:var(--pop)"></span>実績値</li>
      </ul>
    )}
    {shuyou.length === 0 && <p class="secondary">報告書に、この基本施策の主要指標の記載がありません。</p>}
    {shuyouLatest.map((row) => <ShuyouCard row={row} />)}
    {shuyouPast.length > 0 && (
      <details class="past">
        <summary>R6まで使われていた主要指標（{shuyouPast.length}）</summary>
        {shuyouPast.map((row) => <ShuyouCard row={row} />)}
      </details>
    )}
    {drawable && <p class="small secondary">主要指標には、成果指標のような年度ごとの計画値がないため、図に計画の道すじ（点線）はありません。</p>}
    {h?.shuyou && <p class="small inset k-note"><strong>県の説明（<Term word="評価検証報告書" />）:</strong> {h.shuyou}</p>}
  </section>

  <section aria-labelledby="list">
    <h2 id="list" class="anchor">施策（{shisaku.length}）</h2>
    <JudgeLegend />
    {tenkai.map(([tid, tname]) => (
      <>
        <h3>{tname}</h3>
        <ul class="row-list">
          {shisaku.filter((s) => s.tenkai_id === tid).map((s) => <ShisakuItem s={s} />)}
        </ul>
      </>
    ))}
    {rmCount > 0 && (
      <p class="small rm-note"><span class="plan-tag">{KANKO.short}</span> この基本施策の主な取組の一部は、県の観光の個別計画「<a href={KANKO.href}>{KANKO.name}</a>」の{rmCount}の施策でも評価されています。</p>
    )}
  </section>

  <section aria-labelledby="progress">
    <h2 id="progress" class="anchor">主な取組の進捗（この基本施策の合計）</h2>
    <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
  </section>

  {h && (
    <section aria-labelledby="hyoka">
      <h2 id="hyoka" class="anchor">県による4年間のふりかえり（R4〜R6）</h2>
      <p class="small secondary lead">県の<Term word="評価検証報告書" />（{HYOKA.published}）が、この基本施策の成果と課題をまとめたものです。</p>
      <div class="bubble-row voice">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          {h.intro && <p class="intro">{h.intro}</p>}
          <h3>主な施策の成果</h3>
          <ul class="pts">{h.results.map((r) => <li>{r}</li>)}</ul>
        </div>
      </div>
      <div class="bubble-row voice">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <h3>主な課題</h3>
          {h.issues.map((x) => (
            <>
              {x.head && <h4>{x.head}</h4>}
              <ul class="pts">{x.items.map((t) => <li>{t}</li>)}</ul>
            </>
          ))}
        </div>
      </div>
    </section>
  )}

  <ShareBox kind="基本施策" name={k.name} />

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <p class="small">県の報告書での番号は<strong class="report-no">基本施策 {k.code}</strong>です。報告書の PDF では、この番号で探せます。</p>
    {src && <p class="small">{yearLong(LATEST)}: <ExtLink href={src.href}>総括報告書（{src.label}）</ExtLink>。主要指標の出典は、主要指標の「表で見る」の各行にあります。</p>}
    {hSrc && <p class="small">県による4年間のふりかえり: <ExtLink href={hSrc.href}>{hSrc.label.replace(/ \d+ページ$/, '')} {h.page}〜{h.page_end}ページ</ExtLink></p>}
  </section>
</Base>

<style>
  /* 頭は施策ページと同じ太いステッカー。目指す姿は県の吹き出しに入れる */
  .k-head { position: relative; display: grid; gap: 4px; margin-top: 12px; padding-top: 30px; }
  .k-head h1 { margin: 2px 0 10px; }
  .kind { font-size: 0.9375rem; color: var(--ink-2); }
  .label { font-weight: 700; margin-bottom: 4px; }
  .past { margin-top: 18px; }
  .says .first { margin: 4px 0 0; }
  .report-no { white-space: nowrap; }
  .k-note { margin-top: 12px; padding: 8px 12px; }
  .voice { margin-top: 14px; }
  .voice h3 { margin: 0.6em 0 0.3em; font-size: 1.02rem; }
  .voice h4 { margin: 0.8em 0 0.2em; font-size: 0.95rem; }
  .intro { margin: 0 0 4px; font-weight: 700; }
  .pts { margin: 0; padding-left: 1.2em; }
  .pts li { margin: 0 0 6px; }
  .rm-note { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; margin-top: 14px; }
</style>
