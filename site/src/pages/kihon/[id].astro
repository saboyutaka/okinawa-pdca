---
import Base from '../../layouts/Base.astro';
import StatusChart from '../../components/StatusChart.astro';
import Crumbs from '../../components/Crumbs.astro';
import Term from '../../components/Term.astro';
import ShisakuItem from '../../components/ShisakuItem.astro';
import Chip from '../../components/Chip.astro';
import Stamps from '../../components/Stamps.astro';
import ExtLink from '../../components/ExtLink.astro';
import { oneLine } from '../../lib/text.js';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, statusOf, countBy,
  getKihonList, getShouraizou, getShisakuList, getShuyou, sourceLink, toneOfJudgement,
} from '../../lib/data.js';

export function getStaticPaths() {
  return getKihonList().map((k) => ({ params: { id: k.id } }));
}

const k = getKihonList().find((x) => x.id === Astro.params.id);
const shou = getShouraizou().find((x) => x.id === k.shouraizou);
const shisaku = getShisakuList().filter((s) => s.kihon_id === k.id);
const statusKeys = STATUSES.map((x) => x.key);
const shuyou = getShuyou(k.id);
const yearsDesc = [...YEARS].reverse();
const src = k.source && sourceLink(k.source, k.page);

// 主要指標。最新の報告の指標ごとに、4年分の行を名前で結び付ける（名前が少し変わった年度は、その年度の指標が1つだけなら同じ指標とみなす）。
// どの札にも結び付かなかった行（最新の報告に無い指標）も、名前ごとに1枚の札にして、ページから落とさない
const latestShuyou = shuyou.filter((r) => r.year === LATEST);
const used = new Set();
const cardOf = (r, single) => ({
  latest: r,
  years: YEARS.map((y) => {
    const ys = shuyou.filter((x) => x.year === y && !used.has(x));
    const x = y === r.year ? r : ys.find((x) => x.name === r.name) || (single && ys.length === 1 ? ys[0] : null);
    if (x) used.add(x);
    return x;
  }),
});
const shuyouCards = latestShuyou.map((r) => cardOf(r, latestShuyou.length === 1));
for (const r of [...shuyou].sort((a, b) => b.year - a.year)) if (!used.has(r)) shuyouCards.push(cardOf(r, false));
// 目標値の年度（前期実施計画は R6、中期実施計画は R9）
const targetYearOf = (y) => (y <= 2024 ? 'R6' : 'R9');

const tenkai = [...new Map(shisaku.map((s) => [s.tenkai_id, s.tenkai_name])).entries()];
const progressRows = YEARS.map((y) => ({
  label: yearLabel(y),
  counts: countBy(shisaku.flatMap((s) => s.torikumi.filter((t) => t.year === y)), statusOf, statusKeys),
}));
---
<Base title={`${k.name}（基本施策）`} description={`沖縄県PDCA: 基本施策「${k.name}」の主要指標と施策の推進状況`}>
  <Crumbs items={[{ href: '/', label: 'トップ' }, { href: `/future/${k.shouraizou}/`, label: `将来像${k.shouraizou}`, sz: k.shouraizou }, { label: k.name }]} />
  <header class="sticker lift k-head">
    <span class="code-no code-corner" title="県の報告書での番号">基本施策 {k.code}</span>
    <div class="kind">将来像{k.shouraizou}「{shou?.name}」の<Term word="基本施策" /></div>
    <h1>{k.name}</h1>
    {k.mezasu && (
      <div class="bubble-row says">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <div class="small secondary label">目指す姿（県の報告書から）</div>
          <p class="first">{oneLine(k.mezasu)}</p>
        </div>
      </div>
    )}
  </header>

  <section aria-labelledby="shuyou">
    <h2 id="shuyou"><Term word="主要指標" /></h2>
    <p class="small secondary lead">見通しは、目標値（R7からはR9、R6まではR6）に届くかの県の見立てです。</p>
    {shuyouCards.length === 0 && <p class="secondary">報告書に、この基本施策の主要指標の記載がありません。</p>}
    {shuyouCards.map(({ latest: r, years }) => {
      const tone = toneOfJudgement(r.judgement);
      // 見通しが「策定率:目標達成 改定率:…」のように決まった言い方でないときは、スタンプにせず文章のまま出す
      const plain = years.every((x) => !x?.judgement || toneOfJudgement(x.judgement));
      return (
        <article class="sticker s-card">
          <h3>{r.name}{r.year !== LATEST && <small class="past-badge">{yearLabel(r.year)}の報告まで</small>}</h3>
          <dl class="kv">
            <div><dt>基準値</dt><dd>{oneLine(r.base_raw)}</dd></div>
            <div><dt>実績値（{yearLabel(r.year)}報告）</dt><dd class="big">{oneLine(r.actual_raw)}</dd></div>
            <div><dt>目標値（{targetYearOf(r.year)}）</dt><dd>{oneLine(r.target_raw)}</dd></div>
            <div class="kv-j"><dt>見通し</dt><dd>{!r.judgement ? '—' : tone ? <Chip tone={tone} text={r.judgement} /> : <span class="prose small">{r.judgement}</span>}</dd></div>
          </dl>
          {plain && (
            <div class="j-years">
              <div class="small secondary label">4年間の見通し</div>
              <Stamps items={YEARS.map((y, i) => (years[i]?.judgement ? { year: y, tone: toneOfJudgement(years[i].judgement), text: years[i].judgement } : { year: y, tone: null, text: '報告なし' }))} label="4年間の見通し" size="small" />
            </div>
          )}
          <details>
            <summary>表で見る</summary>
            <div class="table-wrap">
              <table>
                <caption class="sr-only">{r.name}の年度別の値</caption>
                <thead><tr><th>報告年度</th><th>基準値</th><th>実績値</th><th>目標値</th><th>見通し</th><th>出典</th></tr></thead>
                <tbody>
                  {yearsDesc.map((y) => {
                    const x = years[YEARS.indexOf(y)];
                    if (!x) return <tr><th>{yearLabel(y)}</th><td colspan="5" class="secondary small">この年度の報告に、この指標はありません</td></tr>;
                    const s2 = sourceLink(x.source, x.page);
                    return (
                      <tr>
                        <th>{yearLabel(y)}{x.name !== r.name && <><br /><small class="secondary">{x.name}</small></>}</th>
                        <td class="small">{oneLine(x.base_raw)}</td>
                        <td>{oneLine(x.actual_raw)}</td>
                        <td class="small">{oneLine(x.target_raw)}</td>
                        <td class="small prose">{x.judgement || '—'}</td>
                        <td class="small">{s2 ? <ExtLink href={s2.href}>{s2.label}</ExtLink> : '—'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        </article>
      );
    })}
  </section>

  <section aria-labelledby="progress">
    <h2 id="progress">主な取組の進捗（この基本施策の合計）</h2>
    <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
  </section>

  <section aria-labelledby="list">
    <h2 id="list">施策（{shisaku.length}）</h2>
    {tenkai.map(([tid, tname]) => (
      <>
        <h3>{tname}</h3>
        <ul class="row-list">
          {shisaku.filter((s) => s.tenkai_id === tid).map((s) => <ShisakuItem s={s} />)}
        </ul>
      </>
    ))}
  </section>

  <section aria-labelledby="source">
    <h2 id="source">出典</h2>
    <p class="small">県の報告書での番号は<strong class="report-no">基本施策 {k.code}</strong>です。報告書の PDF では、この番号で探せます。</p>
    {src && <p class="small">{yearLong(LATEST)}: <ExtLink href={src.href}>総括報告書（{src.label}）</ExtLink>。主要指標の出典は、主要指標の「表で見る」の各行にあります。</p>}
  </section>
</Base>

<style>
  /* 頭は施策ページと同じ太いステッカー。目指す姿は県の吹き出しに入れる */
  .k-head { position: relative; display: grid; gap: 4px; margin-top: 12px; padding-top: 30px; }
  .k-head h1 { margin: 2px 0 10px; }
  .kind { font-size: 0.9375rem; color: var(--ink-2); }
  .label { font-weight: 700; margin-bottom: 4px; }
  .says .first { margin: 4px 0 0; }
  /* 主要指標。最新の値と見通しを大きく出し、4年間の見通しはスタンプ、年度ごとの値と出典は表に畳む */
  .s-card { display: grid; gap: 12px; margin-top: 12px; }
  .s-card h3 { margin: 0; }
  .past-badge { font-family: var(--font); font-size: 0.8125rem; font-weight: 400; margin-left: 8px; padding: 1px 6px; border: 1px solid var(--baseline); border-radius: 4px; color: var(--ink-2); vertical-align: 0.1em; }
  .kv-j :global(.chip) { font-weight: 700; white-space: normal; }
  .j-years { max-width: 420px; }
  .s-card details { margin: 0; }
  .s-card table { min-width: 560px; }
  .report-no { white-space: nowrap; }
</style>
