---
import Base from '../../layouts/Base.astro';
import StatusChart from '../../components/StatusChart.astro';
import StatusBar from '../../components/StatusBar.astro';
import Chip from '../../components/Chip.astro';
import Sz from '../../components/Sz.astro';
import Crumbs from '../../components/Crumbs.astro';
import Term from '../../components/Term.astro';
import ThemeTags from '../../components/ThemeTags.astro';
import { themesOf } from '../../lib/themes.js';
import { HYOKA, KANKO, hyokaOf, planSourceLink, kankoOfPdcaShisaku } from '../../lib/plans.js';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, judgeOf, statusOf, countBy,
  getKihonList, getShouraizou, getShisakuList, getShuyou, sourceLink, deptHref, seikaHref, seikaKeyOf,
} from '../../lib/data.js';

export function getStaticPaths() {
  return getKihonList().map((k) => ({ params: { id: k.id } }));
}

const k = getKihonList().find((x) => x.id === Astro.params.id);
const shou = getShouraizou().find((x) => x.id === k.shouraizou);
const shisaku = getShisakuList().filter((s) => s.kihon_id === k.id);
const statusKeys = STATUSES.map((x) => x.key);
const shuyou = getShuyou(k.id);
const yearsDesc = [...YEARS].reverse();
const src = k.source && sourceLink(k.source, k.page);

const tenkai = [...new Map(shisaku.map((s) => [s.tenkai_id, s.tenkai_name])).entries()];
// 評価検証報告書（R4〜R6）の基本施策ごとの成果と課題
const h = hyokaOf(k.id);
const hSrc = h && planSourceLink('hyoka', h.source, h.page);
// この基本施策の取組が観光ロードマップでも評価されている施策の数
const rmCount = new Set(shisaku.flatMap((s) => kankoOfPdcaShisaku(s).map((r) => r.id))).size;
const progressRows = YEARS.map((y) => ({
  label: yearLabel(y),
  counts: countBy(shisaku.flatMap((s) => s.torikumi.filter((t) => t.year === y)), statusOf, statusKeys),
}));
---
<Base title={`${k.name}（基本施策）`} description={`沖縄県PDCA: 基本施策「${k.name}」の主要指標と施策の推進状況`}>
  <Crumbs items={[{ href: '/', label: 'トップ' }, { href: `/future/${k.shouraizou}/`, label: `将来像${k.shouraizou}`, sz: k.shouraizou }, { label: k.name }]} />
  <header class="k-head">
    <div class="k-top">
      <a class:list={['sz-ribbon', `sz-${k.shouraizou}`]} href={`/future/${k.shouraizou}/`}><Sz id={k.shouraizou} sr={false} />将来像{k.shouraizou} {shou?.name}</a>
      <span class="code-no" title="県の報告書での番号">基本施策 {k.code}</span>
    </div>
    <div class="secondary small"><Term word="基本施策" /></div>
    <h1>{k.name}</h1>
  </header>

  {k.mezasu && (
    <section aria-labelledby="mezasu">
      <h2 id="mezasu">目指す姿</h2>
      <p class="muted-box">{k.mezasu}</p>
    </section>
  )}

  {h && (
    <section aria-labelledby="hyoka">
      <h2 id="hyoka">県による4年間のふりかえり（R4〜R6）</h2>
      <p class="small secondary lead">県の<Term word="評価検証報告書" />（{HYOKA.published}）が、前期実施計画（R4〜R6）のPDCAの結果などをもとに、この基本施策の成果と課題をまとめたものです。</p>
      <div class="bubble-row voice">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          {h.intro && <p class="intro">{h.intro}</p>}
          <h3>主な施策の成果</h3>
          <div data-clamp id="clamp-results"><ul class="pts">{h.results.map((r) => <li>{r}</li>)}</ul></div>
          <button type="button" class="more" data-clamp-toggle="clamp-results" aria-controls="clamp-results" aria-expanded="false" hidden>続きを読む</button>
        </div>
      </div>
      <div class="bubble-row voice">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <h3>主な課題</h3>
          <div data-clamp id="clamp-issues">
            {h.issues.map((x) => (
              <>
                {x.head && <h4>{x.head}</h4>}
                <ul class="pts">{x.items.map((t) => <li>{t}</li>)}</ul>
              </>
            ))}
          </div>
          <button type="button" class="more" data-clamp-toggle="clamp-issues" aria-controls="clamp-issues" aria-expanded="false" hidden>続きを読む</button>
        </div>
      </div>
      {hSrc && <p class="small">出典: <a href={hSrc.href} rel="noopener">{hSrc.label.replace(/ \d+ページ$/, '')} {h.page}〜{h.page_end}ページ</a></p>}
    </section>
  )}

  <section aria-labelledby="shuyou">
    <h2 id="shuyou">主要指標</h2>
    <p class="small secondary">基本施策の最終的な成果をはかる指標です。R4〜R6はR6の目標値、R7からはR9の目標値に対する見通しです。</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>報告年度</th><th>主要指標</th><th>基準値</th><th>実績値</th><th>目標値</th><th>見通し</th></tr></thead>
        <tbody>
          {yearsDesc.flatMap((y) => shuyou.filter((r) => r.year === y).map((r) => {
            const src = sourceLink(r.source, r.page);
            return (
              <tr>
                <th>{yearLabel(y)}</th>
                <td>{r.name}{src && <><br /><a class="small" href={src.href} rel="noopener">出典</a></>}</td>
                <td class="prose small">{r.base_raw}</td>
                <td class="prose">{r.actual_raw}</td>
                <td class="prose small">{r.target_raw}</td>
                <td class="prose small">{r.judgement}</td>
              </tr>
            );
          }))}
        </tbody>
      </table>
    </div>
    {h?.shuyou && <p class="small muted-box"><strong>県の説明（評価検証報告書）:</strong> {h.shuyou}</p>}
  </section>

  <section aria-labelledby="progress">
    <h2 id="progress">主な取組の進捗（この基本施策の合計）</h2>
    <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
  </section>

  <section aria-labelledby="list">
    <h2 id="list">施策（{shisaku.length}）</h2>
    {rmCount > 0 && (
      <p class="small rm-note"><span class="plan-tag">{KANKO.short}</span> この基本施策の主な取組の一部は、県の観光の個別計画「<a href={KANKO.href}>{KANKO.name}</a>」の{rmCount}の施策でも評価されています。</p>
    )}
    {tenkai.map(([tid, tname]) => (
      <>
        <h3>{tname}</h3>
        <ul class="list">
          {shisaku.filter((s) => s.tenkai_id === tid).map((s) => {
            const j = judgeOf(s.judges[LATEST]);
            return (
              <li class="item">
                <div class="name-row"><a href={`/shisaku/${s.id}/`}>{s.name}</a><span class="code-no">{s.code}</span></div>
                <div class="row">
                  {j ? <Chip tone={j.tone} text={`${yearLabel(LATEST)} ${j.key} ${j.label}`} /> : <Chip text="判定なし" />}
                  <div class="mini"><StatusBar categories={STATUSES} counts={countBy(s.torikumi.filter((t) => t.year === LATEST), statusOf, statusKeys)} context={`${s.name} 主な取組 `} /></div>
                </div>
                <ThemeTags ids={themesOf(s.id).map((t) => t.id)} />
                <div class="small links">
                  成果指標: {s.seika.filter((x) => x.year === LATEST).map((x, i) => <>{i > 0 && '／'}<a href={seikaHref(s.id, seikaKeyOf(x))}>{x.name}</a></>)}
                  　関係部等: {s.depts.length ? s.depts.map((d, i) => <>{i > 0 && '、'}{deptHref(d) ? <a href={deptHref(d)}>{d}</a> : d}</>) : (s.kankei || '—')}
                </div>
              </li>
            );
          })}
        </ul>
      </>
    ))}
  </section>

  <section aria-labelledby="source">
    <h2 id="source">出典</h2>
    <p class="small">県の報告書での番号は<strong class="report-no">基本施策 {k.code}</strong>です。報告書の PDF では、この番号で探せます。</p>
    {src && <p class="small">{yearLong(LATEST)}: <a href={src.href} rel="noopener">総括報告書（{src.label}）</a>。主要指標の出典は、表の各行にあります。</p>}
  </section>
</Base>

<style>
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 6px 16px; align-items: center; margin-top: 6px; }
  .row :global(.chip) { white-space: normal; }
  .links { margin-top: 6px; color: var(--ink-2); }
  .k-head { margin-top: 12px; }
  .k-top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 4px 16px; margin-bottom: 10px; }
  .k-top .code-no { margin-left: auto; }
  .k-head .sz-ribbon { display: inline-flex; color: var(--ink); text-decoration: none; font-size: 0.9375rem; }
  .item { display: grid; gap: 4px; }
  .report-no { white-space: nowrap; }
  .rm-note { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
  .voice { margin-top: 14px; }
  .voice h3 { margin: 0.6em 0 0.3em; font-size: 1.02rem; }
  .voice h4 { margin: 0.8em 0 0.2em; font-size: 0.95rem; }
  .intro { margin: 0 0 4px; font-weight: 700; }
  .pts { margin: 0; padding-left: 1.2em; }
  .pts li { margin: 0 0 6px; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }
</style>
