---
// 基本施策1つのページ。施策のページと同じ並び: 頭（目指す姿）→ 目次 → 主要指標 → 施策 → 主な取組の進捗 → 県のふりかえり → シェア → 出典
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../lib/routes.ts';
import Base from '../../layouts/Base.astro';
import StatusChart from '../../components/StatusChart.astro';
import Hierarchy from '../../components/Hierarchy.astro';
import ShareBox from '../../components/ShareBox.astro';
import Term from '../../components/Term.astro';
import HeadKind from '../../components/HeadKind.astro';
import ShisakuItem from '../../components/ShisakuItem.astro';
import ShisakuHead from '../../components/ShisakuHead.astro';
import JudgeLegend from '../../components/JudgeLegend.astro';
import ShuyouCard from '../../components/ShuyouCard.astro';
import ShuyouSays from '../../components/ShuyouSays.astro';
import ExtLink from '../../components/ExtLink.astro';
import ShuyouStatusTag from '../../components/ShuyouStatusTag.astro';
import Toc from '../../components/Toc.astro';
import Says from '../../components/Says.astro';
import { oneLine } from '../../lib/text.ts';
import { HYOKA, KANKO, hyokaOf, planSourceLink, kankoOfPdcaShisaku } from '../../lib/plans.ts';
import { kihonDescription } from '../../lib/describe.ts';
import { kihonHead } from '../../lib/heads.ts';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, statusOf, countBy,
  getShisakuList, getShuyouGroups, getShuyouStatus, sourceLink, planParents, formerText,
} from '../../lib/data.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['kihon/[id]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { k } = Astro.props;
const shisaku = getShisakuList().filter((s) => s.kihon_id === k.id);
const statusKeys = STATUSES.map((x) => x.key);
const src = k.source && sourceLink(k.source, k.page);

// 主要指標（年度をまたいだ指標ごと）。最新の報告で使われなくなった指標は、施策ページの成果指標と同じく畳んで後ろに置く
const shuyou = getShuyouGroups().filter((g) => g.kihon.id === k.id);
const shuyouLatest = shuyou.filter((r) => r.latest.year === LATEST);
const shuyouPast = shuyou.filter((r) => r.latest.year !== LATEST);
// R7で名前が少し変わった主要指標の前の名前（年度のつなぎ方はカードに書かず、出典に注釈として書く。施策のページの成果指標と同じ）
const renamed = shuyou.map((g) => ({
  name: g.latest.name,
  fs: [...Object.values(g.years).filter((r) => r.name !== g.latest.name).reduce((m, r) => m.set(r.name, [...(m.get(r.name) || []), r.year]), new Map<string, number[]>())].map(([name, years]) => ({ name, years })),
})).filter((x) => x.fs.length > 0);
// 頭の箱の主要指標の達成状況（最新の年度の概要版。表の順）
const status = getShuyouStatus().filter((r) => r.kihon_id === k.id);
// 図の凡例は置かない（図の中に「スタート」「いまここ」「ゴール」の文字がある。施策のページの成果指標と同じ）

const tenkai = [...new Map(shisaku.map((s) => [s.tenkai_id, s.tenkai_name])).entries()];
const progressRows = YEARS.map((y) => ({
  label: yearLabel(y),
  counts: countBy(shisaku.flatMap((s) => s.torikumi.filter((t) => t.year === y)), statusOf, statusKeys),
}));
// 評価検証報告書（R4〜R6）の基本施策ごとの成果と課題
const h = hyokaOf(k.id);
const hSrc = h && planSourceLink('hyoka', h.source, h.page);
// 評価検証報告書の主要指標についての県の説明は、成果指標のカードの県による説明と同じく、R6 の報告にあった主要指標のカードの中に置く。
// R6 の報告に主要指標が2つある基本施策（3-(12)）は、2つをまとめた説明なので、カードの後ろに置く
const saysTo = h?.shuyou ? shuyou.filter((r) => r.years[2024]) : [];
const saysOf = (row: (typeof shuyou)[number]) => (saysTo.length === 1 && saysTo[0] === row ? h?.shuyou : undefined);
// この基本施策の取組が観光ロードマップでも評価されている施策の数
const rmCount = new Set(shisaku.flatMap((s) => kankoOfPdcaShisaku(s).map((r) => r.id))).size;
---
<Base title={`${k.name}（沖縄県の基本施策）`} description={kihonDescription(k.name, kihonHead(k.id))} ogType="article">
  <Hierarchy items={planParents({ kihon: k.id })} page={k.name} />
  <header class="sticker lift page-head">
    <HeadKind kind="基本施策" code={k.code} />
    <h1>{k.name}</h1>
    {/* 頭の箱: 最新の年度の主要指標の達成状況（施策のページの頭の判定の箱と同じ地の色の箱）。将来像のページの基本施策の行と同じく、
        概要版の指標ごと（男性・女性なども1指標）に名前と札を並べる。名前は下の主要指標のカードへのリンク。県の見通しはカードの「表で見る」にある */}
    {status.length > 0 && (
      <div class="sh-now inset">
        <div class="sh-l"><Term word="主要指標" />と{yearLong(LATEST)}の<Term word="主要指標の達成率" label="達成状況" /></div>
        <ul class="sh-list">
          {status.map((r) => <li><a class="name-link" href={r.href.slice(r.href.indexOf('#'))}>{r.name}</a><ShuyouStatusTag r={r} /></li>)}
        </ul>
      </div>
    )}
    {k.mezasu && (
      <Says label="目指す姿（県の報告書から）">
        <p>{oneLine(k.mezasu)}</p>
      </Says>
    )}
  </header>

  <Toc
    links={[
      { href: '#shuyou', label: '主要指標' },
      { href: '#list', label: '施策' },
      { href: '#progress', label: '取組の進捗' },
      h && { href: '#hyoka', label: '県のふりかえり' },
      { href: '#source', label: '出典' },
    ]}
    head={{ kind: '基本施策', title: k.name }}
  />

  <section aria-labelledby="shuyou">
    <h2 id="shuyou" class="anchor"><Term word="主要指標" /></h2>
    <p class="small secondary lead">この基本施策の成果をはかる県の物差しごとに、スタート（基準値）からゴール（R9の目標値）までどこまで来たかと、この先の県の見通しが分かります。</p>
    {shuyou.length === 0 && <p class="secondary">報告書に、この基本施策の主要指標の記載がありません。</p>}
    {shuyouLatest.map((row) => <ShuyouCard row={row} says={saysOf(row)} />)}
    {shuyouPast.length > 0 && (
      <details class="past">
        <summary>{yearLabel(LATEST)}の報告に無い主要指標（{shuyouPast.length}）</summary>
        {shuyouPast.map((row) => <ShuyouCard row={row} says={saysOf(row)} />)}
      </details>
    )}
    {h?.shuyou && saysTo.length !== 1 && <ShuyouSays text={h.shuyou} />}
    {shuyou.length > 0 && <p class="small secondary">主要指標は、計画期間の最後のゴール（目標値）だけが決められていて、成果指標のような年度ごとの計画値はありません。</p>}
    <p class="small">ほかの基本施策の主要指標は、<a href="/future/">5つの将来像</a>のページでまとめて見られます。</p>
  </section>

  <section aria-labelledby="list">
    <h2 id="list" class="anchor">施策（{shisaku.length}）</h2>
    <JudgeLegend />
    {/* 施策展開ごとの箱。5つの将来像のページの基本施策の箱と同じく、頭に列の見出し（ShisakuHead）を1回だけ置き、
        行は左の列に施策と成果指標、右の列に主な取組の四角（components/ShisakuItem.astro の toriList） */}
    {tenkai.map(([tid, tname]) => (
      <>
        <h3>{tname}</h3>
        <div class="sticker s-box">
          <ShisakuHead />
          <ul class="row-list">
            {shisaku.filter((s) => s.tenkai_id === tid).map((s) => <ShisakuItem s={s} toriList />)}
          </ul>
        </div>
      </>
    ))}
    {rmCount > 0 && (
      <p class="small rm-note"><span class="plan-tag">{KANKO.short}</span> この基本施策の主な取組の一部は、県の観光の個別計画「<a href={KANKO.href}>{KANKO.name}</a>」の{rmCount}の施策でも評価されています。</p>
    )}
  </section>

  <section aria-labelledby="progress">
    <h2 id="progress" class="anchor">主な取組の進捗（この基本施策の合計）</h2>
    <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
  </section>

  {h && (
    <section aria-labelledby="hyoka">
      <h2 id="hyoka" class="anchor">県によるふりかえり（R4〜R6の3年間）</h2>
      <p class="small secondary lead">県の<Term word="評価検証報告書" />（{HYOKA.published}）が、この基本施策の成果と課題をまとめたものです。</p>
      <Says class="voice">
        {h.intro && <p class="intro">{h.intro}</p>}
        <h3>主な施策の成果</h3>
        <ul class="pts">{h.results.map((r) => <li>{r}</li>)}</ul>
      </Says>
      <Says class="voice">
        <h3>主な課題</h3>
        {h.issues.map((x) => (
          <>
            {x.head && <h4>{x.head}</h4>}
            <ul class="pts">{x.items.map((t) => <li>{t}</li>)}</ul>
          </>
        ))}
      </Says>
    </section>
  )}

  <ShareBox kind="基本施策" name={k.name} />

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <p class="small">県の報告書での番号は<strong class="report-no">基本施策 {k.code}</strong>です。</p>
    {src && <p class="small">{yearLong(LATEST)}: <ExtLink href={src.href}>総括報告書（{src.label}）</ExtLink>。主要指標の出典は、主要指標の「表で見る」の表にあります。</p>}
    {hSrc && <p class="small">県によるふりかえり（R4〜R6）: <ExtLink href={hSrc.href}>{hSrc.label.replace(/ \d+ページ$/, '')} {h.page}〜{h.page_end}ページ</ExtLink></p>}
    {renamed.length > 0 && <p class="small">{renamed.map((x) => `主要指標「${x.name}」は、${formerText(x.fs)}という名前で載っています。`).join('')}同じ指標として<a href="/data/#kazoekata">年度をつないでいます</a>。</p>}
  </section>
</Base>

<style>
  /* 頭は施策ページと同じ太いステッカー。目指す姿は県の吹き出しに入れる */
  /* 頭の主要指標の箱。指標ごとに1行で、名前の後ろに達成状況の札（入らなければ札を次の行へ送る） */
  .sh-now { display: grid; gap: 6px; padding: 12px 18px; }
  .sh-l { font-size: 0.875rem; color: var(--ink-2); }
  .sh-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .sh-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 10px; }
  .sh-list .name-link { font-size: 1.0625rem; }
  @media (max-width: 640px) { .sh-now { padding: 10px 14px; } }
  .past { margin-top: 18px; }
  .report-no { white-space: nowrap; }
  .voice { margin-top: 14px; }
  .voice h3 { margin: 0.6em 0 0.3em; font-size: 1.02rem; }
  .voice h4 { margin: 0.8em 0 0.2em; font-size: 0.95rem; }
  .intro { margin: 0 0 4px; font-weight: 700; }
  .pts { margin: 0; padding-left: 1.2em; }
  .pts li { margin: 0 0 6px; }
  /* 札は文の頭に置いて、文と一緒に折り返す（flex にすると、かっこ・リンク・文が別々の箱になり、スマホでばらばらに折り返す） */
  .rm-note { margin-top: 14px; }
  /* 施策展開ごとの箱: 列の見出しの行の下に、細い線で区切った施策の行（.row-list の枠と影は外して箱に任せる） */
  .s-box { padding: 0; overflow: hidden; }
  .s-box .row-list { border: 0; border-radius: 0; box-shadow: none; border-top: 1.5px solid var(--grid); }
</style>
