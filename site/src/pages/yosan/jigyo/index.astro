---
// 予算事業をさがす。部局の検証票の予算事業（予算事業のページ /yosan/jigyo/<slug>/ があるもの）と、一括交付金（ソフト）の事後評価の事業を同じ一覧で、
// キーワード・種類・財源・部局・将来像・くらしのテーマ・年度・共通の金額・事後評価の評価と移り変わりで絞り込み、金額・名前・施策の順に並べ替える。
// 一括交付金の事業は予算の一覧として並べ、札と種類の絞り込みで見分ける（予算事業とは結び付けない。docs/design.md の5章）。
// 行は検索用のデータ（lib/jigyo-data.ts）を読んでブラウザで描く（scripts/jigyo-search.ts。docs/site.md の7章）
import Base from '../../../layouts/Base.astro';
import Hierarchy from '../../../components/Hierarchy.astro';
import FilterMore from '../../../components/FilterMore.astro';
import ThemeFilter from '../../../components/ThemeFilter.astro';
import Term from '../../../components/Term.astro';
import Icon from '../../../components/Icon.astro';
import Says from '../../../components/Says.astro';
import ExtLink from '../../../components/ExtLink.astro';
import { LATEST, yearLabel, yearLong, yearsLong, FUNDS, DEPTS, getShouraizou, getBudgetProjects } from '../../../lib/data.ts';
import { IKKATSU, IKKATSU_YEARS, IKKATSU_LATEST, IKKATSU_TRENDS, GRADES, ikkatsuGroups, ikkatsuRows, planSourceLink } from '../../../lib/plans.ts';
import { LINKS } from '../../../lib/links.ts';
import { fmt } from '../../../lib/format.ts';
import { JIGYO_DATA_FALLBACK, jigyoDataPath } from '../../../lib/jigyo-data.ts';

const n = getBudgetProjects().length;
const nIk = ikkatsuGroups().length;
const dataPath = jigyoDataPath();
// 一括交付金の事後評価の年度ごとの総括表（事業の行の出典）
const ikSources = IKKATSU_YEARS.flatMap((y) => {
  const id = ikkatsuRows(y)[0]?.source;
  const link = id && planSourceLink('ikkatsu', id);
  return link ? [{ href: link.href, year: y }] : [];
});
---
<Base title="予算事業をさがす" description={`沖縄県PDCAの主な取組に書かれた予算事業（${fmt(n)}件）と、一括交付金（ソフト）の事後評価の事業（${fmt(nIk)}件）を、金額・財源・部局・評価でさがせます。`}>
  <link slot="head" rel="preload" href={dataPath} as="fetch" crossorigin="anonymous" />
  <Hierarchy items={[{ href: '/yosan/', label: '予算と財源' }]} page="予算事業をさがす" />
  <h1>予算事業をさがす</h1>
  <p class="secondary lead">
    部局の検証票で<Term word="主な取組" />に書かれている予算事業 {fmt(n)}件と、一括交付金（ソフト）を使った県の事業 {fmt(nIk)}件（{yearsLong(IKKATSU_YEARS[0], IKKATSU_LATEST)}の<Term word="一括交付金の事後評価" label="事後評価" />つき）を、金額・財源・部局でさがせます。
  </p>
  <Says who="!">
    <p><strong>一括交付金の事業は、沖縄県PDCA（施策・主な取組の評価）とは別の評価の事業です。</strong>「{IKKATSU.short}」の札で見分けられます。金額は事後評価の予算額（前の年度からの繰越を含む事業費）で、予算事業の決算見込額とは数え方と年度が違います。</p>
  </Says>

  <form class="filters sticker" id="jf" role="search" aria-label="予算事業の絞り込み">
    <label class="q" data-label="キーワード">キーワード（名前・前の名前・所管課・書かれている取組の名前・事業の内容）
      <input type="search" name="q" placeholder="例: 観光、子ども、MICE、所管課の名前" />
    </label>
    <label class="sort">並び
      <select name="sort">
        <option value="">金額の大きい順</option>
        <option value="name">名前の順</option>
        <option value="order">施策の順</option>
      </select>
    </label>
    <FilterMore id="jigyo-more">
    <label data-label="種類">種類
      <select name="kind">
        <option value="">すべて</option>
        <option value="budget">予算事業（主な取組の検証票）</option>
        <option value="ikkatsu">一括交付金の事業（事後評価）</option>
      </select>
    </label>
    <label data-label="財源">財源
      <select name="fund">
        <option value="">すべて</option>
        {FUNDS.map((f, i) => <option value={i}>{f.key}</option>)}
      </select>
    </label>
    <label data-label="部局">担当部局
      <select name="dept">
        <option value="">すべて</option>
        {DEPTS.map((d, i) => <option value={i}>{d.name}</option>)}
      </select>
    </label>
    <label data-label="将来像">将来像
      <select name="s">
        <option value="">すべて</option>
        {getShouraizou().map((s) => <option value={s.id}>将来像{s.id}</option>)}
      </select>
    </label>
    <ThemeFilter />
    <label data-label="年度">年度
      <select name="yr">
        <option value="">すべて</option>
        <option value="latest">最新の年度にある（予算事業は{yearLabel(LATEST)}、一括交付金の事業は{yearLabel(IKKATSU_LATEST)}）</option>
        <option value="old">最新の年度に無い（終了・名称変更）</option>
      </select>
    </label>
    <fieldset class="fgroup" data-label="共通">
      <legend class="fgroup-label">共通の金額（予算事業）</legend>
      <div class="fchips">
        <label class="fchip"><input type="checkbox" name="shared" value="1" data-text="共通の金額がある予算事業だけ" /><span>共通の金額がある予算事業だけ</span></label>
      </div>
    </fieldset>
    <fieldset class="fgroup" data-label="評価">
      <legend class="fgroup-label">一括交付金の事業の{yearLabel(IKKATSU_LATEST)}の評価・いくつでも選べます</legend>
      <div class="fchips">
        {GRADES.map((x) => (
          <label class="fchip" title={x.note}>
            <input type="checkbox" name="gr" value={x.key} data-text={`${yearLabel(IKKATSU_LATEST)}の評価 ${x.mark} ${x.key}`} />
            <span><Icon tone={x.tone} shape={x.shape} />{x.mark} {x.key}<span class="sr-only">（{x.note}）</span></span>
          </label>
        ))}
        <label class="fchip"><input type="checkbox" name="gr" value="none" data-text={`${yearLabel(IKKATSU_LATEST)}の評価なし`} /><span><Icon tone="blank" shape="ring" />{yearLabel(IKKATSU_LATEST)}の評価なし</span></label>
      </div>
    </fieldset>
    <label data-label="評価の移り変わり">一括交付金の事業の評価の移り変わり
      <select name="tr">
        <option value="">すべて</option>
        {IKKATSU_TRENDS.map((t) => <option value={t.key}>{t.label}</option>)}
      </select>
    </label>
    </FilterMore>
  </form>
  <div class="active-filters" id="active" hidden></div>
  <p class="result-count" aria-live="polite" aria-atomic="true"><span id="count">読み込み中…</span><span id="unit" hidden>件を表示</span></p>

  <ul class="row-list" id="results" aria-busy="true" data-src={dataPath} data-fallback={JIGYO_DATA_FALLBACK}></ul>
  <p><button type="button" class="button" id="more" hidden>さらに表示</button></p>
  <div class="small secondary note">
    <p>
      予算事業の金額は、予算事業ごとに最後に載った報告の決算見込額で、複数の取組に同じ金額が書かれているときは1回だけ数えています（<a href="/yosan/">予算と財源</a>と同じ数え方）。
      名前が変わった予算事業は、部局の検証票の「翌年度の予算事業名」でつないで1件にしています（<a href="/data/#kazoekata">このサイトでの数え方</a>）。部局は、書かれている取組の最新の報告での所管部局です。
    </p>
    <p>
      一括交付金の事業の金額は、最後の年度の事後評価の予算額（前の年度からの繰越を含む事業費。国が8割・県が2割を負担）です。名前を押すと、施策のページで成果目標・予算の執行・今後の方針を見られます。
      評価は、事業ごとの成果目標の達成率で決まります（◎達成は100%、○概ね達成は70%以上、△一部達成は70%未満で一部の目標を達成、未達成は70%未満でどの目標も未達成）。
      主な取組や予算事業と同じ事業のこともありますが、名前や単位が違うことがあり、結び付けていません。
    </p>
    <p>
      金額の順では、最新の年度のもの（予算事業は{yearLong(LATEST)}の報告、一括交付金の事業は{yearLong(IKKATSU_LATEST)}の事後評価）を先に、そのあとに年度の新しい順に並べています。数え方の違う金額が並ぶので、比べるときは種類で絞り込んでください。
    </p>
    <p>
      出典: 予算事業は各部局の「主な取組」検証票（予算事業のページの出典）。一括交付金の事業は「<ExtLink href={LINKS.ikkatsu}>{IKKATSU.name}</ExtLink>」の総括表（{ikSources.map((x, i) => <>{i > 0 && '・'}<ExtLink href={x.href}>{yearLabel(x.year)}</ExtLink></>)}）。
    </p>
  </div>
  <noscript><p>この検索には JavaScript が必要です。<a href="/yosan/#jigyo">予算と財源</a>で金額の大きい予算事業を見ることもできます。</p></noscript>
</Base>

<style>
  .sort { flex: 0 1 12em; }
  .note p { margin: 0 0 8px; }
  /* 結果の行（scripts/jigyo-search.ts が描く）。左に名前と所管・取組の数（一括交付金の事業は評価）・財源、右に金額と共通の札 */
  #results :global(.j-row) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 20px; align-items: start; }
  #results :global(.j-main) { display: grid; gap: 2px; min-width: 0; line-height: 1.6; }
  #results :global(.j-funds) { display: flex; flex-wrap: wrap; gap: 2px 12px; }
  #results :global(.j-grade .chip) { font-size: 0.8125rem; }
  #results :global(.j-amt) { display: grid; justify-items: end; gap: 2px; text-align: right; white-space: nowrap; }
  #results :global(.j-amt .big) { font-size: 1.15rem; }
  #results :global(.j-amt-v) { display: inline-flex; align-items: center; gap: 8px; }
  @media (max-width: 640px) {
    #results :global(.j-row) { grid-template-columns: 1fr; }
    #results :global(.j-amt) { justify-items: start; text-align: left; }
  }
  /* 検索用のデータが届くまで、一覧の場所を画面の高さぶん取っておく（取組をさがすと同じ。docs/site.md の 7章） */
  :global(:root.js) #results[aria-busy='true'] { display: block; min-height: 100vh; background: none; border-color: transparent; box-shadow: none; }
</style>
