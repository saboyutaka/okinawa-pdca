---
// 予算と財源。部局の検証票に書かれた主な取組の予算事業の金額（重複を除く）を、財源・部局・将来像・予算事業ごとにまとめる。
// 一括交付金（ソフト）は事業ごとの事後評価があるので節を分け、事業をさがすページ（/yosan/ikkatsu/）へつなぐ。
// 合計の数え方・合計から除いた金額・部局票がある範囲は、最後の「データの注意」に畳む（#suspect・#coverage は他のページからの行き先）
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import AmountChart from '../../components/AmountChart.astro';
import BarList from '../../components/BarList.astro';
import StatusChart from '../../components/StatusChart.astro';
import StatusBar from '../../components/StatusBar.astro';
import IkkatsuRow from '../../components/IkkatsuRow.astro';
import BudgetItem from '../../components/BudgetItem.astro';
import Term from '../../components/Term.astro';
import ExtLink from '../../components/ExtLink.astro';
import {
  YEARS, LATEST, yearLabel, yearLong, DEPTS, FUNDS, AMOUNT_KINDS, countBy,
  amountEntries, budgetGroups, getSuspects, budgetOf, getTorikumi, getShisaku, getShouraizou, sourceLink,
  currentDeptOf, torikumiPage, type AmountEntry,
} from '../../lib/data.ts';
import { IKKATSU, IKKATSU_YEARS, IKKATSU_LATEST, IKKATSU_HREF, GRADES, ikkatsuGroups, ikkatsuShisakuIds, isShort } from '../../lib/plans.ts';
import { fmt, yen, pct } from '../../lib/format.ts';
import type { AmountKind } from '../../lib/types.ts';

const sum = (xs: { amount: number }[]) => xs.reduce((s, x) => s + x.amount, 0);
const byFund = (entries: AmountEntry[]) => Object.fromEntries(FUNDS.map((f) => [f.key, sum(entries.filter((e) => e.fund === f.key))]));
const oku = (v: number) => Math.round(v / 1e4) / 10; // 千円 → 億円（小数1桁）

// 財源別の推移。各年度の報告に載っている金額のうち、確定に近いもの（決算額）を優先して並べる
const SERIES: { report: number; kind: AmountKind }[] = [
  { report: 2022, kind: 'settled' },
  { report: 2023, kind: 'settled' },
  { report: 2024, kind: 'settled' },
  { report: LATEST, kind: 'settled' },
  { report: LATEST, kind: 'estimate' },
  { report: LATEST, kind: 'initial' },
];
const trendRows = SERIES.map(({ report, kind }) => {
  const y = report + AMOUNT_KINDS[kind].offset;
  return { label: yearLabel(y), sub: `${AMOUNT_KINDS[kind].label}（${yearLabel(report)}報告）`, amounts: byFund(amountEntries(report, kind)) };
});

const settled = amountEntries(LATEST, 'settled');
const estimate = amountEntries(LATEST, 'estimate');
const initial = amountEntries(LATEST, 'initial');
const fundSum = (es: AmountEntry[], key: string) => sum(es.filter((e) => e.fund === key));
const soft = fundSum(estimate, '一括交付金（ソフト）');
const hard = fundSum(estimate, '一括交付金（ハード）');

// 一括交付金（ソフト）の事後評価
const ikGroups = ikkatsuGroups();
const ikLatest = ikGroups.filter((g) => g.years[IKKATSU_LATEST]);
const gradeKeys = GRADES.map((x) => x.key);
const ikCounts = countBy(ikLatest, (g) => g.years[IKKATSU_LATEST].grade_label || 'なし', gradeKeys);
const ikYearRows = IKKATSU_YEARS.map((y) => ({
  label: yearLabel(y),
  counts: countBy(ikGroups.filter((g) => g.years[y]), (g) => g.years[y].grade_label || 'なし', gradeKeys),
}));
// 将来像は、事業の最初の施策の将来像
const szOf = (g: (typeof ikGroups)[number]) => ikkatsuShisakuIds(g).map(getShisaku).find((s) => s)?.shouraizou;
const ikSzRows = getShouraizou().map((s) => ({
  label: `将来像${s.id}`,
  sub: s.name,
  href: `${IKKATSU_HREF}?s=${s.id}`,
  counts: countBy(ikLatest.filter((g) => szOf(g) === s.id), (g) => g.years[IKKATSU_LATEST].grade_label || 'なし', gradeKeys),
}));
const ikShort = ikLatest
  .filter((g) => isShort(g.years[IKKATSU_LATEST].grade_label))
  .sort((a, b) => gradeKeys.indexOf(b.latest.grade_label) - gradeKeys.indexOf(a.latest.grade_label) || (a.latest.rate ?? 0) - (b.latest.rate ?? 0));

// 部局別・将来像別（最新の報告での所管部局）
const toriByKey = new Map(getTorikumi(LATEST).map((t) => [`${t.shisaku_id}|${t.key}`, t]));
const deptOf = (e: { shisaku_id: string; key: string }) => toriByKey.get(`${e.shisaku_id}|${e.key}`)?.dept || '';
const deptItems = DEPTS.map((d) => ({ label: d.name, n: oku(sum(estimate.filter((e) => deptOf(e) === d.name))), href: `/bukyoku/${d.slug}/#yosan` }))
  .filter((i) => i.n > 0)
  .sort((a, b) => b.n - a.n);
const visionItems = getShouraizou().map((s) => ({
  label: `将来像${s.id}`,
  sz: s.id,
  note: s.name,
  href: `/future/${s.id}/#yosan-h`,
  n: oku(sum(estimate.filter((e) => e.shisaku_id.startsWith(`${s.id}-`)))),
}));

// 予算事業ごと（同じ名前をまとめる）。R7の決算見込額の大きい順。財源ごとの順位は、その財源の金額で決める
const budgets = budgetGroups(LATEST);
const top = budgets.slice(0, 20);
const TOP_BY_FUND = 10;
const byFundTop = FUNDS.filter((f) => f.key !== 'その他').map((f) => ({
  ...f,
  rows: budgets.filter((g) => g.funds.has(f.key)).sort((a, b) => (b.funds.get(f.key) || 0) - (a.funds.get(f.key) || 0)).slice(0, TOP_BY_FUND),
}));

// 部局票がある範囲（総括報告書の取組のうち、予算の記載を読めたもの）。部局は他のページと同じく最新の報告での所管部局
const coverage = DEPTS.map((d) => ({
  name: d.name,
  years: YEARS.map((y) => {
    const ts = getTorikumi(y).filter((t) => currentDeptOf(y, t.shisaku_id, t.key) === d.name);
    return [ts.filter((t) => budgetOf(y, t.shisaku_id, t.key)).length, ts.length];
  }),
})).filter((d) => d.years.some(([, n]) => n > 0));
const coverageAll = YEARS.map((y) => {
  const ts = getTorikumi(y);
  return [ts.filter((t) => budgetOf(y, t.shisaku_id, t.key)).length, ts.length];
});
const coverageLatest = coverageAll[coverageAll.length - 1];

const suspects = getSuspects();
---
<Base title="予算と財源" description="沖縄県PDCAの主な取組に書かれた予算事業の決算額・当初予算額と財源（県単・一括交付金など）の推移と、一括交付金（ソフト）の事業の事後評価です。">
  <Crumbs items={[{ href: '/', label: 'トップ' }, { label: '予算と財源' }]} />

  <header class="sticker lift head">
    <h1>予算と財源</h1>
    <p class="lead">
      各部局の検証票に書かれた、<Term word="主な取組" />の予算事業の金額と財源をまとめました。
      財源の意味や沖縄振興予算との違いは<a href="/yosan/zaigen/">予算の財源のしくみ</a>で説明しています。
    </p>
    <div class="bubble-row says">
      <span class="avatar" aria-hidden="true">!</span>
      <div class="bubble small">
        <p><strong>合計は目安です。</strong>県の予算全体ではなく、主な取組に書かれた予算事業だけの金額です（同じ予算事業の重複は除いています。<a href="#note">数え方</a>）。</p>
      </div>
    </div>
  </header>

  <div class="facts">
    <div class="sticker fact">
      <div class="tile-label">{yearLabel(LATEST)}の決算見込額</div>
      <div class="tile-value">{yen(sum(estimate))}</div>
      <div class="tile-sub">{yearLabel(LATEST - 1)}の決算額 {yen(sum(settled))}、{yearLabel(LATEST + 1)}の当初予算額 {yen(sum(initial))}</div>
    </div>
    <div class="sticker fact">
      <div class="tile-label">うち一括交付金（{yearLabel(LATEST)}の決算見込額）</div>
      <div class="tile-value">{yen(soft + hard)}<small>（{pct(soft + hard, sum(estimate))}）</small></div>
      <div class="tile-sub split"><span class="swatch series-2">ソフト</span> {yen(soft)}　<span class="swatch series-3">ハード</span> {yen(hard)}</div>
    </div>
    <div class="sticker fact">
      <span class="ik-tag">{IKKATSU.short}</span>
      <div class="tile-label">{yearLabel(IKKATSU_LATEST)}に成果目標を達成した事業</div>
      <div class="tile-value">{fmt(ikCounts['達成'] || 0)}/{fmt(ikLatest.length)}<small>事業</small></div>
      <StatusBar categories={GRADES} counts={ikCounts} unit="事業" context={`${yearLabel(IKKATSU_LATEST)}の事後評価 `} size="mini" />
      <div class="tile-sub">一括交付金（ソフト）の事業ごとの、主な取組とは別の<Term word="一括交付金の事後評価" label="評価" />です。</div>
      <a class="small" href={IKKATSU_HREF}>一括交付金の事業をさがす</a>
    </div>
  </div>

  <nav class="toc" aria-label="このページの内容">
    <div class="toc-links" data-scroll-hint>
      <a href="#suii">財源の推移</a>
      <a href="#ikkatsu">一括交付金の事業</a>
      <a href="#bunya">部局・将来像</a>
      <a href="#jigyo">大きな予算事業</a>
      <a href="#note">データの注意</a>
    </div>
  </nav>

  <section aria-labelledby="suii">
    <h2 id="suii" class="anchor">財源別の推移</h2>
    <p class="small secondary lead">色は予算事業の主な財源です。</p>
    <AmountChart
      title="取組に書かれた予算事業の金額（財源別）"
      caption="R3〜R6は決算額、R7は決算見込額、R8は当初予算額。"
      categories={FUNDS}
      rows={trendRows}
    />
    <details class="sticker funds">
      <summary>財源の区分の意味</summary>
      <ul>
        {FUNDS.map((f) => <li><span class={`swatch series-${f.series}`}>{f.key}</span> {f.short}（負担: {f.who}）</li>)}
      </ul>
      <p class="small">
        ここでの合計は県の取組の予算で、国が沖縄のために組む「沖縄振興予算」とは別のものです。
        「県単等」も県民の税金だけでなく、国から配られる地方交付税などが元になっています。くわしくは<a href="/yosan/zaigen/">予算の財源のしくみ</a>へ。
      </p>
    </details>
    <p class="small secondary">年度によって元になる報告と取組の範囲が違うので、増減は目安です。</p>
  </section>

  <section aria-labelledby="ikkatsu">
    <h2 id="ikkatsu" class="anchor">一括交付金（ソフト）の事業と事後評価</h2>
    <p class="small secondary lead">主な取組の評価とは別に、一括交付金（ソフト）を使った事業ごとに、県が成果目標の達成状況を<Term word="一括交付金の事後評価" label="事後評価" />しています。</p>
    <StatusChart title="事後評価の結果" caption="成果目標の達成率による県の評価。" categories={GRADES} rows={ikYearRows} unit="事業" />
    <StatusChart title={`将来像ごとの事業（${yearLabel(IKKATSU_LATEST)}）`} caption="事業の施策で分けています。押すと、その将来像の事業をさがせます。" categories={GRADES} rows={ikSzRows} unit="事業" legend={false} />
    <h3>{yearLabel(IKKATSU_LATEST)}に目標に届かなかった事業（{fmt(ikShort.length)}）</h3>
    <p class="small secondary">△一部達成・未達成の事業です。名前を押すと、施策のページで成果目標と県の今後の方針を見られます。</p>
    <ul class="row-list">
      {ikShort.map((g) => <IkkatsuRow g={g} />)}
    </ul>
    <p class="more-link"><a class="button" href={IKKATSU_HREF}>一括交付金の事業をすべてさがす（{fmt(ikGroups.length)}件）</a></p>
    <p class="small secondary">事業の金額は事後評価の予算額（前の年度からの繰越を含む事業費）で、下の予算事業の決算見込額とは年度と数え方が違います。</p>
  </section>

  <section aria-labelledby="bunya">
    <h2 id="bunya" class="anchor">部局別・将来像別（{yearLong(LATEST)}の決算見込額）</h2>
    <p class="small secondary lead">件数ではなく金額（億円）です。名前を押すと、部局・将来像のページの予算を見られます。</p>
    <BarList title="部局別" caption="最新の報告での所管部局。" items={deptItems} unit="億円" />
    <BarList title="将来像別" items={visionItems} unit="億円" />
  </section>

  <section aria-labelledby="jigyo">
    <h2 id="jigyo" class="anchor">金額の大きい予算事業（{yearLong(LATEST)}の決算見込額）</h2>
    <p class="small secondary lead">同じ名前の予算事業をまとめた上位{fmt(top.length)}件です。1つの予算事業が複数の取組を支えていることがあります。</p>
    <ul class="row-list">{top.map((g) => <BudgetItem g={g} report={LATEST} />)}</ul>
    <h3>財源ごとに見る</h3>
    <p class="small secondary">財源ごとに、その財源の金額が大きい上位{TOP_BY_FUND}件です。</p>
    {byFundTop.map((f) => (
      <details class="fund-top anchor" id={`fund-${f.series}`}>
        <summary><span class={`swatch series-${f.series}`}>{f.key}</span>の上位{fmt(f.rows.length)}件</summary>
        <ul class="row-list">{f.rows.map((g) => <BudgetItem g={g} report={LATEST} />)}</ul>
      </details>
    ))}
    <p class="small secondary">取組の進捗状況は{yearLabel(LATEST)}の報告の判定です。</p>
  </section>

  <section aria-labelledby="note">
    <h2 id="note" class="anchor">データの注意</h2>
    <ul class="small notes">
      <li>県の予算全体ではなく、PDCAの主な取組に書かれている予算事業だけの金額です。県の人件費や借金の返済は入りません。国直轄や市町村の事業は、取組の予算事業として財源に「国直轄」「市町村」と書かれた分（わずか）だけが「その他」に入ります。企業局の事業や流域下水道事業会計など、一般会計ではない会計の事業も含みます。</li>
      <li>同じ予算事業が複数の取組に同じ金額で書かれていることが多いため、同じ予算事業・財源・金額は1回だけ数えています（部局・将来像は、最初に出てくる取組のものに寄せます）。</li>
      <li>県単融資事業費（年650億円前後）のように、貸付の原資（融資枠）を計上している事業も含みます。</li>
      <li>部局の検証票が手に入らない取組（病院事業局など）は含みません。{yearLabel(LATEST)}は主な取組{fmt(coverageLatest[1])}件のうち{fmt(coverageLatest[0])}件（{pct(coverageLatest[0], coverageLatest[1])}）の予算を読めています。</li>
      <li>くわしくは<a href="/about/#kazoekata">このサイトでの数え方</a>と<a href="/yosan/zaigen/">予算の財源のしくみ</a>。</li>
    </ul>

    <details class="sticker cad anchor" id="suspect">
      <summary>合計から除いた金額（要確認・{fmt(suspects.length)}件）</summary>
      <p class="small secondary">
        同じ行の3つの金額（前年度決算・当年度見込・翌年度当初）のうち1つが0でない他の金額の50倍以上・10億円以上で、他の年度の報告にある同じ予算事業・同じ年度の金額でも裏付けられないものは、桁の誤記の疑いがあるため合計に入れていません。
        元の報告書で確認できるよう、出典のページを載せています。
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>報告</th><th>予算事業</th><th>種類</th><th class="num">記載の金額</th><th class="num">同じ行の他の金額</th><th>出典</th></tr></thead>
          <tbody>
            {suspects.map((x) => {
              const src = sourceLink(x.file, x.page);
              const others = (Object.keys(AMOUNT_KINDS) as AmountKind[]).filter((k) => k !== x.kind && x[k] != null).map((k) => `${AMOUNT_KINDS[k].label} ${yen(x[k])}`).join('、');
              const href = torikumiPage(x.shisaku_id, x.key);
              return (
                <tr>
                  <th>{yearLabel(x.report)}</th>
                  <td>{x.name}<br /><small class="secondary">{href ? <a class="sub-link" href={href}>{x.torikumi}</a> : x.torikumi}</small></td>
                  <td>{AMOUNT_KINDS[x.kind].label}</td>
                  <td class="num">{yen(x.amount)}</td>
                  <td class="small">{others || '—'}</td>
                  <td class="small">{src ? <ExtLink href={src.href}>{src.label}</ExtLink> : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </details>

    <details class="sticker cad anchor" id="coverage">
      <summary>部局票がある範囲</summary>
      <p class="small secondary">
        総括報告書の主な取組のうち、部局の検証票から予算の記載を読めたものの数です（部局は最新の報告での所管部局で数えています）。企業局は県企業局のサイトの設定（robots.txt）で自動取得できないため、手動でダウンロードしたものを使っています（R5の1ファイルはまだありません）。
        病院事業局は表の形が特殊で読み取れておらず、R4はファイルが見つかりません（リンク切れ）。県警本部はR6の検証票が公開ページに見当たりません。
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>部局</th>{YEARS.map((y) => <th class="num">{yearLabel(y)}</th>)}</tr></thead>
          <tbody>
            {coverage.map((d) => (
              <tr>
                <th>{d.name}</th>
                {d.years.map(([ok, n]) => <td class="num">{n ? `${fmt(ok)}/${fmt(n)}` : '—'}</td>)}
              </tr>
            ))}
            <tr class="total"><th>合計</th>{coverageAll.map(([ok, n]) => <td class="num"><strong>{fmt(ok)}/{fmt(n)}</strong><br /><small class="secondary">{pct(ok, n)}</small></td>)}</tr>
          </tbody>
        </table>
      </div>
    </details>
  </section>
</Base>

<style>
  .head { display: grid; gap: 8px; margin-top: 12px; }
  .head h1 { margin: 0; }
  .head .lead { margin: 0; }
  .says .bubble p { margin: 0; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 18px; }
  .fact { display: grid; gap: 6px; align-content: start; justify-items: start; }
  .fact .split { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; }
  .funds { margin-top: 16px; padding: 12px 20px; }
  .funds summary { margin: 0; }
  .funds ul { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 6px; font-size: 0.9rem; }
  .funds .swatch { font-weight: 600; margin-right: 4px; }
  .more-link { margin: 16px 0 8px; }
  .fund-top { margin-top: 10px; }
  .fund-top > summary .swatch { font-size: inherit; }
  .notes { padding-left: 1.2em; display: grid; gap: 4px; }
  .cad { margin-top: 12px; padding: 12px 20px; }
  .cad > summary { margin: 0; }
</style>
