---
import Base from '../layouts/Base.astro';
import BarList from '../components/BarList.astro';
import Stamps from '../components/Stamps.astro';
import Icon from '../components/Icon.astro';
import Sz from '../components/Sz.astro';
import Term from '../components/Term.astro';
import { YEARS, LATEST, yearLabel, DEPTS, DELAYS, toneOfStatus, getTorikumiGroups, getShouraizou, deptHref } from '../lib/data.js';
import { getThemes, themeIdsOfItem } from '../lib/themes.js';
import { fmt } from '../lib/format.js';
import { LINKS } from '../lib/links.js';
import ExtLink from '../components/ExtLink.astro';

const groups = getTorikumiGroups();
const all = groups.filter((g) => g.inAllYears);
const delay4 = all.filter((g) => g.delayYears === 4);
const delay3 = all.filter((g) => g.delayYears === 3);
const last = YEARS.length - 1;
const recovered = groups.filter((g) => DELAYS.has(g.statuses[last - 1]) && g.statuses[last] === '順調');

const byDept = DEPTS.map((d) => ({
  label: d.name,
  n: [...delay4, ...delay3].filter((g) => g.dept === d.name).length,
  href: `/bukyoku/${d.slug}/#okure`,
})).filter((i) => i.n > 0).sort((a, b) => b.n - a.n);

const sections = [
  { id: 'delay4', tone: 'critical', title: '4年とも遅れている取組', desc: 'R4〜R7のどの年度も、進捗状況が「やや遅れ」「大幅遅れ」「未着手」だった取組です。', rows: delay4 },
  { id: 'delay3', tone: 'serious', title: '4年のうち3年遅れている取組', desc: '4年のうち3つの年度で遅れていた取組です。', rows: delay3 },
  { id: 'recovered', tone: 'good', title: `${yearLabel(LATEST - 1)}の遅れから${yearLabel(LATEST)}で「順調」に戻った取組`, desc: `${yearLabel(LATEST - 1)}に遅れていて、${yearLabel(LATEST)}は順調になった取組です。`, rows: recovered },
];
const depts = DEPTS.filter((d) => sections.some((s) => s.rows.some((g) => g.dept === d.name)));
const stampsOf = (g) => YEARS.map((y, i) => (g.statuses[i] ? { year: y, tone: toneOfStatus(g.statuses[i]), text: g.statuses[i] } : { year: y, tone: null, text: '報告なし' }));
---
<Base title="遅れが続いている取組" description="沖縄県PDCAで、令和4〜7年度に進捗の遅れが続いている主な取組と、遅れから順調に戻った取組の一覧です。くらしのテーマ・部局・将来像で絞り込めます。">
  <nav class="breadcrumb"><a href="/">トップ</a> › <a href="/torikumi/">取組をさがす</a> › 遅れが続いている取組</nav>
  <h1>遅れが続いている取組</h1>
  <p class="lead">
    主な取組の<Term word="進捗状況" />が「やや遅れ」「大幅遅れ」「未着手」だった年度を数えました。
    4年とも報告にある取組 {fmt(all.length)}件のうち、4年とも遅れているのは{fmt(delay4.length)}件、4年のうち3年遅れているのは{fmt(delay3.length)}件です。
  </p>

  <div class="summary">
    {sections.map((sec) => (
      <a class="sticker sum" href={`#${sec.id}`}>
        <span class="sum-head"><Icon tone={sec.tone} size={16} />{sec.title}</span>
        <span class="big sum-n">{fmt(sec.rows.length)}<small>件</small></span>
      </a>
    ))}
  </div>

  <form class="filters sticker" role="search" aria-label="取組の絞り込み" data-filter="#okure-list" data-count="#count" data-empty="#empty" data-summary="#active">
    <label class="q" data-label="キーワード">キーワード（取組・施策・所管課の名前）
      <input type="search" name="q" placeholder="例: 離島、子ども、観光" />
    </label>
    <label data-label="テーマ"><span class="lbl">くらしのテーマ <span class="own">独自の分類</span></span>
      <select name="theme">
        <option value="">すべて</option>
        {getThemes().map((t) => <option value={t.id}>{t.label}</option>)}
      </select>
    </label>
    <label data-label="部局">担当部局
      <select name="dept">
        <option value="">すべて</option>
        {depts.map((d) => <option value={d.name}>{d.name}</option>)}
      </select>
    </label>
    <fieldset class="fgroup" data-label="将来像">
      <legend class="fgroup-label">将来像</legend>
      <div class="fchips">
        <label class="fchip"><input type="radio" name="s" value="" checked /><span>すべて</span></label>
        {getShouraizou().map((s) => <label class="fchip" title={s.name}><input type="radio" name="s" value={String(s.id)} data-text={`将来像${s.id}`} /><span><Sz id={s.id} sr={false} />将来像{s.id}</span></label>)}
      </div>
    </fieldset>
  </form>
  <div class="active-filters" id="active" hidden></div>
  <p class="result-count" aria-live="polite"><span id="count">{fmt(delay4.length + delay3.length + recovered.length)}</span>件を表示</p>

  <div id="okure-list">
    {sections.map((sec) => (
      <section class="anchor" id={sec.id} data-group aria-labelledby={`h-${sec.id}`}>
        <h2 id={`h-${sec.id}`} class="sec-h"><Icon tone={sec.tone} size={18} /><span>{sec.title}（<span data-group-count>{fmt(sec.rows.length)}</span>件）</span></h2>
        <p class="small secondary">{sec.desc}</p>
        <ul class="row-list">
          {sec.rows.map((g) => {
            const t = g.latest;
            const themes = themeIdsOfItem(g.shisaku.id, t.name);
            return (
              <li
                class="o-row"
                data-item
                data-theme={themes.join('|')}
                data-dept={g.dept}
                data-s={String(g.shisaku.shouraizou)}
                data-text={`${t.name} ${g.section} ${g.shisaku.code} ${g.shisaku.name} ${t.indicator || ''}`}
              >
                <div class="o-main">
                  <a class="o-name name-link" href={g.href}>{t.name}</a>
                  <div class="small secondary">{deptHref(g.section) ? <a class="sub-link" href={deptHref(g.section)}>{g.section}</a> : g.section}・施策 <a class="sub-link" href={`/shisaku/${g.shisaku.id}/`}>{g.shisaku.name}</a> <span class="code-no">{g.shisaku.code}</span></div>
                  {t.indicator && <div class="small secondary">活動指標（{yearLabel(t.year)}）: {t.indicator}　目標 {t.target || '—'} → 実績 <b>{t.actual || '—'}</b></div>}
                </div>
                <Stamps items={stampsOf(g)} label="4年の進捗状況" size="small" />
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
  <p id="empty" class="secondary" hidden>条件に合う取組はありません。条件を1つずつ外してみてください。</p>

  <details class="by-dept">
    <summary>部局別の件数（3年以上遅れ）を見る</summary>
    <BarList title="部局別の件数（3年以上遅れ）" caption="最新の報告での所管部局で数えています。件数を押すと部局のページを開きます。" items={byDept} />
  </details>
  <p class="small secondary">
    進捗状況は、活動指標（例: 説明会の開催回数、支援件数）が年度の計画に対してどこまで進んだかの県の判定です。遅れの理由は、取組のページの「年度ごとの活動と検証」や、施策のページの「県のふりかえり」に書かれています。
    R7で<ExtLink href={LINKS.chuki}>中期実施計画</ExtLink>に切り替わったため、R7で名前が変わった取組は「4年とも報告にある」に入りません。
    <a href="/torikumi/?pat=delay3">取組をさがす</a>でも、ほかの条件と組み合わせて絞り込めます。
  </p>
</Base>

<script src="../scripts/list-filter.js"></script>

<style>
  .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 16px; }
  .sum { display: grid; gap: 4px; text-decoration: none; color: var(--ink); }
  .sum:hover { background: var(--sky); }
  .sum-head { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; line-height: 1.45; }
  .sum-n { font-size: 2.3rem; line-height: 1.1; }
  .sum-n small { font-family: var(--font); font-size: 1rem; font-weight: 700; margin-left: 4px; }
  .sec-h { display: flex; align-items: center; gap: 8px; }
  /* 1件を1行に。左に名前・所管と施策・活動指標、右に4年のスタンプ。テーマは絞り込みと取組のページに任せる */
  .row-list { margin-top: 12px; }
  .o-row { display: grid; grid-template-columns: minmax(0, 1fr) 236px; gap: 6px 20px; align-items: center; }
  .o-main { display: grid; gap: 2px; min-width: 0; }
  .o-name { line-height: 1.5; }
  .o-main b { color: var(--ink); }
  @media (max-width: 640px) { .o-row { grid-template-columns: 1fr; } .o-row :global(.stamps) { max-width: 260px; } }
  .by-dept { margin-top: 28px; }
</style>
