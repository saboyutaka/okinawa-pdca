---
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../lib/routes.ts';
import Base from '../../layouts/Base.astro';
import StatusBar from '../../components/StatusBar.astro';
import Chip from '../../components/Chip.astro';
import Icon from '../../components/Icon.astro';
import Stamps from '../../components/Stamps.astro';
import Term from '../../components/Term.astro';
import SeikaCard from '../../components/SeikaCard.astro';
import SeikaSays from '../../components/SeikaSays.astro';
import SeikaPastSays from '../../components/SeikaPastSays.astro';
import ToriList from '../../components/ToriList.astro';
import Prose from '../../components/Prose.astro';
import Hierarchy from '../../components/Hierarchy.astro';
import HeadKind from '../../components/HeadKind.astro';
import ShareBox from '../../components/ShareBox.astro';
import Toc from '../../components/Toc.astro';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, judgeOf, countBy, seikaVerdict, seikaPastSays, seikaAlias, seikaFormerNames, formerText,
  getKihonList, getTorikumiGroups, seikaGroupsOf, sourceLink, deptHref, planParents,
} from '../../lib/data.ts';
import { JUDGE_UI } from '../../lib/icons.ts';
import { themesOf } from '../../lib/themes.ts';
import { joinLines, firstSentence } from '../../lib/text.ts';
import { fmt } from '../../lib/format.ts';
import { shisakuDescription } from '../../lib/describe.ts';
import { shisakuHead } from '../../lib/heads.ts';
import ExtLink from '../../components/ExtLink.astro';
import IkkatsuCard from '../../components/IkkatsuCard.astro';
import Says from '../../components/Says.astro';
import { KANKO, IKKATSU_YEARS, IKKATSU_HREF, GRADES, ikkatsuOf, kankoOfPdcaShisaku, kankoShisakuHref } from '../../lib/plans.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['shisaku/[id]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { s } = Astro.props;
const kihon = getKihonList().find((k) => k.id === s.kihon_id)!;
// 主な取組（年度をまたいだまとまり。報告書の順）
const tRows = getTorikumiGroups().filter((g) => g.shisaku.id === s.id);
const sRows = seikaGroupsOf(s.id);
const yearsDesc = [...YEARS].reverse();
const themes = themesOf(s.id);

// 最新の年度の数（ページの説明文・SNS のカードの画像と同じ数。lib/heads.ts）
const head = shisakuHead(s);
const toriLatest = s.torikumi.filter((t) => t.year === LATEST);
const toriCounts = head.tori;
const seikaLatest = sRows.filter((r) => r.latest.year === LATEST);
const seikaPast = sRows.filter((r) => r.latest.year !== LATEST);
// 成果指標の県による説明。県は施策の成果指標をまとめて1つの説明を書いている（R7 の成果指標が2つ以上の施策は、どれも全部の指標が同じ説明）ので、
// 最新の年度の指標の説明がどれも同じときは、カードの後ろに1回だけ出す（違うときはカードごと）
// 報告に無くなった指標（畳んだ中）も、同じ年度の同じ説明ならまとめる
const sharedSays = (rows: typeof sRows) => (rows.length > 0 && rows[0].latest.explanation && rows.every((r) => r.latest.year === rows[0].latest.year && r.latest.explanation === rows[0].latest.explanation) ? rows[0].latest : null);
const seikaSays = sharedSays(seikaLatest);
const endedSays = sharedSays(seikaPast);
// 前の年度の説明も、最新の説明をまとめたときに、どの指標も年度ごとに同じ説明なら1回だけ出す
const pastKey = (r: (typeof sRows)[number]) => seikaPastSays(r).map((x) => `${x.year}|${x.explanation}`).join('\n');
const sharedPast = (rows: typeof sRows) => (rows.length > 0 && rows.every((r) => pastKey(r) === pastKey(rows[0])) ? seikaPastSays(rows[0]) : null);
const pastSays = seikaSays ? sharedPast(seikaLatest) : null;
const endedPastSays = endedSays ? sharedPast(seikaPast) : null;
// 成果指標の出典（総括報告書の成果指標の表のページ）。年度ごとに、同じページは1回だけ
const seikaSources = (y: number) => [...new Map(sRows.flatMap((r) => {
  const x = r.years[y];
  const a = x && sourceLink(x.source, x.page);
  return a ? [[a.href, a] as const] : [];
})).values()];
// 印字の名前が同じ指標と並んでいて見分けられないので、ほかの報告書の名前で出している指標（lib/data.ts の SEIKA_ALIASES）
const aliases = sRows.flatMap((r) => {
  const ys = YEARS.filter((y) => r.years[y] && seikaAlias(r.years[y]));
  return ys.length ? [{ ys, printed: r.years[ys[0]].name, from: seikaAlias(r.years[ys[0]])!.from, name: r.name }] : [];
});
// 名前が変わっても同じ指標として年度をつないだ成果指標（lib/renames.ts の SEIKA_RENAMES）。前の名前は出典に書く
const renamed = sRows.flatMap((r) => {
  const fs = seikaFormerNames(r);
  return fs.length ? [{ name: r.name, fs }] : [];
});
// 頭の成果指標の札は、成果指標のカードと同じ言い方（lib/data.ts の seikaVerdict。報告書の欄が「達成」「未達成」のものは言葉だけ）

const j = judgeOf(s.judges[LATEST]);
const judgeStamps = YEARS.map((y) => {
  const jj = judgeOf(s.judges[y]);
  if (!jj) return { year: y, tone: null, text: y === YEARS[0] ? '未公表' : '判定なし' };
  const ui = JUDGE_UI[jj.key];
  return { year: y, tone: jj.tone, shape: ui.shape, key: jj.key, text: ui.short, hatch: ui.hatch };
});
const latest = s.years[LATEST];
const pastYears = yearsDesc.filter((y) => y !== LATEST && s.years[y] && (s.years[y].check || s.years[y].action));
const toriActive = tRows.filter((r) => r.years[LATEST]);
const toriEnded = tRows.filter((r) => !r.years[LATEST]);
// 一括交付金（ソフト）の事業（事後評価の検証シートにこの施策のコードがあるもの）と、観光ロードマップでも評価されている取組の施策
const ikkatsu = ikkatsuOf(s.id);
const ikYear = IKKATSU_YEARS[IKKATSU_YEARS.length - 1];
const ikLatest = ikkatsu.filter((g) => g.latest.year === ikYear);
const ikPast = ikkatsu.filter((g) => g.latest.year !== ikYear);
const ikCounts = countBy(ikLatest.map((g) => g.latest), (j) => j.grade_label || 'なし', GRADES.map((x) => x.key));
const rmShisaku = kankoOfPdcaShisaku(s);
---
<Base title={`${s.name}（沖縄県の施策）`} description={shisakuDescription({ name: s.name, ...head })} ogType="article">
  <Hierarchy items={planParents({ shisaku: s.id })} page={s.name} />
  <header class="sticker lift page-head">
    <HeadKind kind="施策" code={s.code} themes={themes.map((t) => t.id)} />
    <h1>{s.name}</h1>
    <div class="head-meta">
      <span>関係部等: {s.depts.length ? s.depts.map((d, i) => <>{i > 0 && '、'}{deptHref(d) ? <a class="sub-link" href={deptHref(d)}>{d}</a> : d}</>) : (s.kankei || '—')}</span>
    </div>
    <div class="now inset">
      <div class="now-l">
        <div class:list={['circle', 'm-stamp', `tone-${j ? j.tone : 'blank'}`, j && JUDGE_UI[j.key].hatch && 'hatch']} aria-hidden="true"><span class="k">{j && <Icon tone={j.tone} shape={JUDGE_UI[j.key].shape} size={18} />}{s.judges[LATEST] || '—'}</span></div>
        <div class="now-t">
          <div class="lb">{j ? `${j.key} ${j.label}` : '判定なし'}</div>
          <div class="sb">{yearLong(LATEST)}の<Term word="推進状況" label="県の判定" /></div>
        </div>
      </div>
      <div class="now-years">
        <span class="now-yl">4年間</span>
        <Stamps items={judgeStamps} label="4年間の判定" size="small" pop={0.22} />
      </div>
      {/* 判定のもと（成果指標の達成率と、主な取組のうち順調の割合）。本文の節と同じ「成果指標 → 主な取組」の順。
          成果指標はほとんどの施策で1〜2つなので、数ではなく指標の名前と達成率の札を1指標1行で出し、名前を押すとその指標のカードへ移る。
          主な取組は数と1件1つの四角で出し、押すと主な取組の節へ移る（取組の名前と進捗状況は節の一覧にある） */}
      <div class="now-why">
        <div class="why">
          <div class="why-l"><Term word="成果指標" /></div>
          <ul class="why-s">
            {seikaLatest.map((r) => { const v = seikaVerdict(r.latest); return <li><a class="name-link" href={`#${r.anchor}`}>{r.name}</a> <Chip tone={v.tone} text={v.chip} /></li>; })}
          </ul>
        </div>
        <div class="why">
          <div class="why-l"><Term word="主な取組" /></div>
          <a class="why-a" href="#torikumi">
            <span class="why-v"><b>{fmt(toriCounts['順調'] || 0)}/{fmt(toriLatest.length)}</b> 件が順調</span>
            <StatusBar categories={STATUSES} counts={toriCounts} context={`${yearLabel(LATEST)}の主な取組 `} cells squares />
          </a>
        </div>
      </div>
    </div>
    {s.houkou && (
      <Says label="ひとことで言うと（実施計画の「施策の方向」から）">
        <p class="says-first">{firstSentence(s.houkou)}</p>
        <details>
          <summary>施策の方向をすべて読む</summary>
          <p class="prose small">{joinLines(s.houkou)}</p>
        </details>
      </Says>
    )}
  </header>

  <Toc
    links={[
      { href: '#seika', label: '成果指標' },
      { href: '#torikumi', label: '主な取組' },
      { href: '#check', label: '県のふりかえり' },
      ikkatsu.length > 0 && { href: '#ikkatsu', label: '一括交付金' },
      { href: '#source', label: '出典' },
    ]}
    head={{ kind: '施策', title: s.name }}
  >
    <Fragment slot="status">
      <small>{yearLabel(LATEST)}の判定</small>
      <span class:list={['jstamp', `tone-${j ? j.tone : 'blank'}`, j && JUDGE_UI[j.key].hatch && 'hatch']}>{j ? <><Icon tone={j.tone} shape={JUDGE_UI[j.key].shape} size={8} />{j.key}</> : '—'}</span>
    </Fragment>
  </Toc>

  <section aria-labelledby="seika">
    <h2 id="seika" class="anchor">成果指標</h2>
    <p class="small secondary lead">施策の成果は、計画どおりに出ている？ 県が決めた物差しごとに、ゴールまでどこまで来たかをグラフで確かめられます。</p>
    {seikaLatest.map((row) => <SeikaCard row={row} says={!seikaSays} past={!pastSays} />)}
    {seikaSays && <SeikaSays r={seikaSays} />}
    {pastSays && <SeikaPastSays rows={pastSays} year={LATEST} />}
    {seikaPast.length > 0 && (
      <details class="past">
        <summary>{yearLabel(LATEST)}の報告に無い成果指標（{seikaPast.length}）</summary>
        {seikaPast.map((row) => <SeikaCard row={row} says={!endedSays} past={!endedPastSays} />)}
        {endedSays && <SeikaSays r={endedSays} />}
        {endedPastSays && endedSays && <SeikaPastSays rows={endedPastSays} year={endedSays.year} />}
      </details>
    )}
  </section>

  <section aria-labelledby="torikumi">
    <h2 id="torikumi" class="anchor"><Term word="主な取組" /></h2>
    <p class="small secondary lead">県の活動は、計画どおりに進んでいる？ 取組ごとに、{yearLabel(LATEST)}の<Term word="進捗状況" />と、それを決めた<Term word="活動指標" />の計画と実績・決算見込額・4年間の歩みが分かります。予算の推移と県の検証・改善案は、取組のページにあります。</p>
    <ToriList rows={toriActive} />
    {toriEnded.length > 0 && (
      <details class="past">
        <summary>{yearLabel(LATEST)}の報告に無い取組（終了・名前の変更など {toriEnded.length}件）</summary>
        <p class="small secondary">R7から中期実施計画になり、取組が入れ替わったり、名前が変わったりしたものがあります。印は、最後に報告があった年度の進捗状況です。</p>
        <ToriList rows={toriEnded} old />
      </details>
    )}
    {rmShisaku.length > 0 && (
      <p class="small rm-note">
        <span class="plan-tag">{KANKO.short}</span> この施策の主な取組の一部は、県の観光の<a href="/keikaku/">個別計画</a>でも評価されています:{' '}
        {rmShisaku.map((r, i) => <>{i > 0 && '、'}<a href={kankoShisakuHref(r)}>{r.name}</a> <span class="code-no">施策 {r.code}</span></>)}
      </p>
    )}
  </section>

  <section aria-labelledby="check">
    <h2 id="check" class="anchor">県のふりかえりと、これから</h2>
    <p class="small secondary lead">施策検証票に県が書いた、施策の推進状況の分析（Check）と推進戦略案（Action）です。</p>
    {latest && latest.check && (
      <Says class="voice">
        <h3>ふりかえり（{yearLong(LATEST)}・Check）</h3>
        <Prose text={latest.check} />
      </Says>
    )}
    {latest && latest.action && (
      <Says class="voice">
        <h3>これからどうする（{yearLong(LATEST)}・Action）</h3>
        <Prose text={latest.action} />
      </Says>
    )}
    {/* 前の年度は1つの箱に細い線で区切って並べる（年度ごとの太いステッカーを積むと重いため）。見出しの言葉は最新の年度とそろえ、
        Check と Action は中の箱（.inset）に分ける */}
    {pastYears.length > 0 && (
      <ul class="row-list cads">
        {pastYears.map((y) => (
          <li>
            <details class="cad">
              <summary>{yearLong(y)}のふりかえり</summary>
              {s.years[y].check && <div class="cad-part inset"><h3>ふりかえり（Check）</h3><Prose text={s.years[y].check} /></div>}
              {s.years[y].action && <div class="cad-part inset"><h3>これからどうする（Action）</h3><Prose text={s.years[y].action} /></div>}
            </details>
          </li>
        ))}
      </ul>
    )}
  </section>

  {/* 一括交付金の事後評価は沖縄県PDCAとは別の評価なので、県のふりかえり（PDCA の流れ）の後ろに置く */}
  {ikkatsu.length > 0 && (
    <section aria-labelledby="ikkatsu">
      <h2 id="ikkatsu" class="anchor">一括交付金（ソフト）の事業</h2>
      <p class="small secondary lead">主な取組の評価とは別に、この施策に当たる一括交付金（ソフト）の事業ごとに、県が成果目標の達成状況を<Term word="一括交付金の事後評価" label="事後評価" />したもの（◎達成・○概ね達成・△一部達成・未達成）です。</p>
      {ikLatest.length > 0 && (
        <div class="ik-sum">
          <span class="small secondary">{yearLabel(ikYear)}の評価（{fmt(ikLatest.length)}事業）</span>
          {GRADES.filter((x) => ikCounts[x.key]).map((x) => <Chip tone={x.tone} shape={x.shape} text={`${x.mark} ${x.key} ${fmt(ikCounts[x.key])}`} title={x.note} readTitle />)}
        </div>
      )}
      <div class="ikcards">{ikLatest.map((g) => <IkkatsuCard g={g} />)}</div>
      {ikPast.length > 0 && (
        <details class="past">
          <summary>{yearLabel(ikYear)}の事後評価に無い事業（{ikPast.length}）</summary>
          <div class="ikcards">{ikPast.map((g) => <IkkatsuCard g={g} />)}</div>
        </details>
      )}
      <p class="small"><a href={`${IKKATSU_HREF}?s=${s.shouraizou}`}>将来像{s.shouraizou}の一括交付金の事業をさがす</a>・<a href={IKKATSU_HREF}>すべての事業をさがす</a></p>
      <p class="small secondary">主な取組と同じ事業のこともありますが、名前や単位が違うことがあり、取組とは結び付けていません。予算額は前の年度からの繰越を含む事業費（国が8割・県が2割）です。</p>
    </section>
  )}

  <ShareBox kind="施策" name={s.name} />

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <p class="small">県の報告書での番号は<strong class="report-no">施策 {s.code}</strong>（<span class="report-no">基本施策 {kihon?.code}</span>）です。</p>
    <ul class="small">
      {yearsDesc.map((y) => {
        const r = s.years[y];
        const a = r && sourceLink(r.source, r.page);
        const b = r?.summary_ref && sourceLink(r.summary_ref.source, r.summary_ref.page);
        return (
          <li>
            {yearLong(y)}: {a ? <ExtLink href={a.href}>施策検証票（{a.label}）</ExtLink> : '—'}
            {b && <>、<ExtLink href={b.href}>施策総括表（{b.label}）</ExtLink></>}
            {seikaSources(y).map((c) => <>、<ExtLink href={c.href}>成果指標の総括報告書（{c.label}）</ExtLink></>)}
          </li>
        );
      })}
    </ul>
    {renamed.length > 0 && <p class="small">{renamed.map((x) => `成果指標「${x.name}」は、${formerText(x.fs)}という名前で載っています。`).join('')}同じ指標として<a href="/data/#kazoekata">年度をつないでいます</a>。</p>}
    {aliases.map((al) => <p class="small">{al.ys.map(yearLabel).join('・')}の報告書では、成果指標「{al.name}」は「{al.printed}」の名前で、同じ名前のほかの指標と並んで載っています。このサイトでは、{al.from}での名前で出しています。</p>)}
  </section>
</Base>

<style>
  /* 判定は取組のページの進捗状況と同じく、頭の中の箱にハンコと4年間のスタンプを横に並べ（題名は全幅で折り返す）、
     細い線の下に判定のもと（成果指標・主な取組）を置く（取組のページの頭の活動指標と同じ形）。スマホでは ハンコ → 判定のもと → 4年間 の順。丸いハンコは施策の判定だけ */
  .head-meta > span { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .now { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "l years" "why why"; align-items: center; gap: 10px 40px; padding: 12px 18px; }
  .now-l { grid-area: l; display: flex; align-items: center; gap: 16px; min-width: 0; }
  .now .circle {
    flex: none; display: grid; place-items: center; width: 80px; height: 80px; border-radius: 50%; border: 3px solid var(--line);
    background-color: color-mix(in oklab, var(--tone) 26%, var(--paper)); box-shadow: 3px 3px 0 var(--shadow); transform: rotate(-6deg);
  }
  .now .k { font-family: var(--font-num); font-weight: 600; font-size: 2.1rem; line-height: 1; display: flex; align-items: center; gap: 4px; }
  .now-t { display: grid; gap: 2px; min-width: 0; }
  .lb { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; line-height: 1.45; }
  .sb { font-size: 0.875rem; color: var(--ink-2); }
  .now-years { grid-area: years; display: flex; align-items: center; gap: 10px; max-width: 340px; }
  .now-yl { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); }
  .now-years :global(.stamps) { flex: 1; }
  .now-why { grid-area: why; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 32px; padding-top: 12px; border-top: 1.5px solid var(--grid); }
  .why { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .why-l { font-size: 0.875rem; color: var(--ink-2); }
  .why-v b { font-family: var(--font-num); font-weight: 600; font-size: 1.3rem; }
  /* 成果指標: 名前のすぐ後ろに達成率の札（基本施策・くらしのテーマのページの施策の行と同じ並び） */
  .why-s { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .why-s li { line-height: 1.7; }
  .why-s :global(.chip) { white-space: nowrap; vertical-align: -1px; }
  /* 主な取組: 数と四角をまとめて節へのリンクにする。数の文字に名前のリンクと同じ薄い下線を付け、四角はリンクの一部として押させる（四角ごとの吹き出しは出さない） */
  .why-a { display: grid; gap: 6px; justify-items: start; color: inherit; text-decoration: none; }
  .why-a .why-v { text-decoration-line: underline; text-decoration-color: var(--hair); text-decoration-thickness: 2px; }
  .why-a:hover .why-v { text-decoration-color: var(--ink); }
  .why-a :global(.sbar) { pointer-events: none; }
  @media (max-width: 640px) {
    .now { grid-template-columns: minmax(0, 1fr); grid-template-areas: "l" "why" "years"; gap: 12px; padding: 12px 14px; }
    .now-why { grid-template-columns: minmax(0, 1fr); }
    .now .circle { width: 68px; height: 68px; }
    .now .k { font-size: 1.8rem; }
    .now-years { max-width: none; padding-top: 12px; border-top: 1.5px solid var(--grid); }
  }
  .past { margin-top: 18px; }
  /* 札は文の頭に置いて、文と一緒に折り返す（flex にすると、かっこ・リンク・文が別々の箱になり、スマホでばらばらに折り返す） */
