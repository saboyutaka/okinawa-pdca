---
import Base from '../../layouts/Base.astro';
import StatusChart from '../../components/StatusChart.astro';
import StatusBar from '../../components/StatusBar.astro';
import Chip from '../../components/Chip.astro';
import Icon from '../../components/Icon.astro';
import Stamps from '../../components/Stamps.astro';
import Term from '../../components/Term.astro';
import SeikaCard from '../../components/SeikaCard.astro';
import ToriCard from '../../components/ToriCard.astro';
import Prose from '../../components/Prose.astro';
import Crumbs from '../../components/Crumbs.astro';
import ThemeTags from '../../components/ThemeTags.astro';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, RATE_BINS, judgeOf, statusOf, rateBin, countBy,
  getShisakuList, getShisaku, getKihonList, torikumiRows, seikaRows, sourceLink, deptHref, seikaAnchor,
} from '../../lib/data.js';
import { JUDGE_UI } from '../../lib/icons.js';
import { themesOf } from '../../lib/themes.js';
import { joinLines, firstSentence } from '../../lib/text.js';
import { fmt } from '../../lib/format.js';
import ExtLink from '../../components/ExtLink.astro';

export function getStaticPaths() {
  return getShisakuList().map((s) => ({ params: { id: s.id } }));
}

const s = getShisaku(Astro.params.id);
const kihon = getKihonList().find((k) => k.id === s.kihon_id);
const tRows = torikumiRows(s);
const sRows = seikaRows(s);
const statusKeys = STATUSES.map((x) => x.key);
const yearsDesc = [...YEARS].reverse();
const themes = themesOf(s.id);

const progressRows = YEARS.map((y) => ({
  label: yearLabel(y),
  sub: y <= 2024 ? '前期' : '中期',
  counts: countBy(s.torikumi.filter((t) => t.year === y), statusOf, statusKeys),
}));
const toriLatest = s.torikumi.filter((t) => t.year === LATEST);
const toriCounts = countBy(toriLatest, statusOf, statusKeys);
const seikaLatest = sRows.filter((r) => r.latest.year === LATEST);
const seikaPast = sRows.filter((r) => r.latest.year !== LATEST);
const reached = seikaLatest.filter((r) => rateBin(r.latest) === '100%以上').length;
const toneOfBin = (x) => RATE_BINS.find((b) => b.key === rateBin(x))?.tone;
const rateText = (x) => (x.rate != null ? `${x.rate}%` : x.rate_raw || '—');

const j = judgeOf(s.judges[LATEST]);
const judgeStamps = YEARS.map((y) => {
  const jj = judgeOf(s.judges[y]);
  if (!jj) return { year: y, tone: null, text: y === YEARS[0] ? '未公表' : '判定なし' };
  const ui = JUDGE_UI[jj.key];
  return { year: y, tone: jj.tone, shape: ui.shape, key: jj.key, text: ui.short, hatch: ui.hatch };
});
const latest = s.years[LATEST];
const pastYears = yearsDesc.filter((y) => y !== LATEST && s.years[y] && (s.years[y].check || s.years[y].action));
const toriActive = tRows.filter((r) => r.years[LATEST]);
const toriEnded = tRows.filter((r) => !r.years[LATEST]);
---
<Base title={`${s.name}（施策）`} description={`沖縄県PDCA: 施策「${s.name}」の成果指標と主な取組の進み具合（令和4〜7年度）`}>
  <Crumbs items={[{ href: '/', label: 'トップ' }, { href: `/future/${s.shouraizou}/`, label: `将来像${s.shouraizou}`, sz: s.shouraizou }, { href: `/kihon/${s.kihon_id}/`, label: kihon?.name }, { label: s.name }]} />

  <header class="sticker lift head">
    <span class="code-no code-corner" title="県の報告書での番号">施策 {s.code}</span>
    <div class="head-main">
      <div class="kind">施策展開「{s.tenkai_name}」の<Term word="施策" /></div>
      <h1>{s.name}</h1>
      <div class="meta">
        <span>関係部等: {s.depts.length ? s.depts.map((d, i) => <>{i > 0 && '、'}{deptHref(d) ? <a class="sub-link" href={deptHref(d)}>{d}</a> : d}</>) : (s.kankei || '—')}</span>
        {themes.length > 0 && <ThemeTags ids={themes.map((t) => t.id)} />}
      </div>
    </div>
    <div class="head-side">
      <div class:list={['stamp-big', `tone-${j ? j.tone : 'blank'}`]}>
        <div class:list={['circle', j && JUDGE_UI[j.key].hatch && 'hatch']} aria-hidden="true"><span class="k">{j && <Icon tone={j.tone} shape={JUDGE_UI[j.key].shape} size={22} />}{s.judges[LATEST] || '—'}</span></div>
        <div class="lb">{j ? `${j.key} ${j.label}` : '判定なし'}</div>
        <div class="sb">{yearLong(LATEST)}の<Term word="推進状況" label="県の判定" /></div>
      </div>
      <div class="head-years">
        <div class="small secondary label">4年間の判定</div>
        <Stamps items={judgeStamps} label="4年間の判定" size="small" />
      </div>
    </div>
    {s.houkou && (
      <div class="bubble-row says">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <div class="small secondary label">ひとことで言うと（実施計画の「施策の方向」から）</div>
          <p class="first">{firstSentence(s.houkou)}</p>
          <details>
            <summary>施策の方向をすべて読む</summary>
            <p class="prose small">{joinLines(s.houkou)}</p>
          </details>
        </div>
      </div>
    )}
  </header>

  <div class="facts">
    <div class="sticker fact">
      <div class="tile-label"><Term word="主な取組" />（{yearLabel(LATEST)}）</div>
      <div class="tile-value">{fmt(toriCounts['順調'] || 0)}/{fmt(toriLatest.length)}<small>件が順調</small></div>
      {toriLatest.length > 0 && <StatusBar categories={STATUSES} counts={toriCounts} context={`${yearLabel(LATEST)}の主な取組 `} size="mini" />}
    </div>
    <div class="sticker fact">
      <div class="tile-label"><Term word="成果指標" />（{yearLabel(LATEST)}）</div>
      <div class="tile-value">{fmt(reached)}/{fmt(seikaLatest.length)}<small>が計画値に到達</small></div>
      <div class="chips">{seikaLatest.map((r) => <Chip tone={toneOfBin(r.latest)} text={`達成率 ${rateText(r.latest)}`} />)}</div>
    </div>
  </div>

  <nav class="toc" aria-label="このページの内容">
    <a href="#seika">成果指標</a>
    <a href="#torikumi">主な取組</a>
    <a href="#check">県のふりかえり</a>
    <a href="#source">出典</a>
    <button type="button" class="button" data-open-all="#main" aria-pressed="false" hidden>すべて開く</button>
  </nav>

  <section aria-labelledby="seika">
    <h2 id="seika" class="anchor">成果指標：ゴールまでの道のり</h2>
    <p class="small secondary lead">スタートの旗が<Term word="基準値" />、ゴールの旗が<Term word="目標値" />です。</p>
    {seikaLatest.map((row) => <SeikaCard row={row} id={seikaAnchor(s.id, row.key)} />)}
    {seikaPast.length > 0 && (
      <details class="past">
        <summary>R6まで使われていた成果指標（{seikaPast.length}）</summary>
        {seikaPast.map((row) => <SeikaCard row={row} id={seikaAnchor(s.id, row.key)} />)}
      </details>
    )}
  </section>

  <section aria-labelledby="torikumi">
    <h2 id="torikumi" class="anchor"><Term word="主な取組" /></h2>
    <p class="small secondary lead">スタンプは各年度の<Term word="進捗状況" />です。名前を押すと、4年分の活動内容・予算・県の検証と改善案を見られます。</p>
    <StatusChart title="この施策の主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
    <div class="tcards">
      {toriActive.map((row) => <ToriCard row={row} shisakuId={s.id} />)}
    </div>
    {toriEnded.length > 0 && (
      <details class="past">
        <summary>R7の報告に無い取組（終了・名前の変更など {toriEnded.length}件）</summary>
        <p class="small secondary">R7の中期実施計画で取組が入れ替わったり、名前が変わったりしたものです。</p>
        <div class="tcards">
          {toriEnded.map((row) => <ToriCard row={row} shisakuId={s.id} />)}
        </div>
      </details>
    )}
  </section>

  <section aria-labelledby="check">
    <h2 id="check" class="anchor">県のふりかえりと、これから</h2>
    <p class="small secondary lead">施策検証票に県が書いた、施策の推進状況の分析（Check）と推進戦略案（Action）です。</p>
    {latest && latest.check && (
      <div class="bubble-row voice">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <h3>ふりかえり（{yearLong(LATEST)}・Check）</h3>
          <div data-clamp id="clamp-check"><Prose text={latest.check} /></div>
          <button type="button" class="more" data-clamp-toggle="clamp-check" aria-controls="clamp-check" aria-expanded="false" hidden>続きを読む</button>
        </div>
      </div>
    )}
    {latest && latest.action && (
      <div class="bubble-row voice">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <h3>これからどうする（{yearLong(LATEST)}・Action）</h3>
          <div data-clamp id="clamp-action"><Prose text={latest.action} /></div>
          <button type="button" class="more" data-clamp-toggle="clamp-action" aria-controls="clamp-action" aria-expanded="false" hidden>続きを読む</button>
        </div>
      </div>
    )}
    {pastYears.map((y) => (
      <details class="sticker cad">
        <summary>{yearLong(y)}のふりかえり</summary>
        {s.years[y].check && <><h3>施策の推進状況の分析（Check）</h3><Prose text={s.years[y].check} /></>}
        {s.years[y].action && <><h3>施策の推進戦略案（Action）</h3><Prose text={s.years[y].action} /></>}
      </details>
    ))}
  </section>

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <p class="small">県の報告書での番号は<strong class="report-no">施策 {s.code}</strong>（<span class="report-no">基本施策 {kihon?.code}</span>）です。報告書の PDF では、この番号で探せます。</p>
    <ul class="small">
      {yearsDesc.map((y) => {
        const r = s.years[y];
        const a = r && sourceLink(r.source, r.page);
        const b = r?.summary_ref && sourceLink(r.summary_ref.source, r.summary_ref.page);
        return (
          <li>
            {yearLong(y)}: {a ? <ExtLink href={a.href}>施策検証票（{a.label}）</ExtLink> : '—'}
            {b && <>、<ExtLink href={b.href}>施策総括表（{b.label}）</ExtLink></>}
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  /* 右の判定（ハンコと4年間の判定）は縦に長いので、県の吹き出しは左の列に入れて並べる（左の下が空かないように） */
  .head {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto 1fr;
    grid-template-areas: "main side" "says side"; gap: 16px 24px; align-items: start; margin-top: 12px; padding-top: 30px;
  }
  .head-main { grid-area: main; }
  .head h1 { margin: 4px 0 8px; }
  .kind { font-size: 0.9375rem; color: var(--ink-2); }
  .report-no { white-space: nowrap; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 0.9375rem; color: var(--ink-2); }
  .meta > span { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .head-side { grid-area: side; display: grid; justify-items: center; gap: 14px; width: 232px; }
  .stamp-big { display: grid; justify-items: center; gap: 4px; text-align: center; }
  .stamp-big .circle {
    display: grid; place-items: center; width: 108px; height: 108px; border-radius: 50%; border: 3px solid var(--line);
    background-color: color-mix(in oklab, var(--tone) 26%, var(--paper)); box-shadow: 4px 4px 0 var(--shadow); transform: rotate(-6deg);
  }
  .stamp-big .k { font-family: var(--font-num); font-weight: 600; font-size: 2.6rem; line-height: 1; display: flex; align-items: center; gap: 6px; }
  .stamp-big .lb { font-family: var(--font-display); font-weight: 700; line-height: 1.45; }
  .stamp-big .sb { font-size: 0.8125rem; color: var(--ink-2); white-space: nowrap; }
  .head-years { width: 100%; }
  .head-years .label { text-align: center; }
  .says { grid-area: says; }
  .label { font-weight: 700; margin-bottom: 4px; }
  .says .first { font-size: 1rem; margin: 4px 0 0; font-weight: 700; }
  @media (max-width: 640px) {
    .head { grid-template-columns: 1fr; grid-template-rows: auto; grid-template-areas: "main" "side" "says"; }
    .head-side { width: auto; justify-items: start; }
    .head-years { max-width: 280px; }
    .head-years .label { text-align: left; }
    .stamp-big { justify-items: start; grid-template-columns: auto minmax(0, 1fr); text-align: left; align-items: center; gap: 2px 16px; max-width: none; }
    .stamp-big .circle { grid-row: span 2; width: 84px; height: 84px; }
    .stamp-big .k { font-size: 2rem; }
  }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 18px; }
  .fact { display: grid; gap: 6px; align-content: start; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .tcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 18px; margin-top: 18px; }
  .past { margin-top: 18px; }
  .voice { margin-top: 16px; }
  .voice h3 { margin: 0 0 4px; font-size: 1.02rem; }
  .cad { margin-top: 14px; }
  .cad > summary { font-family: var(--font-display); color: var(--ink); font-size: 1rem; }
  .cad h3 { font-size: 0.98rem; }
</style>
