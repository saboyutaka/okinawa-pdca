---
import Base from '../../layouts/Base.astro';
import ShisakuItem from '../../components/ShisakuItem.astro';
import Icon from '../../components/Icon.astro';
import Sz from '../../components/Sz.astro';
import FilterMore from '../../components/FilterMore.astro';
import JudgeLegend from '../../components/JudgeLegend.astro';
import { LATEST, yearLabel, yearLong, JUDGES, DEPTS, getShisakuList, getShouraizou, getKihonList, shisakuDepts, type JudgeTrend } from '../../lib/data.ts';
import { getThemes } from '../../lib/themes.ts';
import { JUDGE_UI } from '../../lib/icons.ts';
import { LINKS } from '../../lib/links.ts';
import ExtLink from '../../components/ExtLink.astro';

const shisaku = getShisakuList();
const shouraizou = getShouraizou();
const kihon = getKihonList();
const themes = getThemes();
// 部局は、関係部等にある部局と、その施策に主な取組がある部局（部局のページの施策と同じ数え方。lib/data.ts の shisakuDepts）。並びは県の部局の一覧の順
const deptsOf = new Map(shisaku.map((s) => [s.id, shisakuDepts(s).map((d) => d.dept)]));
const depts = DEPTS.map((d) => d.name).filter((name) => [...deptsOf.values()].some((ds) => ds.includes(name)));
const groups = kihon.map((k) => ({ kihon: k, items: shisaku.filter((s) => s.kihon_id === k.id) }));
const themeIdsOf = (id: string) => themes.filter((t) => t.ids.includes(id)).map((t) => t.id).join('|');
// 判定の移り変わり（数え方は lib/data.ts の JUDGE_TRENDS。施策の trends に入っている）。short は頭のリンクの短い言い方（左から続けて読む）。
// 頭のリンクは前の年度からの上がった・下がったの2つだけを同じ重みで並べ、「3年続けて遅れ」は絞り込みだけに置く（遅れを前に出さない）
const trends = ([
  { key: 'up', label: `${yearLabel(LATEST - 1)}→${yearLabel(LATEST)}で上がった`, short: `${yearLabel(LATEST - 1)}→${yearLabel(LATEST)}で上がった` },
  { key: 'down', label: `${yearLabel(LATEST - 1)}→${yearLabel(LATEST)}で下がった`, short: '下がった' },
  { key: 'streak', label: `${yearLabel(LATEST)}まで3年続けて遅れ（C〜G）`, short: '3年続けて遅れ' },
] satisfies { key: JudgeTrend; label: string; short: string }[]).map((t) => ({ ...t, n: shisaku.filter((s) => s.trends.includes(t.key)).length }));
const headTrends = trends.filter((t) => t.key !== 'streak');
---
<Base title="施策をさがす" description="沖縄県PDCAの339施策を、将来像・判定・くらしのテーマ・担当部局・キーワードで絞り込んで探せます。">
  <h1>施策をさがす</h1>
  <p class="secondary lead"><ExtLink href={LINKS.jisshiKeikaku}>実施計画</ExtLink>の339施策です。行の判定・取組・成果指標は{yearLong(LATEST)}のものです。</p>
  <p class="small trends"><span class="secondary">判定の移り変わり:</span>{headTrends.map((t) => <a href={`?trend=${t.key}`} data-trend={t.key} title={t.label}>{t.short} {t.n}施策</a>)}</p>

  <form class="filters sticker" role="search" aria-label="施策の絞り込み" data-filter="#shisaku-list" data-count="#count" data-empty="#empty" data-summary="#active">
    <label class="q" data-label="キーワード">キーワード（施策・取組・部局の名前）
      <input type="search" name="q" placeholder="例: 離島、子ども、観光" />
    </label>
    <FilterMore id="shisaku-more">
    <label data-label="テーマ"><span class="lbl">くらしのテーマ <span class="own">独自の分類</span></span>
      <select name="theme">
        <option value="">すべて</option>
        {themes.map((t) => <option value={t.id}>{t.label}</option>)}
      </select>
    </label>
    <label data-label="部局">担当部局
      <select name="dept">
        <option value="">すべて</option>
        {depts.map((d) => <option value={d}>{d}</option>)}
      </select>
    </label>
    <label data-label="判定の移り変わり">判定の移り変わり
      <select name="trend">
        <option value="">すべて</option>
        {trends.map((t) => <option value={t.key}>{t.label}</option>)}
      </select>
    </label>
    <fieldset class="fgroup" data-label="将来像">
      <legend class="fgroup-label">将来像</legend>
      <div class="fchips">
        <label class="fchip"><input type="radio" name="s" value="" checked /><span>すべて</span></label>
        {shouraizou.map((s) => <label class="fchip" title={s.name}><input type="radio" name="s" value={String(s.id)} data-text={`将来像${s.id}`} /><span><Sz id={s.id} sr={false} />将来像{s.id}</span></label>)}
      </div>
    </fieldset>
    <fieldset class="fgroup" data-label="判定">
      <legend class="fgroup-label">判定（{yearLabel(LATEST)}）・いくつでも選べます</legend>
      <div class="fchips">
        {JUDGES.map((j) => (
          <label class="fchip" title={j.label}>
            <input type="checkbox" name="judge" value={j.key} />
            <span><Icon tone={j.tone} shape={JUDGE_UI[j.key].shape} />{j.key} {j.key === 'C' || j.key === 'D' || j.key === 'E' || j.key === 'F' ? j.label.replace('だが、', '・') : j.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    </FilterMore>
  </form>
  <div class="active-filters" id="active" hidden></div>
  <p class="result-count" aria-live="polite" aria-atomic="true"><span id="count">{shisaku.length}</span>施策を表示</p>
  <JudgeLegend />

  <div id="shisaku-list">
    {groups.map(({ kihon: k, items }) => (
      <section class="group" data-group>
        <h2 class="group-title">
          <Sz id={k.shouraizou} />
          <span class="gt-name"><a class="name-link" href={`/kihon/${k.id}/`}>{k.name}</a> <span class="code-no">{k.code}</span></span>
        </h2>
        <ul class="row-list">
          {items.map((s) => (
            <ShisakuItem
              s={s}
              attrs={{
                'data-item': '',
                'data-s': String(s.shouraizou),
                'data-judge': s.judges[LATEST] ?? '',
                'data-trend': s.trends.join('|'),
                'data-dept': deptsOf.get(s.id)!.join('|'),
                'data-theme': themeIdsOf(s.id),
                'data-text': `${s.code} ${s.name} ${s.tenkai_name} ${k.name} ${s.kankei} ${s.torikumi.filter((t) => t.year === LATEST).map((t) => t.name).join(' ')}`,
              }}
            />
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p id="empty" class="secondary" hidden>条件に合う施策はありません。条件を1つずつ外してみてください。</p>
  <p class="small secondary note">
    判定の移り変わりの「上がった」「下がった」は、判定を A 順調 → B 概ね順調 → C〜F（取組か成果が遅れている）→ G 大幅遅れ の順に並べて前の年度と比べています（C〜F の中での入れ替わりは数えません）。施策の判定は令和5年度から公表されています。年度ごとの判定は、各施策のページの「4年間の判定」にあります。
  </p>
</Base>

<style>
  .trends { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 14px; margin: 4px 0 0; }
  .note { margin-top: 1.5em; }
</style>
