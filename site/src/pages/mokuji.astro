---
import Base from '../layouts/Base.astro';
import Term from '../components/Term.astro';
import ExtLink from '../components/ExtLink.astro';
import { LATEST, yearLong, getPlanTree } from '../lib/data.ts';
import { TREE_DATA_FALLBACK, treeDataPath } from '../lib/tree-data.ts';
import { LINKS } from '../lib/links.ts';
import { fmt } from '../lib/format.ts';

// 計画の目次。将来像 → 基本施策 → 施策展開 → 施策 → 主な取組を、開け閉めできる木（<details> の入れ子）で並べる。
// 木は HTML に書かず、ブラウザのスクリプト（scripts/tree.ts）が JSON（lib/tree-data.ts。名前とリンクだけ）から描く（約2,500行あり、HTML に書くと
// 750KB ほどになって、戻る・進むで読み直したときに、読み終えるまで絞り込む前の目次と空の欄が見えていたため）。
// 基本施策には主要指標、施策には成果指標を付ける。PC の幅では名前の横に並べ、スマホでは開いた中に主な取組より先に並べる（同じ指標を2か所に書き、幅で片方だけを出す）。
// 主な取組には活動指標を付ける（取組の名前の右。どの幅でも同じ）。
// どの指標を出すかは、頭の「指標」のボタンで開くチェックボックスで選ぶ（SHOW。はじめは主要指標と成果指標だけ）。木の data-show に選んだ種類が入り、ほかの種類（data-ind）を CSS で隠す。
// 指標は名前だけで、値や達成率は出さない（形を見るページにし、良い・悪いの一覧にしない）。
// 名前はそれぞれのページへのリンクで、▶ の丸（summary）を押すと開け閉めする。
// summary の中にリンクを置くと押せるものが入れ子になるので、名前は summary の外に置き、summary は丸だけにする。施策展開にはページが無いので、名前の行を押しても開け閉めする。
// キーボードと読み上げでは、木（role="tree"）として動かす（scripts/tree.ts）。
// 番号は、通しの番号（1-(2)-イ）ではなく、その階層の中の番号（基本施策 (2)・施策展開 イ・施策 ①・主な取組は施策の中の報告書の番号 1, 2, …）を名前の頭に置く（木の形で上の階層が分かるため）。
// 閉じている行にだけ、すぐ下に並ぶものの数（「取組 6・成果指標 2」）を名前の後ろに出す（開いたら下に並ぶので出さない。CSS で切り替える。指標の数は、指標を名前の横に出す PC では出さない）。
// 頭の「開く深さ」（セレクト）は、選んだ階層まで一度に開く。はじめは将来像だけを開いて、基本施策まで見せる（はじめに選んである深さ）。
// キーワードは、施策・取組・成果指標（活動指標を出しているときは活動指標も）の名前（.qn）を部分一致でさがし、当たった行とその親だけを残して開く。
// 開く深さ・指標・キーワードは小さく1行に並べ、キーワードを後ろに置く（キーワードの欄から Tab 1回で木に入れるように。スマホではキーワードだけ次の行にする）
const tree = getPlanTree();
const kihonAll = tree.flatMap((v) => v.kihon);
const tenkaiAll = kihonAll.flatMap((k) => k.tenkai);
const shisakuAll = tenkaiAll.flatMap((t) => t.shisaku);
const total = (xs: { length: number }[]) => xs.reduce((n, x) => n + x.length, 0);
const nTorikumi = total(shisakuAll.map((s) => s.torikumi));
const nShuyou = total(kihonAll.map((k) => k.shuyou));
const nSeika = total(shisakuAll.map((s) => s.seika));
// 「開く深さ」の選択肢。i 番目は、i より上の階層（details の data-level が i 未満）を開き、その下は閉じる
const DEPTHS = ['将来像だけ', '基本施策まで', '施策展開まで', '施策まで', '主な取組まで'];
const START = 1;
// 出す指標の選択肢（key は木の data-show・行の data-ind の値。short はボタンに出す短い名前）
const SHOW = [
  { key: 'shuyou', name: '主要指標', short: '主要', on: true },
  { key: 'seika', name: '成果指標', short: '成果', on: true },
  { key: 'katsudou', name: '活動指標', short: '活動', on: false },
];
// 目次のデータ。名前に中身のハッシュが付く（lib/tree-data.ts）
const dataPath = treeDataPath();
---
<Base title="計画の目次" description={`新・沖縄21世紀ビジョンの5つの将来像・${kihonAll.length}の基本施策・${tenkaiAll.length}の施策展開・${shisakuAll.length}の施策・${fmt(nTorikumi)}件の主な取組（${yearLong(LATEST)}）を、主要指標・成果指標と一緒に、開け閉めできる目次の形で一覧できます。`}>
  {/* 目次のデータを、ページのスクリプトが届くのを待たずに読み始める（scripts/tree.ts の fetch がこれを使う。crossorigin は fetch の既定に合わせる） */}
  <link slot="head" rel="preload" href={dataPath} as="fetch" crossorigin="anonymous" />
  <h1>計画の目次</h1>
  <p class="secondary lead">
    「<ExtLink href={LINKS.kihonKeikaku} after="」">新・沖縄21世紀ビジョン</ExtLink>の{tree.length}つの<Term word="将来像" />から、{kihonAll.length}の<Term word="基本施策" />、{tenkaiAll.length}の<Term word="施策展開" />、{shisakuAll.length}の<Term word="施策" />、{fmt(nTorikumi)}件の<Term word="主な取組" />までを、成果をはかる<Term word="主要指標" />（{nShuyou}）・<Term word="成果指標" />（{nSeika}）と一緒にたどれます。
  </p>
  <form class="filters tree-search" role="search" aria-label="目次の中をさがす" data-tree-search="plan-tree">
    <label class="tree-depth">開く深さ
      {/* 1つずつ開け閉めして、どの深さにもそろっていないときは「ばらばら」（選べない）にする（scripts/tree.ts） */}
      <select data-tree-depth aria-controls="plan-tree" autocomplete="off">
        {DEPTHS.map((d, i) => <option value={String(i)} selected={i === START}>{d}</option>)}
        <option value="" disabled hidden>ばらばら</option>
      </select>
    </label>
    {/* 押すとチェックボックスの吹き出しを開く。ボタンの文字は選んでいる種類（scripts/tree.ts が書き換える） */}
    <div class="tree-show" data-tree-show="plan-tree">
      <span class="fgroup-label" id="tree-show-label">指標</span>
      <button type="button" class="tree-show-btn" aria-expanded="false" aria-controls="tree-show-pop" aria-labelledby="tree-show-label tree-show-now">
        <span id="tree-show-now" data-tree-show-now>{SHOW.filter((x) => x.on).map((x) => x.short).join('・')}</span><svg class="chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
      </button>
      <fieldset class="tree-show-pop" id="tree-show-pop" hidden>
        <legend>目次に出す指標</legend>
        {SHOW.map((x) => (
          <label><input type="checkbox" value={x.key} data-short={x.short} checked={x.on} autocomplete="off" />{x.name}</label>
        ))}
      </fieldset>
    </div>
    <label class="q">キーワード
      <input type="search" name="q" placeholder="施策・取組・成果指標の名前（例: 離島）" />
    </label>
  </form>
  <p class="result-count tree-hits" data-tree-hits="plan-tree" aria-live="polite"><span id="tree-hits"></span></p>
  <div class="tree-box sticker">
    <p class="tree-root"><span class="tw" aria-hidden="true"></span><span>新・沖縄21世紀ビジョン基本計画</span><span class="tree-hint" aria-hidden="true">矢印キーで行を移り、開け閉めできます</span></p>
    <p class="tree-msg small secondary" role="status">目次を読み込んでいます…</p>
    <ul class="tree" id="plan-tree" data-tree data-show={SHOW.filter((x) => x.on).map((x) => x.key).join(' ')} aria-label="計画の目次。上下の矢印キーで行を移り、左右の矢印キーかスペースで開け閉めし、Enter でページを開きます" aria-busy="true" data-src={dataPath} data-fallback={TREE_DATA_FALLBACK}></ul>
    <noscript><p class="small">目次の表示には JavaScript が必要です。<a href="/shisaku/">施策をさがす</a>・<a href="/future/">5つの将来像</a>から、それぞれの施策・取組を見られます。</p></noscript>
  </div>
  <p class="small secondary">施策・指標・主な取組は{yearLong(LATEST)}の報告にあるものです。主要指標は、県の概要版の数え方（男女別などを分けて数える）です。主な取組は延べ件数で、いくつかの施策に載る取組は、それぞれの施策の下に出ます。</p>
</Base>

<style is:global>
  /* 計画の目次の見た目。目次の行はスクリプト（scripts/tree.ts）が描くので、Astro が範囲をしぼるための属性（data-astro-cid-…）が付かず、
     ページの <style>（scoped）では当たらない。.tree-box などの名前の下に書いた全体の CSS にする */

  /* 開く深さとキーワード。小さく1行に並べる（箱に入れない）。スクリプトでしか動かないので、スクリプトが動くとき（html.js）だけ出す */
  .filters.tree-search { flex-wrap: nowrap; gap: 10px; margin: 16px 0 0; }
  .tree-search .tree-depth { flex: none; }
  .tree-search .q { flex: 1 1 auto; min-width: 0; }
  :root:not(.js) .tree-search { display: none; }
  @media (max-width: 640px) {
    .filters.tree-search { flex-wrap: wrap; }
    .tree-search .q { flex-basis: 100%; }
  }

  /* 出す指標のボタンと、押すと出るチェックボックスの吹き出し。ボタンは並びのセレクトと同じ高さにする */
  .tree-show { position: relative; flex: none; display: grid; gap: 4px; }
  .tree-show-btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 4px 12px 4px 14px;
    font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--paper); border: 2px solid var(--line); border-radius: 12px; cursor: pointer;
  }
  .tree-show-btn:hover, .tree-show-btn[aria-expanded='true'] { background: var(--sky); }
  .tree-show-btn .chev { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tree-show-btn[aria-expanded='true'] .chev { rotate: 180deg; }
  .tree-show-pop {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 45; margin: 0; min-width: 100%; width: max-content; display: grid;
    background: var(--paper); color: var(--ink); border: 2px solid var(--line); border-radius: 12px; box-shadow: 3px 3px 0 var(--shadow); padding: 6px;
  }
  .tree-show-pop[hidden] { display: none; }
  .tree-show-pop legend { float: left; width: 100%; padding: 2px 8px 2px; font-size: 0.75rem; font-weight: 700; color: var(--ink-2); }
  .filters .tree-show-pop label {
    display: flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 12px 0 8px;
    font-size: 0.875rem; font-weight: 400; color: var(--ink); border-radius: 8px; cursor: pointer;
  }
  .tree-show-pop label:hover { background: var(--sky); }
  /* チェックの箱。ブラウザの箱は使わず、指標の札と同じ細めの線の角丸にする。選ぶと青く塗って小さくずらした影を付け、白い ✓ を描く */
  .tree-show-pop input {
    appearance: none; flex: none; display: grid; place-items: center; width: 16px; height: 16px; margin: 0;
    background: var(--paper); border: 1.5px solid var(--line); border-radius: 5px; cursor: pointer;
  }
  .tree-show-pop input::before { content: ''; width: 7px; height: 3.5px; border: solid var(--pop-ink); border-width: 0 0 2px 2px; rotate: -45deg; translate: 0 -1px; scale: 0; }
  .tree-show-pop input:checked { background: var(--pop); border-color: var(--pop); box-shadow: 1.5px 1.5px 0 var(--shadow); }
  .tree-show-pop input:checked::before { scale: 1; }
  .tree-show-pop input:focus-visible { outline: 3px solid var(--pop); outline-offset: 2px; }
  p.tree-hits { margin: 10px 0 0; }
  /* 件数の文字が無いときは場所を取らない（件数を読み上げるため、p（aria-live）は出したままにする） */
  p.tree-hits:has(> span:empty) { margin: 0; }
  .tree-hits > span:empty { display: none; }
  /* 目次のデータが届くまで（scripts/tree.ts が描くまで）、目次の場所を画面の高さぶん取っておく。空のままだと下の注記が最初の画面に見え、
     描くと押し出されてずれるため（取組をさがすと同じ。docs/site.md の 7章）。スクリプトが動かないときは「読み込んでいます」を出さず、場所も取らない */
  :root.js .tree-box .tree[aria-busy='true'] { min-height: 100vh; }
  :root:not(.js) .tree-box .tree-msg { display: none; }
  .tree-box .tree-msg { margin: 4px 0 4px calc(var(--tw) + 8px); }

  /* 木の線: 親の ▶ の丸の真ん中から線を下ろし、子の行の真ん中へ └ の形で曲げて、子の丸（取組は番号）の 1px 手前まで引く（最後の子より下へは伸ばさない）。
     線の太さと曲がりはページの階層（components/Hierarchy.astro）とそろえる。
     --tw は丸の大きさ、--step は段の下げ幅、--lw は線の太さ、--c は行の頭から丸の真ん中まで（階層ごとに字の大きさが違うので、それぞれで決める） */
  .sticker.tree-box { --tw: 22px; --step: calc(var(--tw) / 2 + 5px); --lw: 2px; --pad: 3px; --col: calc(var(--tw) + 8px); margin-top: 12px; padding: 16px 20px 18px 16px; }
  .tree-box .tree, .tree-box .tree ul { list-style: none; margin: 0; padding: 0 0 0 var(--step); }
  .tree-box .tree li { position: relative; }
  .tree-box .tree li::before, .tree-box .tree li:not(:last-child)::after { content: ''; position: absolute; left: calc(var(--tw) / 2 - var(--step) - var(--lw) / 2); top: 0; border: 0 solid var(--hair); border-left-width: var(--lw); }
  .tree-box .tree li::before { width: calc(var(--step) - var(--tw) / 2 + var(--lw) / 2 - 1px + var(--lead, 0px)); height: calc(var(--pt, 0px) + var(--c) + var(--lw) / 2); border-bottom-width: var(--lw); border-bottom-left-radius: 3px; }
  .tree-box .tree li:not(:last-child)::after { bottom: 0; }
  /* キーワードで後ろの行を隠したときは、見えている最後の行より下へ線を伸ばさない */
  .tree-box .tree li:not(:has(~ li:not([hidden])))::after { display: none; }
  /* キーワードに当たった文字。状態の色（黄など）と混ぜないよう、装飾の青の地に下線を引く */
  .tree-box .qn mark { background: var(--sky); color: inherit; box-shadow: inset 0 -2px var(--pop); border-radius: 2px; }

  /* 名前の行。頭の番号は折り返さず、名前が何行かになるときは名前の頭にそろえる */
  .tree-box .tb { display: flex; align-items: baseline; gap: 6px; min-width: 0; padding: var(--pad) 0; line-height: 1.6; }
  .tree-box .tb > :last-child { min-width: 0; }
  .tree-box .no { flex: none; font-weight: 700; color: var(--ink-2); }
  /* 閉じている行の、すぐ下に並ぶものの数 */
  .tree-box .cnt { font-size: 0.8125rem; color: var(--ink-2); white-space: nowrap; margin-left: 4px; }
  .tree-box .cnt > span + span::before { content: '・'; }
  .tree-box .cnt b { font-family: var(--font-num); font-weight: 600; color: var(--ink); }
  .tree-box .nd:has(> details[open]) > .tb .cnt { display: none; }

  /* 取組・指標より上の段の行（.nd）: 名前は summary の外に置き、summary（.tg）は ▶ の丸だけにして、名前の左の列（--col）に重ねる。
     押せる所は丸より広く取る（32px）。子の並びは、その列のぶん左へ戻して、ほかの行と同じ所から線を引く */
  .tree-box .tree .nd { padding-left: var(--col); }
  .tree-box .nd > .tb { position: relative; }
  .tree-box .tree .nd > details > ul { margin-left: calc(-1 * var(--col)); }
  .tree-box .tree summary { list-style: none; cursor: pointer; color: var(--ink); font-weight: 400; font-size: inherit; padding: 0; }
  .tree-box .tree summary::-webkit-details-marker { display: none; }
  .tree-box .tree details[open] > summary { margin-bottom: 0; }
  .tree-box .tree .tg { position: absolute; left: calc(var(--tw) / 2 - 16px); top: calc(var(--pt, 0px) + var(--c) - 16px); width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; }
  /* 施策展開（ページが無い）は、名前の行を押しても開け閉めする（scripts/tree.ts） */
  .tree-box .lv2 > .tb { cursor: pointer; }

  /* 開いているときは、丸の下から子の並びの頭まで線をつなぐ（名前が何行かに折り返しても切れないように） */
  .tree-box .tree-root::after, .tree-box .nd:has(> details[open]) > .tb::after {
    content: ''; position: absolute; top: calc(var(--c) + var(--tw) / 2); bottom: 0; border-left: var(--lw) solid var(--hair);
  }
  .tree-box .tree-root::after { left: calc(var(--tw) / 2 - var(--lw) / 2); }
  .tree-box .nd:has(> details[open]) > .tb::after { left: calc(var(--tw) / 2 - var(--col) - var(--lw) / 2); }
  /* 根（計画そのもの）。開け閉めはしないので、丸の代わりに小さな点を置く（線は点の真ん中から下ろす） */
  .tree-box .tree-root { --c: 13px; position: relative; margin: 0; padding-bottom: 4px; display: flex; align-items: flex-start; gap: 8px; font-family: var(--font-display); font-weight: 700; line-height: 1.6; }
  .tree-box .tree-root .tw { margin-top: calc(var(--c) - var(--tw) / 2); border: 0; background: none; }
  .tree-box .tree-root .tw::before { content: ''; width: 12px; height: 12px; border: 0; border-radius: 50%; background: var(--ink); translate: none; }
  .tree-box .tree-root::after { top: calc(var(--c) + 6px); }
  /* キーボードで木に止まったときだけ、矢印キーで動かせることを根の行の右に出す（指標のマップと同じ。読み上げは木の aria-label で伝える） */
  .tree-box .tree-hint {
    display: none; position: absolute; right: 0; top: var(--c); translate: 0 -50%; padding: 0 8px; font-family: var(--font); font-size: 0.75rem; line-height: 1.6;
    background: var(--paper); border: 1.5px solid var(--pop); border-radius: 999px;
  }
  .tree-box:has(.tree :focus-visible) .tree-hint { display: block; }

  /* 開け閉めの丸（.tw）の形は styles/global.css。施策展開は名前の行に乗せても丸の色を変える。子の無い行は点線の丸だけ */
  .tree-box .lv2 > .tb:hover + details > summary .tw { background: var(--sky); }
  .tree-box .tree .tw-none { border-style: dashed; border-color: var(--hair); }
  .tree-box .tree .tw-none::before { display: none; }

  /* 階層ごとの字の大きさと、行の真ん中の高さ（--c）。将来像は帯（.sz-ribbon）にする */
  .tree-box .lv0 { --c: 23px; }
  .tree-box .lv0 + .lv0 { --pt: 10px; padding-top: var(--pt); }
  /* 将来像の行の上の余白（--pt）は、中の行に受け継がせない（受け継ぐと、中の行の丸と線の曲がりがそのぶん下にずれる） */
  .tree-box .lv0 li { --pt: 0px; }
  .tree-box .lv0 .sz-ribbon { display: inline-flex; vertical-align: middle; padding: 3px 14px 3px 4px; gap: 8px; }
  .tree-box .lv0 .sz-ribbon .badge-sz { width: 1.9em; height: 1.9em; font-size: 0.9rem; }
  .tree-box .lv0 .sz-ribbon .name-link { font-family: var(--font-display); font-size: 1rem; }
  .tree-box .lv1 { --c: 16px; }
  .tree-box .lv1 > .tb { font-size: 1rem; }
  .tree-box .lv1:last-child { padding-bottom: 6px; }
  /* 施策展開はページが無いので、名前はリンクにせず、見出しの丸ゴシックにする（基本施策のページの施策の並びの見出しと同じ） */
  .tree-box .lv2 { --c: 15px; }
  .tree-box .lv2 > .tb { font-size: 0.9375rem; }
  .tree-box .tk-name { font-family: var(--font-display); font-weight: 700; }
  .tree-box .lv3 { --c: 15px; }
  .tree-box .lv3 > .tb { font-size: 0.9375rem; }
  /* 下に段の無い行（取組・指標）は、行を --lead だけ右へずらし、横の線もそのぶん長くする */
  .tree-box .leaf { --c: 13px; --lead: 6px; padding: 2px 0 2px var(--lead); }
  .tree-box .leaf > .tb { font-size: 0.875rem; padding: 0; }
  /* 取組の番号は右にそろえ、名前の頭を縦にそろえる（1つの施策に取組は多くて十数件） */
  .tree-box .leaf .no { min-width: 1.2em; text-align: right; font-family: var(--font-num); font-weight: 600; }
