---
// 将来像1つのページ。頭（名前・3つの段の問いと答え）→ 基本施策ごとの主要指標と主な取組 → 施策の判定 → 4年間の推移 → 予算 → シェア。
// 頭はトップのヒーローと同じく、3つの段（主要指標・成果指標・主な取組。components/Ladder.astro）を中に置き、数だけをこの将来像のものにする。数が何年度の報告かは頭で1回だけ書き、節の見出し・札には書かない。
// 節の頭の文は、表示の説明（「棒は〜」「点を押すと〜」）ではなく、見た人が知りたいこと（何が分かるか・だれが決めているか）の1文にし、比べ方の決まりは図の後ろに置く（トップと同じ）。
// 施策の判定と4年間の推移は、トップの節と同じ形（頭の文・マス目に題を付けない・推移の内訳は出さない）にし、数だけをこの将来像のものにする
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../lib/routes.ts';
import Base from '../../layouts/Base.astro';
import Sz from '../../components/Sz.astro';
import Ladder from '../../components/Ladder.astro';
import HeadStats from '../../components/HeadStats.astro';
import Chunk from '../../components/Chunk.astro';
import KeyBrief from '../../components/KeyBrief.astro';
import Term from '../../components/Term.astro';
import JudgeMatrix from '../../components/JudgeMatrix.astro';
import ExtLink from '../../components/ExtLink.astro';
import TrendFigure from '../../components/TrendFigure.astro';
import ShareBox from '../../components/ShareBox.astro';
import Toc from '../../components/Toc.astro';
import KihonRow from '../../components/KihonRow.astro';
import {
  LATEST, yearLong, STATUSES, RATE_BINS, statusOf, rateBin, countBy,
  getKihonList, getShisakuList, getTorikumi, getSeika, getShuyouStatus, amountEntries, trendPoints,
} from '../../lib/data.ts';
import type { TorikumiRow } from '../../lib/types.ts';
import { band, pct, yen } from '../../lib/format.ts';
import { LINKS } from '../../lib/links.ts';
import { futureDescription } from '../../lib/describe.ts';
import { futureHead } from '../../lib/heads.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['future/[id]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { v } = Astro.props;
const pre = `${v.id}-`;
const statusKeys = STATUSES.map((s) => s.key);
const kihon = getKihonList().filter((k) => k.shouraizou === v.id);
const shisaku = getShisakuList().filter((s) => s.shouraizou === v.id);
const tori = getTorikumi(LATEST).filter((t) => t.shisaku_id.startsWith(pre));
const seika = getSeika(LATEST).filter((s) => s.shisaku_id.startsWith(pre));
const isOk = (t: TorikumiRow) => t.status === '順調';
// 最新の年度の数（ページの説明文・SNS のカードの画像と同じ数。lib/heads.ts）
const head = futureHead(v.id);
const judgeCounts = head.judges;

// 主要指標の達成状況（県の概要版の表の順。読めない年度は空）。基本施策の行の中に置く
const shuyou = getShuyouStatus().filter((r) => r.kihon.shouraizou === v.id);

// 4年間の推移
const trend = trendPoints((t) => t.shisaku_id.startsWith(pre), (s) => s.shisaku_id.startsWith(pre));

// 基本施策ごと。基本施策の名前の下に、主要指標（達成状況の札とスタート → いま → ゴールの値）と主な取組の進捗状況の棒を並べる（components/KihonRow.astro）。
// 成果指標は施策の単位の物差しなので、基本施策の行には出さない（頭の3つの段・施策の判定・4年間の推移・成果指標をさがすにある）
const kihonRows = kihon.map((k) => {
  const t = tori.filter((x) => x.shisaku_id.startsWith(`${k.id}-`));
  return {
    ...k,
    shuyou: shuyou.filter((r) => r.kihon.id === k.id),
    tori: { n: t.length, ok: t.filter(isOk).length, counts: countBy(t, statusOf, statusKeys) },
  };
});
// 主な取組の区分の一覧は凡例の箱にせず、行の「順調」を押すと短い説明と一緒に出す（components/KeyBrief.astro。どれかの基本施策で使っている区分）。
// 主要指標の札は県の言葉で読めるので、説明を置かない
const toriUsed = statusKeys.filter((key) => kihonRows.some((k) => (k.tori.counts[key] || 0) > 0));

// 予算（R7の決算見込額。同じ予算事業の重複を除いたもの）
const estimate = amountEntries(LATEST, 'estimate');
const budget = estimate.filter((e) => e.shisaku_id.startsWith(pre)).reduce((s, e) => s + e.amount, 0);
const budgetAll = estimate.reduce((s, e) => s + e.amount, 0);
---
<Base title={`将来像${v.id} ${v.name}`} description={futureDescription(v.id, v.name, head)} ogType="article">
  <header class:list={['sticker', 'lift', 'v-hero', `sz-${v.id}`]}>
    <Sz id={v.id} sr={false} class="hero-badge" />
    {/* 番号は印にあるので「将来像」の後ろの番号は読み上げだけ */}
    <div class="v-kicker"><span><Term word="将来像" /><span class="sr-only">{v.id}</span></span><span class="tag">{yearLong(LATEST)}の結果</span></div>
    <h1>{v.name}</h1>
    <HeadStats items={[
      { label: '基本施策', n: kihon.length, href: '#kihon' },
      { label: '施策', n: shisaku.length, href: `/shisaku/?s=${v.id}` },
    ]} />
    <Ladder shuyou={shuyou} seika={countBy(seika, rateBin, RATE_BINS.map((b) => b.key))} tori={countBy(tori, statusOf, statusKeys)} q={`s=${v.id}`} shuyouHref="#kihon" shuyouCells />
  </header>

  <Toc
    links={[
      { href: '#kihon', label: '基本施策' },
      { href: '#judge-h', label: '施策の判定' },
      { href: '#trend-h', label: '4年間の推移' },
      { href: '#yosan-h', label: '予算' },
    ]}
    head={{ kind: '将来像', sz: v.id, title: v.name }}
  />

  <section aria-labelledby="kihon">
    <h2 id="kihon" class="anchor">基本施策ごとの<Term word="主要指標" />と主な取組</h2>
    <p class="small secondary lead">主要指標の札は、スタート（基準値）からゴール（R9の目標値）までのうち、どこまで進んだかの県の区分と達成率です。</p>
    <KeyBrief kind="status" used={toriUsed} />
    <ul class="k-list">
      {kihonRows.map((k) => <KihonRow kihon={k} shuyou={k.shuyou} tori={k.tori} />)}
    </ul>
  </section>

  <section aria-labelledby="judge-h">
    <h2 id="judge-h" class="anchor">施策の判定</h2>
    <p class="small secondary lead">施策の<Term word="推進状況" label="判定" />（A〜G）は、主な取組の「順調」の割合と成果指標の<Term word="達成率" />をもとに沖縄県が毎年評価し、「<ExtLink href={LINKS.kekka} after="」">沖縄県PDCA実施結果</ExtLink>で公表しています。</p>
    <JudgeMatrix counts={judgeCounts} hrefOf={(k) => `/shisaku/?s=${v.id}&judge=${k}`} />
  </section>

  <section aria-labelledby="trend-h">
    <h2 id="trend-h" class="anchor">4年間の推移</h2>
    <p class="small secondary lead">この4年、主な取組の「順調」は{band(trend.map((p) => p.a))}、計画値に届いた成果指標は{band(trend.map((p) => p.b))}で推移しています。</p>
    <TrendFigure points={trend} />
  </section>

  <section aria-labelledby="yosan-h">
    <h2 id="yosan-h" class="anchor">予算</h2>
    <div class="sticker budget">
      <div class="tile-label">将来像{v.id}の主な取組に書かれた予算事業（決算見込額）</div>
      <div class="tile-value">{yen(budget)}</div>
      <Chunk frac={budgetAll ? budget / budgetAll : 0} tone="none" label={`主な取組の予算事業全体の${pct(budget, budgetAll)}`} thin />
      <div class="tile-sub">主な取組の予算事業全体（{yen(budgetAll)}）の{pct(budget, budgetAll)}です。同じ予算事業の重複を除いています。</div>
      <a class="b-more" href="/yosan/">予算と財源を見る<span aria-hidden="true"> →</span></a>
    </div>
  </section>

  <ShareBox kind="将来像" name={`${v.id} ${v.name}`} />
</Base>

<style>
  /* 頭。PC は番号の印を左に大きく置き、右に「将来像」・名前・件数の札。スマホは印を小さくして「将来像」の行に並べ、名前を全幅にする。
     3つの段の問いと答え（Ladder）はトップのヒーローと同じく頭の中に置き、余白もトップのヒーローと同じにする（段の位置がそろうように） */
  .v-hero {
    display: grid; grid-template-columns: 76px minmax(0, 1fr); grid-template-areas: "badge kicker" "badge name" "badge stats" "ladder ladder";
    gap: 0 18px; align-items: center; margin-top: 12px; padding: 24px 24px 28px; background: var(--szw);
  }
  .v-hero :global(.hero-badge) { grid-area: badge; width: 76px; height: 76px; font-size: 2.2rem; border-width: 3px; box-shadow: 3px 3px 0 var(--shadow); }
  .v-kicker { grid-area: kicker; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-family: var(--font-display); font-weight: 700; color: var(--ink-2); }
  .v-hero h1 { grid-area: name; margin: 4px 0 10px; }
  .v-hero :global(.head-stats) { grid-area: stats; }
  .v-hero :global(.ladder) { grid-area: ladder; }
  @media (max-width: 520px) {
    .v-hero { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "badge kicker" "name name" "stats stats" "ladder ladder"; column-gap: 10px; }
    .v-hero :global(.hero-badge) { width: 36px; height: 36px; font-size: 1.15rem; border-width: 2.5px; box-shadow: 2px 2px 0 var(--shadow); }
    .v-hero h1 { margin-top: 8px; }
  }


  /* 基本施策は1つずつカード（components/KihonRow.astro）にし、PC は2列に並べる（1列だと右が空くため）。同じ行のカードは高さをそろえる */
  .k-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 900px) { .k-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }


  .budget { display: grid; gap: 6px; }
  .b-more { justify-self: start; font-size: 0.875rem; font-weight: 700; }
</style>
