---
// 将来像1つのページ。ひとめで（取組と成果の割合）→ 主要指標の移り変わり → 施策の判定と前の年度からの変化 → 基本施策ごとの進み → 成果指標の一覧 → 4年間の推移・テーマ・予算 → シェア
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../lib/routes.ts';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Sz from '../../components/Sz.astro';
import DonutCard from '../../components/DonutCard.astro';
import HeadStats from '../../components/HeadStats.astro';
import Moves, { type MoveGroup } from '../../components/Moves.astro';
import Chunk from '../../components/Chunk.astro';
import Term from '../../components/Term.astro';
import StatusBar from '../../components/StatusBar.astro';
import StatusChart from '../../components/StatusChart.astro';
import JudgeMatrix from '../../components/JudgeMatrix.astro';
import TrendChart from '../../components/TrendChart.astro';
import ShareBox from '../../components/ShareBox.astro';
import Toc from '../../components/Toc.astro';
import SeikaRow from '../../components/SeikaRow.astro';
import SeikaKey from '../../components/SeikaKey.astro';
import ShuyouTrendList from '../../components/ShuyouTrendList.astro';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, RATE_BINS, statusOf, rateBin, countBy,
  getKihonList, getShisakuList, getTorikumi, getSeika, getShuyouStatus, getTorikumiGroups, getSeikaGroups, seikaHref, amountEntries,
} from '../../lib/data.ts';
import type { SeikaRow as SeikaRowT, TorikumiRow } from '../../lib/types.ts';
import { getThemes } from '../../lib/themes.ts';
import { fmt, pct, yen } from '../../lib/format.ts';
import { LINKS } from '../../lib/links.ts';
import ExtLink from '../../components/ExtLink.astro';
import { futureDescription } from '../../lib/describe.ts';
import { futureHead } from '../../lib/heads.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['future/[id]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { v } = Astro.props;
const pre = `${v.id}-`;
const statusKeys = STATUSES.map((s) => s.key);
const kihon = getKihonList().filter((k) => k.shouraizou === v.id);
const shisaku = getShisakuList().filter((s) => s.shouraizou === v.id);
const allTori = getTorikumi(LATEST);
const allSeika = getSeika(LATEST);
const tori = allTori.filter((t) => t.shisaku_id.startsWith(pre));
const seika = allSeika.filter((s) => s.shisaku_id.startsWith(pre));
const isOk = (t: TorikumiRow) => t.status === '順調';
const reached = (s: SeikaRowT) => rateBin(s) === '100%以上';
const toriOk = tori.filter(isOk).length;
const seikaOk = seika.filter(reached).length;
// 最新の年度の数（ページの説明文・SNS のカードの画像と同じ数。lib/heads.ts）
const head = futureHead(v.id);
const judgeCounts = head.judges;

// 基本施策ごと
const kihonCards = kihon.map((k) => {
  const t = tori.filter((x) => x.shisaku_id.startsWith(`${k.id}-`));
  const ss = shisaku.filter((s) => s.kihon_id === k.id);
  return {
    ...k,
    n: t.length,
    ok: t.filter(isOk).length,
    counts: countBy(t, statusOf, statusKeys),
    shisaku: ss.length,
  };
});

// 主要指標の達成状況（県の概要版の表の順。読めない年度は空）
const shuyou = getShuyouStatus().filter((r) => r.kihon.shouraizou === v.id);

// 4年間の推移
const trend = YEARS.map((y) => {
  const t = getTorikumi(y).filter((x) => x.shisaku_id.startsWith(pre));
  const s = getSeika(y).filter((x) => x.shisaku_id.startsWith(pre));
  const aOk = t.filter(isOk).length;
  const bOk = s.filter(reached).length;
  return { y, a: (aOk / t.length) * 100, b: (bOk / s.length) * 100, aOk, aN: t.length, bOk, bN: s.length };
});
const torikumiRows = YEARS.map((y) => ({ label: yearLabel(y), sub: y <= 2024 ? '前期' : '中期', counts: countBy(getTorikumi(y).filter((x) => x.shisaku_id.startsWith(pre)), statusOf, statusKeys) }));
const seikaRows = YEARS.map((y) => ({ label: yearLabel(y), sub: y <= 2024 ? '前期' : '中期', counts: countBy(getSeika(y).filter((x) => x.shisaku_id.startsWith(pre)), rateBin, RATE_BINS.map((b) => b.key)) }));

// 前の年度からの変化。施策の判定（lib/data.ts の JUDGE_TRENDS）と、主な取組の進捗状況（PATTERNS）を、良くなったものと悪くなったものの対で並べる
const groups = getTorikumiGroups().filter((g) => g.shisaku.shouraizou === v.id);
const moves: MoveGroup[] = [
  { label: '施策の判定', unit: '施策', items: [
    { tone: 'good', title: '判定が上がった', n: shisaku.filter((s) => s.trends.includes('up')).length, href: `/shisaku/?s=${v.id}&trend=up` },
    { tone: 'serious', title: '判定が下がった', n: shisaku.filter((s) => s.trends.includes('down')).length, href: `/shisaku/?s=${v.id}&trend=down` },
  ] },
  { label: '主な取組の進捗状況', unit: '件', items: [
    { tone: 'good', title: '遅れから「順調」に戻った', n: groups.filter((g) => g.patterns.includes('recover')).length, href: `/torikumi/?s=${v.id}&pat=recover` },
    { tone: 'serious', title: '新しく遅れが出た', n: groups.filter((g) => g.patterns.includes('newdelay')).length, href: `/torikumi/?s=${v.id}&pat=newdelay` },
  ] },
];

// 成果指標の一覧（最新の年度の報告にあるもの）。基本施策の見出しの下に報告書の順で並べ、最初の SEIKA_SHOW 件より後は「さらに表示」で開く（scripts/show-more.ts）
const SEIKA_SHOW = 5;
const seikaGroups = getSeikaGroups().filter((r) => r.latest.year === LATEST && r.shisaku.shouraizou === v.id);
const seikaByKihon = kihon.map((k) => ({ ...k, rows: seikaGroups.filter((r) => r.shisaku.kihon_id === k.id) })).filter((k) => k.rows.length);

// くらしのテーマ（この将来像の施策が多い順）
const ids = new Set(shisaku.map((s) => s.id));
const themes = getThemes().map((t) => ({ ...t, n: t.ids.filter((id) => ids.has(id)).length })).filter((t) => t.n > 0).sort((a, b) => b.n - a.n);

// 予算（R7の決算見込額。同じ予算事業の重複を除いたもの）
const estimate = amountEntries(LATEST, 'estimate');
const budget = estimate.filter((e) => e.shisaku_id.startsWith(pre)).reduce((s, e) => s + e.amount, 0);
const budgetAll = estimate.reduce((s, e) => s + e.amount, 0);
---
<Base title={`将来像${v.id} ${v.name}`} description={futureDescription(v.id, v.name, head)} ogType="article">
  <Crumbs items={[{ href: '/future/', label: '将来像の一覧' }, { label: `将来像${v.id}`, sz: v.id }]} />

  <header class:list={['sticker', 'lift', 'v-hero', `sz-${v.id}`]}>
    <Sz id={v.id} sr={false} class="hero-badge" />
    <div>
      <div class="v-kicker"><Term word="将来像" /><span class="sr-only">{v.id}</span></div>
      <h1>{v.name}</h1>
      <HeadStats items={[
        { label: '基本施策', n: kihon.length, href: '#kihon' },
        { label: '施策', n: shisaku.length, href: `/shisaku/?s=${v.id}` },
      ]} asOf={`数は${yearLong(LATEST)}の報告から`} />
    </div>
  </header>

  <div class="donuts">
    <DonutCard frac={toriOk / tori.length} label={`主な取組のうち順調 ${pct(toriOk, tori.length)}`} more={{ href: `/torikumi/?s=${v.id}`, label: '取組をさがす' }}>
      <Term word="主な取組" />のうち「順調」
      <Fragment slot="sub"><span class="dc-n">{fmt(toriOk)} / {fmt(tori.length)}件</span></Fragment>
    </DonutCard>
    <DonutCard frac={seikaOk / seika.length} label={`成果指標のうち計画値に到達 ${pct(seikaOk, seika.length)}`} more={{ href: `/shihyou/?s=${v.id}`, label: '成果指標をさがす' }}>
      <Term word="成果指標" />のうち<Term word="計画値" />に到達
      <Fragment slot="sub"><span class="dc-n">{fmt(seikaOk)} / {fmt(seika.length)}指標</span></Fragment>
    </DonutCard>
  </div>

  <Toc
    links={[
      shuyou.length > 0 && { href: '#shuyou-h', label: '主要指標' },
      { href: '#judge-h', label: '施策の判定' },
      { href: '#moves-h', label: '前の年度からの変化' },
      { href: '#kihon', label: '基本施策' },
      seikaGroups.length > 0 && { href: '#seika-h', label: '成果指標' },
      { href: '#trend-h', label: '4年間の推移' },
      { href: '#theme-h', label: 'くらしのテーマ' },
      { href: '#yosan-h', label: '予算' },
    ]}
    head={{ kind: '将来像', sz: v.id, title: v.name }}
  />

  {shuyou.length > 0 && (
    <section aria-labelledby="shuyou-h">
      <h2 id="shuyou-h" class="anchor"><Term word="主要指標" />の移り変わり（{fmt(shuyou.length)}）</h2>
      <SeikaKey mini plan={false} goal rate="shuyou" />
      <ShuyouTrendList rows={shuyou} />
      <p class="small secondary">{yearLabel(LATEST)}の値と達成率は県の概要版、それより前の値は総括報告書の付属資料のものです（基本施策のページは付属資料の値で、書き方や値が少し違うものがあります）。{shuyou.some((r) => r.revised) && '※は、統計の基準改定にあわせて県が試算し直した基準値・目標値です。'}<a href="/shihyou/shuyou/">主要指標の一覧</a>で、ほかの将来像の指標も見られます。</p>
    </section>
  )}

  <section aria-labelledby="judge-h">
    <h2 id="judge-h" class="anchor">施策の判定</h2>
    <JudgeMatrix counts={judgeCounts} caption={`将来像${v.id}の${fmt(shisaku.length)}施策`} hrefOf={(k) => `/shisaku/?s=${v.id}&judge=${k}`} />
  </section>

  <section aria-labelledby="moves-h">
    <h2 id="moves-h" class="anchor">前の年度からの変化</h2>
    <p class="small secondary lead">{yearLabel(LATEST - 1)}と{yearLabel(LATEST)}の報告を比べました（判定の C〜F の中の入れ替わりは数えません）。</p>
    <Moves groups={moves} />
  </section>

  <section aria-labelledby="kihon">
    <h2 id="kihon" class="anchor">基本施策ごとの進み具合</h2>
    <p class="small secondary lead">主な取組の<Term word="進捗状況" />の内訳と、そのうち「順調」の割合です。</p>
    <ul class="kcards">
      {kihonCards.map((k) => (
        <li class="sticker kcard">
          <div class="name-row"><a class="k-name name-link" href={`/kihon/${k.id}/`}>{k.name}</a><span class="code-no">{k.code}</span></div>
          {k.n > 0 && (
            <div class="k-row">
              <StatusBar categories={STATUSES} counts={k.counts} context={`${k.name} 主な取組 `} size="mini" />
              <span class="big k-pv"><span class="sr-only">主な取組のうち順調 </span>{pct(k.ok, k.n)}</span>
            </div>
          )}
          <div class="small"><a href={`/shisaku/?q=${encodeURIComponent(k.name)}`}>施策 {fmt(k.shisaku)}</a></div>
        </li>
      ))}
    </ul>
  </section>

  {seikaGroups.length > 0 && (
    <section aria-labelledby="seika-h">
      <h2 id="seika-h" class="anchor">成果指標（{fmt(seikaGroups.length)}）</h2>
      <p class="small"><a href={`/shihyou/?s=${v.id}`}>成果指標をさがす</a>で、見通しや担当部局でさらに絞り込めます。</p>
      <SeikaKey mini rate="seika" />
      {seikaByKihon.map((k) => (
        <>
          <h3 class="k-h"><a class="name-link" href={`/kihon/${k.id}/`}>{k.name}</a><span class="n">（{fmt(k.rows.length)}）</span> <span class="code-no">{k.code}</span></h3>
          <ul class="row-list" id={`seika-${k.id}`} data-more={SEIKA_SHOW}>
            {k.rows.map((r) => <SeikaRow x={r.latest} row={r} shisaku={r.shisaku} href={seikaHref(r.shisaku.id, r.key)} />)}
          </ul>
          {k.rows.length > SEIKA_SHOW + 2 && <p class="more-row"><button type="button" class="button" data-more-btn={`seika-${k.id}`} hidden>さらに表示（残り {fmt(k.rows.length - SEIKA_SHOW)}指標）</button></p>}
        </>
      ))}
    </section>
  )}

  <section aria-labelledby="trend-h">
    <h2 id="trend-h" class="anchor">4年間の推移</h2>
    <figure class="sticker">
      <figcaption>
        <div class="chart-title">「順調」の取組と、計画値に届いた成果指標の割合（将来像{v.id}）</div>
      </figcaption>
      <TrendChart points={trend} />
      <details>
        <summary>表で見る</summary>
        <div class="table-wrap">
          <table>
            <thead><tr><th>年度</th><th class="num">主な取組</th><th class="num">うち順調</th><th class="num">成果指標</th><th class="num">うち計画値に到達</th></tr></thead>
            <tbody>
              {trend.map((p) => (
                <tr>
                  <th>{yearLong(p.y)}（{p.y <= 2024 ? '前期' : '中期'}）</th>
                  <td class="num">{fmt(p.aN)}</td><td class="num">{fmt(p.aOk)}（{p.a.toFixed(1)}%）</td>
                  <td class="num">{fmt(p.bN)}</td><td class="num">{fmt(p.bOk)}（{p.b.toFixed(1)}%）</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </figure>
    <details class="breakdown">
      <summary>内訳を見る（進捗状況・達成率の区分ごと）</summary>
      <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={torikumiRows} />
      <StatusChart title="成果指標の達成状況" categories={RATE_BINS} rows={seikaRows} unit="指標" />
    </details>
    <p class="small secondary">R7からの<ExtLink href={LINKS.chuki}>中期実施計画</ExtLink>で基準値・目標値・計画値が新しくなったため、成果指標の割合は<ExtLink href={LINKS.zenki}>前期実施計画</ExtLink>（R4〜R6）と単純には比べられません。</p>
  </section>

  <section aria-labelledby="theme-h">
    <h2 id="theme-h" class="anchor">くらしのテーマで見る<span class="own">このサイト独自の分類</span></h2>
    <p class="small secondary lead">数字は将来像{v.id}の施策の数です。</p>
    <ul class="tlist">
      {themes.map((t) => <li><a class="ttag t-big" href={`/shisaku/?s=${v.id}&theme=${t.id}`}>{t.label}<b>{fmt(t.n)}</b></a></li>)}
    </ul>
  </section>

  <section aria-labelledby="yosan-h">
    <h2 id="yosan-h" class="anchor">予算</h2>
    <div class="sticker budget">
      <div class="tile-label">将来像{v.id}の主な取組に書かれた予算事業（決算見込額）</div>
      <div class="tile-value">{yen(budget)}</div>
      <Chunk frac={budgetAll ? budget / budgetAll : 0} tone="none" label={`主な取組の予算事業全体の${pct(budget, budgetAll)}`} thin />
      <div class="tile-sub">主な取組の予算事業全体（{yen(budgetAll)}）の{pct(budget, budgetAll)}。同じ予算事業の重複を除いています。<a href="/yosan/">予算と財源</a></div>
    </div>
  </section>

  <ShareBox kind="将来像" name={`${v.id} ${v.name}`} />
</Base>

<style>
  .v-hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; align-items: center; margin-top: 12px; background: var(--szw); }
  .v-hero :global(.hero-badge) { width: 76px; height: 76px; font-size: 2.2rem; border-width: 3px; box-shadow: 3px 3px 0 var(--shadow); }
  .v-kicker { font-family: var(--font-display); font-weight: 700; color: var(--ink-2); }
  .v-hero h1 { margin: 2px 0 8px; }
  @media (max-width: 520px) { .v-hero { grid-template-columns: 1fr; } .v-hero :global(.hero-badge) { width: 56px; height: 56px; font-size: 1.6rem; } }
  .kcards { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .kcard { display: grid; gap: 8px; align-content: start; }
  .k-name { line-height: 1.5; }
  .k-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; }
  .k-pv { font-size: 1.3rem; line-height: 1.2; }
  .dc-n { font-family: var(--font-num); font-weight: 600; font-size: 1rem; color: var(--ink); white-space: nowrap; }
  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .breakdown { margin-top: 16px; }
  .k-h { font-size: 1rem; margin: 1.4em 0 0.5em; }
  .k-h .n { white-space: nowrap; }
  .more-row { margin-top: 12px; }
  .tlist { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .t-big { font-size: 0.9375rem; padding: 4px 12px; gap: 8px; }
  .t-big b { font-family: var(--font-num); font-weight: 600; }
  .budget { display: grid; gap: 6px; max-width: 640px; }
</style>
