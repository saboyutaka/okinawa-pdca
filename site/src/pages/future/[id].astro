---
// 将来像1つのページ。頭（名前・ドーナツ2枚）→ 基本施策ごとの進み具合（主要指標・主な取組・成果指標。成果指標の一覧は畳む）→ 施策の判定 → 4年間の推移 → くらしのテーマ → 予算 → シェア。
// 頭はトップのヒーローと同じく、ドーナツのカードを中に置き、見出しを問い・割合を答えにする。数が何年度の報告かは頭で1回だけ書き、節の見出し・札には書かない。
// 節の頭の文は、表示の説明（「棒は〜」「点を押すと〜」）ではなく、見た人が知りたいこと（何が分かるか・だれが決めているか）の1文にし、比べ方の決まりは図の後ろに置く（トップと同じ）
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../lib/routes.ts';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Sz from '../../components/Sz.astro';
import DonutCard from '../../components/DonutCard.astro';
import HeadStats from '../../components/HeadStats.astro';
import Chunk from '../../components/Chunk.astro';
import Chip from '../../components/Chip.astro';
import Term from '../../components/Term.astro';
import StatusChart from '../../components/StatusChart.astro';
import JudgeMatrix from '../../components/JudgeMatrix.astro';
import TrendChart from '../../components/TrendChart.astro';
import ThemeTiles from '../../components/ThemeTiles.astro';
import ShareBox from '../../components/ShareBox.astro';
import Toc from '../../components/Toc.astro';
import SeikaKey from '../../components/SeikaKey.astro';
import KihonRow from '../../components/KihonRow.astro';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, RATE_BINS, statusOf, rateBin, countBy,
  getKihonList, getShisakuList, getTorikumi, getSeika, getShuyouStatus, getSeikaGroups, amountEntries,
} from '../../lib/data.ts';
import type { SeikaRow as SeikaRowT, TorikumiRow } from '../../lib/types.ts';
import { getThemes } from '../../lib/themes.ts';
import { band, fmt, pct, yen } from '../../lib/format.ts';
import { futureDescription } from '../../lib/describe.ts';
import { futureHead } from '../../lib/heads.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['future/[id]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { v } = Astro.props;
const pre = `${v.id}-`;
const statusKeys = STATUSES.map((s) => s.key);
const binKeys = RATE_BINS.map((b) => b.key);
const kihon = getKihonList().filter((k) => k.shouraizou === v.id);
const shisaku = getShisakuList().filter((s) => s.shouraizou === v.id);
const tori = getTorikumi(LATEST).filter((t) => t.shisaku_id.startsWith(pre));
const seika = getSeika(LATEST).filter((s) => s.shisaku_id.startsWith(pre));
const isOk = (t: TorikumiRow) => t.status === '順調';
const reached = (s: SeikaRowT) => rateBin(s) === '100%以上';
const toriOk = tori.filter(isOk).length;
const seikaOk = seika.filter(reached).length;
// 最新の年度の数（ページの説明文・SNS のカードの画像と同じ数。lib/heads.ts）
const head = futureHead(v.id);
const judgeCounts = head.judges;

// 主要指標の達成状況（県の概要版の表の順。読めない年度は空）。基本施策の行の中に置く
const shuyou = getShuyouStatus().filter((r) => r.kihon.shouraizou === v.id);

// 4年間の推移
const trend = YEARS.map((y) => {
  const t = getTorikumi(y).filter((x) => x.shisaku_id.startsWith(pre));
  const s = getSeika(y).filter((x) => x.shisaku_id.startsWith(pre));
  const aOk = t.filter(isOk).length;
  const bOk = s.filter(reached).length;
  return { y, a: (aOk / t.length) * 100, b: (bOk / s.length) * 100, aOk, aN: t.length, bOk, bN: s.length };
});
const torikumiRows = YEARS.map((y) => ({ label: yearLabel(y), sub: y <= 2024 ? '前期' : '中期', counts: countBy(getTorikumi(y).filter((x) => x.shisaku_id.startsWith(pre)), statusOf, statusKeys) }));
const seikaRows = YEARS.map((y) => ({ label: yearLabel(y), sub: y <= 2024 ? '前期' : '中期', counts: countBy(getSeika(y).filter((x) => x.shisaku_id.startsWith(pre)), rateBin, binKeys) }));

// 基本施策ごと。主要指標と、主な取組の進捗状況・成果指標の達成率の区分の棒を基本施策の名前の下に並べ、その基本施策の成果指標
// （最新の年度の報告にあるもの）の一覧は成果指標の行の下に畳む（components/KihonRow.astro）。
// 成果指標の棒と一覧は同じ行（年度をまたいだまとまりの最新の年度の行）から数える
const seikaGroups = getSeikaGroups().filter((r) => r.latest.year === LATEST && r.shisaku.shouraizou === v.id);
const kihonRows = kihon.map((k) => {
  const t = tori.filter((x) => x.shisaku_id.startsWith(`${k.id}-`));
  const rows = seikaGroups.filter((r) => r.shisaku.kihon_id === k.id);
  return {
    ...k,
    shuyou: shuyou.filter((r) => r.kihon.id === k.id),
    tori: { n: t.length, ok: t.filter(isOk).length, counts: countBy(t, statusOf, statusKeys) },
    seika: { n: rows.length, ok: rows.filter((r) => reached(r.latest)).length, counts: countBy(rows.map((r) => r.latest), rateBin, binKeys) },
    rows,
  };
});
// 棒の凡例はこの節に1回だけ（どれかの基本施策で使っている区分）
const toriLegend = STATUSES.filter((c) => kihonRows.some((k) => (k.tori.counts[c.key] || 0) > 0));
const seikaLegend = RATE_BINS.filter((c) => kihonRows.some((k) => (k.seika.counts[c.key] || 0) > 0));
// 「表で見る」は棒ごとに1つ（行は基本施策、列は区分）
const kihonTables = [
  { title: '主な取組の進捗状況', key: 'tori' as const, cats: toriLegend, unit: '件' },
  { title: '成果指標の達成率', key: 'seika' as const, cats: seikaLegend, unit: '指標' },
];

// くらしのテーマ（この将来像の施策が多い順）
const ids = new Set(shisaku.map((s) => s.id));
const themes = getThemes().map((t) => ({ ...t, n: t.ids.filter((id) => ids.has(id)).length })).filter((t) => t.n > 0).sort((a, b) => b.n - a.n);

// 予算（R7の決算見込額。同じ予算事業の重複を除いたもの）
const estimate = amountEntries(LATEST, 'estimate');
const budget = estimate.filter((e) => e.shisaku_id.startsWith(pre)).reduce((s, e) => s + e.amount, 0);
const budgetAll = estimate.reduce((s, e) => s + e.amount, 0);
---
<Base title={`将来像${v.id} ${v.name}`} description={futureDescription(v.id, v.name, head)} ogType="article">
  <Crumbs items={[{ href: '/future/', label: '5つの将来像' }, { label: `将来像${v.id}` }]} />

  <header class:list={['sticker', 'lift', 'v-hero', `sz-${v.id}`]}>
    <Sz id={v.id} sr={false} class="hero-badge" />
    {/* 番号は印にあるので「将来像」の後ろの番号は読み上げだけ */}
    <div class="v-kicker"><span><Term word="将来像" /><span class="sr-only">{v.id}</span></span><span class="tag">{yearLong(LATEST)}の結果</span></div>
    <h1>{v.name}</h1>
    <HeadStats items={[
      { label: '基本施策', n: kihon.length, href: '#kihon' },
      { label: '施策', n: shisaku.length, href: `/shisaku/?s=${v.id}` },
    ]} />
    <div class="donuts">
      <DonutCard plain frac={toriOk / tori.length} label={`主な取組のうち順調 ${pct(toriOk, tori.length)}`} more={{ href: `/torikumi/?s=${v.id}`, label: '取組をさがす' }}>
        <span class="nw">県の活動は、</span><span class="nw">計画どおりに</span><span class="nw">進んだ？</span>
        <Fragment slot="sub"><Term word="主な取組" />のうち「順調」<span class="dc-n">{fmt(toriOk)} / {fmt(tori.length)}件</span></Fragment>
      </DonutCard>
      <DonutCard plain frac={seikaOk / seika.length} label={`成果指標のうち計画値に到達 ${pct(seikaOk, seika.length)}`} more={{ href: `/shihyou/?s=${v.id}`, label: '成果指標をさがす' }}>
        <span class="nw">くらしや地域は、</span><span class="nw">計画どおりに</span><span class="nw">変わった？</span>
        <Fragment slot="sub"><Term word="成果指標" />のうち<Term word="計画値" />に到達<span class="dc-n">{fmt(seikaOk)} / {fmt(seika.length)}指標</span></Fragment>
      </DonutCard>
    </div>
  </header>

  <Toc
    links={[
      { href: '#kihon', label: '基本施策' },
      { href: '#judge-h', label: '施策の判定' },
      { href: '#trend-h', label: '4年間の推移' },
      { href: '#theme-h', label: 'くらしのテーマ' },
      { href: '#yosan-h', label: '予算' },
    ]}
    head={{ kind: '将来像', sz: v.id, title: v.name }}
  />

  <section aria-labelledby="kihon">
    <h2 id="kihon" class="anchor">基本施策ごとの進み具合</h2>
    <p class="small secondary lead">基本施策ごとに、くらしや地域の変化をはかる<Term word="主要指標" />と、県の活動（主な取組）・成果指標の進み具合を見られます。</p>
    {/* 凡例は5つの将来像のページと同じく、線と影のない白い地の小さな箱に1回だけ。棒の右の割合は、凡例の最初の区分（順調・100%以上）の割合 */}
    <div class="legend-box">
      {shuyou.length > 0 && <SeikaKey mini plan={false} goal rate="shuyou" of="主要指標の" />}
      <div class="lg"><span class="legend-l">主な取組の<Term word="進捗状況" />:</span><ul class="legend" aria-label="主な取組の棒の凡例">{toriLegend.map((c) => <li><Chip tone={c.tone} text={c.key} title={c.note} /></li>)}</ul></div>
      <div class="lg"><span class="legend-l">成果指標の<Term word="達成率" />:</span><ul class="legend" aria-label="成果指標の棒の凡例">{seikaLegend.map((c) => <li><Chip tone={c.tone} text={c.key} title={c.note} /></li>)}</ul></div>
    </div>
    <ul class="row-list k-list">
      {kihonRows.map((k) => <KihonRow kihon={k} shuyou={k.shuyou} tori={k.tori} seika={k.seika} seikaRows={k.rows} />)}
    </ul>
    {shuyou.length > 0 && <p class="small secondary">主要指標の{yearLabel(LATEST)}の値と達成率は県の概要版、それより前の値は総括報告書の付属資料のものです（基本施策のページは付属資料の値で、書き方や値が少し違うものがあります）。{shuyou.some((r) => r.revised) && '※は、統計の基準改定にあわせて県が試算し直した基準値・目標値です。'}<a href="/shihyou/shuyou/">主要指標の一覧</a>で、ほかの将来像の指標も見られます。</p>}
    <details class="k-table">
      <summary>表で見る</summary>
      {kihonTables.map((t) => (
        <div class="table-wrap">
          <table>
            <caption>{t.title}（{t.unit}）</caption>
            <thead><tr><th>基本施策</th>{t.cats.map((c) => <th class="num">{c.key}</th>)}<th class="num">計</th></tr></thead>
            <tbody>
              {kihonRows.map((k) => (
                <tr>
                  <th class="k-th">{k.name}</th>
                  {t.cats.map((c) => <td class="num">{fmt(k[t.key].counts[c.key] || 0)}<br /><small class="secondary">{pct(k[t.key].counts[c.key] || 0, k[t.key].n)}</small></td>)}
                  <td class="num">{fmt(k[t.key].n)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </details>
  </section>

  <section aria-labelledby="judge-h">
    <h2 id="judge-h" class="anchor">施策の判定</h2>
    <p class="small secondary lead">施策の<Term word="推進状況" label="判定" />（A〜G）は、主な取組の「順調」の割合と成果指標の<Term word="達成率" />をもとに、沖縄県が毎年評価しています。</p>
    <JudgeMatrix counts={judgeCounts} caption={`将来像${v.id}の${fmt(shisaku.length)}施策`} hrefOf={(k) => `/shisaku/?s=${v.id}&judge=${k}`} />
  </section>

  <section aria-labelledby="trend-h">
    <h2 id="trend-h" class="anchor">4年間の推移</h2>
    <p class="small secondary lead">この4年、主な取組の「順調」は{band(trend.map((p) => p.a))}、計画値に届いた成果指標は{band(trend.map((p) => p.b))}で推移しています。</p>
    <figure class="sticker">
      <figcaption>
        <div class="chart-title">「順調」の取組と、計画値に届いた成果指標の割合</div>
      </figcaption>
      <TrendChart points={trend} />
      <details>
        <summary>表で見る</summary>
        <div class="table-wrap">
          <table>
            <thead><tr><th>年度</th><th class="num">主な取組</th><th class="num">うち順調</th><th class="num">成果指標</th><th class="num">うち計画値に到達</th></tr></thead>
            <tbody>
              {trend.map((p) => (
                <tr>
                  <th>{yearLong(p.y)}（{p.y <= 2024 ? '前期' : '中期'}）</th>
                  <td class="num">{fmt(p.aN)}</td><td class="num">{fmt(p.aOk)}（{p.a.toFixed(1)}%）</td>
                  <td class="num">{fmt(p.bN)}</td><td class="num">{fmt(p.bOk)}（{p.b.toFixed(1)}%）</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </figure>
    <details class="breakdown">
      <summary>内訳を見る（進捗状況・達成率の区分ごと）</summary>
      <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={torikumiRows} />
      <StatusChart title="成果指標の達成状況" categories={RATE_BINS} rows={seikaRows} unit="指標" />
    </details>
  </section>

  <section aria-labelledby="theme-h">
    <h2 id="theme-h" class="anchor">くらしのテーマで見る<span class="own">このサイト独自の分類</span></h2>
    <p class="small secondary lead">将来像{v.id}の施策が、くらしのどの分野にかかわるかを、施策の数で見られます。</p>
    <ThemeTiles items={themes.map((t) => ({ id: t.id, label: t.label, href: `/shisaku/?s=${v.id}&theme=${t.id}`, n: t.n }))} unit="施策" />
  </section>

  <section aria-labelledby="yosan-h">
    <h2 id="yosan-h" class="anchor">予算</h2>
    <div class="sticker budget">
      <div class="tile-label">将来像{v.id}の主な取組に書かれた予算事業（決算見込額）</div>
      <div class="tile-value">{yen(budget)}</div>
      <Chunk frac={budgetAll ? budget / budgetAll : 0} tone="none" label={`主な取組の予算事業全体の${pct(budget, budgetAll)}`} thin />
      <div class="tile-sub">主な取組の予算事業全体（{yen(budgetAll)}）の{pct(budget, budgetAll)}です。同じ予算事業の重複を除いています。</div>
      <a class="b-more" href="/yosan/">予算と財源を見る<span aria-hidden="true"> →</span></a>
    </div>
  </section>

  <ShareBox kind="将来像" name={`${v.id} ${v.name}`} />
</Base>

<style>
  /* 頭。PC は番号の印を左に大きく置き、右に「将来像」・名前・件数の札。スマホは印を小さくして「将来像」の行に並べ、名前を全幅にする。
     ドーナツのカードはトップのヒーローと同じく頭の中に置く */
  .v-hero {
    display: grid; grid-template-columns: 76px minmax(0, 1fr); grid-template-areas: "badge kicker" "badge name" "badge stats" "donuts donuts";
    gap: 0 18px; align-items: center; margin-top: 12px; background: var(--szw);
  }
  .v-hero :global(.hero-badge) { grid-area: badge; width: 76px; height: 76px; font-size: 2.2rem; border-width: 3px; box-shadow: 3px 3px 0 var(--shadow); }
  .v-kicker { grid-area: kicker; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-family: var(--font-display); font-weight: 700; color: var(--ink-2); }
  .v-hero h1 { grid-area: name; margin: 4px 0 10px; }
  .v-hero :global(.head-stats) { grid-area: stats; }
  .v-hero .donuts { grid-area: donuts; }
  @media (max-width: 520px) {
    .v-hero { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "badge kicker" "name name" "stats stats" "donuts donuts"; column-gap: 10px; }
    .v-hero :global(.hero-badge) { width: 36px; height: 36px; font-size: 1.15rem; border-width: 2.5px; box-shadow: 2px 2px 0 var(--shadow); }
    .v-hero h1 { margin-top: 8px; }
  }

  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .breakdown { margin-top: 16px; }

  /* 凡例（5つの将来像のページの .legend-box と同じ形。主要指標の図・主な取組の棒・成果指標の棒の3行） */
  .legend-box { display: grid; gap: 4px; width: fit-content; max-width: 100%; margin: 12px 0 0 auto; padding: 6px 12px; background: var(--paper); border-radius: 12px; font-size: 0.8125rem; color: var(--ink-2); }
  .legend-box :global(.chart-key) { margin: 0; gap: 2px 12px; }
  .lg { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; }
  .legend { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 2px 12px; }
  .legend :global(.chip) { font-size: 0.75rem; gap: 4px; }
  @media (max-width: 640px) {
    .legend-box { margin-left: 0; padding: 6px 10px; }
    .legend-l { width: 100%; }
    .legend { gap: 2px 6px; }
    .legend :global(.chip) { font-size: 0.6875rem; gap: 2px; }
    .legend :global(.chip svg) { width: 10px; height: 10px; }
  }

  .k-list { margin-top: 12px; }

  .k-table { margin-top: 14px; }
  .k-table caption { text-align: left; font-weight: 700; padding: 12px 0 4px; }
  .k-table .k-th { white-space: normal; min-width: 12em; } /* 基本施策の名前は長いので折り返す */
  .k-table td small { font-size: 0.75rem; }

  .budget { display: grid; gap: 6px; }
  .b-more { justify-self: start; font-size: 0.875rem; font-weight: 700; }
</style>
