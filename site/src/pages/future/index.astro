---
import Base from '../../layouts/Base.astro';
import Tiers from '../../components/Tiers.astro';
import Sz from '../../components/Sz.astro';
import Term from '../../components/Term.astro';
import KeyBrief from '../../components/KeyBrief.astro';
import HeadStats from '../../components/HeadStats.astro';
import {
  LATEST, STATUSES, statusOf, countBy, getShouraizou, getKihonList, getShisakuList, getTorikumi, getSeika, getShuyouStatus,
} from '../../lib/data.ts';
import { fmt } from '../../lib/format.ts';
import { LINKS } from '../../lib/links.ts';
import ExtLink from '../../components/ExtLink.astro';

const kihon = getKihonList();
const shisaku = getShisakuList();
const tori = getTorikumi(LATEST);
const seika = getSeika(LATEST);
const shuyou = getShuyouStatus();
const statusKeys = STATUSES.map((s) => s.key);
// 基本施策ごとに、主要指標の達成率の札（報告書の順）と、主な取組の進捗状況の内訳の棒と「順調」の割合の2段（components/Tiers.astro。トップの将来像の行と同じ形）
const visions = getShouraizou().map((v) => {
  const t = tori.filter((x) => x.shisaku_id.startsWith(`${v.id}-`));
  const ss = shisaku.filter((s) => s.shouraizou === v.id);
  return {
    ...v,
    n: t.length,
    shisaku: ss.length,
    seika: seika.filter((x) => x.shisaku_id.startsWith(`${v.id}-`)).length,
    rows: kihon.filter((k) => k.shouraizou === v.id).map((k) => {
      const kt = t.filter((x) => x.shisaku_id.startsWith(`${k.id}-`));
      return {
        ...k,
        shuyou: shuyou.filter((r) => r.kihon.id === k.id),
        tori: { n: kt.length, ok: kt.filter((x) => x.status === '順調').length, counts: countBy(kt, statusOf, statusKeys) },
      };
    }),
  };
});
// 区分の一覧は凡例の箱にせず、行の「達成率」「順調」を押すと短い説明と一緒に出す（components/KeyBrief.astro。どれかの基本施策で使っている区分）
const statusUsed = statusKeys.filter((key) => visions.some((v) => v.rows.some((r) => (r.tori.counts[key] || 0) > 0)));
---
<Base title="5つの将来像" description={`新・沖縄21世紀ビジョンの5つの将来像と${fmt(kihon.length)}の基本施策の一覧です。基本施策ごとの主要指標の達成率と主な取組の進み具合を見られます。`}>
  <h1>5つの将来像</h1>
  <p class="secondary lead">
    「<ExtLink href={LINKS.kihonKeikaku} after="」">新・沖縄21世紀ビジョン</ExtLink>は、めざす沖縄の姿を5つの<Term word="将来像" />に分け、そのもとに{fmt(kihon.length)}の<Term word="基本施策" />、さらに{fmt(shisaku.length)}の施策を置いています。施策ごとの成果指標と主な取組は、実施計画で決められています。
  </p>
  <KeyBrief kind="shuyou" used={shuyou.map((r) => r.bin)} />
  <KeyBrief kind="status" used={statusUsed} />
  {visions.map((v) => (
    <section class:list={['sticker', 'vision', `sz-${v.id}`]} id={`shouraizou-${v.id}`} aria-labelledby={`h-${v.id}`}>
      <h2 id={`h-${v.id}`} class="v-h"><a class:list={['sz-ribbon', `sz-${v.id}`]} href={`/future/${v.id}/`}><Sz id={v.id} sr={false} /><span class="v-nm"><span class="sr-only">将来像{v.id}　</span>{v.name}</span></a></h2>
      <div class="v-kihon sticker">
        <p class="v-kt">基本施策</p>
        <ul class="k-rows">
          {v.rows.map((k) => (
            <li class="k-r">
              <div class="k-n"><a class="name-link" href={`/kihon/${k.id}/`}>{k.name}</a> <span class="code-no">{k.code}</span></div>
              <Tiers class="k-t" shuyou={k.shuyou} tori={k.tori} context={k.name} tags />
            </li>
          ))}
        </ul>
      </div>
      <div class="v-stats">
        {/* 計画の階層（将来像 → 基本施策 → 施策・取組・成果指標）に合わせ、基本施策の図の下に置く。
            札は押すとその将来像で絞った一覧を開くので、何の札かを頭に1回だけ書く。並びはヘッダーのナビと同じ */}
        <span class="v-l">この将来像でさがす:</span>
        <HeadStats items={[
          { label: '施策', n: v.shisaku, href: `/shisaku/?s=${v.id}` },
          { label: '取組', n: v.n, href: `/torikumi/?s=${v.id}` },
          { label: '成果指標', n: v.seika, href: `/shihyou/?s=${v.id}` },
        ]} />
      </div>
    </section>
  ))}
</Base>

<style>
  .vision { margin-top: 24px; background: var(--szw); scroll-margin-top: 16px; }
  .v-h { margin: 0; font-size: 1.15rem; }
  .v-h .sz-ribbon { display: inline-flex; color: var(--ink); text-decoration: none; background: var(--paper); }
  /* 帯は将来像のページへのリンク。名前のリンク（.name-link）と同じく、名前に薄い下線を付け、乗せると黒く太くする（番号の印には付けない） */
  .v-nm { text-decoration-line: underline; text-decoration-color: var(--hair); text-decoration-thickness: 2px; }
  .v-h .sz-ribbon:hover .v-nm { text-decoration-color: var(--ink); text-decoration-thickness: 2.5px; }
  /* 基本施策の行。PC は名前の右に「主要指標 → 主な取組」の2段を置き、名前が何行にも折り返す幅では名前の下に置く（トップの将来像の行と同じ形） */
  .v-kihon { margin-top: 16px; padding-bottom: 8px; }
  .v-kt { margin: 0 0 4px; font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .k-rows { list-style: none; margin: 0; padding: 0; }
  .k-r { display: grid; grid-template-columns: minmax(0, 1fr) clamp(300px, 46%, 420px); gap: 8px 20px; align-items: center; padding: 12px 0; }
  .k-r + .k-r { border-top: 1.5px solid var(--hair); }
  .k-n { font-weight: 700; line-height: 1.5; }
  @media (min-width: 721px) { .k-n { font-size: 1.0625rem; } }
  @media (max-width: 720px) {
    .k-r { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }
  .v-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 14px; }
  .v-l { font-size: 0.875rem; font-weight: 700; color: var(--ink-2); }
  /* 言葉と札を1つの並びで折り返す。スマホでは言葉を1行目に置き、札3つを2行目に1行で並べる（札が1つだけ言葉の横に残らないように） */
  .v-stats :global(.head-stats) { display: contents; }
  @media (max-width: 520px) {
    .v-stats { gap: 6px; }
    .v-l { width: 100%; }
    .v-stats :global(.head-stats a) { padding: 2px 10px; gap: 4px; font-size: 0.875rem; }
    .v-stats :global(.head-stats b) { font-size: 1.05rem; }
  }
</style>
