---
// 主な取組1件のページ。年度をまたいで同じ名前の取組をまとめ、総括報告書（進捗）と部局の検証票（予算・活動・検証・改善案）を並べる。
// 頭は親の施策の札の下にぶら下げる。①いまの状態（進捗・活動指標・予算・対応する成果指標） ②活動指標の計画と実績（図。年度別計画のこの先の年度も置く） ③予算の推移 ④年度ごとの PDCA。表と原文は畳む
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../../layouts/Base.astro';
import Chip from '../../../components/Chip.astro';
import Icon from '../../../components/Icon.astro';
import Chunk from '../../../components/Chunk.astro';
import Stamps from '../../../components/Stamps.astro';
import Term from '../../../components/Term.astro';
import Sz from '../../../components/Sz.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ThemeTags from '../../../components/ThemeTags.astro';
import IkenBox from '../../../components/IkenBox.astro';
import KatsudouChart from '../../../components/KatsudouChart.astro';
import { themeIdsOfItem } from '../../../lib/themes.ts';
import { JUDGE_UI } from '../../../lib/icons.ts';
import {
  YEARS, LATEST, yearLabel, yearLong, judgeOf, statusOf, toneOfStatus, getTorikumiGroups, torikumiSlug, budgetOf, fundOf,
  deptHref, sourceLink, seikaHrefByName, renameCandidates, repostsOf, firstYearOf, AMOUNT_KINDS, rateBin, RATE_BINS, activityRuns, activityAchievement,
  type TorikumiGroup, type ActivityRun,
} from '../../../lib/data.ts';
import { yen } from '../../../lib/format.ts';
import ExtLink from '../../../components/ExtLink.astro';
import { KANKO, kankoOfPdca, kankoShisakuHref } from '../../../lib/plans.ts';
import type { Tone } from '../../../lib/icons.ts';
import type { AmountKind, BudgetAmountRow } from '../../../lib/types.ts';

export function getStaticPaths() {
  return getTorikumiGroups().map((g) => ({ params: { shisaku: g.shisaku.id, slug: torikumiSlug(g.key) }, props: { g } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { g } = Astro.props;
const s = g.shisaku;
const t = g.latest;
const yearsDesc = [...YEARS].reverse();
const present = yearsDesc.filter((y) => g.years[y]);
const first = firstYearOf(g);
// 年度×部局票の記載（無い年度は undefined）
const recs = Object.fromEntries(present.map((y) => [y, budgetOf(y, s.id, g.key)]));
const latestRec = present.map((y) => recs[y]).find(Boolean);
const tr = recs[t.year];
const seikaName = latestRec?.seika_name;
const seikaHref = seikaName && seikaHrefByName(s.id, seikaName);
// 対応する成果指標の最新の達成率（名前の空白・記号の違いは無視して施策の成果指標から探す）
const norm = (v: string | null | undefined) => (v || '').normalize('NFKC').replace(/[\s・･、，,。.（）()「」『』〔〕]/g, '');
const seikaRow = seikaName && s.seika.filter((x) => x.year === LATEST).find((x) => { const a = norm(x.name); const b = norm(seikaName); return a === b || a.includes(b) || b.includes(a); });
const seikaTone = seikaRow ? RATE_BINS.find((b) => b.key === rateBin(seikaRow))?.tone : undefined;
const seikaRate = seikaRow && (seikaRow.rate != null ? `達成率 ${seikaRow.rate}%` : seikaRow.rate_raw || '達成率なし');
const candidates = renameCandidates(g);
const reposts = repostsOf(g);
// 観光ロードマップ（個別計画）でも主な取組として評価されているか（同じ年度に同じ名前の取組）
const rm = kankoOfPdca(s.id, g.key);
const okUrl = (u: string | null | undefined) => /^https?:\/\/\S+$/.test(u || '');
const amount = (r: BudgetAmountRow, kind: AmountKind) => {
  const v = r[kind];
  const text = v != null ? yen(v) : r[`${kind}_raw`] || '—';
  return r.suspect?.includes(kind) ? `${text}（桁の誤記の疑い）` : text;
};
const KINDS: AmountKind[] = ['settled', 'estimate', 'initial'];
// 報告に載っている年度の範囲（「R4〜R6」「R7」）
const span = (x: TorikumiGroup) => (firstYearOf(x) === x.latest.year ? yearLabel(x.latest.year) : `${yearLabel(firstYearOf(x))}〜${yearLabel(x.latest.year)}`);
const secHref = deptHref(t.section);
const stamps = YEARS.map((y) => (g.years[y] ? { year: y, tone: toneOfStatus(statusOf(g.years[y])), text: statusOf(g.years[y]) } : { year: y, tone: null, text: '報告なし' }));
const latestStatus = statusOf(t);
const latestTone = toneOfStatus(latestStatus);
// 親の施策の判定（施策の判定だけを丸いハンコで出し、取組の進捗状況は横長の札で出して見分ける）
const pj = judgeOf(s.judges[LATEST]);

const toneOfPct = (p: number): Tone => (p >= 90 ? 'good' : p >= 75 ? 'warning' : p >= 60 ? 'serious' : 'critical');
const latestAch = activityAchievement(g, t.year);
// 活動指標の計画と実績。活動指標が途中で変わった取組は、活動指標ごとに図と表を分ける（新しい活動指標が先）
const runs = activityRuns(g);
const runSpan = (run: ActivityRun) => {
  const ys = run.years.filter((r) => !r.future).map((r) => r.y);
  return ys.length > 1 ? `${yearLabel(ys[0])}〜${yearLabel(ys[ys.length - 1])}` : yearLabel(ys[0]);
};
const futureText = (run: ActivityRun) => run.years.filter((r) => r.future).map((r) => yearLabel(r.y)).join('・');

// 予算の推移。各報告に前年度の決算額・その年度の決算見込額・翌年度の当初予算額が載っているので、年度ごとに確定に近い金額（決算 → 決算見込 → 当初予算）を選ぶ。
// 1つの取組に予算事業が複数あるときは合計する（桁の誤記の疑いがある金額は入れない）
const byFy = new Map<number, { fy: number; rank: number; kind: AmountKind; amount: number; report: number }>();
for (const y of present) {
  const b = recs[y];
  if (!b?.budgets?.length) continue;
  for (const kind of KINDS) {
    const fy = y + AMOUNT_KINDS[kind].offset;
    const vals = b.budgets.flatMap((blk) => blk.rows).flatMap((r) => {
      const v = r[kind];
      return v != null && !r.suspect?.includes(kind) ? [v] : [];
    });
    if (!vals.length) continue;
    const rank = KINDS.indexOf(kind);
    const cur = byFy.get(fy);
    if (!cur || rank < cur.rank) byFy.set(fy, { fy, rank, kind, amount: vals.reduce((a, v) => a + v, 0), report: y });
  }
}
const budgetSeries = [...byFy.values()].sort((a, b) => a.fy - b.fy);
const budgetMax = Math.max(1, ...budgetSeries.map((x) => x.amount));
const latestBudget = byFy.get(t.year);
const latestEstimate = latestBudget?.kind === 'estimate' ? latestBudget.amount : null;
const budgetNames = [...new Set(present.flatMap((y) => (recs[y]?.budgets || []).map((b) => b.name)).filter(Boolean))];
const funds = [...new Set(present.flatMap((y) => (recs[y]?.budgets || []).flatMap((b) => b.rows.map((r) => fundOf(r.source || r.source_next)))))];
---
<Base title={`${t.name}（主な取組）`} description={`沖縄県PDCA: 主な取組「${t.name}」の令和4〜7年度の進捗状況・予算・県の検証と改善案`}>
  <Crumbs items={[{ href: '/', label: 'トップ' }, { href: `/future/${s.shouraizou}/`, label: `将来像${s.shouraizou}`, sz: s.shouraizou }, { href: `/shisaku/${s.id}/`, label: s.name }, { label: t.name }]} />

  <a class:list={['parent', `sz-${s.shouraizou}`]} href={`/shisaku/${s.id}/`}>
    <span class="p-kind">この取組が入っている施策</span>
    <span class="code-no code-corner" title="県の報告書での番号">施策 {s.code}</span>
    <span class="p-row">
      <span class:list={['jstamp', `tone-${pj ? pj.tone : 'blank'}`, pj && JUDGE_UI[pj.key].hatch && 'hatch']} aria-hidden="true">{pj ? <><Icon tone={pj.tone} shape={JUDGE_UI[pj.key].shape} size={9} />{pj.key}</> : '—'}</span>
      <span class="p-name"><Sz id={s.shouraizou} />{s.name}</span>
      <span class="p-judge">{pj ? `${yearLabel(LATEST)}の県の判定 ${pj.key} ${pj.label}` : `${yearLabel(LATEST)}の県の判定なし`}</span>
    </span>
  </a>

  <header class="sticker lift head">
    <div class="kind"><Term word="主な取組" /></div>
    <h1>{t.name}</h1>
    <div class="meta">
      <span>所管: {secHref ? <a class="sub-link" href={secHref}>{t.section}</a> : t.section}</span>
      {latestRec?.actor && <span>実施主体: {latestRec.actor.replace(/,/g, '・')}</span>}
      <ThemeTags ids={themeIdsOfItem(s.id, t.name)} />
      {rm.length > 0 && <a class="plan-tag" href="#rm">{KANKO.short}でも評価</a>}
    </div>
    <div class="now inset">
      <div class="now-l">
        <span class:list={['now-pill', `tone-${latestTone}`]}><Icon tone={latestTone} size={16} />{latestStatus}</span>
        <span class="now-sb">{yearLong(t.year)}の<Term word="進捗状況" /></span>
      </div>
      <div class="now-years">
        <span class="now-yl">4年間</span>
        <Stamps items={stamps} label="4年間の進捗状況" size="small" />
      </div>
    </div>
    {latestRec?.activity && (
      <div class="bubble-row says">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <div class="small secondary label">ひとことで言うと（検証票の「取組内容」から）</div>
          <p class="first">{latestRec.activity}</p>
        </div>
      </div>
    )}
  </header>

  <div class="facts">
    <div class="sticker fact">
      <div class="tile-label"><Term word="活動指標" />（{yearLabel(t.year)}）</div>
      <div class="f-name">{t.indicator || tr?.indicator_name || '—'}</div>
      <div class="f-vals">計画 <b>{t.target || '—'}</b> → 実績 <b>{t.actual || '—'}</b></div>
      {latestAch && (
        <>
          <Chunk frac={latestAch.pct / 100} tone={toneOfPct(latestAch.pct)} label={`活動指標の達成割合 ${latestAch.text}`} />
          <div class="tile-sub">達成割合 {latestAch.text}{latestAch.pct >= 100 && '　計画クリア'}</div>
        </>
      )}
      <a class="small" href="#katsudou">計画と実績の推移を見る</a>
    </div>
    <div class="sticker fact">
      <div class="tile-label">予算（{yearLabel(t.year)}の決算見込額）</div>
      <div class="tile-value">{latestEstimate != null ? yen(latestEstimate) : yen(t.budget)}</div>
      <div class="tile-sub">{budgetNames.length ? `予算事業: ${budgetNames.slice(0, 2).join('、')}${budgetNames.length > 2 ? ' ほか' : ''}` : latestEstimate == null ? '総括報告書の値' : ''}{funds.length > 0 && `（${funds.join('・')}）`}</div>
      <a class="small" href="#yosan">予算の推移を見る</a>
    </div>
    <div class="sticker fact">
      <div class="tile-label">対応する<Term word="成果指標" /></div>
      {seikaName ? (
        <>
          <div class="f-name">{seikaHref ? <a class="name-link" href={seikaHref}>{seikaName}</a> : seikaName}</div>
          {seikaRate && <Chip tone={seikaTone} text={`${seikaRate}（${yearLabel(LATEST)}）`} />}
          <div class="tile-sub">この取組で成果を出そうとしている、施策の成果指標です。</div>
        </>
      ) : <div class="tile-sub">部局の検証票に、対応する成果指標の記載がありません。</div>}
    </div>
  </div>

  <nav class="toc" aria-label="このページの内容">
    <div class="toc-links" data-scroll-hint>
      <a href="#katsudou">活動指標</a>
      <a href="#yosan">予算</a>
      <a href="#pdca">活動と検証</a>
      {rm.length > 0 && <a href="#rm">{KANKO.short}</a>}
      <a href="#source">出典</a>
    </div>
    <button type="button" class="button" data-open-all="#main" aria-pressed="false" hidden>すべて開く</button>
  </nav>

  {(t.year !== LATEST || first !== YEARS[0]) && (
    <div class="bubble-row notice-row">
      <span class="avatar" aria-hidden="true">!</span>
      <div class="bubble">
        {t.year !== LATEST && <p><strong>{yearLabel(t.year + 1)}の報告には、この名前の取組はありません。</strong>終わったか、名前が変わった可能性があります。</p>}
        {first !== YEARS[0] && <p><strong>{yearLabel(first)}の報告から載っている取組です。</strong></p>}
        {candidates.length > 0 && (
          <>
            <p class="small">関係がありそうな取組（同じ施策で、この取組の前後の年度に載っているもの。名前の変更や、取組の分割・統合の可能性があります）:</p>
            <ul class="cands">
              {candidates.map((c) => (
                <li>
                  <a class="cand" href={c.group.href}>
                    <span class="c-name">{c.group.latest.name}</span>
                    <span class="small secondary">{span(c.group)}・この取組の{c.after ? '後' : '前'}。{c.shared.length ? `同じ予算事業「${c.shared[0]}」` : '名前が似ている'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="small secondary">年度をまたいだ取組の同一性は名前で判断しています（<a href="/about/#kazoekata">データについて</a>）。</p>
      </div>
    </div>
  )}

  <section aria-labelledby="katsudou">
    <h2 id="katsudou" class="anchor">活動指標の計画と実績</h2>
    <p class="small secondary lead">実績が、その年度の計画の90%以上なら<Term word="進捗状況" />は「順調」です。</p>
    {runs.some((r) => r.chart) && (
      <ul class="chart-key" aria-hidden="true">
        <li><span class="k-path"></span><span class="k-ring"></span>計画</li>
        <li><span class="k-dot" style="--k:var(--pop)"></span>実績</li>
      </ul>
    )}
    {runs.map((run, i) => (
      <div class="sticker kcard">
        {runs.length > 1 && <div class="k-span">{runSpan(run)}の活動指標{i === 0 ? '（いまの活動指標）' : ''}</div>}
        <h3 class="k-name">{run.indicator || '活動指標の記載なし'}{run.unit && <span class="secondary small">（{run.unit}）</span>}</h3>
        <KatsudouChart run={run} here={i > 0 ? '' : t.year === LATEST ? 'いまここ' : '最後の報告'} />
        {run.cumulative && <p class="small secondary note">図は、かっこの前に書かれたその年度の数で描いています（かっこの中は累計や内訳）。</p>}
        {run.skipped && <p class="small secondary note">数で書かれていない値は、図に入れていません。</p>}
        {run.planFrom && <p class="small secondary note">{futureText(run)}の計画は、{run.planFrom}の記載です。</p>}
        <details open={!run.chart}>
          <summary>{run.chart ? '表で見る' : '年度ごとの計画と実績'}</summary>
          <div class="table-wrap">
            <table class="progress stack">
              <caption class="sr-only">{run.indicator}の年度ごとの計画と実績</caption>
              <thead>
                <tr><th>年度</th><th>進捗状況</th><th class="num">計画</th><th class="num">実績</th><th class="num">達成割合</th></tr>
              </thead>
              <tbody>
                {[...run.years].reverse().map((r) => (
                  <tr>
                    <th>{yearLabel(r.y)}{r.future && <><br /><small class="secondary">年度別計画</small></>}</th>
                    <td class="span2">{r.future ? <span class="small secondary">これから</span> : <Chip tone={toneOfStatus(r.status)} text={r.status} />}</td>
                    <td class="num" data-label="計画">{r.plan_raw || '—'}</td>
                    <td class="num" data-label="実績">{r.future ? '—' : <b>{r.actual_raw || '—'}</b>}</td>
                    <td class="num" data-label="達成割合">{r.ach || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    ))}
    {latestRec && okUrl(latestRec.url) && <p class="small">関連ページ: <ExtLink href={latestRec.url}>{latestRec.url}</ExtLink></p>}
  </section>

  <section aria-labelledby="yosan">
    <h2 id="yosan" class="anchor">予算の推移</h2>
    <p class="small secondary lead">年度ごとに、確定に近い金額（決算額 → 決算見込額 → 当初予算額）を出しています。</p>
    {budgetSeries.length > 0 ? (
      <div class="sticker">
        <ul class="bud">
          {budgetSeries.map((b) => (
            <li class:list={[b.kind]}>
              <span class="bud-y">{yearLabel(b.fy)}<small>{AMOUNT_KINDS[b.kind].label}</small></span>
              <span class="bud-track"><span class="bud-bar" style={`width:${(b.amount / budgetMax) * 100}%`} aria-hidden="true"></span><span class="bud-v big">{yen(b.amount)}</span></span>
            </li>
          ))}
        </ul>
        <p class="small secondary bud-key"><span class="k k-settled"></span>決算額 <span class="k k-estimate"></span>決算見込額 <span class="k k-initial"></span>当初予算額{budgetNames.length > 1 && `　／　${budgetNames.length}つの予算事業の合計`}</p>
      </div>
    ) : <p class="secondary">部局の検証票に、この取組の金額の記載がありません。</p>}
    <p class="small secondary">1つの予算事業が複数の取組に重ねて書かれていることがあり、その場合は取組だけに使われた金額ではありません（<a href="/yosan/">予算と財源</a>では重複を除いて集計しています）。</p>
    <details>
      <summary>報告ごとの予算事業と金額を表で見る</summary>
      <div class="table-wrap">
        <table class="budget stack">
          <thead>
            <tr>
              <th>報告</th><th>予算事業</th><th>財源</th>
              {KINDS.map((k) => <th class="num">{AMOUNT_KINDS[k].label}</th>)}
            </tr>
          </thead>
          <tbody>
            {present.flatMap((y) => {
              const b = recs[y];
              const yl = (k: AmountKind) => yearLabel(y + AMOUNT_KINDS[k].offset);
              if (!b?.budgets.length) {
                return [<tr><th>{yearLabel(y)}</th><td colspan="5" class="small secondary wide">部局の検証票が手に入っていません。総括報告書の決算見込額: {yen(g.years[y].budget)}{g.years[y].budget == null && g.years[y].budget_raw ? `（${g.years[y].budget_raw}）` : ''}</td></tr>];
              }
              return b.budgets.flatMap((blk, i) =>
                (blk.rows.length ? blk.rows : [null]).map((r, j) => (
                  <tr class={i > 0 && j === 0 ? 'sep' : ''}>
                    <th>{i === 0 && j === 0 ? yearLabel(y) : ''}</th>
                    <td class="wide name">{j === 0 ? (blk.name || '—') : ''}{j === 0 && blk.name_next && blk.name_next !== blk.name && <><br /><small class="secondary">翌年度: {blk.name_next}</small></>}</td>
                    <td class="small wide" data-label="財源">{r ? fundOf(r.source || r.source_next) : '—'}</td>
                    {KINDS.map((k) => <td class="num" data-label={AMOUNT_KINDS[k].label}>{r ? amount(r, k) : '—'}<br /><small class="secondary">{yl(k)}</small></td>)}
                  </tr>
                )),
              );
            })}
          </tbody>
        </table>
      </div>
      {present.some((y) => recs[y]?.matchedByName) && (
        <p class="small secondary">この取組は、部局の検証票では別の施策に載っているため、名前で結び付けて表示しています。</p>
      )}
    </details>
  </section>

  <section aria-labelledby="pdca">
    <h2 id="pdca" class="anchor">年度ごとの活動と検証</h2>
    <p class="small secondary lead">部局の検証票の記載をそのまま載せています。P は前年度の改善案の反映、D は活動、C は県の検証、A は翌年度の改善案です。</p>
    {present.map((y) => {
      const r = g.years[y];
      const b = recs[y];
      const st = statusOf(r);
      const plansDone = (b?.improvements || []).filter((x) => (x.plan && !/^[―\-ー－]$/.test(x.plan.trim())) || x.result);
      const body = !b ? (
        <>
          <p class="small secondary">この年度の部局の検証票は手に入っていません（<a href="/yosan/#coverage">予算と財源</a>の「部局票がある範囲」）。総括報告書の活動概要を載せます。</p>
          {r.summary && <p class="prose">{r.summary}</p>}
        </>
      ) : (
        <ol class="flow">
          {plansDone.length > 0 && (
            <li class="step-p">
              <span class="badge" aria-hidden="true">P</span>
              <div class="flow-body">
                <h4>前年度に決めた改善案と、その反映</h4>
                <ul class="impr">
                  {plansDone.map((x) => (
                    <li class="inset">
                      {x.plan && !/^[―\-ー－]$/.test(x.plan.trim()) && <div class="impr-plan"><span class="tagline">改善案</span><span class="prose">{x.plan}</span></div>}
                      <div class="impr-res"><span class="tagline">反映</span><span class="prose">{x.result || '—'}</span></div>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          )}
          {(b.activity_done || b.basis) && (
            <li class="step-d">
              <span class="badge" aria-hidden="true">D</span>
              <div class="flow-body">
                {b.activity_done && <><h4>{yearLong(y)}にやったこと</h4><p class="prose">{b.activity_done}</p></>}
                {b.basis && <><h4>進捗の判定の根拠 <Chip tone={toneOfStatus(st)} text={st} /></h4><p class="prose">{b.basis}</p></>}
              </div>
            </li>
          )}
          {b.check?.length > 0 && (
            <li class="step-c">
              <span class="badge" aria-hidden="true">C</span>
              <div class="flow-body">
                <h4>県の検証（Check）</h4>
                <ul class="typed">{b.check.map((x) => <li><span class="type">{x.type}</span><span class="prose">{x.text}</span></li>)}</ul>
              </div>
            </li>
          )}
          {(b.action?.length > 0 || b.activity_next) && (
            <li class="step-a">
              <span class="badge" aria-hidden="true">A</span>
              <div class="flow-body">
                {b.action?.length > 0 && <><h4>{yearLabel(y + 1)}に向けた改善案（Action）</h4><ul class="typed">{b.action.map((x) => <li><span class="type">{x.type}</span><span class="prose">{x.text}</span></li>)}</ul></>}
                {b.activity_next && <><h4>{yearLong(y + 1)}の活動計画</h4><p class="prose">{b.activity_next}</p></>}
              </div>
            </li>
          )}
        </ol>
      );
      const src = b && sourceLink(b.source, b.do_page || b.page);
      return y === t.year ? (
        <div class="sticker cad latest">
          <h3 class="cad-h">{yearLong(y)}の報告 <Chip tone={toneOfStatus(st)} text={st} /></h3>
          {body}
          {src && <p class="small"><ExtLink href={src.href}>主な取組検証票（{src.label}）</ExtLink></p>}
        </div>
      ) : (
        <details class="sticker cad">
          <summary>{yearLong(y)}の報告 <Chip tone={toneOfStatus(st)} text={st} /></summary>
          {body}
          {src && <p class="small"><ExtLink href={src.href}>主な取組検証票（{src.label}）</ExtLink></p>}
        </details>
      );
    })}
  </section>

  {rm.length > 0 && (
    <section aria-labelledby="rm">
      <h2 id="rm" class="anchor">{KANKO.short}でも評価されています</h2>
      <p class="small secondary lead">県の観光の<a href="/keikaku/">個別計画</a>「{KANKO.name}」でも、同じ名前の主な取組が同じ区分で評価されています。</p>
      <ul class="row-list">
        {rm.map((x) => (
          <li>
            <div class="name-row"><span><span class="plan-tag">{KANKO.short}</span> <a class="name-link" href={kankoShisakuHref(x.rm)}>{x.rm.name}</a></span><span class="code-no">施策 {x.rm.code}</span></div>
            <div class="small secondary">
              {Object.values(x.row.years).sort((a, b) => a.year - b.year).map((r, k) => <>{k > 0 && '　'}{yearLabel(r.year)}: {statusOf(r)}</>)}
              {x.row.latest.name !== t.name && <>（観光ロードマップでの名前: {x.row.latest.name}）</>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {reposts.length > 0 && (
    <section aria-labelledby="repost">
      <h2 id="repost">同じ取組が載っている施策</h2>
      <p class="small secondary">総括報告書では、1つの取組が複数の施策に載っていることがあります（再掲）。</p>
      <ul class="reposts">
        {reposts.map((o) => <li><a class="tag" href={o.href}><Sz id={o.shisaku.shouraizou} />施策 {o.shisaku.name} <span class="code-no">{o.shisaku.code}</span></a></li>)}
      </ul>
    </section>
  )}

  <IkenBox kind="主な取組" name={t.name} />

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <ul class="small">
      {present.map((y) => {
        const r = g.years[y];
        const a = sourceLink(r.source, r.page);
        const b = recs[y] && sourceLink(recs[y].source, recs[y].page);
        return (
          <li>
            {yearLong(y)}: {a ? <ExtLink href={a.href}>総括報告書（{a.label}）</ExtLink> : '—'}
            {b ? <>、<ExtLink href={b.href}>主な取組検証票（{b.label}）</ExtLink></> : '、主な取組検証票なし'}
          </li>
        );
      })}
    </ul>
    <p class="small">この取組が入っている施策の、県の報告書での番号は<strong class="report-no">施策 {s.code}</strong>です。報告書の PDF では、この番号で探せます。</p>
    <p class="small"><a href={`/shisaku/${s.id}/#torikumi`}>施策「{s.name}」の主な取組の一覧</a></p>
  </section>
</Base>

