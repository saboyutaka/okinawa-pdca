---
// 主な取組1件のページ。年度をまたいで同じ名前の取組をまとめ、総括報告書（進捗）と部局の検証票（予算・活動・検証・改善案）を並べる
import Base from '../../../layouts/Base.astro';
import Chip from '../../../components/Chip.astro';
import Stamps from '../../../components/Stamps.astro';
import Term from '../../../components/Term.astro';
import Sz from '../../../components/Sz.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ThemeTags from '../../../components/ThemeTags.astro';
import { themeIdsOfItem } from '../../../lib/themes.js';
import {
  YEARS, LATEST, yearLabel, yearLong, statusOf, toneOfStatus, getTorikumiGroups, torikumiSlug, budgetOf, fundOf,
  deptHref, sourceLink, seikaHrefByName, renameCandidates, repostsOf, firstYearOf, AMOUNT_KINDS,
} from '../../../lib/data.js';
import { yen } from '../../../lib/format.js';

export function getStaticPaths() {
  return getTorikumiGroups().map((g) => ({ params: { shisaku: g.shisaku.id, slug: torikumiSlug(g.key) }, props: { g } }));
}

const { g } = Astro.props;
const s = g.shisaku;
const t = g.latest;
const yearsDesc = [...YEARS].reverse();
const present = yearsDesc.filter((y) => g.years[y]);
const first = firstYearOf(g);
// 年度×部局票の記載（無い年度は undefined）
const recs = Object.fromEntries(present.map((y) => [y, budgetOf(y, s.id, g.key)]));
const latestRec = present.map((y) => recs[y]).find(Boolean);
// 年度別計画は前期（R4〜R6）と中期（R7〜R9）で違う。計画期間ごとに最新の報告の記載を出す
const plans = new Map();
for (const y of present) {
  const b = recs[y];
  if (b?.plan?.length && !plans.has(b.plan_years.join())) plans.set(b.plan_years.join(), { years: b.plan_years, rows: b.plan, report: y });
}
const seikaName = latestRec?.seika_name;
const seikaHref = seikaName && seikaHrefByName(s.id, seikaName);
const candidates = renameCandidates(g);
const reposts = repostsOf(g);
const okUrl = (u) => /^https?:\/\/\S+$/.test(u || '');
const amount = (r, kind) => {
  const v = r[kind];
  const text = v != null ? yen(v) : r[`${kind}_raw`] || '—';
  return r.suspect?.includes(kind) ? `${text}（桁の誤記の疑い）` : text;
};
const KINDS = ['settled', 'estimate', 'initial'];
// 報告に載っている年度の範囲（「R4〜R6」「R7」）
const span = (x) => (firstYearOf(x) === x.latest.year ? yearLabel(x.latest.year) : `${yearLabel(firstYearOf(x))}〜${yearLabel(x.latest.year)}`);
const secHref = deptHref(t.section);
const stamps = YEARS.map((y) => (g.years[y] ? { year: y, tone: toneOfStatus(statusOf(g.years[y])), text: statusOf(g.years[y]) } : { year: y, tone: null, text: '報告なし' }));
---
<Base title={`${t.name}（主な取組）`} description={`沖縄県PDCA: 主な取組「${t.name}」の令和4〜7年度の進捗状況・予算・県の検証と改善案`}>
  <Crumbs items={[{ href: '/', label: 'トップ' }, { href: `/future/${s.shouraizou}/`, label: `将来像${s.shouraizou}`, sz: s.shouraizou }, { href: `/shisaku/${s.id}/`, label: `施策 ${s.code}` }, { label: t.name }]} />

  <header class="sticker head">
    <div class="code"><Sz id={s.shouraizou} /> <Term word="主な取組" />　／　施策 <a href={`/shisaku/${s.id}/`}>{s.code} {s.name}</a></div>
    <h1>{t.name}</h1>
    <div class="secondary small">
      所管: {secHref ? <a href={secHref}>{t.section}</a> : t.section}
      {seikaName && <>　／　対応する成果指標: {seikaHref ? <a href={seikaHref}>{seikaName}</a> : seikaName}</>}
    </div>
    <div class="tags"><ThemeTags ids={themeIdsOfItem(s.id, t.name)} /></div>
    <div class="head-years">
      <div class="small secondary label">4年間の<Term word="進捗状況" /></div>
      <Stamps items={stamps} label="4年間の進捗状況" />
    </div>
  </header>
    <nav class="toc" aria-label="このページの内容">
      <a href="#progress">進捗の推移</a>
      {latestRec && <a href="#plan">取組の概要</a>}
      <a href="#yosan">予算</a>
      <a href="#pdca">年度ごとの活動と検証</a>
      <a href="#source">出典</a>
      <button type="button" class="button" data-open-all="#main" aria-pressed="false" hidden>すべて開く</button>
    </nav>

  {(t.year !== LATEST || first !== YEARS[0]) && (
    <div class="notice">
      {t.year !== LATEST && <p>{yearLabel(t.year + 1)}の報告には、この名前の取組はありません。終わったか、名前が変わった可能性があります。</p>}
      {first !== YEARS[0] && <p>{yearLabel(first)}の報告から載っている取組です。</p>}
      {candidates.length > 0 && (
        <>
          <p>関係がありそうな取組（同じ施策で、この取組の前後の年度に載っているもの。名前の変更や、取組の分割・統合の可能性があります）:</p>
          <ul>
            {candidates.map((c) => (
              <li>
                <a href={c.group.href}>{c.group.latest.name}</a>
                <small>（{span(c.group)}・この取組の{c.after ? '後' : '前'}。{c.shared.length ? `同じ予算事業「${c.shared[0]}」` : '名前が似ている'}）</small>
              </li>
            ))}
          </ul>
        </>
      )}
      <p class="small">年度をまたいだ取組の同一性は名前で判断しています（<a href="/about/#kazoekata">データについて</a>）。</p>
    </div>
  )}

  <section aria-labelledby="progress">
    <h2 id="progress">進捗の推移</h2>
    <p class="small secondary">進捗状況は、活動指標（取組の活動の量をはかる指標）の実績が、その年度の計画に対してどこまで進んだかの県の判定です。</p>
    <div class="table-wrap">
      <table class="progress stack">
        <thead>
          <tr><th>報告年度</th><th>進捗状況</th><th>活動指標</th><th class="num">計画</th><th class="num">実績</th><th class="num">達成割合</th></tr>
        </thead>
        <tbody>
          {yearsDesc.map((y) => {
            const r = g.years[y];
            if (!r) return <tr><th>{yearLabel(y)}</th><td colspan="5" class="secondary small wide">この年度の報告に、この名前の取組はありません</td></tr>;
            return (
              <tr>
                <th>{yearLabel(y)}</th>
                <td class="span2"><Chip tone={toneOfStatus(statusOf(r))} text={statusOf(r)} /></td>
                <td class="small wide" data-label="活動指標">{r.indicator || '—'}</td>
                <td class="num" data-label="計画">{r.target || '—'}</td>
                <td class="num" data-label="実績">{r.actual || '—'}</td>
                <td class="num" data-label="達成割合">{recs[y]?.achievement || '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {latestRec && (
    <section aria-labelledby="plan">
      <h2 id="plan">取組の概要</h2>
      {latestRec.activity && <p class="prose">{latestRec.activity}</p>}
      <dl class="kv">
        <div><dt>実施主体</dt><dd>{latestRec.actor || '—'}</dd></div>
        <div><dt>所管課</dt><dd>{secHref ? <a href={secHref}>{t.section}</a> : t.section}</dd></div>
        {okUrl(latestRec.url) && <div class="wide"><dt>関連ページ</dt><dd><a href={latestRec.url} rel="noopener">{latestRec.url}</a></dd></div>}
      </dl>
      {[...plans.values()].map((p) => (
        <div class="table-wrap">
          <table class="plan">
            <caption>年度別計画（{p.years[0]}〜{p.years.at(-1)}。{yearLabel(p.report)}の報告の記載）</caption>
            <thead><tr><th>活動指標</th>{p.years.map((y) => <th class="num">{y}</th>)}</tr></thead>
            <tbody>
              {p.rows.map((r) => (
                <tr><td>{r.indicator || '—'}</td>{p.years.map((_, i) => <td class="num">{r.values[i] || '—'}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
      <p class="small secondary">「２箇所（４箇所）」のような表記は、その年度の目標（かっこ内は累計）です。</p>
    </section>
  )}

  <section aria-labelledby="yosan">
    <h2 id="yosan">予算事業と金額</h2>
    <p class="small secondary">
      各部局の検証票に書かれた、この取組の予算事業です。それぞれの報告に、前年度の決算額・その年度の決算見込額・翌年度の当初予算額が載っています。
      1つの予算事業が複数の取組に重ねて書かれていることがあり、その場合は取組だけに使われた金額ではありません（<a href="/yosan/">予算と財源</a>では重複を除いて集計しています）。
    </p>
    <div class="table-wrap">
      <table class="budget stack">
        <thead>
          <tr>
            <th>報告</th><th>予算事業</th><th>財源</th>
            {KINDS.map((k) => <th class="num">{AMOUNT_KINDS[k].label}</th>)}
          </tr>
        </thead>
        <tbody>
          {present.flatMap((y) => {
            const b = recs[y];
            const yl = (k) => yearLabel(y + AMOUNT_KINDS[k].offset);
            if (!b?.budgets.length) {
              return [<tr><th>{yearLabel(y)}</th><td colspan="5" class="small secondary wide">部局の検証票が手に入っていません。総括報告書の決算見込額: {yen(g.years[y].budget) }{g.years[y].budget == null && g.years[y].budget_raw ? `（${g.years[y].budget_raw}）` : ''}</td></tr>];
            }
            return b.budgets.flatMap((blk, i) =>
              (blk.rows.length ? blk.rows : [null]).map((r, j) => (
                <tr class={i > 0 && j === 0 ? 'sep' : ''}>
                  <th>{i === 0 && j === 0 ? yearLabel(y) : ''}</th>
                  <td class="wide name">{j === 0 ? (blk.name || '—') : ''}{j === 0 && blk.name_next && blk.name_next !== blk.name && <><br /><small class="secondary">翌年度: {blk.name_next}</small></>}</td>
                  <td class="small wide" data-label="財源">{r ? fundOf(r.source || r.source_next) : '—'}</td>
                  {KINDS.map((k) => <td class="num" data-label={AMOUNT_KINDS[k].label}>{r ? amount(r, k) : '—'}<br /><small class="secondary">{yl(k)}</small></td>)}
                </tr>
              )),
            );
          })}
        </tbody>
      </table>
    </div>
    {present.some((y) => recs[y]?.matchedByName) && (
      <p class="small secondary">この取組は、部局の検証票では別の施策に載っているため、名前で結び付けて表示しています。</p>
    )}
  </section>

  <section aria-labelledby="pdca">
    <h2 id="pdca">年度ごとの活動と検証</h2>
    <p class="small secondary">
      各部局の「主な取組」検証票の記載をそのまま載せています。県は毎年、活動の結果を検証（Check）して翌年度の改善案（Action）を決め、翌年度の検証票でその反映状況を報告しています。
    </p>
    {present.map((y) => {
      const r = g.years[y];
      const b = recs[y];
      return (
        <details class="card cad" open={y === t.year}>
          <summary>{yearLong(y)}の報告 <Chip tone={toneOfStatus(statusOf(r))} text={statusOf(r)} /></summary>
          {!b ? (
            <>
              <p class="small secondary">この年度の部局の検証票は手に入っていません（<a href="/yosan/#coverage">予算と財源</a>の「部局票がある範囲」）。総括報告書の活動概要を載せます。</p>
              {r.summary && <p class="prose">{r.summary}</p>}
            </>
          ) : (
            <>
              {b.activity_done && <><h3>{yearLong(y)}の活動内容</h3><p class="prose">{b.activity_done}</p></>}
              {b.basis && <><h3>進捗状況の判定根拠・取組の効果</h3><p class="prose">{b.basis}</p></>}
              {b.improvements?.length > 0 && (
                <>
                  <h3>前年度に決めた改善案と、その反映状況</h3>
                  <div class="table-wrap">
                    <table class="impr stack">
                      <thead><tr><th>{yearLabel(y)}に向けた改善案</th><th>反映状況</th></tr></thead>
                      <tbody>{b.improvements.map((x) => <tr><td class="prose wide" data-label={`${yearLabel(y)}に向けた改善案`}>{x.plan || '—'}</td><td class="prose wide" data-label="反映状況">{x.result || '—'}</td></tr>)}</tbody>
                    </table>
                  </div>
                </>
              )}
              {b.check?.length > 0 && (
                <>
                  <h3>取組の検証（Check）</h3>
                  <ul class="typed">{b.check.map((x) => <li><span class="type">{x.type}</span><span class="prose">{x.text}</span></li>)}</ul>
                </>
              )}
              {b.action?.length > 0 && (
                <>
                  <h3>{yearLabel(y + 1)}に向けた改善案（Action）</h3>
                  <ul class="typed">{b.action.map((x) => <li><span class="type">{x.type}</span><span class="prose">{x.text}</span></li>)}</ul>
                </>
              )}
              {b.activity_next && <><h3>{yearLong(y + 1)}の活動計画</h3><p class="prose">{b.activity_next}</p></>}
              {(() => {
                const src = sourceLink(b.source, b.do_page || b.page);
                return src && <p class="small"><a href={src.href} rel="noopener">主な取組検証票（{src.label}）</a></p>;
              })()}
            </>
          )}
        </details>
      );
    })}
  </section>

  {reposts.length > 0 && (
    <section aria-labelledby="repost">
      <h2 id="repost">同じ取組が載っている施策</h2>
      <p class="small secondary">総括報告書では、1つの取組が複数の施策に載っていることがあります（再掲）。</p>
      <ul>
        {reposts.map((o) => <li><a href={o.href}>施策 {o.shisaku.code} {o.shisaku.name}</a></li>)}
      </ul>
    </section>
  )}

  <section aria-labelledby="source">
    <h2 id="source">出典</h2>
    <ul class="small">
      {present.map((y) => {
        const r = g.years[y];
        const a = sourceLink(r.source, r.page);
        const b = recs[y] && sourceLink(recs[y].source, recs[y].page);
        return (
          <li>
            {yearLong(y)}: {a ? <a href={a.href} rel="noopener">総括報告書（{a.label}）</a> : '—'}
            {b ? <>、<a href={b.href} rel="noopener">主な取組検証票（{b.label}）</a></> : '、主な取組検証票なし'}
          </li>
        );
      })}
    </ul>
    <p class="small"><a href={`/shisaku/${s.id}/#torikumi`}>施策「{s.name}」の主な取組の一覧</a></p>
  </section>
</Base>

<style>
  .head { margin-top: 12px; }
  .head h1 { margin: 6px 0 8px; }
  .head .code { font-size: 0.9375rem; }
  .head-years { margin-top: 14px; }
  .tags { margin-top: 8px; }
  .label { font-weight: 700; margin-bottom: 4px; }
  section h2 { scroll-margin-top: 72px; }
  .notice { margin-top: 16px; }
  .notice p { margin: 0 0 6px; }
  .notice ul { margin: 0 0 6px; padding-left: 1.2em; }
  .progress { min-width: 640px; }
  .progress td.small { min-width: 14em; }
  .progress :global(.chip) { white-space: nowrap; }
  td.num { white-space: normal; min-width: 5em; }
  .kv { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px 16px; margin: 8px 0 12px; }
  .kv div { min-width: 0; }
  .kv .wide { grid-column: 1 / -1; }
  .kv dt { font-size: 0.8125rem; color: var(--ink-2); font-weight: 700; }
  .kv dd { margin: 0; overflow-wrap: anywhere; }
  .plan { margin-top: 8px; }
  .plan td.num { min-width: 4em; }
  .budget { min-width: 720px; }
  .budget td:nth-child(2) { min-width: 12em; }
  .budget tr.sep th, .budget tr.sep td { border-top: 1px solid var(--grid); }
  .cad { margin-top: 12px; }
  .cad > summary { font-family: var(--font-display); font-weight: 700; color: var(--ink); font-size: 1rem; cursor: pointer; }
  .cad > summary :global(.chip) { font-weight: 400; margin-left: 8px; }
  .cad h3 { font-size: 0.95rem; margin: 16px 0 4px; }
  .cad p { margin: 0 0 8px; }
  .impr { min-width: 560px; }
  .impr td { width: 50%; }
  .typed { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .typed li { display: grid; gap: 2px; }
  .typed .type { font-size: 0.8125rem; color: var(--ink-2); font-weight: 700; }
  /* スマホでは表を1件ずつの縦並びにする（横にスクロールしないと計画・実績・金額が見えないため） */
  @media (max-width: 640px) {
    .stack { min-width: 0; }
    .stack thead { display: none; }
    .stack tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 12px; padding: 10px 0; border-bottom: 1px solid var(--grid); }
    .stack th, .stack td { border: 0; padding: 0; min-width: 0; width: auto; }
    .stack th:empty, .stack td:empty { display: none; }
    .stack .wide { grid-column: 1 / -1; }
    .stack .span2 { grid-column: span 2; }
    .stack td.name:empty { display: none; }
    .stack td.num { text-align: left; }
    .stack td[data-label]::before { content: attr(data-label); display: block; font-size: 0.8125rem; color: var(--ink-2); }
    .stack tr.sep th, .stack tr.sep td { border-top: 0; }
    .budget td:nth-child(2) { min-width: 0; }
    .progress td.small { min-width: 0; }
  }
</style>
