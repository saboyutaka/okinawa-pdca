---
// 主な取組1件のページ。年度をまたいで同じ名前の取組をまとめ、総括報告書（進捗）と部局の検証票（予算・活動・検証・改善案）を並べる。
// 頭はページの階層（入っている施策まで。components/Hierarchy.astro）の線の先につなぐ。①いまの状態（進捗状況と、それを決める活動指標の計画と実績。施策のページの頭と同じく、状態の理由まで頭で答える）
// ②活動指標の計画と実績（図と県の判定の根拠。年度別計画のこの先の年度も置き、前の活動指標は畳む） ③年度ごとの PDCA ④予算の推移（予算事業と財源も）。表と原文は畳む
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../../lib/routes.ts';
import Base from '../../../layouts/Base.astro';
import Chip from '../../../components/Chip.astro';
import Icon from '../../../components/Icon.astro';
import Chunk from '../../../components/Chunk.astro';
import Stamps from '../../../components/Stamps.astro';
import Term from '../../../components/Term.astro';
import Sz from '../../../components/Sz.astro';
import Hierarchy from '../../../components/Hierarchy.astro';
import HeadKind from '../../../components/HeadKind.astro';
import ShareBox from '../../../components/ShareBox.astro';
import KatsudouChart from '../../../components/KatsudouChart.astro';
import ShareMenu from '../../../components/ShareMenu.astro';
import Toc from '../../../components/Toc.astro';
import { themeIdsOfItem } from '../../../lib/themes.ts';
import {
  YEARS, LATEST, yearLabel, yearLong, statusOf, toneOfStatus, budgetOf, fundOf,
  sectionHref, sourceLink, renameCandidates, repostsOf, firstYearOf, formerNames, formerText, AMOUNT_KINDS, activityShares, activityAchievement, activityAchievements, planPath,
  isNoBudgetName, budgetKey, type TorikumiGroup, type ActivityRun,
} from '../../../lib/data.ts';
import { yen } from '../../../lib/format.ts';
import { firstSentence } from '../../../lib/text.ts';
import { torikumiHead } from '../../../lib/describe.ts';
import ExtLink from '../../../components/ExtLink.astro';
import { KANKO, kankoOfPdca, kankoShisakuHref } from '../../../lib/plans.ts';
import type { Tone } from '../../../lib/icons.ts';
import type { AmountKind } from '../../../lib/types.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['torikumi/[shisaku]/[slug]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { g } = Astro.props;
const s = g.shisaku;
const t = g.latest;
const yearsDesc = [...YEARS].reverse();
const present = yearsDesc.filter((y) => g.years[y]);
const first = firstYearOf(g);
// 年度×部局票の記載（無い年度は undefined）
const recs = Object.fromEntries(present.map((y) => [y, budgetOf(y, s.id, g.key)]));
const latestRec = present.map((y) => recs[y]).find(Boolean);
const tr = recs[t.year];
// 部局票の「対応する成果指標」は出さない（docs/site.md の 1章の seikaNameMatches・torikumiOfSeika）
const candidates = renameCandidates(g);
// 別の施策に移った可能性のある取組があるか（この取組の後の年度・前の年度）
const movedAfter = candidates.some((c) => c.moved && c.after);
const anyMoved = candidates.some((c) => c.moved);
// 前の年度の報告での名前（名前が変わった取組も、同じ取組として年度をつないでいる。lib/renames.ts）
const formers = formerNames(g);
const reposts = repostsOf(g);
// 観光ロードマップ（個別計画）でも主な取組として評価されているか（同じ年度に同じ名前の取組）
const rm = kankoOfPdca(s.id, g.key);
const okUrl = (u: string | null | undefined) => /^https?:\/\/\S+$/.test(u || '');
const KINDS: AmountKind[] = ['settled', 'estimate', 'initial'];
// 報告に載っている年度の範囲（「R4〜R6」「R7」）
const span = (x: TorikumiGroup) => (firstYearOf(x) === x.latest.year ? yearLabel(x.latest.year) : `${yearLabel(firstYearOf(x))}〜${yearLabel(x.latest.year)}`);
const secHref = sectionHref(t.section);
const stamps = YEARS.map((y) => (g.years[y] ? { year: y, tone: toneOfStatus(statusOf(g.years[y])), text: statusOf(g.years[y]) } : { year: y, tone: null, text: '報告なし' }));
const latestStatus = statusOf(t);
const latestTone = toneOfStatus(latestStatus);

const toneOfPct = (p: number): Tone => (p >= 90 ? 'good' : p >= 75 ? 'warning' : p >= 60 ? 'serious' : 'critical');
const latestAch = activityAchievement(g, t.year);
// 活動指標の表が2つ以上ある取組の、表ごとの達成割合
const latestAchs = activityAchievements(g, t.year);
// 活動指標の計画と実績。活動指標が途中で変わった取組は、活動指標ごとに図と表を分ける（新しい活動指標が先）。前の活動指標は畳む（施策ページの「R6まで使われていた成果指標」と同じ）。
// 目標・実績が2行以上の活動指標（「５回／200名」）は行ごとの run（part）になるので、同じ活動指標（group）のカードを1つの見出しの下に並べる
// 図のカードごとに、id とシェアのボタン（活動指標のシェア用のページ。lib/data.ts の activityShares）を付ける
const shares = activityShares(g);
const shareOf = new Map(shares.map((a) => [a.run, a]));
const runGroups = shares.map((a) => a.run).reduce((m, run) => m.set(run.group, [...(m.get(run.group) ?? []), run]), new Map<number, ActivityRun[]>());
// 頭に出す最新の報告の行ごとの値（2行以上の活動指標だけ。1行なら t.target・t.actual をそのまま出す）
const headRuns = runGroups.get(0) ?? [];
const headParts = headRuns.length > 1 ? headRuns.map((p) => [p, p.years.find((y) => y.y === t.year)!] as const) : null;
const runSpan = (run: ActivityRun) => {
  const ys = run.years.filter((r) => !r.future).map((r) => r.y);
  return ys.length > 1 ? `${yearLabel(ys[0])}〜${yearLabel(ys[ys.length - 1])}` : yearLabel(ys[0]);
};
const futureText = (run: ActivityRun) => run.years.filter((r) => r.future).map((r) => yearLabel(r.y)).join('・');
// 名前の変わった活動指標を同じ活動指標としてつないだもの（前の名前は出典に書く）
const actFormers = [...runGroups.values()].map((runs) => runs[0]).filter((run) => run.formers.length > 0);
// 計画期間（図の帯の見出しと同じ言葉）
const periodOf = (y: number) => (y <= 2024 ? '前期（R4〜R6）' : '中期（R7〜R9）');
// 表の「1件（3件）」を、図に使うかっこの前と、かっこの中（累計や内訳）に分ける。かっこの中は下の行に出す
const parenSplit = (raw: string) => {
  const i = raw.search(/[（(]/);
  return i > 0 ? [raw.slice(0, i).trimEnd(), raw.slice(i)] : [raw, ''];
};
// 最新の報告の「進捗の判定の根拠」は活動指標の図のすぐ後に県の吹き出しで出し、その年度の PDCA の D には出さない（施策ページの成果指標のカードの「道のり → 県による説明」と同じ並び）
const latestBasis = tr?.basis;
// 閉じた年度に出す、その年度にやったことの1文目（部局票が無い年度は総括報告書の活動概要）
const didOf = (y: number) => firstSentence(recs[y]?.activity_done || g.years[y].summary);

// 予算の推移。各報告に前年度の決算額・その年度の決算見込額・翌年度の当初予算額が載っているので、年度ごとに確定に近い金額（決算 → 決算見込 → 当初予算）を選ぶ。
// 1つの取組に予算事業が複数あるときは合計する（桁の誤記の疑いがある金額は入れない）
const byFy = new Map<number, { fy: number; rank: number; kind: AmountKind; amount: number; report: number }>();
for (const y of present) {
  const b = recs[y];
  if (!b?.budgets?.length) continue;
  for (const kind of KINDS) {
    const fy = y + AMOUNT_KINDS[kind].offset;
    const vals = b.budgets.flatMap((blk) => blk.rows).flatMap((r) => {
      const v = r[kind];
      return v != null && !r.suspect?.includes(kind) ? [v] : [];
    });
    if (!vals.length) continue;
    const rank = KINDS.indexOf(kind);
    const cur = byFy.get(fy);
    if (!cur || rank < cur.rank) byFy.set(fy, { fy, rank, kind, amount: vals.reduce((a, v) => a + v, 0), report: y });
  }
}
const budgetSeries = [...byFy.values()].sort((a, b) => a.fy - b.fy);
const budgetMax = Math.max(1, ...budgetSeries.map((x) => x.amount));
// 部局票に金額が無いときは、総括報告書の最新の報告の決算見込額を書き添える
const noAmount = `部局の検証票に、この取組の金額の記載がありません。${t.budget != null ? `総括報告書の${yearLabel(t.year)}の決算見込額は${yen(t.budget)}です。` : ''}`;
// 予算事業の名前と財源は、予算の推移の箱の頭に出す（予算事業の欄の「―」などは名前に数えない）
const budgetNames = [...new Set(present.flatMap((y) => (recs[y]?.budgets || []).map((b) => b.name)).filter((n) => !isNoBudgetName(n)))];
const funds = [...new Set(present.flatMap((y) => (recs[y]?.budgets || []).flatMap((b) => b.rows.map((r) => fundOf(r.source || r.source_next)))))];

// 「表で見る」の予算の表。1つの年度の金額は 当初予算額 → 決算見込額 → 決算額 の順に確定していき、それぞれ前の年度・その年度・次の年度の報告に載っている。
// 予算事業ごとに、お金の年度を列（活動指標の表と同じ向き）、確定していく順を行にして並べ直す。当初予算額は翌年度の予算事業名（name_next）で載っている
const STAGES: AmountKind[] = ['initial', 'estimate', 'settled'];
type BudCell = { sum: number; n: number; raws: string[]; suspect: boolean };
const budMap = new Map<string, { name: string; funds: Set<string>; cells: Map<string, BudCell> }>();
for (const y of present) {
  for (const blk of recs[y]?.budgets || []) {
    for (const kind of STAGES) {
      const name = kind === 'initial' && !isNoBudgetName(blk.name_next) ? blk.name_next : blk.name;
      const key = isNoBudgetName(name) ? '' : budgetKey(name);
      if (!budMap.has(key)) budMap.set(key, { name: key ? name : '', funds: new Set(), cells: new Map() });
      const grp = budMap.get(key)!;
      const ck = `${kind}|${y + AMOUNT_KINDS[kind].offset}`;
      for (const r of blk.rows) {
        const v = r[kind];
        const raw = r[`${kind}_raw`];
        if (v == null && isNoBudgetName(raw)) continue;
        if (!grp.cells.has(ck)) grp.cells.set(ck, { sum: 0, n: 0, raws: [], suspect: false });
        const c = grp.cells.get(ck)!;
        if (v != null) { c.sum += v; c.n++; } else c.raws.push(raw);
        if (r.suspect?.includes(kind)) c.suspect = true;
        grp.funds.add(fundOf(kind === 'initial' ? r.source_next || r.source : r.source || r.source_next));
      }
    }
  }
}
const budGroups = [...budMap.values()].filter((x) => x.cells.size);
const budFys = [...new Set(budGroups.flatMap((x) => [...x.cells.keys()].map((k) => Number(k.split('|')[1]))))].sort((a, b) => a - b);
const budText = (c: BudCell | undefined) => {
  if (!c) return '—';
  const text = [c.n ? yen(c.sum) : '', ...c.raws].filter(Boolean).join('・');
  return c.suspect ? `${text}（桁の誤記の疑い）` : text;
};
// 部局票が手に入っていない報告（総括報告書の決算見込額だけ）
const noRecYears = present.filter((y) => !recs[y]?.budgets?.length).reverse();
---
<Base {...torikumiHead(g)} ogType="article">
  <Hierarchy items={planPath({ shisaku: s.id })} page={t.name} />
  <header class="sticker lift head">
    <HeadKind kind="主な取組" code={`${s.code}-${t.no}`} themes={themeIdsOfItem(s.id, t.name)} />
    <h1>{t.name}</h1>
    <div class="meta">
      <span>所管: {secHref ? <a class="sub-link" href={secHref}>{t.section}</a> : t.section}</span>
      {latestRec?.actor && <span>実施主体: {latestRec.actor.replace(/,/g, '・')}</span>}
      {rm.length > 0 && <a class="plan-tag" href="#rm">{KANKO.short}でも評価</a>}
    </div>
    <div class="now inset">
      <div class="now-l">
        <span class:list={['now-pill', `tone-${latestTone}`]}><Icon tone={latestTone} size={16} />{latestStatus}</span>
        <span class="now-sb">{yearLong(t.year)}の<Term word="進捗状況" /></span>
      </div>
      <div class="now-years">
        <span class="now-yl">4年間</span>
        <Stamps items={stamps} label="4年間の進捗状況" size="small" pop={0.1} />
      </div>
      <div class="now-act">
        <div class="act-name"><span class="act-l"><Term word="活動指標" /></span>{t.indicator || tr?.indicator_name || '—'}</div>
        {headParts ? (
          // 2行以上の活動指標は、行ごとの札（小学校・北部…）を頭に付けて並べ、行ごとの達成割合（部局票の表ごとの値）を同じ行に書く。計画が数で無い行（「－」）は割合を出さない
          <ul class="act-lines">{headParts.map(([p, y]) => <li><span class="act-part">{p.part}</span><span class="act-v">計画 <b>{y.plan_raw || '—'}</b> → 実績 <b>{y.actual_raw || '—'}</b></span>{y.ach && y.plan != null && <span class="act-sub act-v">達成割合 {y.ach}</span>}</li>)}</ul>
        ) : (
          <div class="act-vals">計画 <b>{t.target || '—'}</b> → 実績 <b>{t.actual || '—'}</b></div>
        )}
        {!headParts && latestAchs.length > 0 && <ul class="act-lines act-sub">{latestAchs.map((x) => <li>{x.name}: 達成割合 {x.text || '—'}</li>)}</ul>}
        {!headParts && latestAch && (
          <div class="act-ach">
            <Chunk frac={latestAch.pct / 100} tone={toneOfPct(latestAch.pct)} label={`活動指標の達成割合 ${latestAch.text}`} />
            <span class="act-sub">達成割合 {latestAch.text}{latestAch.pct >= 100 && '　計画クリア'}</span>
          </div>
        )}
      </div>
    </div>
    {latestRec?.activity && (
      <div class="bubble-row says">
        <span class="avatar" aria-hidden="true">県</span>
        <div class="bubble">
          <div class="small secondary label">ひとことで言うと（検証票の「取組内容」から）</div>
          <p class="first">{latestRec.activity}</p>
        </div>
      </div>
    )}
  </header>

  <Toc
    links={[
      { href: '#katsudou', label: '活動指標' },
      { href: '#pdca', label: '活動と検証' },
      { href: '#yosan', label: '予算' },
      rm.length > 0 && { href: '#rm', label: KANKO.short },
      { href: '#source', label: '出典' },
    ]}
    head={{ kind: '主な取組', title: t.name }}
  >
    <Fragment slot="status"><small>{yearLabel(t.year)}</small><Chip tone={latestTone} text={latestStatus} /></Fragment>
  </Toc>

  <section aria-labelledby="katsudou">
    <h2 id="katsudou" class="anchor">活動指標の計画と実績</h2>
    {[...runGroups.values()].map((runs, i) => {
      const run0 = runs[0];
      const split = runs.length > 1;
      const cards = runs.map((run) => {
      // 図の描き方とこの先の年度の計画の出どころの注記は、表の後ろに置く（図の下に並べると図が長くなるため）
      const notes = [
        run.cumulative && '図は、かっこの前に書かれたその年度の数で描いています（かっこの中は累計や内訳）。',
        run.skipped && '数で書かれていない値は、図に入れていません。',
        run.planFrom && `${futureText(run)}の計画は、${run.planFrom}の記載です。`,
      ].filter(Boolean).join('');
      // 表は図と同じく、年度を列にして左から右へ。行は 計画 → 実績 → 達成割合 → 進捗状況（進捗状況が決まる順）。
      // 図のある活動指標は列を図の年度にそろえ（.aligned）、図の帯と同じく最新でない計画期間の列に地の色を敷き、期間の変わり目に縦の線を引く
      const cols = run.years;
      const curPeriod = periodOf(cols.filter((r) => !r.future).at(-1)!.y);
      const cell = (k: number, ...more: string[]) => ['num', ...more, k > 0 && periodOf(cols[k].y) !== periodOf(cols[k - 1].y) && 'sep', periodOf(cols[k].y) !== curPeriod && 'off'];
      const unit = run.unit && <span class="secondary small">（{run.unit}）</span>;
      const sh = shareOf.get(run)!;
      return (
        <div class="sticker kcard" id={sh.anchor}>
          {!split && i > 0 && <div class="k-span">{runSpan(run)}の活動指標</div>}
          <div class="k-head">
            {split ? <h4 class="k-part">{run.part}{unit}</h4> : <h3 class="k-name">{run.indicator || '活動指標の記載なし'}{unit}</h3>}
            {sh.name && <ShareMenu path={sh.share} kind="活動指標" name={sh.name} />}
          </div>
          <KatsudouChart run={run} here={i > 0 ? '' : t.year === LATEST ? 'いまここ' : '最後の報告'} />
          <details open={!run.chart}>
            <summary>{run.chart ? '表で見る' : '年度ごとの計画と実績'}</summary>
            <div class="table-wrap">
              <table class:list={['progress', run.chart && 'aligned']}>
                <caption class="sr-only">{run.indicator}{run.part && `の${run.part}`}の年度ごとの計画と実績{new Set(cols.map((r) => periodOf(r.y))).size > 1 && '（R6までは前期、R7からは中期の実施計画）'}</caption>
                <colgroup><col class="lab" /><col span={cols.length} /></colgroup>
                <thead>
                  <tr><td></td>{cols.map((r, k) => <th scope="col" class:list={cell(k)}>{yearLabel(r.y)}{r.future && <small class="secondary">年度別計画</small>}</th>)}</tr>
                </thead>
                <tbody>
                  <tr><th scope="row">計画</th>{cols.map((r, k) => { const [a, b] = parenSplit(r.plan_raw || '—'); return <td class:list={cell(k, 'lines')}>{a}{b && <span class="paren">{b}</span>}</td>; })}</tr>
                  <tr><th scope="row">実績</th>{cols.map((r, k) => { const [a, b] = parenSplit(r.future ? '—' : r.actual_raw || '—'); return <td class:list={cell(k, 'lines')}><b>{a}</b>{b && <span class="paren">{b}</span>}</td>; })}</tr>
                  <tr><th scope="row">達成割合</th>{cols.map((r, k) => <td class:list={cell(k, 'lines')}>{r.future ? '—' : r.ach || '—'}</td>)}</tr>
                  <tr><th scope="row">進捗状況</th>{cols.map((r, k) => <td class:list={cell(k)}>{r.future ? <span class="small secondary">これから</span> : <Chip tone={toneOfStatus(r.status)} text={r.status} />}</td>)}</tr>
                </tbody>
              </table>
            </div>
            {notes && <p class="small secondary note">{notes}</p>}
          </details>
        </div>
      );
      });
      // 行ごとに分けた活動指標は、名前を1回だけ見出しにして、行のカードを下に並べる（「開催数」「参加者数（累計）」のように、行の札がカードの見出し）
      const card = split ? (
        <div class="k-group">
          {i > 0 && <div class="k-span">{runSpan(run0)}の活動指標</div>}
          <h3 class="k-name">{run0.indicator || '活動指標の記載なし'}</h3>
          <p class="small secondary">計画と実績が{runs.length}つの値で書かれているので、値ごとに図と表を分けています。</p>
          {cards}
        </div>
      ) : cards[0];
      if (i > 0) return <details class="past"><summary>{runSpan(run0)}に使われていた活動指標</summary>{card}</details>;
      return (
        <>
          {card}
          {latestBasis && (
            <div class="bubble-row says basis">
              <span class="avatar" aria-hidden="true">県</span>
              <div class="bubble">
                <div class="small secondary label">進捗の判定の根拠（{yearLabel(t.year)}・部局の検証票）</div>
                <p class="prose">{latestBasis}</p>
              </div>
            </div>
          )}
        </>
      );
    })}
    {latestRec && okUrl(latestRec.url) && <p class="small">関連ページ: <ExtLink href={latestRec.url}>{latestRec.url}</ExtLink></p>}
  </section>

  <section aria-labelledby="pdca">
    <h2 id="pdca" class="anchor">年度ごとの活動と検証</h2>
    <p class="small secondary lead">前の年度の改善案をどう活かし（P）、何をして（D）、どうふりかえり（C）、次に何を変えるのか（A）。県が毎年まとめている部局の検証票の言葉のまま、年度ごとにたどれます。</p>
    {present.map((y) => {
      const r = g.years[y];
      const b = recs[y];
      const st = statusOf(r);
      const plansDone = (b?.improvements || []).filter((x) => (x.plan && !/^[―\-ー－]$/.test(x.plan.trim())) || x.result);
      // 最新の報告の判定の根拠は、活動指標の図の後に出している
      const basis = y === t.year ? '' : b?.basis;
      const body = !b ? (
        <>
          <p class="small secondary">この年度の部局の検証票は手に入っていません（<a href="/yosan/#coverage">予算と財源</a>の「部局票がある範囲」）。総括報告書の活動概要を載せます。</p>
          {r.summary && <p class="prose">{r.summary}</p>}
        </>
      ) : (
        <ol class="flow">
          {plansDone.length > 0 && (
            <li class="step-p">
              <span class="badge" aria-hidden="true">P</span>
              <div class="flow-body">
                <h4>前年度に決めた改善案と、その反映</h4>
                <ul class="impr">
                  {plansDone.map((x) => (
                    <li class="inset">
                      {x.plan && !/^[―\-ー－]$/.test(x.plan.trim()) && <div class="impr-plan"><span class="tagline">改善案</span><span class="prose">{x.plan}</span></div>}
                      <div class="impr-res"><span class="tagline">反映</span><span class="prose">{x.result || '—'}</span></div>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          )}
          {(b.activity_done || basis) && (
            <li class="step-d">
              <span class="badge" aria-hidden="true">D</span>
              <div class="flow-body">
                {b.activity_done && <><h4>{yearLong(y)}にやったこと</h4><p class="prose">{b.activity_done}</p></>}
                {basis && <><h4>進捗の判定の根拠 <Chip tone={toneOfStatus(st)} text={st} /></h4><p class="prose">{basis}</p></>}
              </div>
            </li>
          )}
          {b.check?.length > 0 && (
            <li class="step-c">
              <span class="badge" aria-hidden="true">C</span>
              <div class="flow-body">
                <h4>県の検証（Check）</h4>
                <ul class="typed">{b.check.map((x) => <li><span class="type">{x.type}</span><span class="prose">{x.text}</span></li>)}</ul>
              </div>
            </li>
          )}
          {(b.action?.length > 0 || b.activity_next) && (
            <li class="step-a">
              <span class="badge" aria-hidden="true">A</span>
              <div class="flow-body">
                {b.action?.length > 0 && <><h4>{yearLabel(y + 1)}に向けた改善案（Action）</h4><ul class="typed">{b.action.map((x) => <li><span class="type">{x.type}</span><span class="prose">{x.text}</span></li>)}</ul></>}
                {b.activity_next && <><h4>{yearLong(y + 1)}の活動計画</h4><p class="prose">{b.activity_next}</p></>}
              </div>
            </li>
          )}
        </ol>
      );
      const did = didOf(y);
      // 前の年度は、やったことの1文目だけを出して残りを畳む（開いたら1文目は消し、D に全文を出す）
      return y === t.year ? (
        <div class="sticker cad latest">
          <h3 class="cad-h">{yearLong(y)}の報告 <Chip tone={toneOfStatus(st)} text={st} /></h3>
          {body}
        </div>
      ) : (
        <div class="sticker cad">
          <h3 class="cad-h">{yearLong(y)}の報告 <Chip tone={toneOfStatus(st)} text={st} /></h3>
          {did && <p class="cad-did"><span class="tagline">やったこと</span><span>{did}</span></p>}
          <details class="cad-more">
            <summary>{yearLabel(y)}の記載をすべて読む</summary>
            {body}
          </details>
        </div>
      );
    })}
  </section>

  <section aria-labelledby="yosan">
    <h2 id="yosan" class="anchor">予算の推移</h2>
    <p class="small secondary lead">1つの年度の金額は<Term word="当初予算額" /> → <Term word="決算見込額" /> → <Term word="決算額" />の順に確定していくので、年度ごとにいちばん確定に近い金額を出しています。</p>
    {budgetSeries.length > 0 || budgetNames.length > 0 || funds.length > 0 ? (
      <div class="sticker">
        {(budgetNames.length > 0 || funds.length > 0) && (
          <dl class="bud-meta">
            {budgetNames.length > 0 && <div><dt>予算事業</dt><dd>{budgetNames.join('、')}</dd></div>}
            {funds.length > 0 && <div><dt>財源</dt><dd>{funds.join('・')}</dd></div>}
          </dl>
        )}
        {budgetSeries.length > 0 ? (
          <>
            <ul class="bud">
              {budgetSeries.map((b) => (
                <li class:list={[b.kind]}>
                  <span class="bud-y">{yearLabel(b.fy)}<small>{AMOUNT_KINDS[b.kind].label}</small></span>
                  <span class="bud-track"><span class="bud-bar" style={`width:${(b.amount / budgetMax) * 100}%`} aria-hidden="true"></span><span class="bud-v big">{yen(b.amount)}</span></span>
                </li>
              ))}
            </ul>
            <p class="small secondary bud-key"><span><span class="k k-initial"></span>当初予算額</span><span><span class="k k-estimate"></span>決算見込額</span><span><span class="k k-settled"></span>決算額</span>{budgetNames.length > 1 && <span>／　{budgetNames.length}つの予算事業の合計</span>}</p>
          </>
        ) : <p class="secondary">{noAmount}</p>}
      </div>
    ) : <p class="secondary">{noAmount}</p>}
    <p class="small secondary">1つの予算事業が複数の取組に重ねて書かれていることがあり、その場合は取組だけに使われた金額ではありません（<a href="/yosan/">予算と財源</a>では重複を除いて集計しています）。</p>
    <details>
      <summary>予算事業ごとの金額を表で見る</summary>
      {budGroups.length > 0 && (
        <div class="table-wrap">
          <table class="budget">
            <caption class="sr-only">予算事業ごとの、年度ごとの当初予算額・決算見込額・決算額</caption>
            <thead>
              <tr><td></td>{budFys.map((fy) => <th scope="col" class="num">{yearLabel(fy)}</th>)}</tr>
            </thead>
            {budGroups.map((grp) => (
              <tbody>
                <tr class="grp"><th scope="rowgroup" colspan={budFys.length + 1}>{grp.name || '予算事業の名前の記載なし'}{grp.funds.size > 0 && <small class="secondary">財源: {[...grp.funds].join('・')}</small>}</th></tr>
                {STAGES.map((kind) => (
                  <tr><th scope="row">{AMOUNT_KINDS[kind].label}</th>{budFys.map((fy) => <td class="num">{budText(grp.cells.get(`${kind}|${fy}`))}</td>)}</tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      )}
      <p class="small secondary">当初予算額は前の年度の報告、決算見込額はその年度の報告、決算額は次の年度の報告の部局の検証票に載っている額です。</p>
      {noRecYears.map((y) => (
        <p class="small secondary">{yearLabel(y)}の報告は部局の検証票が手に入っていません（総括報告書の{yearLabel(y)}の決算見込額: {yen(g.years[y].budget)}{g.years[y].budget == null && g.years[y].budget_raw ? `（${g.years[y].budget_raw}）` : ''}）。</p>
      ))}
      {present.some((y) => recs[y]?.matchedByName) && (
        <p class="small secondary">この取組は、部局の検証票では別の施策に載っているため、名前で結び付けて表示しています。</p>
      )}
    </details>
  </section>

  {rm.length > 0 && (
    <section aria-labelledby="rm">
      <h2 id="rm" class="anchor">{KANKO.short}でも評価されています</h2>
      <p class="small secondary lead">県の観光の<a href="/keikaku/">個別計画</a>「{KANKO.name}」でも、同じ名前の主な取組が同じ区分で評価されています。</p>
      <ul class="row-list">
        {rm.map((x) => (
          <li>
            <div class="name-row"><span><span class="plan-tag">{KANKO.short}</span> <a class="name-link" href={kankoShisakuHref(x.rm)}>{x.rm.name}</a></span><span class="code-no">施策 {x.rm.code}</span></div>
            <div class="small secondary">
              {Object.values(x.row.years).sort((a, b) => a.year - b.year).map((r, k) => <>{k > 0 && '　'}{yearLabel(r.year)}: {statusOf(r)}</>)}
              {x.row.latest.name !== t.name && <>（観光ロードマップでの名前: {x.row.latest.name}）</>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {reposts.length > 0 && (
    <section aria-labelledby="repost">
      <h2 id="repost">同じ取組が載っている施策</h2>
      <p class="small secondary">総括報告書では、1つの取組が複数の施策に載っていることがあります（再掲）。</p>
      <ul class="reposts">
        {reposts.map((o) => <li><a class="tag" href={o.href}><Sz id={o.shisaku.shouraizou} />施策 {o.shisaku.name} <span class="code-no">{o.shisaku.code}</span></a></li>)}
      </ul>
    </section>
  )}

  <ShareBox kind="主な取組" name={t.name} />

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <ul class="small">
      {present.map((y) => {
        const r = g.years[y];
        const a = sourceLink(r.source, r.page);
        const b = recs[y] && sourceLink(recs[y].source, recs[y].page);
        return (
          <li>
            {yearLong(y)}: {a ? <ExtLink href={a.href}>総括報告書（{a.label}）</ExtLink> : '—'}
            {b ? <>、<ExtLink href={b.href}>主な取組検証票（{b.label}）</ExtLink></> : '、主な取組検証票なし'}
          </li>
        );
      })}
    </ul>
    <p class="small">この取組が入っている施策の、県の報告書での番号は<strong class="report-no">施策 {s.code}</strong>です。報告書の PDF では、この番号で探せます。</p>
    {(t.year !== LATEST || first !== YEARS[0] || formers.length > 0 || actFormers.length > 0) && (
      <p class="small">{first !== YEARS[0] && `${yearLabel(first)}の報告から載っている取組です。`}{t.year !== LATEST && `${yearLabel(t.year + 1)}の報告には、${movedAfter ? 'この施策に' : ''}この名前の取組はありません（終わったか、名前${movedAfter ? 'や載っている施策' : ''}が変わった可能性があります）。`}{formers.length > 0 && `この取組は、${formerText(formers)}という名前で載っています。`}{actFormers.map((run) => `活動指標「${run.indicator}」は、${formerText(run.formers)}という名前で載っています。`).join('')}年度をまたいだ取組は<a href="/about/#kazoekata">名前で結び付けています</a>（名前が変わったものは、予算事業や活動指標が続いているかで判断）。</p>
    )}
    {candidates.length > 0 && (
      <>
        <p class="small">関係がありそうな取組（この取組の前後の年度に載っている、同じ施策のもの{anyMoved && 'と、予算事業と活動指標が同じ別の施策のもの'}。名前の変更や、取組の分割・統合{anyMoved && '、施策の移動'}の可能性があります）:</p>
        <ul class="small">
          {candidates.map((c) => (
            <li><a href={c.group.href}>{c.group.latest.name}</a>（{span(c.group)}・この取組の{c.after ? '後' : '前'}。{c.moved && `別の施策「${c.group.shisaku.name}」。`}{c.shared.length ? `同じ予算事業「${c.shared[0]}」` : '名前が似ている'}{c.moved && '・同じ活動指標'}）</li>
          ))}
        </ul>
      </>
    )}
  </section>
</Base>

<style>
  .report-no { white-space: nowrap; }
  .head { display: grid; gap: 12px; }
  .head > :global(.head-kind) { margin-bottom: -6px; }
  .head h1 { margin: 0; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 18px; font-size: 0.9375rem; color: var(--ink-2); }
  /* 状態（札と4年間）の下に、状態を決める活動指標の計画と実績を置く。スマホでは 札 → 活動指標 → 4年間 の順 */
  .now { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "l years" "act act"; align-items: center; gap: 10px 32px; padding: 12px 16px; }
  .now-l { grid-area: l; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .now-act { grid-area: act; display: grid; gap: 6px; padding-top: 12px; border-top: 1.5px solid var(--grid); }
  .act-name { font-family: var(--font-display); font-weight: 700; line-height: 1.5; }
  .act-l { margin-right: 10px; font-family: var(--font); font-size: 0.875rem; color: var(--ink-2); }
  .act-vals b, .act-lines b { font-family: var(--font-num); font-weight: 600; font-size: 1.15rem; }
  .act-lines { margin: 0; padding-left: 1.2em; }
  /* 行の札・「計画 → 実績」・達成割合は、それぞれかたまりで折り返す（スマホで札が長いとき、数の途中で折れないように） */
  .act-part { display: inline-block; min-width: 4em; margin-right: 10px; font-family: var(--font-display); font-weight: 700; font-size: 0.9375rem; }
  .act-v { display: inline-block; margin-right: 10px; }
  .act-sub { font-size: 0.875rem; color: var(--ink-2); }
  .act-ach { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .act-ach :global(.chunk) { flex: 0 1 320px; min-width: 160px; }
  .now-pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 4px 16px; border: 2.5px solid var(--line); border-radius: 999px;
    background-color: color-mix(in oklab, var(--tone) 26%, var(--paper)); box-shadow: 2px 2px 0 var(--shadow);
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
  }
  .now-sb { font-size: 0.875rem; color: var(--ink-2); }
  .now-years { grid-area: years; display: flex; align-items: center; gap: 10px; max-width: 340px; }
  .now-yl { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); }
  .now-years :global(.stamps) { flex: 1; }
  .label { font-weight: 700; margin-bottom: 4px; }
  .says .first { margin: 4px 0 0; font-weight: 700; }
  @media (max-width: 640px) {
    .now { grid-template-columns: minmax(0, 1fr); grid-template-areas: "l" "act" "years"; gap: 12px; }
    .now-years { max-width: none; padding-top: 12px; border-top: 1.5px solid var(--grid); }
  }
  .basis { margin-top: 14px; }
  .basis .prose { margin: 4px 0 0; }
  .past { margin-top: 14px; }
  .kcard { margin-top: 12px; }
  .k-span { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); }
  .k-name { margin: 0; }
  .k-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 6px 16px; }
  .k-head > :global(.share-menu) { margin-left: auto; }
  .k-group { margin-top: 12px; }
  .k-group > p { margin: 4px 0 0; }
  .k-part { margin: 0; font-size: 1rem; }
  .note { margin: 6px 0 0; }
  .bud-meta { display: grid; gap: 4px; margin: 0 0 14px; padding-bottom: 12px; border-bottom: 1.5px solid var(--grid); font-size: 0.9375rem; }
  .bud-meta > div { display: grid; grid-template-columns: 5.5em minmax(0, 1fr); gap: 8px; }
  .bud-meta dt { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); padding-top: 2px; }
  .bud-meta dd { margin: 0; }
  .bud { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .bud li { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: 10px; align-items: center; }
  .bud-y { font-family: var(--font-num); font-weight: 600; font-size: 1.05rem; line-height: 1.2; }
  .bud-y small { display: block; font-family: var(--font); font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); }
  .bud-track { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .bud-bar { display: block; height: 20px; min-width: 4px; border: 2px solid var(--line); border-radius: 0 999px 999px 0; background: var(--pop); }
  .estimate .bud-bar { background: color-mix(in oklab, var(--pop) 55%, var(--paper)); }
  .initial .bud-bar { background: var(--paper); background-image: repeating-linear-gradient(135deg, color-mix(in oklab, var(--pop) 45%, var(--paper)) 0 2px, transparent 2px 6px); }
  .bud-v { white-space: nowrap; font-size: 1rem; }
  /* 色の見本と文字が別の行に分かれないよう、項目ごとに折り返さない */
  .bud-key { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; margin: 12px 0 0; }
  .bud-key > span { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .k { display: inline-block; width: 16px; height: 12px; border: 1.5px solid var(--line); border-radius: 3px; }
  .k-settled { background: var(--pop); }
  .k-estimate { background: color-mix(in oklab, var(--pop) 55%, var(--paper)); }
  .k-initial { background: repeating-linear-gradient(135deg, color-mix(in oklab, var(--pop) 45%, var(--paper)) 0 2px, var(--paper) 2px 6px); }
  section details { margin-top: 10px; }
  /* 年度が列の活動指標の表。期間の変わり目に縦の線を引き、最新でない計画期間の列に図の帯と同じ地の色を敷く */
  .progress thead th { vertical-align: bottom; }
  .progress thead small { display: block; font-weight: 400; }
  .progress .sep { border-left: 1.5px solid var(--line); }
  .progress .off { background: var(--bg); }
  /* 値は折り返さない（ページ全体の overflow-wrap: anywhere で「1,80」「0kW」のように割れるため）。入りきらなければ表を横にすべらせる。
     目標・実績が行ごとに分かれた取組は改行を残し、かっこの中（累計や内訳）は下の行に小さく出す */
  .progress td { white-space: nowrap; overflow-wrap: normal; }
  .progress td.lines { white-space: pre; }
  .progress .paren { display: block; font-size: 0.8125rem; color: var(--ink-2); font-weight: 400; }
  .progress :global(.chip) { white-space: nowrap; }
  /* 図のある活動指標は、列を図の年度にそろえる。左の列は図の左の余白（--plot-l。scripts/charts.ts の drawKatsudou が入れる）、右の 8px は図の右の余白。
     値は図の点の真下に置き、文字は図の目盛りに近い大きさにする。スマホの幅では年度の列が狭すぎるので、そろえずに横にすべらせる */
  @media (min-width: 641px) {
    .aligned { table-layout: fixed; width: calc(100% - 8px); font-size: 0.8125rem; }
    .aligned col.lab { width: var(--plot-l, 60px); }
    .aligned th, .aligned td { min-width: 0; padding: 6px 4px; text-align: center; }
    .aligned th[scope="row"] { text-align: left; padding-left: 0; }
    .aligned thead th { font-family: var(--font-num); font-size: 12px; }
  }
  td.num { white-space: normal; min-width: 5em; }
  /* 予算事業ごとの表。予算事業の名前の行の下に 当初予算額 → 決算見込額 → 決算額 の行。金額は折り返さず、入りきらなければ表を横にすべらせる */
  .budget tr.grp th { padding-top: 14px; color: var(--ink); white-space: normal; }
  .budget tr.grp small { margin-left: 12px; font-weight: 400; }
  .budget td.num { white-space: nowrap; overflow-wrap: normal; }
  .cad { margin-top: 14px; }
  .cad-h { font-family: var(--font-display); font-weight: 700; color: var(--ink); font-size: 1.02rem; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0; }
  .cad-h :global(.chip) { font-weight: 400; }
  .cad-did { display: grid; grid-template-columns: 5.5em minmax(0, 1fr); gap: 8px; margin: 8px 0 0; }
  .cad-more { margin-top: 8px; }
  /* 開いたら D に全文が出るので、1文目は消す */
  .cad:has(.cad-more[open]) .cad-did { display: none; }
  .flow { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 0; }
  .flow > li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; position: relative; padding-bottom: 16px; }
  .flow > li:not(:last-child)::before { content: ""; position: absolute; left: 19px; top: 40px; bottom: 0; width: 2.5px; background: var(--hair); }
  .badge {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 2.5px solid var(--line);
    font-family: var(--font-num); font-weight: 600; font-size: 1.1rem; background: var(--paper); position: relative; z-index: 1;
  }
  .step-p .badge { background: var(--sky); }
  .step-d .badge { background: var(--lilac); }
  .step-c .badge { background: var(--pink); }
  .step-a .badge { background: var(--paper); box-shadow: 2px 2px 0 var(--shadow); }
  .flow-body { min-width: 0; padding-top: 6px; }
  .flow-body h4 { font-size: 0.98rem; margin: 0 0 4px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .flow-body h4:not(:first-child) { margin-top: 12px; }
  .flow-body p { margin: 0; }
  .impr { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .impr li { display: grid; gap: 4px; padding: 8px 12px; }
  .impr-plan, .impr-res { display: grid; grid-template-columns: 3.6em minmax(0, 1fr); gap: 8px; font-size: 0.9375rem; }
  .tagline { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); padding-top: 2px; }
  .typed { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
