---
import Base from '../../layouts/Base.astro';
import FilterMore from '../../components/FilterMore.astro';
import ThemeFilter from '../../components/ThemeFilter.astro';
import { LATEST, yearLabel, STATUSES, DEPTS, getTorikumiGroups, getShouraizou } from '../../lib/data.ts';
import { fmt } from '../../lib/format.ts';
import { KANKO, KANKO_TORIKUMI_HREF } from '../../lib/plans.ts';
import { SEARCH_DATA_FALLBACK, SEARCH_SUMMARY_FALLBACK, searchDataPath, searchSummaryPath } from '../../lib/search-data.ts';

const groups = getTorikumiGroups();
const depts = DEPTS.filter((d) => groups.some((g) => g.dept === d.name));
// 検索用のデータと、キーワードで探すときだけ読むやったこと。名前に中身のハッシュが付く（lib/search-data.ts）
const dataPath = searchDataPath();
---
<Base title="取組をさがす" description="沖縄県PDCAの主な取組（約1,700件）を、令和4〜7年度の進捗状況つきで検索できます。">
  {/* 検索用のデータを、ページのスクリプトが届くのを待たずに読み始める（下のスクリプトの fetch がこれを使う。crossorigin は fetch の既定に合わせる） */}
  <link slot="head" rel="preload" href={dataPath} as="fetch" crossorigin="anonymous" />
  <h1>取組をさがす</h1>
  <p class="secondary lead">令和4〜7年度の報告書に出てくる主な取組 {fmt(groups.length)}件を、4年分の進捗状況つきでさがせます。</p>

  <form class="filters sticker" id="tf" role="search" aria-label="取組の絞り込み">
    <label class="q" data-label="キーワード">キーワード（取組の名前・所管課・施策・活動指標・やったこと）
      <input type="search" name="q" placeholder="例: 離島、子ども、観光、所管課の名前" />
    </label>
    <FilterMore id="tori-more">
    <ThemeFilter />
    <label data-label="将来像">将来像
      <select name="s">
        <option value="">すべて</option>
        {getShouraizou().map((s) => <option value={s.id}>将来像{s.id}</option>)}
      </select>
    </label>
    <label data-label="部局">担当部局
      <select name="dept">
        <option value="">すべて</option>
        {depts.map((d) => <option value={d.name}>{d.name}</option>)}
      </select>
    </label>
    <label data-label={`${yearLabel(LATEST)}の進捗`}>{yearLabel(LATEST)}の進捗
      <select name="st">
        <option value="">すべて</option>
        {STATUSES.map((s, i) => <option value={i}>{s.key}</option>)}
        <option value="delay">遅れ（やや遅れ・大幅遅れ・未着手）</option>
        <option value="none">{yearLabel(LATEST)}の報告に無い</option>
      </select>
    </label>
    <label data-label="4年間の様子">4年間の様子
      <select name="pat">
        <option value="">すべて</option>
        <option value="recover">{yearLabel(LATEST - 1)}の遅れから{yearLabel(LATEST)}で順調に</option>
        <option value="newdelay">{yearLabel(LATEST - 1)}の順調・概ね順調から{yearLabel(LATEST)}で遅れ</option>
        <option value="delay4">4年とも遅れ</option>
        <option value="delay3">3年以上遅れ</option>
        <option value="streak">{yearLabel(LATEST - 2)}から{yearLabel(LATEST)}まで続けて遅れ（今も遅れている）</option>
        <option value="new">{yearLabel(LATEST)}で新しく出た</option>
        <option value="ended">{yearLabel(LATEST)}の報告に無い（終了・名称変更）</option>
      </select>
    </label>
    <label data-label="個別計画">個別計画
      <select name="plan">
        <option value="">すべて</option>
        <option value="kanko">{KANKO.short}でも評価されている</option>
      </select>
    </label>
    <fieldset class="fgroup" data-label="共通">
      <legend class="fgroup-label">複数の施策に共通</legend>
      <div class="fchips">
        <label class="fchip"><input type="checkbox" name="link" value="repost" data-text="複数の施策に共通の取組だけ" /><span>共通の取組だけ</span></label>
      </div>
    </fieldset>
    </FilterMore>
  </form>
  <div class="active-filters" id="active" hidden></div>
  <p class="result-count" aria-live="polite" aria-atomic="true"><span id="count">読み込み中…</span><span id="unit" hidden>件を表示</span><span id="no-summary" class="small secondary" hidden>（やったことを読み込めなかったため、キーワードは取組の名前などだけでさがしています）</span></p>

  <ul class="row-list" id="results" aria-busy="true" data-src={dataPath} data-fallback={SEARCH_DATA_FALLBACK} data-summary-src={searchSummaryPath()} data-summary-fallback={SEARCH_SUMMARY_FALLBACK}></ul>
  <p><button type="button" class="button" id="more" hidden>さらに表示</button></p>
  <p class="small secondary">
    同じ施策の中で名前が同じ取組を、年度をまたいで1件にまとめています（「子ども」「こども」のような書き方の違いは同じ名前とみなします。令和7年度の中期実施計画で名前が変わった取組などは別の行。前後の年度で関係のありそうな取組は、取組のページの頭に前回までの取組・後続の取組として出しています）。キーワードは「子ども」「子供」「こども」・「障害」「障がい」のどの書き方でも同じように探せます。部局は最新の報告での所管部局です。
    絞り込みの「遅れ」は「やや遅れ」「大幅遅れ」「未着手」で、「4年とも遅れ」「3年以上遅れ」は4年とも報告にある取組だけを数えています。進捗状況の理由は、取組のページの「年度ごとの活動と検証」にあります。
    観光ロードマップにしか無い取組は、<a href={KANKO_TORIKUMI_HREF}>{KANKO.short}の取組をさがす</a>で見られます。
  </p>
  <noscript><p>この検索には JavaScript が必要です。<a href="/shisaku/">施策の一覧</a>から各施策のページで取組を見ることもできます。</p></noscript>
</Base>

<style>
  /* 結果の行の形は styles/global.css の .t-row */
  /* 検索用のデータが届くまで、一覧の場所を画面の高さぶん取っておく（箱は描かない）。空のままだと下の注記が最初の画面に見え、
     データが届いて行を描くと押し出されて、ページが大きくずれていた（CLS。docs/site.md の 7章）。
     スクリプトが動かないときは取らない（<head> のスクリプトが html に js を付ける） */
  :global(:root.js) #results[aria-busy='true'] { display: block; min-height: 100vh; background: none; border-color: transparent; box-shadow: none; }
</style>
