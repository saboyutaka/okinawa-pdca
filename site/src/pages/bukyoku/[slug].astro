---
import Base from '../../layouts/Base.astro';
import StatusChart from '../../components/StatusChart.astro';
import AmountChart from '../../components/AmountChart.astro';
import Chip from '../../components/Chip.astro';
import Stamps from '../../components/Stamps.astro';
import Sz from '../../components/Sz.astro';
import ThemeTags from '../../components/ThemeTags.astro';
import { getThemes, themesOf, themeIdsOfItem } from '../../lib/themes.js';
import { JUDGE_UI } from '../../lib/icons.js';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, RATE_BINS, DEPTS, REORGANIZED, judgeOf, rateBin, countBy, toneOfStatus,
  getTorikumiGroups, getShisakuList, getSeika, seikaDept, seikaHref, seikaKeyOf, deptHref, JUDGEMENTS, toneOfJudgement,
  FUNDS, AMOUNT_KINDS, amountEntries, currentDeptOf, budgetKey,
} from '../../lib/data.js';
import { yen } from '../../lib/format.js';
import { fmt, pct } from '../../lib/format.js';

export function getStaticPaths() {
  return DEPTS.map((d) => ({ params: { slug: d.slug } }));
}

const dept = DEPTS.find((d) => d.slug === Astro.params.slug);
const statusKeys = STATUSES.map((s) => s.key);
const last = YEARS.length - 1;
const mine = getTorikumiGroups().filter((g) => g.dept === dept.name);
const latest = mine.filter((g) => g.statuses[last]);
const okLatest = latest.filter((g) => g.statuses[last] === '順調').length;
const delayed = mine.filter((g) => g.inAllYears && g.delayYears >= 3).sort((a, b) => b.delayYears - a.delayYears);
const shisaku = getShisakuList().filter((s) => s.depts.includes(dept.name));

const progressRows = YEARS.map((y, i) => ({
  label: yearLabel(y),
  counts: countBy(mine.filter((g) => g.statuses[i]), (g) => g.statuses[i], statusKeys),
}));

// 課ごと（最新年度）
const sections = [...new Set(latest.map((g) => g.section))];
const sectionRows = sections
  .map((sec) => ({ label: sec.replace(dept.name, ''), counts: countBy(latest.filter((g) => g.section === sec), (g) => g.statuses[last], statusKeys) }))
  .sort((a, b) => Object.values(b.counts).reduce((x, y) => x + y, 0) - Object.values(a.counts).reduce((x, y) => x + y, 0));

const seikaRows = YEARS.map((y) => ({
  label: yearLabel(y),
  counts: countBy(getSeika(y).filter((s) => seikaDept(s) === dept.name), rateBin, RATE_BINS.map((b) => b.key)),
}));
const seikaLatest = getSeika(LATEST).filter((s) => seikaDept(s) === dept.name);
const seikaOk = seikaLatest.filter((s) => rateBin(s) === '100%以上').length;

// 予算（最新の報告。予算事業は最初に出てくる取組の部局に寄せる。docs/data.md 11.4）
const mineEntries = (kind) => amountEntries(LATEST, kind).filter((e) => currentDeptOf(LATEST, e.shisaku_id, e.key) === dept.name);
const budgetRows = ['settled', 'estimate', 'initial'].map((kind) => ({
  label: yearLabel(LATEST + AMOUNT_KINDS[kind].offset),
  sub: AMOUNT_KINDS[kind].label,
  amounts: Object.fromEntries(FUNDS.map((f) => [f.key, mineEntries(kind).filter((e) => e.fund === f.key).reduce((s, e) => s + e.amount, 0)])),
}));
const topBudgets = [...mineEntries('estimate').reduce((m, e) => {
  const k = budgetKey(e.budgetName);
  const g = m.get(k) || { name: e.budgetName, amount: 0, funds: new Set(), shisaku_id: e.shisaku_id };
  g.amount += e.amount;
  g.funds.add(e.fund);
  return m.set(k, g);
}, new Map()).values()].sort((a, b) => b.amount - a.amount).slice(0, 5);
const shisakuById = new Map(getShisakuList().map((s) => [s.id, s]));
---
<Base title={`${dept.name}の取組`} description={`沖縄県PDCA: ${dept.name}が所管する主な取組と成果指標の進み具合（令和4〜7年度）`}>
  <nav class="breadcrumb"><a href="/">トップ</a> › <a href="/bukyoku/">部局</a> › {dept.name}</nav>
  <h1>{dept.name}</h1>
  {REORGANIZED.has(dept.name) && (
    <p class="notice">
      令和5年度の組織再編で、旧子ども生活福祉部・旧保健医療部から取組が移ってきています。R4の数値は、その取組がR5以降に所管されている部局に寄せて数えています。
    </p>
  )}

  <div class="cards">
    <div class="card">
      <div class="tile-label">{yearLong(LATEST)}の主な取組</div>
      <div class="tile-value">{fmt(latest.length)}<small>件</small></div>
      <div class="tile-sub">「順調」 {fmt(okLatest)}件（{pct(okLatest, latest.length)}）</div>
    </div>
    <div class="card">
      <div class="tile-label">4年のうち3年以上遅れている取組</div>
      <div class="tile-value">{fmt(delayed.length)}<small>件</small></div>
      <div class="tile-sub">{delayed.length ? <a href="#okure">一覧を見る</a> : '該当なし'}</div>
    </div>
    <div class="card">
      <div class="tile-label">{yearLong(LATEST)}に計画値を達成した成果指標</div>
      <div class="tile-value">{fmt(seikaOk)}<small> / {fmt(seikaLatest.length)}指標</small></div>
      <div class="tile-sub">成果指標の担当部課がこの部局のもの</div>
    </div>
  </div>

  <h2>主な取組の進捗状況</h2>
  <StatusChart title="年度別" categories={STATUSES} rows={progressRows} />
  {sectionRows.length > 1 && (
    <StatusChart title={`課ごと（${yearLong(LATEST)}）`} categories={STATUSES} rows={sectionRows} />
  )}

  <section aria-labelledby="seika">
    <h2 id="seika">成果指標</h2>
    <StatusChart title="計画値に対する達成率" caption="成果指標の担当部課がこの部局のもの。R7で目標値・計画値が見直されているため、R6以前とは単純に比べられません。" categories={RATE_BINS} rows={seikaRows} unit="指標" />
  </section>

  <section aria-labelledby="yosan">
    <h2 id="yosan">予算</h2>
    {budgetRows.some((r) => Object.values(r.amounts).some((v) => v > 0)) ? (
      <>
        <AmountChart
          title="取組に書かれた予算事業の金額（財源別）"
          caption={`${yearLabel(LATEST)}の報告の前年度決算額・決算見込額・翌年度当初予算額。同じ予算事業の重複を除いています。`}
          categories={FUNDS}
          rows={budgetRows}
        />
        <h3>金額の大きい予算事業（{yearLong(LATEST)}の決算見込額）</h3>
        <ul class="list">
          {topBudgets.map((g) => {
            const s = shisakuById.get(g.shisaku_id);
            return (
              <li class="item">
                <strong>{g.name}</strong> <span class="big">{yen(g.amount)}</span> <small class="secondary">（{[...g.funds].join('・')}）</small>
                {s && <div class="small"><Sz id={s.shouraizou} /> 施策 <a href={`/shisaku/${s.id}/`}>{s.name}</a> <span class="code-no">{s.code}</span></div>}
              </li>
            );
          })}
        </ul>
        <p class="small"><a href="/yosan/">予算と財源</a>・<a href="/yosan/zaigen/">財源のしくみ</a></p>
      </>
    ) : <p class="secondary">この部局の検証票（予算）は手に入っていません（<a href="/yosan/#coverage">予算と財源</a>の「部局票がある範囲」）。</p>}
  </section>

  <section aria-labelledby="lists" id="dept-lists">
    <h2 id="lists">{dept.name}の取組・成果指標・施策</h2>
    <form class="filters sticker" role="search" aria-label="この部局の一覧の絞り込み" data-filter="#dept-lists" data-count="#dcount" data-empty="#dempty" data-summary="#active">
      <label data-label="テーマ"><span class="lbl">くらしのテーマ <span class="own">独自の分類</span></span>
        <select name="theme">
          <option value="">すべて</option>
          {getThemes().map((t) => <option value={t.id}>{t.label}</option>)}
        </select>
      </label>
      <label class="q" data-label="キーワード">キーワード
        <input type="search" name="q" placeholder="例: 離島、子ども" />
      </label>
    </form>
    <div class="active-filters" id="active" hidden></div>
    <p class="result-count" aria-live="polite">下の3つの一覧で <span id="dcount">{fmt(delayed.length + seikaLatest.length + shisaku.length)}</span>件を表示</p>
    <p id="dempty" class="secondary" hidden>条件に合うものはありません。</p>

    <div class="anchor" id="okure" {...(delayed.length ? { 'data-group': '' } : {})}>
      <h3>遅れが続いている取組（<span data-group-count>{fmt(delayed.length)}</span>件）</h3>
      {delayed.length === 0 ? <p class="secondary">4年のうち3年以上遅れている取組はありません。</p> : (
        <ul class="dcards">
          {delayed.map((g) => {
            const themes = themeIdsOfItem(g.shisaku.id, g.latest.name);
            return (
              <li class="item dcard" data-item data-theme={themes.join('|')} data-text={`${g.latest.name} ${g.section} ${g.shisaku.code} ${g.shisaku.name}`}>
                <a class="d-name" href={g.href}>{g.latest.name}</a>
                <div class="small secondary">{g.section}</div>
                <div class="small"><Sz id={g.shisaku.shouraizou} /> 施策 <a href={`/shisaku/${g.shisaku.id}/`}>{g.shisaku.name}</a> <span class="code-no">{g.shisaku.code}</span></div>
                <ThemeTags ids={themes} />
                <Stamps items={YEARS.map((y, i) => (g.statuses[i] ? { year: y, tone: toneOfStatus(g.statuses[i]), text: g.statuses[i] } : { year: y, tone: null, text: '報告なし' }))} label="4年の進捗状況" size="small" />
                <div class="small secondary">活動指標（{yearLabel(g.latest.year)}）: {g.latest.indicator}　目標 {g.latest.target || '—'} → 実績 {g.latest.actual || '—'}</div>
              </li>
            );
          })}
        </ul>
      )}
    </div>

    {seikaLatest.length > 0 && (
      <div class="anchor" id="seika-list" data-group>
        <h3>{yearLong(LATEST)}の成果指標（<span data-group-count>{fmt(seikaLatest.length)}</span>）</h3>
        <ul class="list">
          {seikaLatest.map((x) => {
            const s = shisakuById.get(x.shisaku_id);
            const bin = rateBin(x);
            const themes = themeIdsOfItem(x.shisaku_id, x.name);
            return (
              <li class="item" data-item data-theme={themes.join('|')} data-text={`${x.name} ${x.dept || ''} ${s?.code} ${s?.name}`}>
                <a href={seikaHref(x.shisaku_id, seikaKeyOf(x))}><strong>{x.name}</strong></a>
                <span class="small secondary">　{x.dept}</span>
                {s && <div class="small"><Sz id={s.shouraizou} /> 施策 <a href={`/shisaku/${s.id}/`}>{s.name}</a> <span class="code-no">{s.code}</span></div>}
                <ThemeTags ids={themes} />
                <div class="tags">
                  <Chip tone={RATE_BINS.find((b) => b.key === bin)?.tone} text={x.rate != null ? `達成率 ${x.rate}%` : (x.rate_raw === '達成' || x.rate_raw === '未達成' ? x.rate_raw : '達成率なし')} />
                  {x.judgement && <Chip tone={toneOfJudgement(x.judgement)} text={`見通し: ${x.judgement}`} />}
                </div>
              </li>
            );
          })}
        </ul>
        <p class="small"><a href={`/shihyou/?dept=${encodeURIComponent(dept.name)}`}>{dept.name}の成果指標を成果指標のページでさがす</a></p>
      </div>
    )}

    <div class="anchor" id="shisaku" data-group>
      <h3>関係する施策（<span data-group-count>{fmt(shisaku.length)}</span>）</h3>
      <p class="small secondary">施策の「関係部等」にこの部局が書かれている施策です。</p>
      <ul class="list">
        {shisaku.map((s) => {
          const j = judgeOf(s.judges[LATEST]);
          const themes = themesOf(s.id).map((t) => t.id);
          return (
            <li class="item" data-item data-theme={themes.join('|')} data-text={`${s.code} ${s.name}`}>
              <div class="name-row"><span><Sz id={s.shouraizou} /> <a href={`/shisaku/${s.id}/`}>{s.name}</a></span><span class="code-no">{s.code}</span></div>
              <div>{j ? <Chip tone={j.tone} text={`${yearLabel(LATEST)} ${j.key} ${j.label}`} shape={JUDGE_UI[j.key].shape} /> : <Chip text="判定なし" />}</div>
              <ThemeTags ids={themes} />
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  <p><a href={`/torikumi/?dept=${encodeURIComponent(dept.name)}`}>{dept.name}の取組をすべて見る</a></p>
</Base>

<script src="../../scripts/list-filter.js"></script>

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 4px; }
  .list :global(.chip) { white-space: normal; }
  .list .item, .dcard { display: grid; gap: 4px; }
  .dcards { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .d-name { font-family: var(--font-display); font-weight: 700; line-height: 1.5; }
  #dept-lists h3 { margin-top: 1.8em; }
</style>
