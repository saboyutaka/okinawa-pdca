---
// 部局1つのページ。将来像のページと同じ並び: ひとめで（取組と成果の割合）→ 施策の判定と前の年度からの変化 → 課ごと → 4年間の推移・予算 → 一覧
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../lib/routes.ts';
import Base from '../../layouts/Base.astro';
import HeadKind from '../../components/HeadKind.astro';
import HeadStats from '../../components/HeadStats.astro';
import DonutCard from '../../components/DonutCard.astro';
import Moves, { type MoveGroup } from '../../components/Moves.astro';
import JudgeMatrix from '../../components/JudgeMatrix.astro';
import TrendFigure from '../../components/TrendFigure.astro';
import StatusChart from '../../components/StatusChart.astro';
import AmountChart from '../../components/AmountChart.astro';
import Sz from '../../components/Sz.astro';
import SeikaRow from '../../components/SeikaRow.astro';
import SeikaKey from '../../components/SeikaKey.astro';
import Term from '../../components/Term.astro';
import ShisakuItem from '../../components/ShisakuItem.astro';
import JudgeLegend from '../../components/JudgeLegend.astro';
import FilterMore from '../../components/FilterMore.astro';
import ShareBox from '../../components/ShareBox.astro';
import Toc from '../../components/Toc.astro';
import ExtLink from '../../components/ExtLink.astro';
import SecHead from '../../components/SecHead.astro';
import { getThemes, themeIdsOf } from '../../lib/themes.ts';
import {
  YEARS, LATEST, yearLabel, yearLong, STATUSES, RATE_BINS, REORGANIZED, rateBin, countBy,
  getTorikumiGroups, getShisakuList, getTorikumi, getSeika, seikaDept, seikaHref, seikaGroupOf, shisakuDepts,
  sectionName, sectionAnchor, deptHref, deptSourcePages, torikumiPage,
  FUNDS, AMOUNT_KINDS, amountEntries, currentDeptOf, budgetKey,
} from '../../lib/data.ts';
import type { AmountKind, SeikaRow as SeikaRowT } from '../../lib/types.ts';
import { LINKS } from '../../lib/links.ts';
import { fmt, pct, yen } from '../../lib/format.ts';
import { deptDescription } from '../../lib/describe.ts';
import { deptHead } from '../../lib/heads.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['bukyoku/[slug]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { dept } = Astro.props;
const q = encodeURIComponent(dept.name);
const statusKeys = STATUSES.map((s) => s.key);
const last = YEARS.length - 1;
const mine = getTorikumiGroups().filter((g) => g.dept === dept.name);
const latest = mine.filter((g) => g.statuses[last]);
const okLatest = latest.filter((g) => g.statuses[last] === '順調').length;
const reached = (s: SeikaRowT) => rateBin(s) === '100%以上';
const seikaLatest = getSeika(LATEST).filter((s) => seikaDept(s) === dept.name);
const seikaOk = seikaLatest.filter(reached).length;
const allTori = getTorikumi(LATEST);
const allSeika = getSeika(LATEST);
const allToriRate = pct(allTori.filter((t) => t.status === '順調').length, allTori.length);
const allSeikaRate = pct(allSeika.filter(reached).length, allSeika.length);

// この部局がかかわる施策: 関係部等に名前がある施策と、関係部等には無いがこの部局の取組がある施策（lib/data.ts の shisakuDepts。施策をさがすの部局の絞り込みと同じ）
const related = getShisakuList().flatMap((s) => {
  const ds = shisakuDepts(s);
  const role = ds.find((d) => d.dept === dept.name)?.role;
  return role ? [{ s, role, kankei: ds.filter((d) => d.role === 'kankei').map((d) => d.dept) }] : [];
});
const kankeiList = related.filter((r) => r.role === 'kankei');
const toriList = related.filter((r) => r.role === 'torikumi');
// 関係部等に無い施策の行に出す、その施策のこの部局の取組の数（最新の年度。最新の年度に無ければ全年度）
const toriText = (shisakuId: string) => {
  const gs = mine.filter((g) => g.shisaku.id === shisakuId);
  const n = gs.filter((g) => g.statuses[last]).length;
  return n ? `この部局の取組 ${fmt(n)}件` : `この部局の取組 ${fmt(gs.length)}件（${yearLabel(LATEST)}の報告には無い）`;
};
// 最新の年度の数（ページの説明文・SNS のカードの画像と同じ数。lib/heads.ts）
const head = deptHead(dept.name);
const judgeCounts = head.judges;

// 課ごと（最新年度）。行の id は、取組のページの「所管」のリンクの行き先（lib/data.ts の sectionHref）
const sections = [...new Set(latest.map((g) => g.section))];
const sectionRows = sections
  .map((sec) => ({
    label: sectionName(sec) || sec,
    id: sectionAnchor(sec),
    href: `/torikumi/?dept=${q}&q=${encodeURIComponent(sectionName(sec) || sec)}`,
    counts: countBy(latest.filter((g) => g.section === sec), (g) => g.statuses[last]!, statusKeys),
  }))
  .sort((a, b) => Object.values(b.counts).reduce((x, y) => x + y, 0) - Object.values(a.counts).reduce((x, y) => x + y, 0));

// 4年間の推移。取組は最新の所管部局に寄せて数える。成果指標が無い年度がある部局は、折れ線を描かずに内訳の図だけ出す
const trend = YEARS.map((y, i) => {
  const t = mine.filter((g) => g.statuses[i]);
  const s = getSeika(y).filter((x) => seikaDept(x) === dept.name);
  const aOk = t.filter((g) => g.statuses[i] === '順調').length;
  const bOk = s.filter(reached).length;
  return { y, a: t.length ? (aOk / t.length) * 100 : 0, b: s.length ? (bOk / s.length) * 100 : 0, aOk, aN: t.length, bOk, bN: s.length };
});
const drawTrend = trend.every((p) => p.aN > 0 && p.bN > 0);
const period = (y: number) => (y <= 2024 ? '前期' : '中期');
const progressRows = YEARS.map((y, i) => ({
  label: yearLabel(y),
  sub: period(y),
  counts: countBy(mine.filter((g) => g.statuses[i]), (g) => g.statuses[i]!, statusKeys),
}));
const seikaRows = YEARS.map((y) => ({
  label: yearLabel(y),
  sub: period(y),
  counts: countBy(getSeika(y).filter((s) => seikaDept(s) === dept.name), rateBin, RATE_BINS.map((b) => b.key)),
}));

// 前の年度からの変化。かかわる施策の判定（lib/data.ts の JUDGE_TRENDS）と、主な取組の進捗状況（PATTERNS）を、良くなったものと悪くなったものの対で並べる
const relatedShisaku = related.map((r) => r.s);
const moves: MoveGroup[] = [
  ...(related.length ? [{ label: 'かかわる施策の判定', unit: '施策', items: [
    { tone: 'good' as const, title: '判定が上がった', n: relatedShisaku.filter((s) => s.trends.includes('up')).length, href: `/shisaku/?dept=${q}&trend=up` },
    { tone: 'serious' as const, title: '判定が下がった', n: relatedShisaku.filter((s) => s.trends.includes('down')).length, href: `/shisaku/?dept=${q}&trend=down` },
  ] }] : []),
  { label: '主な取組の進捗状況', unit: '件', items: [
    { tone: 'good', title: '遅れから「順調」に戻った', n: mine.filter((g) => g.patterns.includes('recover')).length, href: `/torikumi/?dept=${q}&pat=recover` },
    { tone: 'serious', title: '新しく遅れが出た', n: mine.filter((g) => g.patterns.includes('newdelay')).length, href: `/torikumi/?dept=${q}&pat=newdelay` },
  ] },
];

// 予算（最新の報告。予算事業は最初に出てくる取組の部局に寄せる。docs/data.md 11.4）
const mineEntries = (kind: AmountKind) => amountEntries(LATEST, kind).filter((e) => currentDeptOf(LATEST, e.shisaku_id, e.key) === dept.name);
const budgetRows = (['settled', 'estimate', 'initial'] as const).map((kind) => ({
  label: yearLabel(LATEST + AMOUNT_KINDS[kind].offset),
  sub: AMOUNT_KINDS[kind].label,
  amounts: Object.fromEntries(FUNDS.map((f) => [f.key, mineEntries(kind).filter((e) => e.fund === f.key).reduce((s, e) => s + e.amount, 0)])),
}));
const topBudgets = [...mineEntries('estimate').reduce((m, e) => {
  const k = budgetKey(e.budgetName);
  const g = m.get(k) || { name: e.budgetName, amount: 0, funds: new Set<string>(), shisaku_id: e.shisaku_id, key: e.key, torikumi: e.torikumi };
  g.amount += e.amount;
  g.funds.add(e.fund);
  return m.set(k, g);
}, new Map<string, { name: string; amount: number; funds: Set<string>; shisaku_id: string; key: string; torikumi: string }>()).values()]
  .sort((a, b) => b.amount - a.amount)
  .slice(0, 5);
const shisakuById = new Map(getShisakuList().map((s) => [s.id, s]));
const sources = deptSourcePages(dept.name);
---
<Base title={`沖縄県${dept.name}の取組`} description={deptDescription(dept.name, head)} ogType="article">
  <header class="sticker lift page-head">
    <HeadKind kind="部局" term={false} />
    <h1>{dept.name}</h1>
    <HeadStats items={[
      { label: '課', n: sections.length, href: '#ka' },
      { label: '主な取組', n: latest.length, href: `/torikumi/?dept=${q}`, note: yearLabel(LATEST) },
      { label: '成果指標', n: seikaLatest.length, href: seikaLatest.length ? '#seika-list' : '#lists', note: yearLabel(LATEST) },
      { label: '施策', n: related.length, href: '#shisaku' },
    ]} />
  </header>

  <div class="donuts">
    <DonutCard frac={latest.length ? okLatest / latest.length : 0} label={`主な取組のうち順調 ${pct(okLatest, latest.length)}`}>
      主な取組のうち「順調」
      <Fragment slot="sub">{fmt(latest.length)}件のうち{fmt(okLatest)}件（{yearLong(LATEST)}）。県全体は{allToriRate}。</Fragment>
    </DonutCard>
    {seikaLatest.length > 0 && (
      <DonutCard frac={seikaOk / seikaLatest.length} label={`成果指標のうち計画値に到達 ${pct(seikaOk, seikaLatest.length)}`}>
        <Term word="成果指標" />のうち<Term word="計画値" />に到達
        <Fragment slot="sub">{fmt(seikaLatest.length)}指標のうち{fmt(seikaOk)}指標（{yearLong(LATEST)}）。担当部課がこの部局の指標です。県全体は{allSeikaRate}。</Fragment>
      </DonutCard>
    )}
  </div>

  <Toc
    links={[
      related.length > 0 && { href: '#judge', label: '施策の判定' },
      { href: '#moves', label: '前の年度からの変化' },
      { href: '#ka', label: '課ごとの取組' },
      { href: '#trend', label: '4年間の推移' },
      { href: '#yosan', label: '予算' },
      { href: '#lists', label: '成果指標・施策' },
      { href: '#source', label: '出典' },
    ]}
    head={{ kind: '部局', title: dept.name }}
  />

  {related.length > 0 && (
    <section aria-labelledby="judge">
      <SecHead id="judge" class="anchor">かかわる施策の判定（{yearLong(LATEST)}）</SecHead>
      <p class="small secondary lead">関係部等にこの部局の名前がある施策と、この部局の主な取組がある施策です。マスを押すと、{dept.name}とその判定で絞り込んだ施策の一覧を開きます。</p>
      <JudgeMatrix counts={judgeCounts} caption={`${dept.name}がかかわる${fmt(related.length)}施策`} hrefOf={(k) => `/shisaku/?dept=${q}&judge=${k}`} />
    </section>
  )}

  <section aria-labelledby="moves">
    <SecHead id="moves" class="anchor">前の年度からの変化</SecHead>
    <p class="small secondary lead">{yearLong(LATEST - 1)}と{yearLong(LATEST)}の報告を比べました。判定は A → B → C〜F → G の順で比べ、C〜F の中での入れ替わりは数えません。取組の遅れ＝やや遅れ・大幅遅れ・未着手。</p>
    <Moves groups={moves} />
  </section>

  <section aria-labelledby="ka">
    <SecHead id="ka" class="anchor">課ごとの主な取組</SecHead>
    <p class="small secondary lead">{yearLong(LATEST)}の主な取組の<Term word="進捗状況" />です。課の名前を押すと、その課の取組を取組をさがすで開きます。</p>
    <StatusChart title={`${dept.name}の課（${yearLong(LATEST)}）`} categories={STATUSES} rows={sectionRows} />
  </section>

  <section aria-labelledby="trend">
    <SecHead id="trend" class="anchor">4年間の推移</SecHead>
    {drawTrend ? (
      <>
        <TrendFigure points={trend} name={dept.name} />
        <details class="breakdown">
          <summary>内訳を見る（進捗状況・達成率の区分ごと）</summary>
          <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
          <StatusChart title="成果指標の達成状況" categories={RATE_BINS} rows={seikaRows} unit="指標" />
        </details>
      </>
    ) : (
      <StatusChart title="主な取組の進捗状況" categories={STATUSES} rows={progressRows} />
    )}
    <p class="small secondary">令和4〜6年度は<ExtLink href={LINKS.zenki}>前期実施計画</ExtLink>、令和7年度からは<ExtLink href={LINKS.chuki}>中期実施計画</ExtLink>です。令和7年度に基準値・目標値・計画値が新しくなったため、成果指標の割合は計画期間をまたいで単純には比べられません。</p>
    {REORGANIZED.has(dept.name) && (
      <p class="small secondary">令和5年度の組織再編で、旧子ども生活福祉部・旧保健医療部から取組が移ってきています。令和4年度の数は、その取組が令和5年度以降に所管されている部局に寄せて数えています。</p>
    )}
  </section>

  <section aria-labelledby="yosan">
    <SecHead id="yosan" class="anchor">予算</SecHead>
    {budgetRows.some((r) => Object.values(r.amounts).some((v) => v > 0)) ? (
      <>
        <AmountChart
          title="取組に書かれた予算事業の金額（財源別）"
          caption={`${yearLong(LATEST)}の報告の前年度決算額・決算見込額・翌年度当初予算額。同じ予算事業の重複を除いています。`}
          categories={FUNDS}
          rows={budgetRows}
        />
        <h3>金額の大きい予算事業（{yearLong(LATEST)}の決算見込額）</h3>
        <ul class="row-list">
          {topBudgets.map((g) => {
            const s = shisakuById.get(g.shisaku_id);
            const tHref = torikumiPage(g.shisaku_id, g.key);
            return (
              <li class="b-row">
                <div class="b-main">
                  <strong>{g.name}</strong>
                  <div class="small secondary">取組 {tHref ? <a class="sub-link" href={tHref}>{g.torikumi}</a> : g.torikumi}</div>
                  {s && <div class="small secondary"><Sz id={s.shouraizou} /> 施策 <a class="sub-link" href={`/shisaku/${s.id}/`}>{s.name}</a> <span class="code-no">{s.code}</span></div>}
                </div>
                <div class="b-amt">
                  <span class="big">{yen(g.amount)}</span>
                  <span class="small secondary">{[...g.funds].join('・')}</span>
                </div>
              </li>
            );
          })}
        </ul>
        <p class="small"><a href="/yosan/">予算と財源</a>・<a href="/yosan/zaigen/">財源のしくみ</a></p>
      </>
    ) : <p class="secondary">この部局の検証票（予算）は手に入っていません（<a href="/yosan/#coverage">予算と財源</a>の「部局票がある範囲」）。</p>}
  </section>

  <section aria-labelledby="lists" id="dept-lists">
    <SecHead id="lists" class="anchor">{dept.name}の成果指標・施策</SecHead>
    <p class="small">{dept.name}の{yearLong(LATEST)}の主な取組（{fmt(latest.length)}件）は、<a href={`/torikumi/?dept=${q}`}>取組をさがす</a>で進捗状況や4年間の様子で絞り込んで見られます。</p>
    <form class="filters sticker" role="search" aria-label="この部局の一覧の絞り込み" data-filter="#dept-lists" data-count="#dcount" data-empty="#dempty" data-summary="#active">
      <label class="q" data-label="キーワード">キーワード（指標・施策の名前）
        <input type="search" name="q" placeholder="例: 離島、子ども" />
      </label>
      <FilterMore id="dept-more">
        <label data-label="テーマ"><span class="lbl">くらしのテーマ <span class="own">独自の分類</span></span>
          <select name="theme">
            <option value="">すべて</option>
            {getThemes().map((t) => <option value={t.id}>{t.label}</option>)}
          </select>
        </label>
      </FilterMore>
    </form>
    <div class="active-filters" id="active" hidden></div>
    <p class="result-count" aria-live="polite" aria-atomic="true">下の一覧で <span id="dcount">{fmt(seikaLatest.length + related.length)}</span>件を表示</p>
    <p id="dempty" class="secondary" hidden>条件に合うものはありません。</p>

    {seikaLatest.length > 0 && (
      <div class="anchor" id="seika-list" data-group>
        <h3>{yearLong(LATEST)}の成果指標（<span data-group-count>{fmt(seikaLatest.length)}</span>）</h3>
        <p class="small secondary">担当部課がこの部局の指標です。右の札は<Term word="達成率" />です。</p>
        <SeikaKey mini />
        <ul class="row-list">
          {seikaLatest.map((x) => {
            const s = shisakuById.get(x.shisaku_id);
            const row = seikaGroupOf(x)!; // どの成果指標の行も、施策の成果指標のまとまりにある
            return (
              <SeikaRow
                x={x}
                row={row}
                shisaku={s}
                href={seikaHref(x.shisaku_id, row.key)}
                attrs={{ 'data-item': '', 'data-theme': themeIdsOf(x.shisaku_id).join('|'), 'data-text': `${row.name} ${x.dept || ''} ${s?.code} ${s?.name}` }}
              />
            );
          })}
        </ul>
        <p class="small"><a href={`/shihyou/?dept=${q}`}>{dept.name}の成果指標をさがす</a></p>
      </div>
    )}

    {related.length > 0 && (
      <div class="anchor" id="shisaku" data-group>
        <h3>かかわる施策（<span data-group-count>{fmt(related.length)}</span>）</h3>
        <JudgeLegend />
        {kankeiList.length > 0 && (
          <div data-group>
            <h4>関係部等にこの部局の名前がある施策（<span data-group-count>{fmt(kankeiList.length)}</span>）</h4>
            <ul class="row-list">
              {kankeiList.map(({ s }) => (
                <ShisakuItem s={s} kihon attrs={{ 'data-item': '', 'data-theme': themeIdsOf(s.id).join('|'), 'data-text': `${s.code} ${s.name}` }} />
              ))}
            </ul>
          </div>
        )}
        {toriList.length > 0 && (
          <div data-group>
            <h4>この部局の取組がある、ほかの部局の施策（<span data-group-count>{fmt(toriList.length)}</span>）</h4>
            <p class="small secondary">施策の関係部等には名前が無いものの、この部局が所管する主な取組がある施策です。</p>
            <ul class="row-list">
              {toriList.map(({ s, kankei }) => (
                <ShisakuItem s={s} attrs={{ 'data-item': '', 'data-theme': themeIdsOf(s.id).join('|'), 'data-text': `${s.code} ${s.name} ${kankei.join(' ')}` }}>
                  <Fragment slot="sub">
                    関係部等 {kankei.length ? kankei.map((d, i) => <>{i > 0 && '、'}{deptHref(d) ? <a class="sub-link" href={deptHref(d)}>{d}</a> : d}</>) : (s.kankei || '—')}・{toriText(s.id)}
                  </Fragment>
                </ShisakuItem>
              ))}
            </ul>
          </div>
        )}
        <p class="small"><a href={`/shisaku/?dept=${q}`}>{dept.name}の施策を施策をさがすで見る</a></p>
      </div>
    )}
  </section>

  <ShareBox kind="部局" name={dept.name} />

  <section aria-labelledby="source">
    <SecHead id="source" class="anchor">出典</SecHead>
    <p class="small">主な取組の進捗状況・成果指標・施策の判定は、県の「<ExtLink href={LINKS.kekka} after="」">沖縄県PDCA実施結果</ExtLink>の総括報告書から読み取っています（1件ずつの出典は、施策と取組のページにあります）。予算は、部局ごとの検証票から読み取っています。</p>
    {sources.length > 0 && (
      <ul class="small">
        {sources.map((p) => (
          <li>{p.years.map(yearLabel).join('・')}: <ExtLink href={p.href}>{p.title}</ExtLink>{p.n > 0 && <span class="secondary">（この部局の取組 {fmt(p.n)}件）</span>}</li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .breakdown { margin-top: 16px; }
  .b-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 20px; align-items: center; }
  .b-main { display: grid; gap: 2px; min-width: 0; line-height: 1.6; }
  .b-amt { display: grid; justify-items: end; text-align: right; }
  .b-amt .big { font-size: 1.2rem; white-space: nowrap; }
  @media (max-width: 560px) { .b-row { grid-template-columns: 1fr; } .b-amt { justify-items: start; text-align: left; } }
  #dept-lists h3 { margin-top: 1.8em; }
  #dept-lists h4 { margin: 1.2em 0 0.5em; font-size: 0.98rem; }
</style>
