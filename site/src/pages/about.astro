---
import Base from '../layouts/Base.astro';
import { YEARS, LATEST, yearLabel, yearLong, load, getTorikumi, getSeika, rateBin, SEIKA_REACHED_PUBLISHED, amountEntries, getFinanceReference, getBudgetRecords } from '../lib/data.ts';
import { fmt } from '../lib/format.ts';
import { LINKS, PROJECT, SITE } from '../lib/links.ts';
import { HASHTAG } from '../lib/iken.ts';
import { TERMS } from '../lib/terms.ts';
import { getThemes, unthemed } from '../lib/themes.ts';
import ExtLink from '../components/ExtLink.astro';
import PlanMap from '../components/PlanMap.astro';

// 年度ごとの県の公開ページ（総括報告書の掲載ページ）と、そこから読んだ総括報告書のPDFの数（zip の中のものを含む）
const sources = load('sources');
const pages = YEARS.flatMap((y) => {
  const rows = sources.filter((s) => s.year === y);
  const page = rows.find((s) => s.page_url);
  return page ? [{ ...page, pdf: rows.length, zip: rows.filter((s) => s.zip_member).length }] : [];
});
// 読んだ部局の検証票（主な取組・成果指標）のPDFの数（年度別）
const bukyokuFiles = load('bukyoku/files');
const bukyokuPdf = YEARS.map((y) => `${yearLabel(y)} ${fmt(bukyokuFiles.filter((f) => f.year === y).length)}`).join('・');
// 沖縄県PDCAのほかの資料で出典にしているPDFの数（評価検証報告書は本文だけを読んでいる）
const kankoPdf = load('kanko/sources').length;
const ikkatsuPdf = load('ikkatsu/sources').length;
const hyokaPdf = load('hyoka/sources').filter((s) => s.kind === 'honbun').length;
// 主な取組の予算事業（最新の報告の決算見込額、重複を除く）と、県の一般会計の規模の比較（目安）
const torikumiBudget = Math.round(amountEntries(LATEST, 'estimate').reduce((s, e) => s + e.amount, 0) / 1e5);
const prefBudget = getFinanceReference().prefecture;
// 進捗状況の欄が空欄・「-」の取組の件数（年度別）
const blanks = YEARS.map((y) => [y, getTorikumi(y).filter((t) => !t.status).length]).filter(([, n]) => n > 0);
// 部局票の取組のうち、活動内容・判定の根拠・改善案の反映状況・検証・改善案のどれかが空のもの（docs/issues.md の A9 と同じ欄）
const records = getBudgetRecords();
const emptyFields = records.filter((b) => (['activity_done', 'basis', 'improvements', 'check', 'action'] as const).some((k) => !b[k]?.length)).length;
const themes = getThemes();
// 言葉は当たるが内容が合わないため、テーマから個別に外している施策の数（themes.json の exclude）
const excluded = themes.reduce((n, t) => n + t.exclude.length, 0);
// 一括交付金の事業のうち、検証シートを画像から読んだもの（R5の一部）と、施策を別の年度の同じ名前の事業から補ったもの
const ikkatsu = load('ikkatsu/jigyo');
const ikkatsuImage = ikkatsu.filter((j) => j.sheet_image).length;
const ikkatsuBorrowed = ikkatsu.filter((j) => j.shisaku_from).length;
// 計画値に届いた成果指標の数（このサイトの数え方と概要版）
const reached = YEARS.map((y) => `${yearLabel(y)} ${fmt(getSeika(y).filter((s) => rateBin(s) === '100%以上').length)}`).join('・');
const reachedPub = YEARS.map((y) => `${yearLabel(y)} ${fmt(SEIKA_REACHED_PUBLISHED[y])}`).join('・');
---
<Base title="このサイトについて" description="このサイトの作り手・データの出典・作り方・使っている技術・注意点">
  <h1>このサイトについて</h1>
  <p class="lead">
    沖縄県が公表している「<ExtLink href={LINKS.kekka}>沖縄県PDCA実施結果</ExtLink>」の報告書を読み取り、施策と取組がどこまで進んだかを見やすくまとめ直した非公式のサイトです。<a href="/code-for-okinawa/">{PROJECT.org}</a> が作っていて、県は関わっていません。
  </p>

  <h2 id="naritachi">このサイトのなりたち</h2>
  <p>
    私たちは2021年に、新・沖縄21世紀ビジョン基本計画の骨子案を読む会として「<ExtLink href={PROJECT.miraiTeian}>沖縄未来提案プロジェクト</ExtLink>」を行いました。
    貧困対策・環境・交通・観光・防災など分野ごとの部会に分かれ、それぞれの分野で活動する人たちの知見を持ち寄って、骨子案を読み、パブリックコメントを提出しました。
  </p>
  <p>
    その計画が{yearLong(YEARS[0])}に始まってから{YEARS.length}年。県による評価も{yearLabel(YEARS[0])}〜{yearLabel(LATEST)}の{YEARS.length}年分が公表されています。
    そこで決められた計画や施策のいまを振り返るために、このサイトを作りました。
  </p>
  <p>
    サイトの名前「{SITE.name}」には、計画が描いた沖縄のみらいが、いまどこまで来たかを見る、という意味を込めています。
    縮めて「{SITE.short}」、SNS のハッシュタグは <strong>#{HASHTAG}</strong> です（<a href="/iken/#sns">SNS で話す</a>）。
  </p>

  <h2>沖縄県PDCAとは</h2>
  <p>
    沖縄県は「<ExtLink href={LINKS.kihonKeikaku}>新・沖縄21世紀ビジョン基本計画</ExtLink>」を進めるため、<ExtLink href={LINKS.jisshiKeikaku}>実施計画</ExtLink>に並ぶ施策と取組について、計画（Plan）・実施（Do）・検証（Check）・改善（Action）を毎年度まわしています。
    その検証結果が「<ExtLink href={LINKS.kekka}>沖縄県PDCA実施結果</ExtLink>」で、毎年度、前の年度の分が公表されます（公表の時期は年度によって違い、令和4年度対象は令和6年3月、令和5年度対象は令和6年11月、令和6年度対象は令和7年8月、令和7年度対象は令和8年8月）。仕組みは県の「<ExtLink href={LINKS.pdcaGaiyou}>沖縄県PDCAの概要</ExtLink>」で説明されています。
  </p>

  <h3 id="kaisou">計画の階層と指標のつながり</h3>
  <PlanMap />
  <ul>
    <li id="torikumi">
      <strong>主な取組は、県の事業のすべてではありません。</strong>
      県が実施計画で、施策ごとに「課題の解決に向けた手段となる具体的な事業等」として選んだもので、PDCAはこの主な取組を対象にしています。
      県の一般会計（令和{prefBudget.year - 2018}年度当初 {fmt(prefBudget.total)}億円）に対して、このサイトで集計した主な取組の予算事業は{yearLabel(LATEST)}の決算見込額で約{fmt(torikumiBudget)}億円です
      （一般会計には人件費や借金の返済も含むので、比べるのは目安です。<a href="/yosan/zaigen/">予算の財源のしくみ</a>）。
      主な取組に入っていない県の事業のほか、国・市町村・民間の取組もあり、成果指標の数字はそれらや社会情勢にも左右されます。
      「取組は順調だが、成果は遅れている」施策では、こうした主な取組の外の要因が効いていることもあります。
    </li>
    <li>R4〜R6は<ExtLink href={LINKS.zenki}>前期実施計画</ExtLink>（目標年度R6）、R7からは<ExtLink href={LINKS.chuki}>中期実施計画</ExtLink>（R7〜R9、目標年度R9）です。R7で取組の一部と指標の基準値・目標値が見直されています。</li>
  </ul>

  <h2 id="yougo">用語</h2>
  <p class="small secondary">本文の点線の下線が付いた言葉を押しても、同じ説明が出ます。</p>
  <dl class="terms sticker">
    {Object.entries(TERMS).map(([w, d]) => <div><dt>{w}</dt><dd>{d}</dd></div>)}
  </dl>

  <h2 id="theme">くらしのテーマについて</h2>
  <p>
    <a href="/#themes">くらしのテーマ</a>（{themes.length}テーマ）は、<strong>このサイトが独自にまとめた分類</strong>で、県の計画の分類ではありません。
    施策の名前・施策展開の名前・基本施策の名前に決まった言葉（例: 子ども・子育てなら「子ども」「保育」「ひとり親」など）が含まれる施策を、そのテーマに入れています。
    どの施策もいずれかのテーマに入るように言葉を選んでいて（いまどのテーマにも入らない施策は{fmt(unthemed().length)}）、1つの施策が複数のテーマに入ることもあります。
    主な取組・成果指標は、その施策のテーマに加えて、取組・指標の名前に言葉が含まれるテーマにも入れています。
    テーマごとの言葉は、各テーマのページの頭に出しています。言葉は当たっても内容が合わない施策は、個別にテーマから外しています（いま{fmt(excluded)}件）。
  </p>

  <h2 id="shutten">出典</h2>
  <p>沖縄県「<ExtLink href={LINKS.kekka}>沖縄県PDCA実施結果</ExtLink>」の総括報告書（将来像1〜5の本文と付属資料）と、予算・財源と取組ごとの活動・検証・改善案については各部局が公開している「主な取組」検証票（<ExtLink href={LINKS.pdca}>沖縄県PDCA</ExtLink>の各部局のページ）です。</p>
  <ul>
    {pages.map((p) => <li>{yearLong(p.year)}: <ExtLink href={p.page_url}>{p.page_title}</ExtLink>のPDF {fmt(p.pdf)}件{p.zip > 0 && `（うち${fmt(p.zip)}件はzipの中）`}</li>)}
  </ul>
  <p>部局の検証票（主な取組と成果指標）は、{YEARS.length}年分で{fmt(bukyokuFiles.length)}件のPDFを読んでいます（{bukyokuPdf}）。</p>
  <p>各施策・各取組のページの「出典」から、元のPDFの該当ページを開けます（zipで公開されている年度はzipへのリンクです）。</p>
  <p id="others">沖縄県PDCAのほかに、次の県の公表資料も読み取っています。</p>
  <ul>
    <li><a href="/keikaku/kanko/">観光ロードマップ</a>: 沖縄県「<ExtLink href={LINKS.kankoRm}>沖縄観光推進ロードマップ</ExtLink>」の年度別の「沖縄観光推進ロードマップPDCA実施報告書」（R4〜R6、PDF {fmt(kankoPdf)}件）。第6次沖縄県観光振興基本計画の実施計画の評価です。</li>
    <li>施策のページの「一括交付金（ソフト）の事業」と<a href="/yosan/ikkatsu/">一括交付金の事業をさがす</a>: 沖縄県「<ExtLink href={LINKS.ikkatsu}>沖縄振興特別推進交付金の事後評価</ExtLink>」の総括表（成果目標・評価）と検証シート（施策のコード・予算の執行・今後の方針）（R4〜R6、PDF {fmt(ikkatsuPdf)}件）。沖縄県PDCAとは別の評価で、主な取組とは結び付けていません。</li>
    <li>基本施策のページの「県によるふりかえり（R4〜R6）」: 「<ExtLink href={LINKS.hyoka}>新・沖縄21世紀ビジョン基本計画 評価検証報告書</ExtLink>」の本文の第2章（基本施策の推進による成果と課題。PDF {fmt(hyokaPdf)}件）。</li>
  </ul>

  <h2 id="tsukurikata">作り方</h2>
  <ol>
    <li>県のサイトから報告書のPDF・zipを取得します。どのファイルを・いつ・どのページから取ったかを台帳に残し、各ページの「出典」のリンクはこの台帳から作っています。</li>
    <li>総括報告書のPDFの表を機械的に読み取り、施策・主な取組・成果指標・主要指標の表にします。主要指標の達成率は、概要版の表から読み取ります。各部局の「主な取組」検証票からは、予算事業と金額、取組ごとの活動・検証・改善案を読み取ります。</li>
    <li>総括報告書の成果指標と主な取組は、別のプログラムでもう一度読み取り、欄ごとに突き合わせます。食い違いがあれば、元のPDFのページを見て確かめます。見た目は同じでも別の文字（康熙部首など）が混ざると検索で見つからなくなるため、そうした文字が残っていないかも調べます。</li>
    <li>施策総括表に印字された判定（A〜G）が、取組の進捗の内訳と成果指標の達成率から県の区分表どおりに決まっているかを、判定のあるR5〜R7の全施策で確かめます。</li>
    <li>件数を県の概要版の公表値と突き合わせます。施策（339）・主な取組（1,539／1,539／1,539／1,534）・成果指標（393／393／393／391）・基本施策（36）は、4年度とも公表値と一致しています。主要指標（49）の前進・横ばい・後退などの区分ごとの数も、読み取れるR4・R6・R7で概要版と一致しています。</li>
    <li>観光ロードマップ（R5・R6 とも主な取組291件・成果指標100、進捗状況の内訳と「前進」の数）と、一括交付金の事後評価（R4 181・R5 179・R6 176事業と評価の内訳）も、県の公表値と一致しています。</li>
  </ol>
  <p>データを作り直すたびに、これらの突き合わせを自動で行っています。</p>

  <h2 id="gijutsu">使っている技術</h2>
  <p>報告書の取得からサイトの公開まで、次の道具で作っています。</p>
  <dl class="tech sticker">
    <div>
      <dt>データの読み取り</dt>
      <dd>
        <ExtLink href="https://www.python.org/">Python</ExtLink>。PDF の表は <ExtLink href="https://github.com/jsvine/pdfplumber">pdfplumber</ExtLink> で読み取り、<ExtLink href="https://pymupdf.readthedocs.io/">PyMuPDF</ExtLink> で読み直して突き合わせます。読み取った結果から、施策（<code>shisaku.json</code>）・主な取組（<code>torikumi.json</code>）・成果指標（<code>seika.json</code>）などの JSON ファイルを作成します。
      </dd>
    </div>
    <div>
      <dt>サイト</dt>
      <dd>
        <ExtLink href="https://astro.build/">Astro</ExtLink> と <ExtLink href="https://www.typescriptlang.org/">TypeScript</ExtLink>。読み取った JSON から、すべてのページを前もって HTML に書き出しています（静的サイト生成、SSG）。グラフは、グラフ用のライブラリを使わずに SVG と CSS で描いています。
      </dd>
    </div>
    <div>
      <dt>公開</dt>
      <dd><ExtLink href="https://workers.cloudflare.com/">Cloudflare Workers</ExtLink>。GitHub に変更を入れると、Cloudflare がサイトを書き出して公開します。</dd>
    </div>
    <div>
      <dt>開発</dt>
      <dd><ExtLink href="https://www.docker.com/">Docker</ExtLink>（読み取りもサイトの書き出しも、コンテナの中で動かします）、Git と GitHub、画面の確かめに <ExtLink href="https://playwright.dev/">Playwright</ExtLink>。</dd>
    </div>
    <div>
      <dt>AI</dt>
      <dd>読み取りのプログラムやサイトの多くは、AI（Anthropic の <ExtLink href="https://claude.com/product/claude-code">Claude Code</ExtLink>）と一緒に書いています。AI と一緒に書いたものも、上の作り方のとおり、公表値との突き合わせ・別のプログラムでの読み直し・テストで確かめています。</dd>
    </div>
  </dl>
  <p>
    <strong>シビックテックや技術に興味のある方は、{PROJECT.org} で一緒に活動しませんか。</strong>参加の連絡は <ExtLink href={PROJECT.orgUrl}>{PROJECT.org} のサイト</ExtLink>のフォームから受け付けています（<a href="/code-for-okinawa/">{PROJECT.org} とは</a>）。
  </p>

  <h2 id="kazoekata">このサイトでの数え方</h2>
  <ul>
    <li><strong>「順調」の割合</strong>は、その年度の報告にある主な取組のうち、進捗状況が「順調」のものの割合です（「記載なし」も分母に入れています）。</li>
    <li><strong>成果指標の達成状況</strong>は、計画値に対する達成率で「100%以上」「60%以上100%未満」「0%超60%未満」「0%以下」に分けています。報告書に「達成」とあるものは100%以上、「未達成」は0%以下、「-%」などは「達成率なし」です。</li>
    <li><strong>主な取組の件数は、県の数え方と同じく延べ件数です。</strong>1つの取組が複数の施策に載っている（再掲）ことがあり、それぞれ1件と数えています。</li>
    <li><strong>年度をまたいだ同じ取組・同じ成果指標</strong>は、同じ施策の中で名前が同じもの（空白や句読点の違いと、「子ども」「子供」「こども」・「障害」「障がい」の書き方の違いは無視）です。R7の報告から県の書き方が「こども」に変わったため、書き方の違いだけのものは同じ取組・指標として4年分をつないでいます。</li>
    <li><strong>4年のうち3年以上遅れた取組</strong>は、4年とも報告にある取組のうち、進捗状況が「やや遅れ」「大幅遅れ」「未着手」だった年度が3年以上あるものです（間に順調の年度をはさむものも入ります）。「R5からR7まで続けて遅れ」は、R5・R6・R7と続けて遅れていて、今も遅れている取組です。どちらも取組をさがすの「4年間の様子」で絞り込めます。</li>
    <li><strong>予算と財源</strong>は、各部局の「主な取組」検証票に書かれた予算事業の金額です。同じ予算事業が複数の取組に同じ金額で書かれていることが多いため、同じ予算事業・財源・金額は1回だけ数えています。桁の誤記と見られる金額（同じ行の0でない他の金額の50倍以上・10億円以上で、他の年度の報告でも裏付けられないもの）は合計から除き、ページに一覧しています。</li>
    <li><strong>部局</strong>は、その取組の最新の報告での所管部局で数えています。令和5年度の組織再編より前（R4）の取組も、再編後の部局に寄せています。成果指標の担当部課のR4の旧部局名は、その課の取組がR5で最も多く移った先の課に読み替えています。</li>
  </ul>

  <h2 id="chuui">注意点</h2>
  <ul>
    <li><strong>非公式のサイトです。</strong><a href="/code-for-okinawa/">{PROJECT.org}</a> が作っていて、県は関わっていません。PDFからの読み取りには誤りが含まれる可能性があります。数値を引用するときは必ず元の報告書で確認してください。</li>
    <li><strong>主な取組の進捗の内訳が、概要版と数件ずれることがあります。</strong>報告書の進捗状況の欄が空欄や「-」の取組（{blanks.map(([y, n]) => `${yearLabel(y)}で${n}件`).join('、')}）は、このサイトでは「記載なし」としています。県の集計ではこれらも「順調」「未着手」などに数えられています。</li>
    <li><strong>施策の推進状況（A〜G）は、施策総括表に印字された判定をそのまま使っています。</strong>印字された判定は、どの施策も概要版の区分表（主な取組のうち「順調」の割合と、成果指標の達成率）のとおりです。ただし区分ごとの件数は概要版とずれます（R5は最大11件、R6・R7は数件）。成果指標が2つ以上ある施策で、施策総括表は各指標の達成率をそのまま平均した値で判定していますが、概要版の件数は各指標の達成率を100%で頭打ちにしてから平均した値で数えているとみられます。そう計算し直すと、R7の件数は県が集計で「その他」に回した3施策の分を除いて概要版と一致します。R4は施策ごとの判定が公表されていないため「未公表」としています。</li>
    <li><strong>計画値に届いた成果指標の数は、概要版の数と少しずれます。</strong>このサイトは報告書の達成率が100%以上のもの（「達成」と書かれたものを含む）を数えています（{reached}）。概要版の「計画値を達成」の数は {reachedPub} で、県がどの指標を数えたかは公表されていません。</li>
    <li><strong>成果指標の達成率は、その年度の計画値に対する割合です。</strong>R7から目標値・計画値が新しくなったため、R6以前とR7以降の達成率は単純には比べられません。実績値は報告時点の最新値で、統計の都合で前の年度の値のことがあります。</li>
    <li><strong>主要指標の達成率は、R9の目標値に対する割合です。</strong>県の概要版の表の値をそのまま使っています（トップと将来像のページの主要指標の図。図の令和7年度より前の値は付属資料のもの）。基本施策のページの主要指標の値は総括報告書の付属資料のもので、統計の基準改定にあわせて試算し直した基準値・目標値（※の付いた指標）など、概要版と値や書き方が違うものがあります。R5の概要版は表が画像のため読み取っていません。</li>
    <li><strong>施策ページの決算見込額は合計しないでください。</strong>同じ予算事業の金額が、複数の取組に重ねて書かれていることがあります。合計は<a href="/yosan/">予算と財源</a>で重複を除いて出しています。</li>
    <li><strong>部局の検証票が手に入らない取組があります。</strong>病院事業局（R4はリンク切れ、R5は公開ページが見当たらず、R6・R7は表が読み取れません）、県警本部のR6（公開ページが見当たりません）、文化観光スポーツ部のR7の一部（公開ファイルに一部の取組しか載っていません）、知事公室のR5の一部（県のページで、別の施策展開と同じファイルにリンクされています）、企画部・商工労働部の一部（県のページに前の年度の検証票が掲載されていて、その年度の票がありません。前の年度の金額などを載せないよう、取り込んでいません）。このほか、成果指標の検証票にだけ名前があって主な取組の検証票に無いものなどが数件あります。</li>
    <li>年度をまたいだ取組・成果指標の対応は、名前が同じかどうかで判断しています。書き方の違い（「子ども」「こども」など）のほかに名前が少しでも変わると、別の行（別の取組のページ）になります。取組のページでは、同じ施策で前後の年度に載っている取組のうち、同じ予算事業を使うものや名前が似ているものを「関係がありそうな取組」として示しています。</li>
    <li><strong>取組のページの活動内容・検証・改善案は、部局の検証票の文章をそのまま載せています。</strong>空欄の欄と、表の形が崩れていて読み取れなかった欄は表示していません（4年分の延べ{fmt(records.length)}取組のうち{fmt(emptyFields)}件）。</li>
    <li><strong>R5の報告書の成果指標の達成率は、25指標が概要版に書かれた計算式と合いません</strong>（実績値÷目標値で計算したと見られるものなど）。このサイトは報告書の値をそのまま載せています。</li>
  </ul>

  <h2 id="hoka">沖縄県PDCA以外の資料の注意点</h2>
  <ul>
    <li><strong>観光ロードマップは沖縄県PDCAとは別の計画です。</strong>施策の番号（1-ア-①）は沖縄県PDCAの施策（1-(1)-ア-①）とは別です。主な取組は、同じ年度に同じ名前の取組（名前がよく似ていて決算見込額が同じものを含む）が沖縄県PDCAにあれば、取組のページへのリンクを付けています。</li>
    <li><strong>観光ロードマップのR4の実施報告書（本編）は読み取れません。</strong>文字に変換できないフォントで作られているためです。R4は概要版の件数だけを載せています。成果指標のR4の実績値は、R5・R6の報告書に載っている値です。</li>
    <li><strong>観光ロードマップの決算見込額は合計しないでください。</strong>同じ予算（観光統計の調査など）が複数の取組に重ねて書かれています。予算と財源のページにも足していません。</li>
    <li><strong>一括交付金の事後評価の評価（◎○△未）は、県の総括表の評価をそのまま載せています。</strong>成果目標ごとの達成率の平均で、100%が達成、70%以上が概ね達成です。繰越した事業と、事業が終わった後の検証（後年度に効果が出る事業）は載せていません。</li>
    <li><strong>一括交付金の事業と施策は、検証シートに書かれた基本計画の施策のコードで結び付けています。</strong>R5の将来像2の一部の事業（子育て・離島・福祉などの{ikkatsuImage}事業）は検証シートが画像だけのPDFのため、施策のコード・担当部課・予算の執行を画像から読み取っています。検証シートに施策のコードが無い事業（{ikkatsuBorrowed}事業）は、別の年度の同じ名前の事業のコードで決めています。主な取組とは名前が違うことがあり、取組とは結び付けていません。</li>
    <li>評価検証報告書は、成果指標・主要指標の表とグラフを読まず、文章だけを載せています（数字は沖縄県PDCAの抽出結果にあります）。</li>
  </ul>

  <h2>このサイトの表示について</h2>
  <ul>
    <li><strong>県を批判するためではなく、状況を公平に確かめられるように作っています。</strong>順調なもの・遅れているもののどちらかを選んで目立たせず、全体の内訳を同じ重みで見せています。遅れている取組や判定が下がった施策などは、各一覧の絞り込みで見られます。</li>
    <li>状態（順調・概ね順調・やや遅れ・大幅遅れ など）は、色だけでなく形（● ◆ ▲ ■）と文字でも区別しています。施策の判定の E・F（取組が遅れている）は ▼ と斜線です。</li>
    <li>将来像の番号の印は、新・沖縄21世紀ビジョン基本計画のパンフレットの将来像の色（1 緑・2 青・3 橙・4 ピンク・5 青緑）に合わせています。文字が読みやすいよう、色を少し濃く・明るくしているものがあります。</li>
    <li>くらしのテーマのラベルはピンクの地で表示しています（このサイト独自の分類のしるし）。</li>
    <li>個別計画（観光ロードマップ）の札は淡い紫の地で表示しています。沖縄県PDCAの施策・取組と取り違えないようにするためです。</li>
    <li>図には「表で見る」を付けています。図の値は表でも読めます。</li>
    <li>数字の表示に、丸い英字フォント <ExtLink href="https://github.com/hafontia/Fredoka-One">Fredoka</ExtLink>（数字と記号だけに絞ったもの。<a href="/fonts/Fredoka-OFL.txt">SIL Open Font License 1.1</a>）を使っています。日本語の文字は、お使いの端末のフォントで表示します。</li>
    <li>SNS で共有したときに出るカードの画像の文字には、<ExtLink href="https://github.com/notofonts/noto-cjk">Noto Sans CJK JP</ExtLink>（<a href="/fonts/NotoSansCJK-OFL.txt">SIL Open Font License 1.1</a>）を使っています。</li>
  </ul>
