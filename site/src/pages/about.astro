---
import Base from '../layouts/Base.astro';
import { YEARS, LATEST, yearLabel, yearLong, getTorikumi, amountEntries, getFinanceReference, getBudgetRecords } from '../lib/data.js';
import { fmt } from '../lib/format.js';
import fs from 'node:fs';
import { LINKS, PROJECT } from '../lib/links.js';
import { TERMS } from '../lib/terms.js';
import { getThemes, unthemed } from '../lib/themes.js';
import path from 'node:path';

// 年度ごとの県の公開ページ（総括報告書の掲載ページ）
const sources = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), '../data/extracted/soukatsu/sources.json'), 'utf-8'));
const pages = YEARS.map((y) => sources.find((s) => s.year === y && s.page_url)).filter(Boolean);
// 主な取組の予算事業（最新の報告の決算見込額、重複を除く）と、県の一般会計の規模の比較（目安）
const torikumiBudget = Math.round(amountEntries(LATEST, 'estimate').reduce((s, e) => s + e.amount, 0) / 1e5);
const prefBudget = getFinanceReference().prefecture;
// 進捗状況の欄が空欄・「-」の取組の件数（年度別）
const blanks = YEARS.map((y) => [y, getTorikumi(y).filter((t) => !t.status).length]).filter(([, n]) => n > 0);
// 部局票の取組のうち、活動内容・判定の根拠・改善案の反映状況・検証・改善案のどれかが空のもの（docs/issues.md の A9 と同じ欄）
const records = getBudgetRecords();
const emptyFields = records.filter((b) => ['activity_done', 'basis', 'improvements', 'check', 'action'].some((k) => !b[k]?.length)).length;
const themes = getThemes();
---
<Base title="データについて" description="このサイトのデータの出典・作り方・注意点">
  <nav class="breadcrumb"><a href="/">トップ</a> › データについて</nav>
  <h1>データについて</h1>

  <h2>沖縄県PDCAとは</h2>
  <p>
    沖縄県は「<a href={LINKS.kihonKeikaku} rel="noopener">新・沖縄21世紀ビジョン基本計画</a>」を進めるため、<a href={LINKS.jisshiKeikaku} rel="noopener">実施計画</a>に並ぶ施策と取組について、計画（Plan）・実施（Do）・検証（Check）・改善（Action）を毎年度まわしています。
    その検証結果が「<a href={LINKS.kekka} rel="noopener">沖縄県PDCA実施結果</a>」で、毎年夏ごろに前年度分が公表されます（例: 令和7年度対象の結果は令和8年8月公表）。仕組みは県の「<a href={LINKS.pdcaGaiyou} rel="noopener">沖縄県PDCAの概要</a>」で説明されています。
  </p>
  <ul>
    <li><strong>将来像（5）</strong> → <strong>基本施策（36）</strong> → 施策展開 → <strong>施策（339）</strong> → <strong>主な取組（約1,500）</strong>の階層になっています。</li>
    <li id="torikumi">
      <strong>主な取組は、県の事業のすべてではありません。</strong>
      県が実施計画で、施策ごとに「課題の解決に向けた手段となる具体的な事業等」として選んだもので、PDCAはこの主な取組を対象にしています。
      県の一般会計（令和{prefBudget.year - 2018}年度当初 {fmt(prefBudget.total)}億円）に対して、このサイトで集計した主な取組の予算事業は{yearLabel(LATEST)}の決算見込額で約{fmt(torikumiBudget)}億円です
      （一般会計には人件費や借金の返済も含むので、比べるのは目安です。<a href="/yosan/zaigen/">予算の財源のしくみ</a>）。
      主な取組に入っていない県の事業のほか、国・市町村・民間の取組もあり、成果指標の数字はそれらや社会情勢にも左右されます。
      「取組は順調だが、成果は遅れている」施策では、こうした主な取組の外の要因が効いていることもあります。
    </li>
    <li><strong>主要指標</strong>は基本施策の最終的な成果、<strong>成果指標</strong>は施策の成果、<strong>活動指標</strong>は主な取組の活動量をはかる指標です。</li>
    <li>R4〜R6は<a href={LINKS.zenki} rel="noopener">前期実施計画</a>（目標年度R6）、R7からは<a href={LINKS.chuki} rel="noopener">中期実施計画</a>（R7〜R9、目標年度R9）です。R7で取組の一部と指標の基準値・目標値が見直されています。</li>
  </ul>

  <h2 id="yougo">用語</h2>
  <p class="small secondary">本文の点線の下線が付いた言葉を押しても、同じ説明が出ます。</p>
  <dl class="terms sticker">
    {Object.entries(TERMS).map(([w, d]) => <div><dt>{w}</dt><dd>{d}</dd></div>)}
  </dl>

  <h2 id="theme">くらしのテーマについて</h2>
  <p>
    <a href="/theme/">くらしのテーマ</a>（{themes.length}テーマ）は、<strong>このサイトが独自にまとめた分類</strong>で、県の計画の分類ではありません。
    施策の名前・施策展開の名前・基本施策の名前に決まった言葉（例: 子ども・子育てなら「子ども」「保育」「ひとり親」など）が含まれる施策を、そのテーマに入れています。
    どの施策もいずれかのテーマに入るように言葉を選んでいて（いまどのテーマにも入らない施策は{fmt(unthemed().length)}）、1つの施策が複数のテーマに入ることもあります。
    主な取組・成果指標は、その施策のテーマに加えて、取組・指標の名前に言葉が含まれるテーマにも入れています。
    言葉の一覧と、人が直すための追加・除外の指定は、リポジトリの <code>data/reference/themes.json</code> にあります。
  </p>

  <h2>出典</h2>
  <p>沖縄県「<a href={LINKS.kekka} rel="noopener">沖縄県PDCA実施結果</a>」の総括報告書（将来像1〜5の本文と付属資料）と、予算・財源と取組ごとの活動・検証・改善案については各部局が公開している「主な取組」検証票（<a href={LINKS.pdca} rel="noopener">沖縄県PDCA</a>の各部局のページ）です。</p>
  <ul>
    {pages.map((p) => <li>{yearLong(p.year)}: <a href={p.page_url} rel="noopener">{p.page_title}</a></li>)}
  </ul>
  <p>各施策・各取組のページの「出典」から、元のPDFの該当ページを開けます（zipで公開されている年度はzipへのリンクです）。</p>

  <h2>作り方</h2>
  <ol>
    <li>県のサイトから報告書のPDF・zipを取得します。</li>
    <li>PDFの表を機械的に読み取り、施策・主な取組・成果指標・主要指標の表にします。</li>
    <li>件数を県の概要版の公表値と突き合わせます。施策（339）・主な取組（1,539／1,539／1,539／1,534）・成果指標（393／393／393／391）・基本施策（36）は、4年度とも公表値と一致しています。</li>
  </ol>

  <h2 id="kazoekata">このサイトでの数え方</h2>
  <ul>
    <li><strong>「順調」の割合</strong>は、その年度の報告にある主な取組のうち、進捗状況が「順調」のものの割合です（「記載なし」も分母に入れています）。</li>
    <li><strong>成果指標の達成状況</strong>は、計画値に対する達成率で「100%以上」「60%以上100%未満」「0%超60%未満」「0%以下」に分けています。報告書に「達成」とあるものは100%以上、「未達成」は0%以下、「-%」などは「達成率なし」です。</li>
    <li><strong>主な取組の件数は、県の数え方と同じく延べ件数です。</strong>1つの取組が複数の施策に載っている（再掲）ことがあり、それぞれ1件と数えています。</li>
    <li><strong>年度をまたいだ同じ取組・同じ成果指標</strong>は、同じ施策の中で名前が同じもの（空白や句読点の違いは無視）です。</li>
    <li><strong>遅れが続いている取組</strong>は、4年とも報告にある取組のうち、進捗状況が「やや遅れ」「大幅遅れ」「未着手」だった年度が3年以上あるものです。</li>
    <li><strong>予算と財源</strong>は、各部局の「主な取組」検証票に書かれた予算事業の金額です。同じ予算事業が複数の取組に同じ金額で書かれていることが多いため、同じ予算事業・財源・金額は1回だけ数えています。桁の誤記と見られる金額（同じ行の0でない他の金額の50倍以上・10億円以上で、他の年度の報告でも裏付けられないもの）は合計から除き、ページに一覧しています。</li>
    <li><strong>部局</strong>は、その取組の最新の報告での所管部局で数えています。令和5年度の組織再編より前（R4）の取組も、再編後の部局に寄せています。成果指標の担当部課のR4の旧部局名は、その課の取組がR5で最も多く移った先の課に読み替えています。</li>
  </ul>

  <h2>注意点</h2>
  <ul>
    <li><strong>非公式のサイトです。</strong><a href="/code-for-okinawa/">{PROJECT.org}</a> が作っていて、県は関わっていません。PDFからの読み取りには誤りが含まれる可能性があります。数値を引用するときは必ず元の報告書で確認してください。</li>
    <li><strong>主な取組の進捗の内訳が、概要版と数件ずれることがあります。</strong>報告書の進捗状況の欄が空欄や「-」の取組（{blanks.map(([y, n]) => `${yearLabel(y)}で${n}件`).join('、')}）は、このサイトでは「記載なし」としています。県の集計ではこれらも「順調」「未着手」などに数えられています。</li>
    <li><strong>施策の推進状況（A〜G）は、施策総括表に印字された判定をそのまま使っています。</strong>区分ごとの件数は概要版と数件ずれます（「概ね順調」がこのサイトの方が少ないなど）。県は一部の施策を集計で「その他」に回していますが、それだけではずれを説明できず、原因は分かっていません。R4は施策ごとの判定が公表されていないため「未公表」としています。</li>
    <li><strong>成果指標の達成率は、その年度の計画値に対する割合です。</strong>R7から目標値・計画値が新しくなったため、R6以前とR7以降の達成率は単純には比べられません。実績値は報告時点の最新値で、統計の都合で前の年度の値のことがあります。</li>
    <li><strong>施策ページの決算見込額は合計しないでください。</strong>同じ予算事業の金額が、複数の取組に重ねて書かれていることがあります。合計は<a href="/yosan/">予算と財源</a>で重複を除いて出しています。</li>
    <li><strong>部局の検証票が手に入らない取組があります。</strong>病院事業局（表が読み取れない・R4はリンク切れ）、県警本部のR6（公開ページが見当たりません）、文化観光スポーツ部のR7の一部（公開ファイルに一部の取組しか載っていません）。</li>
    <li>年度をまたいだ取組・成果指標の対応は、名前が同じかどうかで判断しています。名前が少しでも変わると別の行（別の取組のページ）になります。取組のページでは、同じ施策で前後の年度に載っている取組のうち、同じ予算事業を使うものや名前が似ているものを「関係がありそうな取組」として示しています。</li>
    <li><strong>取組のページの活動内容・検証・改善案は、部局の検証票の文章をそのまま載せています。</strong>空欄の欄と、表の形が崩れていて読み取れなかった欄は表示していません（4年分の延べ{fmt(records.length)}取組のうち{fmt(emptyFields)}件）。</li>
    <li><strong>R5の報告書の成果指標の達成率は、25指標が概要版に書かれた計算式と合いません</strong>（実績値÷目標値で計算したと見られるものなど）。このサイトは報告書の値をそのまま載せています。</li>
  </ul>

  <h2 id="license">データの利用について</h2>
  <p>このサイトのソースコードと、報告書から読み取ったデータ（<code>data/extracted</code>）は <a href={PROJECT.repo} rel="noopener">GitHub</a> で公開しています。</p>
  <ul>
    <li><strong>ソースコード</strong>（PDFの読み取りと、このサイト）は <a href="https://opensource.org/license/mit" rel="noopener">MIT License</a> です。</li>
    <li>
      <strong>このサイトが作ったデータ</strong>は <a href="https://creativecommons.org/licenses/by/4.0/deed.ja" rel="noopener">CC BY 4.0</a> です。報告書に無く、このサイトが加えたもの（くらしのテーマの分類、施策・取組・成果指標のIDと年度をまたいだ対応づけ、表の形への整理、予算の重複の除き方と誤記の疑いの判定など）が対象です。使うときは「{PROJECT.org}『沖縄県PDCAダッシュボード』」と出典を書いてください。
    </li>
    <li>
      <strong>県の報告書から読み取った内容</strong>（施策・取組・指標の名前、数値、判定、県の分析・検証・改善案などの文章）は、CC BY 4.0 の対象ではありません。県の文章の著作権は沖縄県にあります。使うときは<a href={LINKS.siteTerms} rel="noopener">県のサイトの利用条件</a>を確かめ、出典（沖縄県「<a href={LINKS.kekka} rel="noopener">沖縄県PDCA実施結果</a>」など）を書いてください。このサイトが手を加えたものを、県が作ったもののように見せないでください。
    </li>
  </ul>

  <h2>このサイトの表示について</h2>
  <ul>
    <li>状態（順調・概ね順調・やや遅れ・大幅遅れ など）は、色だけでなく形（● ◆ ▲ ■）と文字でも区別しています。施策の判定の E・F（取組が遅れている）は ▼ と斜線です。</li>
    <li>将来像の番号の印は、新・沖縄21世紀ビジョン基本計画のパンフレットの将来像の色（1 緑・2 青・3 橙・4 ピンク・5 青緑）に合わせています。文字が読みやすいよう、色を少し濃く・明るくしているものがあります。</li>
    <li>くらしのテーマのラベルはピンクの地で表示しています（このサイト独自の分類のしるし）。</li>
    <li>図には「表で見る」を付けています。図の値は表でも読めます。</li>
    <li>数字の表示に、丸い英字フォント <a href="https://github.com/hafontia/Fredoka-One" rel="noopener">Fredoka</a>（数字と記号だけに絞ったもの。<a href="/fonts/Fredoka-OFL.txt">SIL Open Font License 1.1</a>）を使っています。日本語の文字は、お使いの端末のフォントで表示します。</li>
  </ul>
</Base>

<style>
  .terms { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px 24px; margin: 8px 0 0; }
  .terms dt { font-family: var(--font-display); font-weight: 700; }
  .terms dd { margin: 2px 0 0; font-size: 0.9375rem; }
</style>
