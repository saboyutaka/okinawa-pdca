---
import Base from '../layouts/Base.astro';
import Ladder from '../components/Ladder.astro';
import Chunk from '../components/Chunk.astro';
import Term from '../components/Term.astro';
import ThemeTiles from '../components/ThemeTiles.astro';
import Sz from '../components/Sz.astro';
import JudgeMatrix from '../components/JudgeMatrix.astro';
import TrendChart from '../components/TrendChart.astro';
import Share from '../components/Share.astro';
import {
  YEARS, LATEST, STATUSES, RATE_BINS, yearLong, rateBin, countBy, countJudges,
  getTorikumi, getSeika, getShisakuList, getShouraizou, getTorikumiGroups, getShuyouStatus, getPdfCount,
} from '../lib/data.ts';
import { getThemes } from '../lib/themes.ts';
import { band, fmt, pct } from '../lib/format.ts';
import { LINKS, SITE } from '../lib/links.ts';
import ExtLink from '../components/ExtLink.astro';
import { BOSHU, HASHTAG, boshuState, dayText } from '../lib/iken.ts';

const latestTori = getTorikumi(LATEST);
// 年度をまたいでまとめた取組（取組をさがすと同じ数え方）
const groups = getTorikumiGroups();
const L = YEARS.length - 1;
const latestGroups = groups.filter((g) => g.statuses[L]);
// ヒーローの3つの段（components/Ladder.astro）: 主要指標の達成状況・成果指標の達成率・主な取組の進捗状況の内訳
const shuyou = getShuyouStatus();
const seikaCounts = countBy(getSeika(LATEST), rateBin, RATE_BINS.map((b) => b.key));
const toriCounts = countBy(latestGroups, (g) => g.statuses[L]!, STATUSES.map((s) => s.key));
const shisaku = getShisakuList();
const judgeCounts = countJudges(shisaku);


// 将来像ごと
const visions = getShouraizou().map((v) => {
  const t = latestTori.filter((x) => x.shisaku_id.startsWith(`${v.id}-`));
  return { ...v, n: t.length, ok: t.filter((x) => x.status === '順調').length };
});


// 4年間の推移
const trend = YEARS.map((y) => {
  const t = getTorikumi(y);
  const s = getSeika(y);
  const aOk = t.filter((x) => x.status === '順調').length;
  const bOk = s.filter((x) => rateBin(x) === '100%以上').length;
  return { y, a: (aOk / t.length) * 100, b: (bOk / s.length) * 100, aOk, aN: t.length, bOk, bN: s.length };
});
// 県民意見募集（パブリックコメント）の受付の状態（ビルドした日で決まる）
const boshu = boshuState();
---
<Base>
  <section class="hero sticker lift" aria-labelledby="hero-h">
    <p class="site-line"><b>{SITE.name}</b><span>{SITE.tagline}</span></p>
    <span class="tag">{yearLong(LATEST)}の結果</span>
    <h1 id="hero-h">沖縄県の取組、どこまで進んだ？</h1>
    <p class="lead">
      沖縄県は毎年、「<ExtLink href={LINKS.kihonKeikaku} after="」">新・沖縄21世紀ビジョン</ExtLink>に並ぶ<Term word="施策" />と<Term word="主な取組" />がどこまで進んだかを点検し、「<ExtLink href={LINKS.kekka} after="」">沖縄県PDCA実施結果</ExtLink>として公表しています。<br />
      その結果（令和4〜7年度）を、<a href="/about/">PDF <span class="big pdf-n">{fmt(getPdfCount())}</span>件</a>から見やすくまとめました。
    </p>
    <Ladder shuyou={shuyou} seika={seikaCounts} tori={toriCounts} />
  </section>

  <form class="search sticker" action="/shisaku/" method="get" role="search" aria-label="さがす">
    <label for="top-q">気になる言葉でさがす</label>
    <div class="search-row">
      <input id="top-q" type="search" name="q" placeholder="例: 子ども、観光、サンゴ、しまくとぅば" />
      <button type="submit" class="button">施策</button>
      <button type="submit" class="button" formaction="/torikumi/">取組</button>
      <button type="submit" class="button" formaction="/shihyou/">成果指標</button>
    </div>
  </form>

  <section id="themes" aria-labelledby="themes-h">
    <h2 id="themes-h">気になるテーマから見てみよう<span class="own">このサイト独自の分類</span></h2>
    <p class="small secondary lead">くらしの{getThemes().length}の分野ごとに、県の施策・取組・成果指標をまとめて見られます。</p>
    <ThemeTiles items={getThemes().map((t) => ({ id: t.id, label: t.label, href: `/theme/${t.id}/` }))} />
    <p class="small more-link"><a href="/theme/">テーマを一覧で見る<span aria-hidden="true"> →</span></a></p>
  </section>

  <section aria-labelledby="vision-h">
    <h2 id="vision-h">5つの<Term word="将来像" />、それぞれの進み具合</h2>
    <p class="small secondary lead">「<ExtLink href={LINKS.kihonKeikaku} after="」">新・沖縄21世紀ビジョン</ExtLink>は、めざす沖縄の姿として5つの将来像を掲げています。</p>
    <ul class="row-list visions">
      {visions.map((v) => (
        <li class:list={['vision', `sz-${v.id}`]}>
          <Sz id={v.id} sr={false} class="big-badge" />
          <a class="v-name name-link" href={`/future/${v.id}/`}><span class="sr-only">将来像{v.id}　</span>{v.name}</a>
          <Chunk frac={v.ok / v.n} label={`主な取組 ${v.n}件のうち順調 ${v.ok}件（${pct(v.ok, v.n)}）`} thin />
          <span class="v-pv big" aria-hidden="true">{pct(v.ok, v.n)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="judge-h">
    <h2 id="judge-h">県の「判定」はこう決まる</h2>
    <p class="small secondary lead">
      施策の<Term word="推進状況" label="判定" />（A〜G）は、主な取組の「順調」の割合と成果指標の<Term word="達成率" />をもとに沖縄県が毎年評価し、「<ExtLink href={LINKS.kekka} after="」">沖縄県PDCA実施結果</ExtLink>で公表しています。
    </p>
    <JudgeMatrix counts={judgeCounts} />
  </section>

  <section aria-labelledby="trend-h">
    <h2 id="trend-h">4年間の推移</h2>
    <p class="small secondary lead">この4年、主な取組の「順調」は{band(trend.map((p) => p.a))}、計画値に届いた成果指標は{band(trend.map((p) => p.b))}で推移しています。</p>
    <figure class="sticker trend">
      <figcaption>
        <div class="chart-title">「順調」の取組と、計画値に届いた成果指標の割合</div>
      </figcaption>
      <TrendChart points={trend} />
      <details>
        <summary>表で見る</summary>
        <div class="table-wrap">
          <table>
            <thead><tr><th>年度</th><th class="num">主な取組</th><th class="num">うち順調</th><th class="num">成果指標</th><th class="num">うち計画値に到達</th></tr></thead>
            <tbody>
              {trend.map((p) => (
                <tr>
                  <th>{yearLong(p.y)}（{p.y <= 2024 ? '前期' : '中期'}）</th>
                  <td class="num">{fmt(p.aN)}</td><td class="num">{fmt(p.aOk)}（{p.a.toFixed(1)}%）</td>
                  <td class="num">{fmt(p.bN)}</td><td class="num">{fmt(p.bOk)}（{p.b.toFixed(1)}%）</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </figure>
  </section>

  <section aria-labelledby="iken-h">
    <h2 id="iken-h">意見を伝えるには</h2>
    <div class="sticker iken">
      <p>
        {/* 募集の期間の外はパブリックコメントに触れず、いまできること（県の窓口・SNS）を書く。終わった募集は /iken/ に */}
        {boshu === 'open' && `${yearLong(BOSHU.year)}の結果への県民意見募集（パブリックコメント）を、${dayText(BOSHU.end)}まで受け付けています。`}
        {boshu === 'before' && `${yearLong(BOSHU.year)}の結果への県民意見募集（パブリックコメント）を、${dayText(BOSHU.start)}から受け付けます。`}
        県には、いつでも意見を送れる窓口があります。SNS で <strong>#{HASHTAG}</strong> を付けて話すこともできます。
      </p>
      <div class="iken-actions">
        <a class="pill-btn" href="/iken/">意見を伝えたい人へ<span aria-hidden="true">→</span></a>
        <Share link="top" label="このサイトを SNS でシェア" />
      </div>
    </div>
  </section>

</Base>

<style>
  .hero { position: relative; overflow: hidden; margin-top: 12px; background: var(--sky); padding: 24px 24px 28px; }
  .hero::before, .hero::after { content: ""; position: absolute; border-radius: 50%; border: 2.5px solid var(--line); pointer-events: none; }
  .hero::before { width: 170px; height: 170px; right: -50px; top: -60px; background: var(--pink); }
  .hero::after { width: 90px; height: 90px; left: -34px; bottom: -34px; background: var(--lilac); }
  .hero > * { position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(1.7rem, 4.6vw, 2.5rem); margin: 0.3em 0 0.2em; }
  /* サイトの名前と説明（lib/links.ts の SITE）。PC 幅は縦の線で区切って1行に、狭い画面は2行に積む */
  .site-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 10px; margin: 0 0 10px; font-family: var(--font-display); font-size: 0.9375rem; line-height: 1.5; }
  .site-line b { font-size: 1.0625rem; }
  .site-line span { color: var(--ink-2); padding-left: 10px; border-left: 2px solid var(--line); }
  /* 狭い画面では、右上の丸を小さくして説明の文字にかからないようにする */
  @media (max-width: 560px) {
    .site-line { flex-direction: column; }
    .site-line span { padding-left: 0; border-left: 0; }
    .hero::before { width: 130px; height: 130px; }
  }
  .hero .lead { font-size: 1rem; }
  .pdf-n { font-size: 1.2rem; margin-inline: 1px; }

  .search { margin-top: 24px; display: grid; gap: 8px; }
  .search label { font-family: var(--font-display); font-weight: 700; }
  .search-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .search-row input {
    flex: 1 1 14em; min-width: 0; font: inherit; color: var(--ink); background: var(--paper);
    border: 2px solid var(--line); border-radius: 12px; padding: 8px 12px; min-height: 46px;
  }
  /* スマホでは入力欄を1行まるごとにして（ボタンは下の1行に並べる）、例の言葉の字を少し小さくし、切れないようにする。
     入力する字は 16px のまま（小さくすると、iPhone で押したときに画面が拡大されるため） */
  @media (max-width: 560px) { .search-row input { flex-basis: 100%; } .search-row input::placeholder { font-size: 0.875rem; } }

  .more-link { margin: 10px 0 0; }

  /* 将来像は1つの箱に1行ずつ。色は番号の印だけに使う */
  .vision { display: grid; grid-template-columns: 40px minmax(0, 1fr) clamp(120px, 24%, 220px) 4em; grid-template-areas: "badge name bar pv"; gap: 4px 14px; align-items: center; }
  .vision :global(.big-badge) { grid-area: badge; width: 38px; height: 38px; font-size: 1.15rem; }
  .v-name { grid-area: name; line-height: 1.5; }
  .vision :global(.chunk) { grid-area: bar; }
  .v-pv { grid-area: pv; justify-self: end; font-size: 1.15rem; line-height: 1.2; }
  @media (max-width: 640px) {
    .vision { grid-template-columns: 32px minmax(0, 1fr) auto; grid-template-areas: "badge name name" "badge bar pv"; gap: 6px 12px; }
    .vision :global(.big-badge) { width: 32px; height: 32px; font-size: 0.95rem; align-self: start; }
  }

  .trend { margin-top: 0; }
  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }

  .iken { background: var(--lilac); }
  .iken p { margin-top: 0; }
  .iken-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

</style>
