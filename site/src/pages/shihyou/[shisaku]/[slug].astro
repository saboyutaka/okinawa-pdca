---
// 成果指標のシェア用のページ（docs/site.md の 4章）。SNS のカードは指標の道のり（lib/card.ts の seikaCard）で、開いた人は施策のページのその指標のカードへ移る。
// もとは成果指標1つのページだった URL（公開した URL を変えないため、このままシェア用に使う）
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../../lib/routes.ts';
import Base from '../../../layouts/Base.astro';
import ShareJump from '../../../components/ShareJump.astro';
import { seikaHead } from '../../../lib/describe.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['shihyou/[shisaku]/[slug]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { g } = Astro.props;
---
<Base {...seikaHead(g)} ogType="article" jump={g.href}>
  <ShareJump kind="成果指標" name={g.name} to={g.href} place={`施策「${g.shisaku.name}」のページ`} />
</Base>
