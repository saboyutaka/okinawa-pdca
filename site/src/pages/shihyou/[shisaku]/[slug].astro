---
// 成果指標1つのページ。年度をまたいで同じ名前の成果指標をまとめる（施策ページのカードと同じまとまり）。シェアや画面の共有で、この指標だけを見せられるようにする。
// 頭は親の施策の札の下にぶら下げる。①計画値に届いたかとスタート → いま → ゴールの数字（施策ページのカードと同じ部品） ②道のりの図と表
// ③県による説明（最新の年度は畳まず、前の年度は畳む） ④この指標の施策の主な取組（進捗状況の内訳と一覧） ⑤観光ロードマップの同じ指標 ⑥出典
// 達成率は計画期間（前期・中期）をまたいで比べない。図の地の色と表の「前期・中期」で分ける
import type { InferGetStaticPropsType } from 'astro';
import { ROUTES } from '../../../lib/routes.ts';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ParentShisaku from '../../../components/ParentShisaku.astro';
import Term from '../../../components/Term.astro';
import ThemeTags from '../../../components/ThemeTags.astro';
import SeikaGoal from '../../../components/SeikaGoal.astro';
import SeikaKey from '../../../components/SeikaKey.astro';
import SeikaRoute from '../../../components/SeikaRoute.astro';
import SeikaSays from '../../../components/SeikaSays.astro';
import SeikaTable from '../../../components/SeikaTable.astro';
import StatusBar from '../../../components/StatusBar.astro';
import Chip from '../../../components/Chip.astro';
import Stamps from '../../../components/Stamps.astro';
import ShareBox from '../../../components/ShareBox.astro';
import ExtLink from '../../../components/ExtLink.astro';
import { themeIdsOfItem } from '../../../lib/themes.ts';
import {
  YEARS, LATEST, STATUSES, yearLabel, yearLong, sectionHref, sourceLink, statusOf, toneOfStatus, countBy, textGoalChartRow,
  torikumiOfSeika, seikaAlias, type TorikumiGroup,
} from '../../../lib/data.ts';
import { KANKO, RM_LATEST, kankoOfSeika } from '../../../lib/plans.ts';
import { seikaHead } from '../../../lib/describe.ts';

// URL は lib/routes.ts で決める（docs/site.md の 8章）
export const getStaticPaths = ROUTES['shihyou/[shisaku]/[slug]'];
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { g } = Astro.props;
const s = g.shisaku;
const x = g.latest;
const u = x.unit;
const yl = yearLabel(x.year);
const present = [...YEARS].reverse().filter((y) => g.years[y]);
const rows = Object.values(g.years);
const secHref = sectionHref(x.dept);

// 道のりの図を描けるか（SeikaChart と同じ決め方。目標値が文の指標はスタートと実績値だけの図）。描けない指標（目標が「〜との差の縮小」など）は表を開いて出す
const textGoal = textGoalChartRow(g);
const drawn = Boolean(textGoal) || (rows.some((r) => r.actual != null) && rows.some((r) => r.target != null));
const plan = rows.some((r) => r.target != null);

// 県による説明。最新のものは畳まずに出し、前の年度は畳む
const says = present.map((y) => g.years[y]).filter((r) => r.explanation);
const [latestSays, ...pastSays] = says;

// この指標の施策の主な取組（指標の最新の報告と同じ年度のもの）と、その年度の進捗状況の内訳。県の検証票は取組ごとの成果指標を施策単位で書いているので、
// 取組を名前で選ばずに施策の取組をまとめて出す（lib/data.ts の torikumiOfSeika）
const torikumi = torikumiOfSeika(g);
const statusCounts = countBy(torikumi.map((t) => t.years[x.year]), statusOf, STATUSES.map((c) => c.key));
const stampsOf = (t: TorikumiGroup) => YEARS.map((y, i) => {
  const st = t.statuses[i];
  return st ? { year: y, tone: toneOfStatus(st), text: st } : { year: y, tone: null, text: '報告なし' };
});
// 観光ロードマップ（個別計画）にも同じ成果指標があるか
const rm = kankoOfSeika(g.href);
// 印字の名前が同じ指標と並んでいて見分けられないので、ほかの報告書の名前で出している年度（lib/data.ts の SEIKA_ALIASES）
const aliased = [...present].reverse().filter((y) => seikaAlias(g.years[y]));
const alias = aliased.length > 0 ? { printed: g.years[aliased[0]].name, from: seikaAlias(g.years[aliased[0]])!.from } : null;
---
<Base {...seikaHead(g)} ogType="article">
  <Crumbs items={[{ href: `/future/${s.shouraizou}/`, label: `将来像${s.shouraizou}`, sz: s.shouraizou }, { href: `/shisaku/${s.id}/`, label: s.name }, { label: g.name }]} />

  <ParentShisaku s={s} kind="この指標が入っている施策" />

  <header class="sticker lift head hang">
    <div class="kind"><Term word="成果指標" /></div>
    <h1>{g.name}{u && <span class="unit secondary">（{u}）</span>}</h1>
    <div class="meta">
      <span>担当: {secHref ? <a class="sub-link" href={secHref}>{x.dept}</a> : (x.dept || '—')}</span>
      <ThemeTags ids={themeIdsOfItem(s.id, x.name)} />
      {rm.length > 0 && <a class="plan-tag" href="#rm">{KANKO.short}にも同じ指標</a>}
    </div>
    {x.year !== LATEST && <p class="small notice-inline">この指標は{yl}まで使われていました（R7の中期<Term word="実施計画" />で入れ替わった指標）。</p>}
    <div class="goal"><SeikaGoal row={g} /></div>
  </header>

  <section aria-labelledby="route">
    <h2 id="route" class="anchor">{drawn ? 'ゴールまでの道のり' : '年度ごとの値'}</h2>
    {drawn && plan && <p class="small secondary lead">スタートからゴールまで、点線の計画どおりに進んでいるかを青い点の実績値で見ます。</p>}
    {drawn && <SeikaKey plan={plan} />}
    <div class="sticker route">
      <SeikaRoute row={g} />
      <SeikaTable row={g} open={!drawn} />
    </div>
  </section>

  {latestSays && (
    <section aria-labelledby="says">
      <h2 id="says" class="anchor">県による説明</h2>
      <SeikaSays r={latestSays} />
      {pastSays.length > 0 && (
        <details class="past-says">
          <summary>前の年度の説明（{pastSays.map((r) => yearLabel(r.year)).join('・')}）</summary>
          {pastSays.some((r) => r.year <= 2024) && x.year >= 2025 && <p class="small secondary">R6までは前期<Term word="実施計画" />の基準値・計画値に対する説明です。</p>}
          {pastSays.map((r) => <SeikaSays r={r} />)}
        </details>
      )}
    </section>
  )}

  {torikumi.length > 0 && (
    <section aria-labelledby="torikumi">
      <h2 id="torikumi" class="anchor">この指標の施策の<Term word="主な取組" /></h2>
      <p class="small secondary lead">県の検証票では、主な取組ごとの「対応する成果指標」に施策の成果指標がまとめて書かれているので、施策の{yl}の主な取組をすべて出します。</p>
      <div class="sticker tori-sum">
        <div class="tile-label">{yearLong(x.year)}の<Term word="進捗状況" />（{torikumi.length}件）</div>
        <StatusBar categories={STATUSES} counts={statusCounts} context={`施策「${s.name}」の${yl}の主な取組 `} />
        <div class="tori-chips">{STATUSES.filter((c) => statusCounts[c.key]).map((c) => <Chip tone={c.tone} text={`${c.key} ${statusCounts[c.key]}件`} />)}</div>
      </div>
      <p class="small secondary tori-note">スタンプは4年間の<Term word="進捗状況" />です。</p>
      <ul class="row-list">
        {torikumi.map((t) => (
          <li class="t-row">
            <div class="t-main">
              <a class="name-link" href={t.href}>{t.latest.name}</a>
              <div class="small secondary">{sectionHref(t.section) ? <a class="sub-link" href={sectionHref(t.section)}>{t.section}</a> : t.section}</div>
            </div>
            <Stamps items={stampsOf(t)} label="4年間の進捗状況" size="small" />
          </li>
        ))}
      </ul>
    </section>
  )}

  {rm.length > 0 && (
    <section aria-labelledby="rm">
      <h2 id="rm" class="anchor">{KANKO.short}にも同じ成果指標があります</h2>
      <p class="small secondary lead">県の観光の<a href="/keikaku/">個別計画</a>「{KANKO.name}」でも、同じ成果指標で評価しています（沖縄県PDCAとは別の評価です）。</p>
      <ul class="row-list">
        {rm.map((r) => (
          <li>
            <div class="name-row"><span><span class="plan-tag">{KANKO.short}</span> <a class="name-link" href={r.href}>{r.latest.name}</a></span><span class="code-no">施策 {r.rm.code}</span></div>
            <div class="small secondary">{yearLabel(RM_LATEST)}の達成状況: {r.judgement}</div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <ShareBox kind="成果指標" name={g.name} />

  <section aria-labelledby="source">
    <h2 id="source" class="anchor">出典</h2>
    <ul class="small">
      {present.map((y) => {
        const r = g.years[y];
        const a = sourceLink(r.source, r.page);
        const b = r.base_fix && sourceLink(r.base_fix.source, r.base_fix.page);
        return (
          <li>
            {yearLong(y)}: {a ? <ExtLink href={a.href}>総括報告書（{a.label}）</ExtLink> : '—'}
            {b && <>、<ExtLink href={b.href}>成果指標の検証票（{b.label}。基準値）</ExtLink></>}
          </li>
        );
      })}
    </ul>
    {alias && <p class="small">{aliased.map(yearLabel).join('・')}の報告書では、この指標は「{alias.printed}」の名前で、同じ名前のほかの指標と並んで載っています。このサイトでは、{alias.from}での名前で出しています。</p>}
    <p class="small">この指標が入っている施策の、県の報告書での番号は<strong class="report-no">施策 {s.code}</strong>です。報告書の PDF では、この番号で探せます。</p>
    <p class="small"><a href={`/shisaku/${s.id}/#seika`}>施策「{s.name}」の成果指標</a>・<a href="/shihyou/">成果指標をさがす</a></p>
  </section>
</Base>

<style>
  .head { display: grid; gap: 12px; }
  .head h1 { margin: 0; }
  .unit { font-size: 0.6em; font-weight: 400; }
  .kind { font-size: 0.9375rem; font-weight: 700; color: var(--ink-2); margin-bottom: -6px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 18px; font-size: 0.9375rem; color: var(--ink-2); }
  .notice-inline { justify-self: start; margin: 0; background: var(--pink); border-radius: 10px; padding: 4px 10px; }
  .goal :global(.verdict) { margin-top: 0; }
  section h2 { scroll-margin-top: 72px; }
  .route { margin-top: 12px; }
  .route :global(details) { margin-top: 10px; }
  .past-says { margin-top: 14px; }
  .tori-sum { display: grid; gap: 8px; margin-top: 12px; }
  .tori-chips { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .tori-note { margin: 14px 0 8px; }
  .report-no { white-space: nowrap; }
</style>
