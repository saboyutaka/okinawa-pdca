---
import Base from '../layouts/Base.astro';
import FilterMore from '../components/FilterMore.astro';
import ThemeFilter from '../components/ThemeFilter.astro';
import Term from '../components/Term.astro';
import Chip from '../components/Chip.astro';
import Sz from '../components/Sz.astro';
import ExtLink from '../components/ExtLink.astro';
import { YEARS, LATEST, yearLabel, yearLong, DEPTS } from '../lib/data.ts';
import { MAP_KINDS, MAP_SEARCH_FALLBACK, infoOf, mapCells, mapCheck, mapCounts, mapDataFallback, mapDataPath, mapRows, mapSearchPath, type MapKind, type MapKindInfo } from '../lib/map-data.ts';
import { mapLabel } from '../lib/map-label.ts';
import { LINKS } from '../lib/links.ts';
import { TERMS } from '../lib/terms.ts';
import { fmt } from '../lib/format.ts';

// 指標のマップ。主要指標・成果指標・活動指標（主な取組）を、1マス＝1指標で並べ、選んだ年度の県の区分で色分けする（材料は lib/map-data.ts、動きは scripts/indicator-map.ts）。
// 3つを1つの枠にまとめ、将来像ごとの行に「主要指標｜成果指標｜活動指標」を横に並べる（PC。全部のマスが1画面に入るよう、将来像は行の左の丸の番号にし、列の見出しは上に貼り付ける。
// スマホでは行の頭に「将来像N」を書き、行の中で縦に積んで指標の名前を添える）。
// 3つは区分の意味が違う（主要指標は R9 の目標値に対する前進・後退、成果指標はその年度の計画値に対する達成率、活動指標は主な取組の進捗状況）ので、
// 凡例はマップの下の別の箱に、指標ごとの行で並べる（色でそろえた表にすると、別の区分が同じ意味に読めるため。docs/design.md の1章）。主要指標の凡例と札は形を付けない（2章）。
// マス目は1つの画像として読み、Tab で1回だけ止まって矢印キーでマスを移る。マスを押す・移ると、マスの下（入らなければ上）の吹き出しに中身を出す。
// 頭で年度（新しい年度が上）を選び、キーワード（計画の目次と同じ探し方）・くらしのテーマ・部局・指標ごとの区分で絞り込むと、条件に合わないマスを薄くする
// （隠さずに、全体の中のどこにあるかを見せる）。条件は URL のクエリに残す
const used = new Set(MAP_KINDS.flatMap((k) => mapCells(k.kind).map((c) => c.dept)));
const depts = DEPTS.filter((d) => used.has(d.name));
const at = YEARS.indexOf(LATEST);
const yl = yearLabel(LATEST);
const counts = (kind: MapKind) => infoOf(kind).cats.map((c, i): [string, number] => [c.label, mapCells(kind).filter((x) => x.c[at] === String(i)).length]);
const n = Object.fromEntries(MAP_KINDS.map((k) => [k.kind, mapCounts(k.kind)[at]]));
const rows = mapRows();
// 列の見出しの指標の名前を押すと、説明の下に県の報告書での呼び名（最終アウトカムなど）の説明を出す
const outcomeNote = (k: MapKindInfo) => `「${k.outcome}」は、${TERMS[k.outcome]}`;
// 指標ごとの区分の絞り込みの見出しと、押したときの中身の親
const KIND = {
  shuyou: { bin: '主要指標の達成率', parent: '基本施策' },
  seika: { bin: '成果指標の達成率', parent: '施策' },
  katsudou: { bin: '主な取組の進捗状況', parent: '施策' },
};
---
<Base title="指標のマップ" description={`沖縄県PDCAの主要指標${n.shuyou}・成果指標${n.seika}・主な取組の活動指標${fmt(n.katsudou)}件（${yearLong(LATEST)}）を、1マス＝1指標で将来像ごとに並べ、令和4〜7年度の年度ごとの県の区分で色分けしたマップです。`}>
  <h1>指標のマップ</h1>
  <p class="secondary lead">
    <Term word="主要指標" />・<Term word="成果指標" />・<Term word="活動指標" />を、1マス＝1指標で将来像ごとに並べ、選んだ年度の県の区分で色分けしました。
  </p>

  <form class="filters sticker map-form" role="search" aria-label="マップの指標をさがす" data-map-form data-years={YEARS.join(',')} data-summary="map-active"
    data-search={mapSearchPath()} data-search-fallback={MAP_SEARCH_FALLBACK}>
    <label class="q">キーワード（指標・取組・施策の名前）
      <input type="search" name="q" placeholder="例: 観光、離島、子ども" />
    </label>
    <label>年度
      <select name="year">
        {[...YEARS].reverse().map((y) => <option value={String(y)} selected={y === LATEST}>{yearLong(y)}</option>)}
      </select>
    </label>
    <FilterMore id="map-more">
      <ThemeFilter />
      <label data-label="部局">担当部局
        <select name="dept">
          <option value="">すべて</option>
          {depts.map((d) => <option value={d.name}>{d.name}</option>)}
        </select>
      </label>
      {MAP_KINDS.map((k) => (
        <label data-label={KIND[k.kind].bin}>{KIND[k.kind].bin}
          <select name={k.param}>
            <option value="">すべて</option>
            {k.cats.map((c) => <option value={c.key}>{c.label}</option>)}
          </select>
        </label>
      ))}
    </FilterMore>
  </form>
  <div class="active-filters" id="map-active" hidden></div>
  <p class="result-count" aria-live="polite" data-map-result></p>

  <div class="imap sticker" data-map-root>
    <p class="im-note small secondary" data-map-empty hidden>主要指標は、令和5年度の県の概要版の表が画像で、指標ごとの値を読み取れていないため出していません。</p>
    <p class="im-note small secondary" data-map-nofilter hidden>主要指標は基本施策ごとの指標で、部局・くらしのテーマに分けていないので、その条件ではどれも薄くなります。</p>
    <div class="im-cols">
      <span class="im-cg" aria-hidden="true">将来像</span>
      {MAP_KINDS.map((k) => (
        <div class="im-col" data-tier={k.kind} data-tier-head={k.kind} data-param={k.param} data-term={k.term} data-unit={k.unit} data-parent={KIND[k.kind].parent} data-shapes={String(k.shapes)}
          data-cats={JSON.stringify(k.cats.map((c) => [c.key, c.label, c.tone]))} data-src={mapDataPath(k.kind)} data-fallback={mapDataFallback(k.kind)} data-check={mapCheck(k.kind)}>
          <span class="im-name"><Term word={k.term} note={outcomeNote(k)} /><span class="im-n">(<b data-map-count>{fmt(n[k.kind])}</b><span class="sr-only">{k.unit}</span>)</span></span>
        </div>
      ))}
      <span class="key-hint im-hint" aria-hidden="true">矢印キーで移り、Enter で開けます</span>
    </div>
    <div class="im-grid" tabindex="0" role="img" data-map-grid
      aria-label={mapLabel(yl, MAP_KINDS.map((k) => ({ term: k.term, unit: k.unit, counts: counts(k.kind), hit: null })))}>
      {rows.map((r) => (
        <div class="im-row">
          <p class="im-gt"><Sz id={r.s} sr={false} /><span class="im-gn">将来像{r.s}</span></p>
          <div class="im-tiers">
            {r.tiers.map((t) => (
              <div class="im-tier" data-tier={t.kind}>
                <p class="im-tl">{infoOf(t.kind).term}</p>
                <div class="im-cells" set:html={t.html} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="cellpop im-pop" data-map-pop aria-live="polite" hidden></div>
  </div>

  <section class="map-key sticker" aria-labelledby="map-key-h">
    <h2 class="mk-title" id="map-key-h">色の見方</h2>
    <p class="mk-lead small secondary">色は<span data-map-year>{yearLong(LATEST)}</span>の県の区分です。活動指標は、1マス＝1件の<Term word="主な取組" />です。</p>
    <dl class="mk-list small">
      {MAP_KINDS.map((k) => (
        <div class="mk-row">
          <dt>{k.term}の{k.kind === 'katsudou' ? <Term word="進捗状況" /> : <Term word={k.measure} label="達成率" />}</dt>
          <dd><ul aria-label={`${k.term}の区分`}>{k.cats.map((c) => <li><i class={`mc tone-${c.tone}`} aria-hidden="true"></i>{k.shapes ? <Chip tone={c.tone} text={c.label} /> : c.label}</li>)}</ul></dd>
        </div>
      ))}
    </dl>
  </section>

  <p class="small secondary note">
    並びは報告書の順です。令和4〜6年度は<ExtLink href={LINKS.zenki}>前期実施計画</ExtLink>、令和7年度からは<ExtLink href={LINKS.chuki}>中期実施計画</ExtLink>で、令和7年度に指標と目標値が見直されたので、年度を変えるとマスの数が変わります。
    主な取組は延べ件数で、いくつかの施策に載る取組は施策ごとに1マスです。部局は最新の報告の担当部局で、くらしのテーマは<Term word="くらしのテーマ" label="このサイト独自の分類" />です。
  </p>
</Base>

<style>
  .result-count:empty { display: none; }
  .note { margin-top: 1.5em; }
  @media print {
    #map-active, .result-count { display: none; }
  }
</style>

<style is:global>
  /* 指標のマップ。マス（.mc）は lib/map-data.ts が文字列で書き、吹き出しの中身はスクリプト（scripts/indicator-map.ts）が描くので、
     Astro が範囲をしぼるための属性が付かない。.imap・.map-key の下に書いた全体の CSS にする */
  .imap {
    position: relative; margin-top: 12px; padding: 14px 18px 12px;
    --cell: 13px; --gap: 2px; --pitch: calc(var(--cell) + var(--gap)); --w-gt: 2.25rem; --w-shuyou: calc(7 * var(--pitch) - var(--gap));
  }
  .imap .im-note { margin: 0 0 6px; }

  /* 列の見出し（指標の名前と数）と、将来像ごとの行。PC では列の幅を見出しと行でそろえ、見出しはマップを読むあいだ上に貼り付ける。
     左の細い列が将来像の丸の番号。主要指標は列の数で幅を決め、残りを成果指標と活動指標で 22:78 に分ける（数の比で、どの幅でも将来像ごとの行の高さがほぼそろう） */
  .imap .im-cols, .imap .im-row, .imap .im-tiers { display: flex; gap: 0 16px; align-items: flex-start; }
  .imap .im-cols { position: sticky; top: 0; z-index: 3; align-items: baseline; padding: 2px 0 6px; background: var(--paper); border-bottom: 1.5px solid var(--grid); }
  .imap .im-cg { flex: none; width: var(--w-gt); font-family: var(--font-display); font-weight: 700; font-size: 0.75rem; color: var(--muted); }
  .imap :is(.im-col, .im-tier)[data-tier="shuyou"] { flex: none; width: var(--w-shuyou); }
  .imap :is(.im-col, .im-tier)[data-tier="seika"] { flex: 22 1 0; min-width: 0; }
  .imap :is(.im-col, .im-tier)[data-tier="katsudou"] { flex: 78 1 0; min-width: 0; }
  .imap .im-col { min-width: 0; }
  .imap :is(.im-col, .im-tier).empty { display: none; }
  .imap .im-name { font-family: var(--font-display); font-weight: 700; font-size: 0.9375rem; line-height: 1.4; }
  .imap .im-n { display: inline-block; margin-left: 2px; font-family: var(--font); font-weight: 400; font-size: 0.8125rem; color: var(--ink-2); }
  .imap .im-n b { display: inline-block; font-family: var(--font-num); font-weight: 600; font-size: 0.9375rem; color: var(--ink); margin-left: 1px; }
  .imap .im-grid { margin-top: 2px; padding: 0 4px 2px; margin-inline: -4px; border-radius: 8px; }
  .imap .im-grid:focus-visible { outline: 3px solid var(--pop); outline-offset: 2px; }
  /* キーボードでマス目に止まったときだけ、キーの使い方を見出しの右に出す（読み上げはマス目の aria-label の終わりで伝える） */
  .imap .im-hint { right: 0; bottom: 6px; }
  .imap:has(.im-grid:focus-visible) .im-hint { display: block; }
  .imap .im-row { padding: 5px 0; }
  .imap .im-row + .im-row { border-top: 1.5px solid var(--grid); }
  .imap .im-tiers { flex: 1 1 0; min-width: 0; }
  .imap .im-gt { flex: none; width: var(--w-gt); display: flex; align-items: center; gap: 6px; margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.875rem; }
  .imap .im-gt .badge-sz { width: 1.6em; height: 1.6em; font-size: 0.8rem; }
  .imap .im-gn { display: none; }
  .imap .im-tl { display: none; margin: 0 0 3px; font-size: 0.75rem; font-weight: 700; color: var(--ink-2); }
  .imap .im-cells { display: flex; flex-wrap: wrap; gap: var(--gap); }

  /* マス。色は区分（.tone-*）。地との差が 3:1 未満の色には、内訳の棒の区間と同じ内側の縁を付ける（--tone-edge。黄と灰は付けない）。選んだマスは太い縁、条件に合わないマスは薄くする */
  :is(.imap, .map-key) .mc { display: block; flex: none; width: var(--cell, 12px); height: var(--cell, 12px); border-radius: 3px; background: var(--tone); box-shadow: inset 0 0 0 1px var(--tone-edge, var(--tone)); }
  :is(.imap, .map-key) .mc:is(.tone-warning, .tone-blank) { box-shadow: none; }
  .imap .im-cells .mc { cursor: pointer; }
  .imap .mc.dim { opacity: 0.16; }
  .imap .mc.sel { outline: 2.5px solid var(--ink); outline-offset: 1.5px; opacity: 1; }
  @media (hover: hover) { .imap .im-cells .mc:hover { outline: 2px solid var(--ink-2); outline-offset: 1px; } }
  :is(.map-key, .imap .cp-head) .mc { width: 12px; height: 12px; }

  /* 吹き出し: 押したマスの下（画面に入らなければ上）に出し、尾（--ax はマスの真ん中の位置）でマスを指す */
  /* 吹き出しは押せる四角の吹き出し（styles/global.css の .cellpop）と同じ形。マップの中に置くので、重なりの順はマップの中だけで決める */
  .imap .im-pop { z-index: 6; }
  .imap .imp-l { font-weight: 700; color: var(--ink-2); margin-right: 6px; }

  /* 凡例（マップの下の箱）: 指標ごとに1行。マスと同じ色の四角と、状態の形と文字 */
  .map-key { margin-top: 14px; padding: 14px 20px; }
  .map-key .mk-title { margin: 0; font-size: 1rem; }
  .map-key .mk-lead { margin: 2px 0 0; }
  .map-key .mk-list { margin: 8px 0 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 14px; }
  .map-key .mk-row { display: contents; }
  .map-key dt { font-weight: 700; color: var(--ink-2); }
  .map-key dd { margin: 0; }
  .map-key ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 2px 14px; }
  .map-key li { display: inline-flex; align-items: center; gap: 5px; }

  /* スマホ: 列の見出しは横に流し、行の頭に「将来像N」を書いて、行の中では指標を縦に積んで名前を添える */
  @media (max-width: 640px) {
    .imap { --cell: 14px; padding: 14px 14px 12px; }
    .imap .im-cols { position: relative; flex-wrap: wrap; gap: 0 14px; }
    .imap .im-cg { display: none; }
    .imap .im-hint { bottom: auto; top: calc(100% + 10px); }
    .imap .im-row { display: block; padding: 8px 0 10px; }
    .imap .im-gt { width: auto; margin: 0 0 6px; }
    .imap .im-gn { display: inline; }
    .imap .im-tiers { flex-direction: column; gap: 8px; }
    .imap :is(.im-col, .im-tier)[data-tier] { flex: none; width: auto; max-width: 100%; }
    .imap .im-tl { display: block; }
    .map-key { padding: 12px 14px; }
    .map-key .mk-list { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .map-key dd + dt { margin-top: 4px; }
  }
  @media print {
    .imap .im-cols { position: static; }
    .imap .im-pop { display: none; }
    .imap .im-row { break-inside: avoid; }
  }
</style>
