---
// 施策の判定（A〜G）のマス目。縦は主な取組のうち「順調」の割合、横は成果指標の達成率（境目は40%と80%）。
// マスの置き方は県の概要版の「施策評価の判定基準」区分表（R4〜R7 とも同じ）どおり。A と B は「順調」の割合40%以上の2段にまたがり、
// C・D は達成率40%未満の列を「順調」の割合80%で分ける。マスを押すと、その判定の施策の一覧を開く。
// 判定の意味はマスの短い言い方と縦横の見出しで読めるので、凡例は付けない（C と D の違いは行、E と F の違いは列で分かる）
// スマホでは縦書きの軸の名前が長くて窮屈なので、横書きにして「よこ」「たて」を付け、マス目の上に2行で並べる。
// 行と列の見出しは割合だけにし、何の割合かは軸の名前で1回だけ書く。マスの数の単位（施策）は図の題（caption）に任せる。
// マスにマウスを乗せる・フォーカスすると、そのマスが入る行と列の見出し（○%）を光らせ、なぜその判定かをマス目だけで読めるようにする
// （見出しの r2〜r4・c2〜c4 と、マスの on-r2〜on-c4。A・B は2行にまたがる）
import Icon from './Icon.astro';
import { judgeOf, JUDGE_CELLS } from '../lib/data.ts';
import { JUDGE_UI } from '../lib/icons.ts';
import { fmt } from '../lib/format.ts';

interface Props { counts: Record<string, number>; caption: string; hrefOf?: (key: string) => string }
const { counts, caption, hrefOf = (k) => `/shisaku/?judge=${k}` } = Astro.props;
const AX = ['80%以上', '40〜80%', '40%未満'];
// マス目の中の位置（行・列は見出しの1行・1列を含めて数える）。範囲と説明は lib/data.ts の JUDGE_CELLS（区分表）
const PLACE: Record<string, { row: number; col: number; span: number }> = {
  A: { row: 2, col: 2, span: 2 }, B: { row: 2, col: 3, span: 2 }, C: { row: 2, col: 4, span: 1 }, D: { row: 3, col: 4, span: 1 },
  E: { row: 4, col: 2, span: 1 }, F: { row: 4, col: 3, span: 1 }, G: { row: 4, col: 4, span: 1 },
};
const CELLS = JUDGE_CELLS.map((c) => ({ k: c.key, ...PLACE[c.key], y: c.yText, x: c.xText }));
---
<figure class="matrix-fig sticker">
  <figcaption class="mx-cap">{caption}</figcaption>
  <div class="mx-xtitle" aria-hidden="true"><span class="mx-ax">よこ</span><span>成果指標の達成率<span class="nw">（左ほど高い）</span></span></div>
  <div class="mx-body">
    <div class="mx-ytitle" aria-hidden="true"><span class="mx-ax">たて</span><span>主な取組のうち「順調」の割合<span class="nw">（上ほど高い）</span></span></div>
    <div class="matrix">
      <div class="mx-hd" style="grid-row: 1; grid-column: 1;" aria-hidden="true"></div>
      {AX.map((a, i) => <div class={`mx-hd c${i + 2}`} style={`grid-row: 1; grid-column: ${i + 2};`} aria-hidden="true">{a}</div>)}
      {AX.map((a, i) => <div class={`mx-hd r${i + 2}`} style={`grid-row: ${i + 2}; grid-column: 1;`} aria-hidden="true">{a}</div>)}
      {CELLS.map(({ k, row, col, span, y, x }) => {
        const j = judgeOf(k)!;
        const ui = JUDGE_UI[k];
        const n = counts[k] || 0;
        return (
          <a
            class:list={['mcell', 'press', `tone-${j.tone}`, ui.hatch && 'hatch', `on-c${col}`, ...Array.from({ length: span }, (_, i) => `on-r${row + i}`)]}
            style={`grid-row: ${row} / span ${span}; grid-column: ${col};`}
            href={hrefOf(k)}
            aria-label={`${k} ${j.label}、${fmt(n)}施策。主な取組の順調の割合 ${y}、成果指標の達成率 ${x}。この判定の施策の一覧を開く`}
          >
            <span class="mk"><Icon tone={j.tone} shape={ui.shape} size={16} />{k}</span>
            <span class="ms">{ui.short}</span>
            <span class="mn">{fmt(n)}</span>
          </a>
        );
      })}
    </div>
  </div>
</figure>

<style>
  .matrix-fig { margin-top: 12px; }
  .mx-cap { font-family: var(--font-display); font-weight: 700; margin-bottom: 6px; }
  .mx-xtitle { font-size: 0.875rem; font-weight: 700; color: var(--ink-2); text-align: center; margin-left: calc(2em + 5em + 14px); }
  .mx-body { display: grid; grid-template-columns: 2em minmax(0, 1fr); gap: 8px; margin-top: 4px; }
  .mx-ytitle { writing-mode: vertical-rl; font-size: 0.875rem; font-weight: 700; color: var(--ink-2); justify-self: center; align-self: center; letter-spacing: 0.08em; }
  .mx-ax { display: none; }
  .matrix { display: grid; grid-template-columns: 5em repeat(3, minmax(0, 1fr)); gap: 6px; }
  .mx-hd { font-size: 0.8125rem; color: var(--ink-2); display: flex; align-items: center; justify-content: center; text-align: center; line-height: 1.35; font-weight: 700; border-radius: 10px; }
  /* 乗せた・フォーカスしたマスの行と列の見出しを光らせる */
  .matrix:has(.on-r2:is(:hover, :focus-visible)) .r2, .matrix:has(.on-r3:is(:hover, :focus-visible)) .r3, .matrix:has(.on-r4:is(:hover, :focus-visible)) .r4,
  .matrix:has(.on-c2:is(:hover, :focus-visible)) .c2, .matrix:has(.on-c3:is(:hover, :focus-visible)) .c3, .matrix:has(.on-c4:is(:hover, :focus-visible)) .c4 {
    color: var(--ink); background: var(--sky); box-shadow: inset 0 0 0 2px var(--line);
  }
  @media (prefers-reduced-motion: no-preference) { .mx-hd { transition: background-color 0.12s, color 0.12s, box-shadow 0.12s; } }
  .mcell {
    display: grid; align-content: start; gap: 2px; min-height: 100px; padding: 10px 12px; border-radius: 16px; color: var(--ink); text-decoration: none;
    background-color: color-mix(in oklab, var(--tone) 22%, var(--paper)); border: 2px solid var(--line);
  }
  a.mcell { --sh: 2px; box-shadow: 2px 2px 0 var(--shadow); }
  a.mcell:hover { background-color: color-mix(in oklab, var(--tone) 38%, var(--paper)); }
  a.mcell:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--shadow); }
  .mcell.hatch { background-image: repeating-linear-gradient(135deg, color-mix(in oklab, var(--tone) 42%, var(--paper)) 0 2px, transparent 2px 7px); }
  .mk { display: flex; align-items: center; gap: 6px; font-family: var(--font-num); font-size: 1.3rem; font-weight: 600; }
  .ms { font-family: var(--font-display); font-size: 0.8125rem; line-height: 1.4; font-weight: 700; }
  .mn { font-family: var(--font-num); font-size: 1.6rem; font-weight: 600; line-height: 1.1; margin-top: auto; white-space: nowrap; }
  @media (max-width: 600px) {
    .matrix { grid-template-columns: 4em repeat(3, minmax(0, 1fr)); gap: 4px; }
    .mx-hd { white-space: nowrap; font-size: 0.75rem; }
    /* 折り返したときは「よこ」「たて」の札の右にそろえる */
    .mx-xtitle, .mx-ytitle { display: flex; align-items: baseline; writing-mode: horizontal-tb; justify-self: start; text-align: left; margin-left: 0; letter-spacing: 0; line-height: 1.5; }
    .nw { white-space: nowrap; }
    .mx-body { grid-template-columns: minmax(0, 1fr); gap: 2px; margin-top: 0; }
    .matrix { margin-top: 8px; }
    .mx-ax { display: inline-block; flex: none; font-size: 0.75rem; color: var(--ink); background: var(--bg); border-radius: 6px; padding: 0 6px; margin-right: 6px; }
    .mcell { min-height: 84px; padding: 8px; }
    .ms { font-size: 0.75rem; line-height: 1.35; }
    .mn { font-size: 1.2rem; }
  }
</style>
