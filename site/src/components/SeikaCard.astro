---
// 成果指標1つ（施策ページ）。①名前と達成率の札・シェアのボタン ②スタート → いま → ゴールの値（1行。将来像のページの主要指標と同じ形） ③道のりの図と「表で見る」
// ④県の説明（吹き出し。says={false} のときは出さない。施策のどの成果指標も同じ説明のときは、施策のページがカードの後ろに1回だけ出す）と、前の年度の説明（畳む。past={false} のときは出さない）
// ⑤観光ロードマップの同じ指標。図はスタート・いま・ゴールの位置を見せるので、値は箱にせず1行にまとめる。
// その年度の計画値と県の見通しは、図と表に任せる。「計画値にまだ届いていません」の文は、札にマウスを乗せると出し、読み上げでは読む。
// カードの id（g.anchor）は、成果指標の一覧・指標のマップ・計画の目次・シェア用のページから飛ぶ先
import Icon from './Icon.astro';
import SeikaRoute from './SeikaRoute.astro';
import RouteVals from './RouteVals.astro';
import SeikaSays from './SeikaSays.astro';
import SeikaPastSays from './SeikaPastSays.astro';
import ShareMenu from './ShareMenu.astro';
import { LATEST, yearLabel, sectionHref, withUnit, refText, seikaVerdict, seikaPastSays, type SeikaGroupOfShisaku } from '../lib/data.ts';
import { KANKO, RM_LATEST, kankoOfSeika } from '../lib/plans.ts';

interface Props { g: SeikaGroupOfShisaku; says?: boolean; past?: boolean }
const { g, says = true, past = true } = Astro.props;
const x = g.latest;
const u = x.unit;
const verdict = seikaVerdict(x);
const ref = refText(x.actual_ref_year);
// 達成率は数を大きく出す。報告書の欄が「達成」「未達成」など数でないときは、その言葉だけ
const rateNum = x.rate != null ? `${x.rate}%` : null;
const vals = [
  { label: 'スタート', v: withUnit(x.base_raw, u), y: '' },
  { label: x.year === LATEST ? 'いま' : `${yearLabel(x.year)}の報告`, v: withUnit(x.actual_raw, u), y: ref, now: true },
  { label: 'ゴール', v: withUnit(x.target_raw, u), y: x.target_year },
];
// 観光ロードマップ（個別計画）でも同じ成果指標で評価しているもの
const rm = kankoOfSeika(g.href);
---
<article class="sticker scard" id={g.anchor}>
  <div class="sc-head">
    <h3>{g.name}{u && <span class="secondary small">（{u}）</span>}</h3>
    <div class="sc-acts">
      <span class:list={['sc-rate', `tone-${verdict.tone || 'blank'}`]} title={verdict.text}>
        <Icon tone={verdict.tone} size={14} />{rateNum ? <><span class="sc-rate-l">達成率</span><b>{rateNum}</b></> : <b class="word">{verdict.chip}</b>}<span class="sr-only">。{verdict.text}</span>
      </span>
      <ShareMenu path={g.share} kind="成果指標" name={g.name} />
    </div>
  </div>
  <p class="small secondary meta">担当: {sectionHref(x.dept) ? <a class="sub-link" href={sectionHref(x.dept)}>{x.dept}</a> : (x.dept || '—')}</p>
  <RouteVals vals={vals} />
  <SeikaRoute g={g} />
  {says && x.explanation && <SeikaSays r={x} />}
  {past && <SeikaPastSays rows={seikaPastSays(g)} year={x.year} />}
  {rm.length > 0 && (
    <p class="small rm-note">
      <span class="plan-tag">{KANKO.short}</span> 県の観光の<a href="/keikaku/">個別計画</a>でも、同じ成果指標で評価しています（沖縄県PDCAとは別の評価）:
      {rm.map((r, i) => <>{i > 0 && '、'}<a href={r.href}>{r.latest.name}</a>（{yearLabel(RM_LATEST)}の達成状況: {r.judgement}）</>)}
    </p>
  )}
</article>

<style>
  .scard { margin-top: 18px; }
  .sc-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 6px 16px; }
  .sc-head h3 { margin: 0; }
  .sc-acts { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  /* 達成率の札。数を大きく、区分の色の地と形で（取組のページの頭の進捗状況の札に近い形。ステッカーの中なので影は付けない） */
  .sc-rate {
    display: inline-flex; align-items: center; gap: 6px; padding: 2px 14px; border: 2px solid var(--line); border-radius: 999px; white-space: nowrap;
    background-color: color-mix(in oklab, var(--tone) 22%, var(--paper));
  }
  .sc-rate-l { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); }
  .sc-rate b { font-family: var(--font-num); font-weight: 600; font-size: 1.35rem; line-height: 1.3; }
  .sc-rate b.word { font-family: var(--font-display); font-size: 1rem; }
  .meta { margin: 2px 0 4px; }
  .rm-note { margin: 12px 0 0; }
</style>
