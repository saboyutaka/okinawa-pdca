---
// 施策の一覧の1件（施策をさがす・くらしのテーマ）。判定・4年の判定・取組の進み・成果指標を1枚にまとめる
import Chip from './Chip.astro';
import StatusBar from './StatusBar.astro';
import Icon from './Icon.astro';
import Sz from './Sz.astro';
import ThemeTags from './ThemeTags.astro';
import { YEARS, LATEST, yearLabel, STATUSES, judgeOf, statusOf, rateBin, countBy, getKihonList, deptHref, seikaHref, seikaKeyOf, RATE_BINS } from '../lib/data.js';
import { JUDGE_UI } from '../lib/icons.js';
import { themesOf } from '../lib/themes.js';

interface Props { s: any; attrs?: Record<string, string> }
const { s, attrs = {} } = Astro.props;
const kihon = getKihonList().find((k) => k.id === s.kihon_id);
const latestTori = s.torikumi.filter((t) => t.year === LATEST);
const counts = countBy(latestTori, statusOf, STATUSES.map((x) => x.key));
const ok = counts['順調'] || 0;
const seika = s.seika.filter((x) => x.year === LATEST);
const j = judgeOf(s.judges[LATEST]);
const judgeYears = YEARS.filter((y) => y !== LATEST && y !== YEARS[0]);
const rateText = (x) => (x.rate != null ? `達成率 ${x.rate}%` : x.rate_raw === '達成' || x.rate_raw === '未達成' ? x.rate_raw : '達成率なし');
const toneOfBin = (x) => RATE_BINS.find((b) => b.key === rateBin(x))?.tone;
---
<li class="item s-item" {...attrs}>
  <div class="item-head">
    <a class="item-name" href={`/shisaku/${s.id}/`}>{s.name}</a>
  </div>
  <div class="item-meta">
    <Sz id={s.shouraizou} />
    <a href={`/kihon/${s.kihon_id}/`}>{kihon?.name}</a>
    <span class="dept">{s.depts.length ? s.depts.map((d, i) => <>{i > 0 && '、'}{deptHref(d) ? <a href={deptHref(d)}>{d}</a> : d}</>) : s.kankei}</span>
  </div>
  <div class="item-body">
    <div class="judges">
      {j ? <Chip tone={j.tone} text={`${j.key} ${j.label}`} shape={JUDGE_UI[j.key].shape} /> : <Chip text="判定なし" />}
      <span class="past">
        {judgeYears.map((y) => {
          const pj = judgeOf(s.judges[y]);
          return <span title={pj ? `${yearLabel(y)}: ${pj.label}` : `${yearLabel(y)}: 判定なし`}>{yearLabel(y)} <Icon tone={pj?.tone || 'blank'} shape={pj ? JUDGE_UI[pj.key].shape : 'ring'} />{pj?.key ?? '—'}</span>;
        })}
      </span>
    </div>
    <div class="tori">
      <div class="small">主な取組（{yearLabel(LATEST)}） <b>{ok}/{latestTori.length}件</b>が順調</div>
      {latestTori.length > 0 && <StatusBar categories={STATUSES} counts={counts} context={`${s.name} 主な取組 `} size="mini" />}
    </div>
    <div class="tags"><ThemeTags ids={themesOf(s.id).map((t) => t.id)} /></div>
    <div class="seika small">
      成果指標: {seika.length ? seika.map((x, i) => <>{i > 0 && '　'}<a href={seikaHref(s.id, seikaKeyOf(x))}>{x.name}</a> <Chip tone={toneOfBin(x)} text={rateText(x)} /></>) : '—'}
    </div>
  </div>
</li>

<style>
  .item-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .item-name { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; font-size: 0.875rem; color: var(--ink-2); margin-top: 2px; }
  .item-meta a { color: var(--ink-2); }
  .item-meta .dept { margin-left: auto; }
  .item-body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 8px 20px; margin-top: 10px; align-items: center; }
  .judges { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; }
  .judges :global(.chip) { white-space: normal; font-weight: 700; }
  .past { display: inline-flex; flex-wrap: wrap; gap: 4px 12px; font-size: 0.875rem; color: var(--ink-2); }
  .past span { display: inline-flex; align-items: center; gap: 4px; }
  .tori { display: grid; gap: 4px; }
  .seika, .tags { grid-column: 1 / -1; }
  .seika { color: var(--ink-2); line-height: 1.7; }
  .seika :global(.chip) { vertical-align: -0.1em; }
  @media (max-width: 640px) {
    .item-body { grid-template-columns: 1fr; }
    .item-meta .dept { margin-left: 0; width: 100%; }
  }
</style>
