---
// 施策の一覧の1行（施策をさがす・くらしのテーマ。親は ul.row-list）。
// 1行目に判定の小さなハンコと名前、2行目に取組の進みと成果指標の達成率を並べる。
// 判定はハンコだけで出し、言い方（A〜G の意味）は一覧の上の凡例（JudgeLegend）に1回だけ書く。前の年度の判定は施策のページの「4年間の判定」に任せる（移り変わりは絞り込みの data-trend）。
// 一覧は将来像・基本施策ごとに見出しを立てているので、見出しと同じこと（将来像・基本施策）は行に書かない。
// 部局・テーマ・成果指標の名前は施策のページに任せる（絞り込みは data-* で効く）。kihon を付けると基本施策の名前を出す（見出しが将来像だけの一覧）。
// sub のスロットを渡すと、基本施策の名前の代わりにそれを出す（部局のページの「関係部等: 環境部」など）
import Chip from './Chip.astro';
import StatusBar from './StatusBar.astro';
import Icon from './Icon.astro';
import { LATEST, yearLabel, STATUSES, judgeOf, statusOf, countBy, getKihonList, rateText, rateTone, type Shisaku } from '../lib/data.ts';
import { JUDGE_UI } from '../lib/icons.ts';

interface Props { s: Shisaku; attrs?: Record<string, string>; kihon?: boolean }
const { s, attrs = {}, kihon: showKihon = false } = Astro.props;
const kihon = showKihon ? getKihonList().find((k) => k.id === s.kihon_id) : null;
const latestTori = s.torikumi.filter((t) => t.year === LATEST);
const counts = countBy(latestTori, statusOf, STATUSES.map((x) => x.key));
const ok = counts['順調'] || 0;
const seika = s.seika.filter((x) => x.year === LATEST);
const j = judgeOf(s.judges[LATEST]);
const ui = j && JUDGE_UI[j.key];
const judgeText = `${yearLabel(LATEST)}の判定: ${j ? `${j.key} ${j.label}` : '判定なし'}`;
---
<li class="s-item" {...attrs}>
  <span class:list={['jstamp', `tone-${j ? j.tone : 'blank'}`, ui?.hatch && 'hatch']} title={judgeText} aria-hidden="true">{j && ui ? <><Icon tone={j.tone} shape={ui.shape} size={9} />{j.key}</> : '—'}</span>
  <div class="name-row">
    <a class="item-name name-link" href={`/shisaku/${s.id}/`}>{s.name}</a>
    <span class="code-no">{s.code}</span>
  </div>
  <div class="facts small">
    <span class="sr-only">{judgeText}</span>
    {Astro.slots.has('sub') ? <span class="kihon"><slot name="sub" /></span> : kihon && <span class="kihon">基本施策 {kihon.name}</span>}
    <span class="tori">
      取組 <b>{ok}/{latestTori.length}</b>順調
      {latestTori.length > 0 && <StatusBar categories={STATUSES} counts={counts} context={`${s.name} 主な取組 `} size="mini" />}
    </span>
    <span class="seika">
      成果指標{seika.length ? seika.map((x) => <Chip tone={rateTone(x)} text={rateText(x)} />) : ' —'}
      <span class="sr-only">（達成率）</span>
    </span>
  </div>
</li>

<style>
  .s-item { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 2px 12px; align-items: start; }
  .jstamp { grid-row: span 2; margin-top: 2px; cursor: help; }
  .item-name { font-size: 1rem; line-height: 1.5; }
  .facts { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 18px; color: var(--ink-2); line-height: 1.6; }
  .facts b { color: var(--ink); }
  .kihon { flex-basis: 100%; }
  .tori, .seika { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 2px 6px; }
  .tori :global(.sbar) { width: 88px; }
  .seika :global(.chip) { gap: 4px; }
</style>
