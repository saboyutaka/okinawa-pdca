---
// 主要指標1つの道のり（将来像のページの基本施策の行 components/KihonRow.astro）。スタート（基準値）からゴール（目標値）までの線に、
// いまの位置を県の達成率で置く。どの指標も同じ長さの線にし、数の大きさではなく「道のりのどこまで来たか」だけを見せる。
// - 前進: スタートからいままでを太い線で塗り、いまに丸い印。ゴールを超えたもの（達成率 100%超）はゴールの先に置く
// - 基準値より悪いもの（マイナス・「後退」）: スタートの外（左）に、左向きの矢印を置く。「後退」の印字は数が無いので、外の真ん中に置く
// - 極端な値（-639% など）は線の端で止める（数は右の達成率の札にある）
// - 比べられないもの（「-」。統計がまだ出ていないなど）: 印を置かず、線を点線にする
// いまの値は線の上、スタートとゴールの値は線の下に置き（重ならないように）、読み上げはスタート → いま → ゴールの順。線と印は読み上げない。
// 動き: 画面に入ったときに1回だけ、スタートからいままで線を伸ばして印を置く（styles/global.css の「動き」・scripts/draw-in.ts。docs/design.md の8章）
import { shuyouBin, eraRef, halfWidth, sameScale, type ShuyouStatus } from '../lib/data.ts';

interface Props { r: ShuyouStatus }
const { r } = Astro.props;
// 線の上の位置（%）。左の S までは基準値より悪いときの外、右の G から先はゴールを超えたとき
const S = 14;
const G = 90;
const bin = shuyouBin(r);
const raw = r.rate != null ? S + (r.rate / 100) * (G - S) : bin === '100%以上' ? G : bin === '後退' ? S / 2 : null;
const p = raw == null ? null : Math.min(100, Math.max(0, raw));
const back = p != null && p < S;
// いまの値の札の寄せ方（線の端で切れないように、左の端の近くは左寄せ、右の端の近くは右寄せ）
const align = p == null || p < 30 ? 'a-l' : p > 70 ? 'a-r' : 'a-c';
const half = (s: string) => halfWidth(s).replace(/％/g, '%');
const [b, a, t] = sameScale([half(r.base_raw), half(r.actual_raw), half(r.target_raw)]);
const ref = (s: string | null) => eraRef(s);
---
<div class:list={['road', p == null && 'none']} data-draw-in style={`--s:${S}%;--g:${G}%;--p:${p ?? S}%`}>
  <div class="rd-sl"><span class="rd-k">スタート</span> <span class="rd-v">{b}</span>{ref(r.base_ref) && <span class="rd-y">（{ref(r.base_ref)}）</span>}</div>
  <div class="rd-nowrow"><span class:list={['rd-now', align]}><span class="rd-k">いま</span> <b class="rd-v">{a}</b>{ref(r.actual_ref) && <span class="rd-y">（{ref(r.actual_ref)}）</span>}</span></div>
  <div class="rd-gl"><span class="rd-k">ゴール</span> <span class="rd-v">{t}</span>{ref(r.target_ref) && <span class="rd-y">（{ref(r.target_ref)}）</span>}</div>
  <div class="rd-track" aria-hidden="true">
    <span class="rd-line"></span>
    {p != null && p !== S && <span class:list={['rd-fill', back && 'back']}></span>}
    <span class="rd-s"></span>
    <svg class="rd-g" viewBox="0 0 14 18" width="14" height="18"><path d="M2.5 17 V1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path d="M3 1.5 L13 5.5 L3 9.5 Z" fill="currentColor" /></svg>
    {p != null && <span class:list={['rd-dot', back && 'back']}></span>}
  </div>
</div>

<style>
  /* 上から「いま」・線・「スタート｜ゴール」の3段。線の上の位置は、左右に印の半分の余白を取った内側の幅に対する割合。
     スタートとゴールの値は、線の上のスタートの位置からゴールの位置までを半分ずつ使う（入らなければ折り返す） */
  .road {
    display: grid; grid-template-columns: calc(var(--s) - 6px) minmax(0, 1fr) minmax(0, 1fr) calc(100% - var(--g) - 6px);
    grid-template-areas: "now now now now" "track track track track" ". start goal ."; column-gap: 12px; padding: 0 8px; margin-top: 2px;
  }
  .rd-k { font-size: 0.75rem; font-weight: 700; color: var(--ink-2); }
  .rd-y { display: inline-block; font-size: 0.75rem; color: var(--ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .rd-nowrow { grid-area: now; position: relative; height: 1.5em; }
  .rd-now { position: absolute; bottom: 0; left: var(--p); white-space: nowrap; line-height: 1.4; }
  .rd-now.a-l { translate: -10px 0; }
  .rd-now.a-c { translate: -50% 0; }
  .rd-now.a-r { translate: calc(-100% + 10px) 0; }
  .none .rd-now { left: var(--s); }
  .rd-now .rd-v { font-size: 0.9375rem; }
  .rd-sl, .rd-gl { font-size: 0.875rem; color: var(--ink-2); line-height: 1.45; }
  .rd-sl { grid-area: start; margin-left: -12px; } /* 1列目とのすき間のぶん左へ（スタートの印の左端にそろえる） */
  .rd-gl { grid-area: goal; text-align: right; margin-right: -12px; }
  /* スマホでは、言葉の後ろで折り返し、値の途中では折り返さない */
  @media (max-width: 720px) {
    .rd-sl, .rd-gl { font-size: 0.8125rem; }
    .rd-sl .rd-k, .rd-gl .rd-k { display: block; }
  }
  .rd-track { grid-area: track; position: relative; height: 22px; color: var(--line); }
  .rd-track > * { position: absolute; }
  .rd-line { left: var(--s); width: calc(var(--g) - var(--s)); top: 9px; height: 4px; border-radius: 2px; background: var(--hair); }
  .none .rd-line { background: repeating-linear-gradient(90deg, var(--hair) 0 6px, transparent 6px 10px); }
  /* スタートからいままで。後ろ向き（基準値より悪い）のときは、スタートから左へ */
  .rd-fill { top: 9px; height: 4px; left: var(--s); width: calc(var(--p) - var(--s)); border-radius: 2px; background: var(--line); transform-origin: left center; }
  .rd-fill.back { left: var(--p); width: calc(var(--s) - var(--p)); transform-origin: right center; }
  .rd-s { left: var(--s); top: 5px; width: 12px; height: 12px; translate: -50% 0; border: 2.5px solid var(--line); border-radius: 50%; background: var(--paper); }
  .rd-g { left: var(--g); top: -6px; translate: -2.5px 0; }
  .rd-dot { left: var(--p); top: 11px; width: 14px; height: 14px; translate: -50% -50%; border-radius: 50%; background: var(--line); box-shadow: 0 0 0 2.5px var(--paper); }
  /* 後ろ向きは、左を向いた三角の矢印 */
  .rd-dot.back { width: 12px; height: 14px; translate: -30% -50%; border-radius: 0; box-shadow: none; clip-path: polygon(0 50%, 100% 0, 100% 100%); }
</style>
