---
// トップの主要指標の図（県の概要版の主要指標の達成状況）。将来像ごとに1行で、主要指標1つを1つの点にして、スタート（基準値）から
// ゴール（目標値）までの道の上に達成率の位置で置く。道の外（後退・目標値に到達）は位置で比べず左右の枠にまとめる（lib/data.ts の shuyouSpot）。
// 横の並び（後退 | 道 | 目標値に到達）は将来像ページの道のりの行（ShuyouRoad）と同じ。点は状態で色を分けず実績値の青1色、
// 枠の幅は左右で同じにして、どちらかだけを目立たせない。点に名前と値のツールチップ（scripts/tooltip.ts）を付け、同じ内容を「表で見る」に出す。
// 近い位置の点は段を変えて重ならないようにする（段はビルド時に決め、道の線を中心に上・下・2段上・2段下…と交互に積む）
import Sz from './Sz.astro';
import Term from './Term.astro';
import { SHUYOU_BINS, SHUYOU_FORWARD, shuyouRateText, yearLong, LATEST, type ShuyouStatus } from '../lib/data.ts';
import { fmt } from '../lib/format.ts';

interface Props { rows: ShuyouStatus[]; visions: { id: number; name: string }[] }
const { rows, visions } = Astro.props;
// 道の上の点の間が GAP（道の長さの%）より近いときは段を変える
const GAP = 4;
const value = (raw: string, ref: string | null) => (ref ? `${raw}（${ref}）` : raw);
const binLabel = (r: ShuyouStatus) => SHUYOU_BINS.find((b) => b.key === r.bin)!.label;
const tip = (r: ShuyouStatus) => ({
  'data-tip-value': r.name,
  'data-tip-label': `達成率 ${shuyouRateText(r)}（${binLabel(r)}）・実績値 ${value(r.actual_raw, r.actual_ref)}`,
});
const lines = visions.map((v) => {
  const rs = rows.filter((r) => r.kihon.shouraizou === v.id);
  const ends: number[] = [];
  const road = rs.flatMap((r) => (r.spot?.zone === 'road' ? [{ r, at: r.spot.at }] : [])).sort((a, b) => a.at - b.at).map((d) => {
    let lane = ends.findIndex((e) => d.at - e >= GAP);
    if (lane < 0) lane = ends.push(d.at) - 1;
    else ends[lane] = d.at;
    return { ...d, y: lane % 2 ? -(lane + 1) / 2 : lane / 2 };
  });
  return {
    ...v,
    n: rs.length,
    back: rs.filter((r) => r.spot?.zone === 'back'),
    goal: rs.filter((r) => r.spot?.zone === 'goal'),
    road,
    // 線より上・下に積んだ段の数（道の高さと線の位置に使う）
    up: Math.max(0, ...road.map((d) => -d.y)),
    down: Math.max(0, ...road.map((d) => d.y)),
    none: rs.filter((r) => !r.spot).length,
  };
});
const count = (keys: string[]) => rows.filter((r) => keys.includes(r.bin)).length;
---
<figure class="sticker shuyou-map">
  <figcaption>
    <div class="chart-title">めざす姿までの道のり（{yearLong(LATEST)}・主要指標{fmt(rows.length)}）</div>
    <div class="chart-caption">点は主要指標1つです。スタート（<Term word="基準値" />）からゴール（R9年度の<Term word="目標値" />）までのどこにいるかを、県の<Term word="主要指標の達成率" label="達成率" />の位置に置きました。点を押すと名前と値を出します。</div>
  </figcaption>
  <div class="map" aria-hidden="true">
    <div class="m-row m-head">
      <span class="m-label"></span>
      <span class="strip">
        <span class="z-back">後退</span>
        <span class="z-road"><span>スタート</span><span>50%</span><span>ゴール</span></span>
        <span class="z-goal">目標値に<wbr />到達</span>
      </span>
      <span class="m-none"></span>
    </div>
    {lines.map((l) => (
      <div class:list={['m-row', `sz-${l.id}`]}>
        <a class="m-label" href={`/future/${l.id}/#shuyou-h`} tabindex="-1"><Sz id={l.id} sr={false} />将来像{l.id}</a>
        <span class="strip">
          <span class="z-back">{l.back.map((r) => <i class="dot" {...tip(r)} />)}</span>
          <span class="z-road" style={`--up:${l.up};--down:${l.down}`}>
            <i class="line" /><i class="mid" /><i class="start" /><i class="ring" />
            {l.road.map((d) => <i class="dot" style={`left:${d.at}%;--y:${d.y}`} {...tip(d.r)} />)}
          </span>
          <span class="z-goal">{l.goal.map((r) => <i class="dot" {...tip(r)} />)}</span>
        </span>
        <span class="m-none">{l.none > 0 && `比べられない ${l.none}`}</span>
      </div>
    ))}
  </div>
  <p class="m-sum">
    前進 <b>{fmt(count([...SHUYOU_FORWARD]))}</b>（うち目標値に到達 {fmt(count(['100%以上']))}）・横ばい <b>{fmt(count(['横ばい']))}</b>・後退 <b>{fmt(count(['後退']))}</b>・比べられない <b>{fmt(count(['その他']))}</b>
  </p>
  <details>
    <summary>表で見る</summary>
    <div class="table-wrap">
      <table>
        <thead><tr><th>将来像</th><th>主要指標</th><th>基準値</th><th>直近の実績値</th><th>目標値</th><th class="num">達成率</th><th>区分</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="nowrap">将来像{r.kihon.shouraizou}</td>
              <th scope="row"><a href={r.href}>{r.name}</a>{r.revised && '※'} <span class="code-no">{r.code}</span></th>
              <td>{value(r.base_raw, r.base_ref)}</td>
              <td>{value(r.actual_raw, r.actual_ref)}</td>
              <td>{value(r.target_raw, r.target_ref)}</td>
              <td class="num nowrap">{shuyouRateText(r)}</td>
              <td class="nowrap">{binLabel(r)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .shuyou-map { display: grid; gap: 12px; }
  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .chart-caption { font-size: 0.875rem; color: var(--ink-2); }
  .map { display: grid; gap: 6px; }
  /* PC は「将来像 | 後退・道・目標値に到達 | 比べられない」。スマホは将来像の名前を上に置き、道を全幅にする */
  .m-row { display: grid; grid-template-columns: 6.5em minmax(0, 1fr) 7.5em; grid-template-areas: "label strip none"; gap: 10px; align-items: center; }
  .m-label { grid-area: label; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.875rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .m-label :global(.badge-sz) { width: 22px; height: 22px; font-size: 0.8125rem; }
  .m-none { grid-area: none; font-size: 0.75rem; color: var(--muted); font-weight: 700; }
  .strip { grid-area: strip; display: grid; grid-template-columns: 15% minmax(0, 1fr) 15%; gap: 6px; align-items: stretch; }
  .m-head { font-size: 0.75rem; font-weight: 700; color: var(--ink-2); }
  .m-head .z-back, .m-head .z-goal { text-align: center; line-height: 1.2; align-self: end; }
  .m-head .z-road { display: flex; justify-content: space-between; align-self: end; }
  .m-row:not(.m-head) .z-back, .m-row:not(.m-head) .z-goal { border-radius: 8px; background: var(--bg); padding: 5px; display: flex; flex-wrap: wrap; gap: 3px; align-content: center; min-height: 26px; }
  .m-row:not(.m-head) .z-back { justify-content: flex-end; }
  /* 道: 点を積んだ段の数だけ高くし、線は上に積んだ段の下に引く（--up・--down は線より上・下の段の数）。
     枠（後退・目標値に到達）の点は線の高さにそろえず、枠の中で折り返す */
  .m-row:not(.m-head) .z-road { position: relative; margin: 0 8px; min-height: calc((var(--up) + var(--down) + 1) * 16px + 10px); --mid: calc(var(--up) * 16px + 13px); }
  .line { position: absolute; top: var(--mid); left: 0; right: 0; height: 4px; margin-top: -2px; border-radius: 2px; background: var(--grid); }
  .mid { position: absolute; top: 4px; bottom: 4px; left: 50%; border-left: 1.5px dashed var(--hair); }
  .start { position: absolute; top: var(--mid); left: 0; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: var(--ink-2); }
  .ring { position: absolute; top: var(--mid); left: 100%; width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; border-radius: 50%; border: 2.5px solid var(--ink-2); background: var(--paper); box-sizing: border-box; }
  .dot { display: block; flex: none; width: 13px; height: 13px; border-radius: 50%; background: var(--pop); border: 1.5px solid var(--line); box-sizing: border-box; cursor: default; }
  .z-road .dot { position: absolute; top: var(--mid); margin: -6.5px 0 0 -6.5px; transform: translateY(calc(var(--y) * 16px)); }
  .m-sum { margin: 0; font-size: 0.875rem; color: var(--ink-2); }
  .m-sum b { font-family: var(--font-num); font-weight: 600; color: var(--ink); font-size: 1.05rem; }
  .nowrap { white-space: nowrap; }
  @media (max-width: 640px) {
    .m-row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "label none" "strip strip"; gap: 4px 8px; }
    .m-head { grid-template-areas: "strip strip"; }
    .m-head .m-label, .m-head .m-none { display: none; }
    .strip { grid-template-columns: 17% minmax(0, 1fr) 17%; gap: 4px; }
    .m-row:not(.m-head) .z-back, .m-row:not(.m-head) .z-goal { padding: 4px; gap: 2px; }
    .dot { width: 11px; height: 11px; }
    .z-road .dot { margin: -5.5px 0 0 -5.5px; }
  }
</style>
