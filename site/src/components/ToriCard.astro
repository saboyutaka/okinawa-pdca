---
// 主な取組1つ（施策ページ。親は .tcards の grid）。4年のスタンプ・活動指標・対応する成果指標・その年にやったこと。予算は取組のページで見せる
import Stamps from './Stamps.astro';
import Chunk from './Chunk.astro';
import Term from './Term.astro';
import ThemeTags from './ThemeTags.astro';
import { YEARS, yearLabel, statusOf, toneOfStatus, budgetOf, sectionHref, seikaHrefByName, torikumiHref, type YearGroup } from '../lib/data.ts';
import { themeIdsOfItem } from '../lib/themes.ts';
import type { TorikumiRow } from '../lib/types.ts';

interface Props { row: YearGroup<TorikumiRow>; shisakuId: string }
const { row, shisakuId } = Astro.props;
const t = row.latest;
const b = budgetOf(t.year, t.shisaku_id, t.key);
const seikaHref = b?.seika_name ? seikaHrefByName(shisakuId, b.seika_name) : null;
const href = torikumiHref(shisakuId, row.key);
const stamps = YEARS.map((y) => (row.years[y] ? { year: y, tone: toneOfStatus(statusOf(row.years[y])), text: statusOf(row.years[y]) } : { year: y, tone: null, text: '報告なし' }));
// 「目標 10件 → 実績 54件」のように同じ単位の数のときだけ棒にする
const qty = (raw: string) => { const m = (raw || '').normalize('NFKC').match(/^([\d,.]+)\s*([^\d\s（(→]*)/); return m ? { v: Number(m[1].replace(/,/g, '')), u: m[2] } : null; };
// 目標・実績が2行以上に印字されている取組（北部と西表、件数と回数など）は、行ごとに並べて棒は出さない（1つの割合にまとめられないため）
const tq = t.lines ? null : qty(t.target);
const aq = t.lines ? null : qty(t.actual);
const comparable = tq && aq && tq.v > 0 && tq.u === aq.u;
const ratio = comparable ? aq.v / tq.v : 0;
// 棒の色は進捗状況の区分（STATUSES）と同じ境目（90%・75%・60%）
const ratioTone = ratio >= 0.9 ? 'good' : ratio >= 0.75 ? 'warning' : ratio >= 0.6 ? 'serious' : 'critical';
---
<article class="sticker tcard">
  <div class="th">
    <h3><a class="name-link" href={href}>{t.name}</a></h3>
    <div class="sec">{sectionHref(t.section) ? <a class="sub-link" href={sectionHref(t.section)}>{t.section}</a> : t.section}</div>
    <ThemeTags ids={themeIdsOfItem(shisakuId, t.name)} />
  </div>
  <Stamps items={stamps} label="4年の進捗状況" size="small" />
  {t.indicator ? (
    <div class="act inset">
      <div class="act-l"><Term word="活動指標" />（{yearLabel(t.year)}）</div>
      <div class="act-name">{t.indicator}</div>
      {t.lines ? (
        <ul class="act-lines">{t.lines.map((l) => <li>目標 {l.target || '—'} → 実績 {l.actual || '—'}</li>)}</ul>
      ) : (
        <div>目標 {t.target || '—'} → 実績 {t.actual || '—'}{comparable && ratio >= 1 && <strong>　目標クリア</strong>}</div>
      )}
      {comparable && <Chunk frac={ratio} tone={ratioTone} label={`活動指標 目標 ${t.target}、実績 ${t.actual}（目標の${Math.round(ratio * 100)}%）`} thin />}
    </div>
  ) : <div />}
  {b?.seika_name ? <div class="small">対応する成果指標: {seikaHref ? <a class="sub-link" href={seikaHref}>{b.seika_name}</a> : b.seika_name}</div> : <div />}
  {t.summary ? (
    <div class="did">
      <div class="did-l">{yearLabel(t.year)}にやったこと</div>
      <p>{t.summary}</p>
    </div>
  ) : <div />}
  <a class="to-page" href={href}>この取組の4年分の活動・予算・検証・改善案</a>
</article>

<style>
  /* 並んだカードで段（見出し・スタンプ・活動指標…）の高さをそろえる。中身のない段も空の div で数を保つ */
  .tcard { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 10px; align-content: start; padding: 16px; }
  .th { display: grid; gap: 4px; align-content: start; }
  h3 { font-size: 1rem; margin: 0; line-height: 1.5; }
  .sec { font-size: 0.875rem; color: var(--ink-2); }
  .th :global(.ttags) { margin-top: 2px; }
  .act { padding: 8px 12px; font-size: 0.875rem; display: grid; gap: 4px; align-self: start; }
  .act-l { color: var(--ink-2); font-weight: 700; }
  .act-name { font-weight: 700; }
  .act-lines { margin: 0; padding-left: 1.2em; }
  .did { font-size: 0.875rem; display: grid; gap: 2px; align-content: start; }
  .did-l { color: var(--ink-2); font-weight: 700; }
  .did p { margin: 0; line-height: 1.7; }
  .to-page { font-size: 0.875rem; font-weight: 700; align-self: end; }
</style>
