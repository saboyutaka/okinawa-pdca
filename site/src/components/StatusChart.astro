---
// 区分ごとの内訳を、行（年度・将来像など）ごとの100%積み上げ横棒で並べる。凡例は上、表は下に畳んで置く。
// 同じ区分の図をいくつも並べるページでは、凡例をページに1回だけ出し、図には legend={false} を渡す（毎回の凡例はくどいため）。
// 行の名前が年度（R4 前期）のように短いときは、名前を1行にし、スマホでも棒を同じ行に置く（1行が3段になって縦に長くなるため）
import StatusBar from './StatusBar.astro';
import Chip from './Chip.astro';
import { fmt, pct } from '../lib/format.ts';
import type { Shape, Tone } from '../lib/icons.ts';

// id は行の名前に付ける（ほかのページからその行へ飛べるように。部局のページの課の行）。code は報告書の番号で、名前の後ろに小さく薄く置く。行の右には件数を出す
interface Row { label: string; sub?: string; code?: string; href?: string; id?: string; counts: Record<string, number> }
interface Props {
  title: string;
  caption?: string;
  categories: { key: string; tone: Tone; note?: string; shape?: Shape; hatch?: boolean }[];
  rows: Row[];
  unit?: string;
  legend?: boolean;
}
const { title, caption, categories, rows, unit = '件', legend = true } = Astro.props;
const used = categories.filter((c) => rows.some((r) => (r.counts[c.key] || 0) > 0));
const totalOf = (r: Row) => used.reduce((s, c) => s + (r.counts[c.key] || 0), 0);
const short = rows.every((r) => r.label.length <= 4 && (r.sub ?? '').length <= 3);
---
<figure class="chart-card sticker">
  <figcaption>
    <div class="chart-title">{title}</div>
    {caption && <div class="chart-caption">{caption}</div>}
  </figcaption>
  {legend && (
    <ul class="legend" aria-label="凡例">
      {used.map((c) => <li><Chip tone={c.tone} text={c.key} title={c.note} shape={c.shape} /></li>)}
    </ul>
  )}
  <div class:list={['rows', short && 'short']}>
    {rows.map((r) => (
      <div class="row">
        <div class:list={['row-label', r.id && 'anchor']} id={r.id}>
          {r.href ? <a class="name-link" href={r.href}>{r.label}</a> : r.label}
          {r.code && <> <span class="code-no">{r.code}</span></>}
          {r.sub && <span class="row-sub">{r.sub}</span>}
        </div>
        <StatusBar categories={used} counts={r.counts} unit={unit} context={`${r.label} `} />
        <div class="row-total num">{fmt(totalOf(r))}{unit}</div>
      </div>
    ))}
  </div>
  <details class="table-view">
    <summary>表で見る</summary>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th></th>{used.map((c) => <th class="num">{c.key}</th>)}<th class="num">計</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th>{r.label}</th>
              {used.map((c) => <td class="num">{fmt(r.counts[c.key] || 0)}<br /><small class="secondary">{pct(r.counts[c.key] || 0, totalOf(r))}</small></td>)}
              <td class="num">{fmt(totalOf(r))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .chart-card { margin: 16px 0 0; }
  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .chart-caption { font-size: 0.875rem; color: var(--ink-2); }
  .legend { list-style: none; padding: 0; margin: 10px 0 14px; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  figcaption + .rows { margin-top: 12px; }
  /* 全行で列幅をそろえ、棒の左端を合わせる */
  .rows { display: grid; grid-template-columns: minmax(4.5em, max-content) 1fr auto; align-items: center; gap: 10px 12px; }
  .row { display: contents; }
  .row-label { font-size: 0.9375rem; line-height: 1.35; font-weight: 700; }
  .row-sub { display: block; font-size: 0.8125rem; color: var(--ink-2); font-weight: 400; }
  /* ほかのページから飛んできた行（部局のページの課）は、地の色で示す */
  .row-label:target { background: var(--sky); box-shadow: 0 0 0 4px var(--sky); border-radius: 4px; }
  .row-total { font-size: 0.875rem; color: var(--ink-2); min-width: 4.5em; text-align: right; }
  .short .row-label { white-space: nowrap; }
  .short .row-sub { display: inline; margin-left: 0.3em; }
  .table-view { margin-top: 14px; }
  .table-view td small { font-size: 0.75rem; } /* 件数の下の割合は添えるだけなので小さく */
  @media (max-width: 560px) {
    .rows:not(.short) { grid-template-columns: 1fr; }
    .rows:not(.short) .row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 12px; }
    .rows:not(.short) .row :global(.sbar) { grid-column: 1 / -1; grid-row: 2; }
    .short { gap: 8px 10px; }
    .short .row-total { min-width: 0; }
  }
</style>
