---
// シェア用のページ（lib/routes.ts の SHARE_ROUTES）の中身。開くとすぐに指標を見せる場所へ移る（layouts/Base.astro の jump）ので、ふつうは見えない。
// スクリプトが動かないときのために、何の指標かと、見せる場所へのリンクだけを置く
import HeadKind from './HeadKind.astro';
import type { TermWord } from '../lib/terms.ts';

// place は見せる場所のページ（「施策「〇〇」のページ」）
interface Props { kind: TermWord; name: string; to: string; place: string }
const { kind, name, to, place } = Astro.props;
---
<header class="sticker lift page-head">
  <HeadKind kind={kind} />
  <h1>{name}</h1>
  <p><a href={to}>{place}で、この{kind}を見る</a></p>
</header>

<style>
  p { margin: 0; }
</style>
