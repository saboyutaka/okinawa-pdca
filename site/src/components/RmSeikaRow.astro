---
// 観光ロードマップの成果指標の一覧の1行（lib/plans.ts の kankoSeikaList の行。親は ul.row-list）。
// 沖縄県PDCAの成果指標の行（SeikaRow）と同じ形で、左に名前と施策の2行、右に基準値と比べた県の判定の印とゴールまでの道のりの小さな図（RmSeikaSpark）。
// 図の凡例は一覧の上に1回だけ書く（SeikaKey）。基準値・実績値・目標値は図に任せて読み上げ用の文にだけ残し、数字は施策展開のページの札で見る。
// 名前は施策展開のページのその指標の札へのリンク
import Chip from './Chip.astro';
import RmSeikaSpark from './RmSeikaSpark.astro';
import { withUnit, refText } from '../lib/data.ts';
import { rmJudgementOf, type KankoSeikaListRow } from '../lib/plans.ts';

interface Props { r: KankoSeikaListRow }
const { r } = Astro.props;
const x = r.x;
const u = ['―', '-', '－'].includes(x.unit) ? '' : x.unit;
const j = rmJudgementOf(r.judgement);
const ref = refText(r.latestRef);
const srText = `基準値と比べた判定 ${r.judgement}。基準値 ${withUnit(x.base_raw, u)}、実績値 ${withUnit(r.latestRaw, u)}${ref ? `（${ref}）` : ''}、目標値 ${withUnit(x.target_raw, u)}（R6）`;
---
<li class="m-row">
  <div class="m-head"><a class="name-link" href={r.href}>{x.name}</a>{u && <small class="secondary">（{u}）</small>}</div>
  <div class="m-sub small secondary">施策 <a class="sub-link" href={r.href.split('#')[0] + '#rm-' + r.rm.id}>{r.rm.name}</a> <span class="code-no">{r.rm.code}</span></div>
  <div class="m-viz" aria-hidden="true">
    <Chip tone={j.tone} shape={j.shape} text={r.judgement} title={j.note} />
    <RmSeikaSpark x={x} />
  </div>
  <span class="sr-only">{srText}</span>
</li>
