---
// トップの主要指標の図。県の概要版の49指標を将来像の見出しの下に表の順に並べ、1指標1枚の箱に名前・報告年度ごとの値の小さな折れ線
// （SeikaSpark。値は lib/data.ts の getShuyouStatus の series）・いまの値・県の達成率を入れる（良い・悪いで並べ替えない・選ばない）。
// 下に区分ごとの数を同じ重みで1行（前進（うち目標値に到達）・横ばい・後退・比べられない）と「表で見る」
import Sz from './Sz.astro';
import Term from './Term.astro';
import SeikaSpark from './SeikaSpark.astro';
import SeikaKey from './SeikaKey.astro';
import { SHUYOU_BINS, SHUYOU_FORWARD, shuyouRateText, yearLong, LATEST, type ShuyouStatus } from '../lib/data.ts';
import { fmt } from '../lib/format.ts';

interface Props { rows: ShuyouStatus[]; visions: { id: number; name: string }[] }
const { rows, visions } = Astro.props;
const value = (raw: string, ref: string | null) => (ref ? `${raw}（${ref}）` : raw);
const binLabel = (r: ShuyouStatus) => SHUYOU_BINS.find((b) => b.key === r.bin)!.label;
const groups = visions.map((v) => ({ ...v, rows: rows.filter((r) => r.kihon.shouraizou === v.id) })).filter((v) => v.rows.length);
const count = (keys: string[]) => rows.filter((r) => keys.includes(r.bin)).length;
---
<figure class="sticker shuyou-grid">
  <figcaption>
    <div class="chart-title">主要指標の移り変わり（{yearLong(LATEST)}の報告の{fmt(rows.length)}指標）</div>
    <div class="chart-caption">報告の年度ごとの<Term word="実績値" />の折れ線です。○は R9年度の<Term word="目標値" />、右下の数は県の<Term word="主要指標の達成率" label="達成率" />です。名前を押すと、基本施策のページの大きな図を開きます。</div>
  </figcaption>
  <SeikaKey mini plan={false} goal where="各指標の" />
  {groups.map((v) => (
    <div class:list={['v-block', `sz-${v.id}`]}>
      <h3 class="v-h"><Sz id={v.id} sr={false} /><a class="name-link" href={`/future/${v.id}/#shuyou-h`}>将来像{v.id}　{v.name}</a></h3>
      <ul class="tiles">
        {v.rows.map((r) => (
          <li class="tile inset">
            <a class="name-link t-name" href={r.href}>{r.name}</a>
            <div class="t-viz" aria-hidden="true"><SeikaSpark part={r.series} /></div>
            <div class="t-foot small" aria-hidden="true">
              <span>いま <b>{r.actual_raw}</b></span>
              <span class="t-rate">達成率 <b>{shuyouRateText(r)}</b></span>
            </div>
            <span class="sr-only">{`実績値 ${value(r.actual_raw, r.actual_ref)}、達成率 ${shuyouRateText(r)}（${binLabel(r)}）`}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <p class="m-sum">
    前進 <b>{fmt(count([...SHUYOU_FORWARD]))}</b>（うち目標値に到達 {fmt(count(['100%以上']))}）・横ばい <b>{fmt(count(['横ばい']))}</b>・後退 <b>{fmt(count(['後退']))}</b>・比べられない <b>{fmt(count(['その他']))}</b>（県の区分。基準値と比べたもの）
  </p>
  <details>
    <summary>表で見る</summary>
    <div class="table-wrap">
      <table>
        <thead><tr><th>将来像</th><th>主要指標</th><th>基準値</th><th>直近の実績値</th><th>目標値</th><th class="num">達成率</th><th>区分</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="nowrap">将来像{r.kihon.shouraizou}</td>
              <th scope="row"><a href={r.href}>{r.name}</a>{r.revised && '※'} <span class="code-no">{r.code}</span></th>
              <td>{value(r.base_raw, r.base_ref)}</td>
              <td>{value(r.actual_raw, r.actual_ref)}</td>
              <td>{value(r.target_raw, r.target_ref)}</td>
              <td class="num nowrap">{shuyouRateText(r)}</td>
              <td class="nowrap">{binLabel(r)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {rows.some((r) => r.revised) && <p class="small secondary">※は、統計の基準改定にあわせて県が試算し直した基準値・目標値です。</p>}
  </details>
</figure>

<style>
  .shuyou-grid { display: grid; gap: 12px; }
  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .chart-caption { font-size: 0.875rem; color: var(--ink-2); }
  .v-block { display: grid; gap: 8px; margin-top: 6px; }
  .v-h { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 0.9375rem; line-height: 1.4; }
  .v-h :global(.badge-sz) { flex: none; width: 24px; height: 24px; font-size: 0.875rem; }
  /* 箱は名前の長さで高さが変わるので、折れ線と値を箱の下にそろえる（同じ行の箱で図の高さがそろう） */
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); }
  .tile { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; min-width: 0; }
  .t-name { font-size: 0.8125rem; line-height: 1.45; }
  .t-viz { margin-top: auto; }
  .t-viz :global(.spark) { width: 100%; height: auto; }
  /* 箱の地（.inset）と図の前期の地が同じ色になるので、前期の地を少し濃くする */
  .t-viz :global(.sp-band) { fill: var(--grid); }
  /* いまの値と達成率は2行に分けて、どの箱も同じ高さの位置に図を置く */
  .t-foot { display: grid; color: var(--ink-2); line-height: 1.4; }
  .t-foot b { color: var(--ink); }
  .t-rate b { font-family: var(--font-num); font-weight: 600; }
  .m-sum { margin: 4px 0 0; font-size: 0.875rem; color: var(--ink-2); }
  .m-sum b { font-family: var(--font-num); font-weight: 600; color: var(--ink); font-size: 1.05rem; }
  .nowrap { white-space: nowrap; }
  @media (max-width: 640px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
    .tile { padding: 8px 10px; }
    .t-name { font-size: 0.75rem; }
  }
</style>
