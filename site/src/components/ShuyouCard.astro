---
// 主要指標1つ（基本施策ページ）。成果指標のカード（SeikaCard）と同じ順に ①県の見通し（1行）と「スタート → いま → ゴール」の数字（ShuyouGoal）
// ②道のりの図 ③そのすぐ下に、年度を列にして図にそろえた表（畳む。ShuyouTable） ④県による説明（吹き出し。ShuyouSays）。
// 主要指標には達成率と年度ごとの計画値がないので、①は県の見通しにし、図には計画の道すじを引かない。
// 男性・女性のように1つの欄に値が並ぶ指標は、部分ごとに①〜③を並べる（分け方と、図に置く数の読み取りは lib/data.ts の shuyouRows）
import SeikaChart from './SeikaChart.astro';
import ShuyouGoal from './ShuyouGoal.astro';
import ShuyouTable from './ShuyouTable.astro';
import ShuyouSays from './ShuyouSays.astro';
import Term from './Term.astro';
import { YEARS, LATEST, yearLabel, type ShuyouGroup } from '../lib/data.ts';

// id は主要指標の一覧の行から飛ぶ先（lib/data.ts の shuyouAnchor）。says はこの指標についての評価検証報告書の県の説明
interface Props { row: ShuyouGroup; id: string; says?: string }
const { row, id, says } = Astro.props;
const x = row.latest;
const yl = yearLabel(x.year);
const split = row.parts.length > 1;
// 計画期間をまたいで基準値・目標値が変わった（R6→R7）
const prevRow = [...YEARS].reverse().filter((y) => y < x.year).map((y) => row.years[y]).find((r) => r && (r.year <= 2024) !== (x.year <= 2024));
// 新しくなったのはスタート（基準値）・ゴール（目標値）のどちらか。どちらも同じ指標もある（欄の中の改行・全角半角の違いは同じとみなす）
const sameText = (a: string | null | undefined, b: string | null | undefined) => (a || '').normalize('NFKC').replace(/\s/g, '') === (b || '').normalize('NFKC').replace(/\s/g, '');
const renewed = prevRow && [!sameText(prevRow.base_raw, x.base_raw) && 'スタート', !sameText(prevRow.target_raw, x.target_raw) && 'ゴール'].filter(Boolean).join('と');
---
<article class="sticker scard" id={id}>
  <h3>{x.name}{!split && row.parts[0].unit && <span class="secondary small">（{row.parts[0].unit}）</span>}</h3>
  {x.year !== LATEST && <p class="small notice-inline">この指標は{yl}まで使われていました（R7の中期実施計画で入れ替わった指標）。</p>}
  {row.parts.map((p) => (
    <div class="part">
      {split && <h4>{p.label}{p.unit && <span class="secondary small">（{p.unit}）</span>}</h4>}
      <ShuyouGoal part={p} />
      <SeikaChart row={p} unit={p.scale === 1 ? p.unit : ''} drawable={p.drawable} aligned />
      <ShuyouTable row={row} part={p} />
    </div>
  ))}
  {prevRow && (
    <p class="small secondary note">
      {yl}から中期<Term word="実施計画" />になり、{renewed ? `${renewed}が新しくなりました` : 'スタートとゴールの値は前期と同じです'}。
    </p>
  )}
  {says && <ShuyouSays text={says} />}
</article>

<style>
  .scard { margin-top: 18px; }
  .scard h3 { margin-top: 0; }
  .notice-inline { background: var(--pink); border-radius: 10px; padding: 4px 10px; display: inline-block; }
  /* 男性・女性のように分けた部分は、細い線で区切って名前の見出しを付ける */
  .part + .part { margin-top: 16px; padding-top: 4px; border-top: 2px solid var(--hair); }
  .part h4 { margin: 10px 0 0; }
  .note { margin: 10px 0 0; }
</style>
