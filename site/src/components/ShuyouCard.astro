---
// 主要指標1つ（基本施策ページ）。成果指標のカード（SeikaCard）と同じ順に ①名前と達成状況の札・シェアのボタン ②スタート → いま → ゴールの値（1行）
// ③道のりの図とそのすぐ下の「表で見る」（ShuyouTable） ④県の吹き出し（県の見通しと評価検証報告書の説明。ShuyouSays）。
// ①の札は将来像のページと同じ概要版の達成状況（「後退 -6%」）で、将来像のページと同じく名前のすぐ後ろに置く（シェアのボタンとは離す）。男性・女性のように分けた指標は部分の見出しの横に、
// 付属資料の欄が分けられず概要版の行と部分が対応しない指標は名前の下に、行ごとの名前を付けて並べる（どこに置くかは lib/data.ts の shuyouStatusOfCard）。
// 県の見通しは県の見立ての言葉なので、①の札（数え方）と分けて④の県の吹き出しに出す（年度ごとの見通しは表）。
// 主要指標には年度ごとの計画値がないので、図には計画の道すじを引かない。図はスタート・いま・ゴールの位置を見せるので、値は箱にせず1行にまとめる。
// 中期実施計画で基準値・目標値が新しくなったことは、表の計画期間ごとの基準値・目標値で見られるので書かない（成果指標と同じ）。
// 男性・女性のように1つの欄に値が並ぶ指標は、部分ごとに②③を並べる（分け方と、図に置く数の読み取りは lib/data.ts の shuyouRows）
import SeikaChart from './SeikaChart.astro';
import ShuyouTable from './ShuyouTable.astro';
import ShuyouSays from './ShuyouSays.astro';
import ShareMenu from './ShareMenu.astro';
import ShuyouStatusTag from './ShuyouStatusTag.astro';
import RouteVals from './RouteVals.astro';
import { LATEST, yearLabel, refText, withUnit, sameScale, shuyouStatusOfCard, type ShuyouGroupOfKihon, type ShuyouPart } from '../lib/data.ts';

// カードの id（g.anchor）は、将来像のページ・指標のマップ・計画の目次・シェア用のページから飛ぶ先。says はこの指標についての評価検証報告書の県の説明
interface Props { g: ShuyouGroupOfKihon; says?: string }
const { g, says } = Astro.props;
const x = g.latest;
const yl = yearLabel(x.year);
const split = g.parts.length > 1;
const tags = shuyouStatusOfCard(g);
// 図の位が1でない指標（万t-CO₂ など）は、位の書かれていない数に単位を添えない（どの位の数か分からないため）
const unitOf = (p: ShuyouPart) => (p.scale === 1 ? p.unit : '');
// 欄の後ろのかっこ（基準年・「速報値」など）は、外側のかっこを外して値の後ろに小さく出す
const unparen = (s: string) => s.replace(/^\s*[（(]/, '').replace(/[）)]\s*$/, '');
// スタート → いま → ゴールの値。位は1つの指標の中でそろえる（印字は「3兆2,885億円 → 34,516億円」のようにまちまち。lib/data.ts の sameScale）
const valsOf = (p: ShuyouPart) => {
  const now = p.latest;
  const [b, a, t] = sameScale([now.b.text, now.a.text, now.t.text]).map((v) => withUnit(v, unitOf(p)));
  return [
    { label: 'スタート', v: b, y: unparen(now.b.note) },
    { label: now.year === LATEST ? 'いま' : `${yl}の報告`, v: a, y: refText(now.a.note), now: true },
    { label: 'ゴール', v: t, y: [now.target_year, unparen(now.t.note)].filter(Boolean).join('・') },
  ];
};
---
<article class="sticker scard" id={g.anchor}>
  <div class="sc-head">
    <div class="sc-title">
      <h3>{x.name}{!split && g.parts[0].unit && <span class="secondary small unit">（{g.parts[0].unit}）</span>}</h3>
      {tags.head.length === 1 && <ShuyouStatusTag r={tags.head[0]} />}
    </div>
    <ShareMenu path={g.share} kind="主要指標" name={x.name} />
  </div>
  {tags.head.length > 1 && (
    <ul class="sc-tags">{tags.head.map((r) => <li><span class="small secondary">{r.name}</span><ShuyouStatusTag r={r} /></li>)}</ul>
  )}
  {g.parts.map((p, i) => (
      <div class="part">
        {split && <div class="part-head"><h4>{p.label}{p.unit && <span class="secondary small">（{p.unit}）</span>}</h4>{tags.parts[i].map((r) => <ShuyouStatusTag r={r} />)}</div>}
        <RouteVals vals={valsOf(p)} />
        <SeikaChart row={p} unit={unitOf(p)} drawable={p.drawable} />
        <ShuyouTable g={g} part={p} />
      </div>
  ))}
  <ShuyouSays g={g} text={says} />
</article>

<style>
  .scard { margin-top: 18px; }
  /* 名前と札の列と、シェアのボタンの列。名前が長いときも、シェアのボタンは右上に置いたまま名前の列の中で折り返す */
  .sc-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 6px 16px; }
  .sc-title { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 10px; min-width: 0; }
  .scard h3 { margin: 0; }
  .unit { white-space: nowrap; } /* 「（万t-CO₂）」をかっこの途中で割らない */
  /* 概要版の行と部分が対応しない指標の札: 行ごとに名前と札 */
  .sc-tags { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px 16px; }
  .sc-tags li { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0 6px; }
  /* 男性・女性のように分けた部分は、細い線で区切って名前の見出しを付ける */
  .part + .part { margin-top: 16px; padding-top: 4px; border-top: 1.5px solid var(--hair); }
  .part-head { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 10px; margin: 10px 0 0; }
  .part h4 { margin: 10px 0 0; }
  .part-head h4 { margin: 0; }
</style>
