---
// 節の見出しを、その節の # へのリンクにする（docs/design.md の3章）。
// 後ろの # は見た目だけの印で、読み上げはリンクの名前を見出しの文字だけにする。
// リンクの中にボタン（Term）は入れられないので、見出しの後ろに添える札などは after のスロットに置く（用語の説明は節の頭の文で出す）。
// class を渡したページの style が当たるよう、残りの属性（Astro が付ける data-astro-cid-*）も見出しに渡す
interface Props { id: string; level?: 2 | 3; class?: string; [attr: string]: unknown }
const { id, level = 2, class: cls, ...rest } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---
<Tag id={id} class:list={['sec-head', cls]} {...rest}><a class="sec-link" href={`#${id}`}><slot /><span class="sec-mark" aria-hidden="true">{'\u2060'}#</span></a><slot name="after" /></Tag>

<style>
  .sec-head { scroll-margin-top: 16px; }
  .sec-link { color: inherit; text-decoration: none; }
  /* # の場所は空けておき、出したときに見出しの文字がずれないようにする。# だけが次の行に送られて見出しの下に空の行ができないよう、
     前の字と語結合子（U+2060）でつなぐ（inline-block にすると、つないでも前で折り返される） */
  .sec-mark { margin-left: 0.3em; color: var(--muted); font-weight: 400; opacity: 0; }
  .sec-link:is(:hover, :focus-visible, :active) .sec-mark { opacity: 1; }
  @media print { .sec-mark { display: none; } }
</style>
