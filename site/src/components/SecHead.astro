---
// 節の見出しを、その節の # へのリンクにする（docs/design.md の3章）。
// 後ろの # は見た目だけの印で、読み上げはリンクの名前を見出しの文字だけにする
interface Props { id: string; level?: 2 | 3 }
const { id, level = 2 } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---
<Tag id={id} class="sec-head"><a class="sec-link" href={`#${id}`}><slot /><span class="sec-mark" aria-hidden="true">#</span></a></Tag>

<style>
  .sec-head { scroll-margin-top: 16px; }
  .sec-link { color: inherit; text-decoration: none; }
  /* # の場所は空けておき、出したときに見出しの文字がずれないようにする */
  .sec-mark { display: inline-block; margin-left: 0.3em; color: var(--muted); font-weight: 400; opacity: 0; }
  .sec-link:is(:hover, :focus-visible, :active) .sec-mark { opacity: 1; }
  @media print { .sec-mark { display: none; } }
</style>
