---
// 年度ごとのスタンプ（判定・進捗状況）。items は年度の順。size="small" は小さい丸を横の線でつなぐ（報告のない年度にかかる線は点線）
import Icon from './Icon.astro';
import { yearLabel } from '../lib/data.js';

interface Item { year: number; tone?: string | null; shape?: string; key?: string; text: string; hatch?: boolean }
interface Props { items: Item[]; label: string; size?: 'normal' | 'small' }
const { items, label, size = 'normal' } = Astro.props;
const small = size === 'small';
---
<ol class:list={['stamps', small && 'small-stamps']} aria-label={label}>
  {items.map((it, i) => (
    <li class:list={['stamp', i > 0 && 'seg', i > 0 && (!it.tone || !items[i - 1].tone) && 'seg-dash']}>
      <span class="y">{yearLabel(it.year)}</span>
      <span class="cw">
        <span class:list={['c', `tone-${it.tone || 'blank'}`, it.hatch && 'hatch']} aria-hidden="true">
          {it.key ? <span class="k"><Icon tone={it.tone || 'blank'} shape={it.shape} size={small ? 9 : 11} />{it.key}</span> : <Icon tone={it.tone || 'blank'} shape={it.tone ? it.shape : 'ring'} size={small ? 12 : 16} />}
        </span>
      </span>
      <span class="t"><span class="sr-only">{yearLabel(it.year)}: </span>{it.text}</span>
    </li>
  ))}
</ol>

<style>
  ol.stamps { list-style: none; padding: 0; margin: 0; }
  .cw { display: grid; place-items: center; }
  .small-stamps { gap: 4px; flex-wrap: nowrap; }
  .small-stamps .stamp { min-width: 0; gap: 1px; }
  .small-stamps .cw { justify-self: stretch; position: relative; }
  .small-stamps .c { position: relative; z-index: 1; width: 32px; height: 32px; border-width: 2px; font-size: 0.875rem; }
  /* 前の年度の丸の中心からこの丸の中心まで（丸は同じ幅の枠の真ん中にあるので、枠の幅＋すき間） */
  .small-stamps .seg .cw::before {
    content: ''; position: absolute; top: 50%; right: 50%; width: calc(100% + 4px); height: 3px; transform: translateY(-50%);
    background: var(--line);
  }
  .small-stamps .seg-dash .cw::before { background: repeating-linear-gradient(90deg, var(--line) 0 4px, transparent 4px 8px); }
</style>
