---
// トップのヒーローと将来像・くらしのテーマのページの頭に置く、3つの段の問いと答え（docs/design.md の1章「3つの段」）。
// くらしのテーマは主要指標との対応をまだ決めていない（#93）ので、shuyou を渡さず、成果指標と取組の2段にする。
// 計画の階層と同じ向きに上から「沖縄の姿（基本施策の主要指標）→ 施策の成果（成果指標）→ 県の活動（主な取組の進捗状況）」と並べ、
// どの段も、県の呼び名・問い・何をいくつ数えたか・答えの割合1つ・県の区分の内訳の棒1本を同じ形で出す（区分は県の並びのまま）。
// 県の呼び名は、県の概要版の「新PDCA」の図と様式２の見出しの言葉（主要指標＝最終アウトカム、成果指標＝初期アウトカム、
// 活動指標＝アウトプット）。問いの上に小さく置き、押すと用語の説明を出す（Term）。
// 答えの割合は、問いに答える区分の割合を小さく添えるだけにする（主要指標は基準値より良くなった「前進」。県の概要版の区分で、目標値に到達を含む。
// 成果指標は「計画値に到達」（達成率 100%以上）、取組は「順調」。トップの4年間の推移と同じ数）。
// 主要指標は、トップ（49指標）ではほかの段と同じつながった棒にし（1マスずつにすると、スマホで細かすぎるため）、
// 将来像のページ（5〜18指標）では、指標のマップのマスのような1指標1つの四角を並べる（shuyouCells。5指標で1指標が棒の2割を占め、割合に見えるため）。
// 四角を押すと、その指標の名前・基本施策・値を吹き出しに出す（StatusBar の pop。中身は指標のマップの吹き出しと同じ。Tab で1回止まり、← → で移る）。
// 3つの段の割合は意味が違う（主要指標は R9 のゴールに対して、成果指標と取組はその年度の計画に対して）ので、1つの図や目盛りにまとめず、差も書かない。
// すっきり見せるため、凡例と区分ごとの数は並べない。区分の名前と数は、棒の区間にマウスを乗せる・タップすると出る（StatusBar。読み上げは棒全体で読む）。
// 「主要指標の49指標」のような何をいくつ数えたかの言葉が、その一覧へのリンク（q は将来像のページの「s=1」のような一覧の条件）。
// 主要指標は一覧のページを置かず、基本施策ごとに見せる5つの将来像のページへ（将来像のページでは、同じページの基本施策の節 shuyouHref へ）。
// ステッカーの中の箱なので、線と影は付けず白い地だけにし、段は細い線で区切る。棒は動かさない（design.md の8章）
import StatusBar from './StatusBar.astro';
import Term from './Term.astro';
import { LATEST, RATE_BINS, STATUSES, SHUYOU_CATS, SHUYOU_FORWARD, shuyouCounts, yearLabel, type ShuyouStatus, type CellItem } from '../lib/data.ts';
import { shuyouCells as cellsOf } from '../lib/map-data.ts';
import type { Tone } from '../lib/icons.ts';
import type { TermWord } from '../lib/terms.ts';
import { fmt, pct } from '../lib/format.ts';

interface Props {
  /** 主要指標（くらしのテーマのページは渡さず、主要指標の段を出さない） */
  shuyou?: ShuyouStatus[];
  /** 成果指標の達成率の区分（RATE_BINS）ごとの数 */
  seika: Record<string, number>;
  /** 主な取組の進捗状況（STATUSES）ごとの数 */
  tori: Record<string, number>;
  /** 複数の施策に載っている同じ取組を1件と数えた主な取組の数（トップ。数の下に「重なりを除くと」として添える。lib/data.ts の distinctTorikumiCount） */
  toriDistinct?: number;
  /** 一覧の条件（将来像のページは `s=1`） */
  q?: string;
  /** 主要指標の行き先（将来像のページは同じページの基本施策の節 `#kihon`） */
  shuyouHref?: string;
  /** 主要指標を1指標1つの四角で並べ、押すと中身を出す（将来像のページ） */
  shuyouCells?: boolean;
}
const { shuyou, seika, tori, toriDistinct, q = '', shuyouHref = '/future/', shuyouCells = false } = Astro.props;
const href = (path: string) => (q ? `${path}?${q}` : path);
const sum = (c: Record<string, number>) => Object.values(c).reduce((a, n) => a + n, 0);
// 棒の区分。主要指標は概要版の言葉（「目標値に到達」など）で出す（lib/data.ts の SHUYOU_CATS）
interface Cat { key: string; tone: Tone; n: number }
type Rung = { id: string; kind: TermWord; q: string[]; term: TermWord; n: number; unit: string; href: string; measure: string; cats: Cat[]; ans: { label: string; n: number }; items?: CellItem[]; note?: string };
const shuyouRung = (rows: ShuyouStatus[]): Rung => {
  const c = shuyouCounts(rows);
  return {
    id: 'shuyou', kind: '最終アウトカム', q: ['沖縄は、', 'めざす姿に', '近づいた？'], term: '主要指標', n: rows.length, unit: '指標', href: shuyouHref, measure: '達成率',
    cats: SHUYOU_CATS.map((x) => ({ ...x, n: c[x.key] })),
    ans: { label: '前進', n: rows.filter((r) => SHUYOU_FORWARD.includes(r.bin)).length },
    items: shuyouCells ? cellsOf(rows) : undefined,
  };
};
const rungs: Rung[] = [
  ...(shuyou ? [shuyouRung(shuyou)] : []),
  {
    id: 'seika', kind: '初期アウトカム', q: ['施策の成果は、', '計画どおりに', '出た？'], term: '成果指標', n: sum(seika), unit: '指標', href: href('/shihyou/'), measure: '達成率',
    cats: RATE_BINS.map((b) => ({ key: b.key, tone: b.tone, n: seika[b.key] || 0 })),
    ans: { label: '計画値に到達', n: seika['100%以上'] || 0 },
  },
  {
    id: 'tori', kind: 'アウトプット', q: ['県の活動は、', '計画どおりに', '進んだ？'], term: '主な取組', n: sum(tori), unit: '件', href: href('/torikumi/'), measure: '進捗状況',
    cats: STATUSES.map((s) => ({ key: s.key, tone: s.tone, n: tori[s.key] || 0 })),
    ans: { label: '順調', n: tori['順調'] || 0 },
    note: toriDistinct != null ? `（重なりを除くと ${fmt(toriDistinct)}件）` : undefined,
  },
];
---
<ul class="ladder">
  {rungs.map((r) => (
    <li class:list={['rung', `rung-${r.id}`]}>
      <div class="r-q">
        <p class="r-kind"><Term word={r.kind} /></p>
        <p class="r-title">{r.q.map((w) => <span class="nw">{w}</span>)}</p>
        <p class="r-sub">
          <a class="r-link" href={r.href}>{r.term}の<b>{fmt(r.n)}</b>{r.unit}<span aria-hidden="true"> →</span></a>
          <span class="r-ans"><span class="r-al">{r.ans.label}</span>{pct(r.ans.n, r.n)}</span>
        </p>
        {r.note && <p class="r-note">{r.note}</p>}
      </div>
      <StatusBar categories={r.cats} counts={Object.fromEntries(r.cats.map((c) => [c.key, c.n]))} unit={r.unit} context={`${r.term}の${r.measure} `} labelKey=""
        pop={r.items && { term: r.term, year: yearLabel(LATEST), items: r.items, shapes: false, keys: true }} />
    </li>
  ))}
</ul>

<style>
  .ladder { list-style: none; margin: 18px 0 0; padding: 2px 18px; background: var(--paper); border-radius: 16px; }
  /* PC は「問いと数 | 棒」の2列。どの段も同じ列にそろえ、問いは1行に収める（何をいくつ数えたかのリンクは問いの下の行） */
  .rung { display: grid; grid-template-columns: 19.5em minmax(0, 1fr); gap: 8px 24px; align-items: center; padding: 14px 0; }
  .rung + .rung { border-top: 1.5px solid var(--hair); }
  .r-kind { margin: 0 0 2px; font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem; line-height: 1.5; color: var(--ink-2); }
  .r-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1.5; }
  .r-title .nw { display: inline-block; } /* 問いは文節の切れ目でだけ折り返す */
  /* 何をいくつ数えたか（リンク）と答えの割合を1行に。割合は右に寄せ、入らなければ次の行へ */
  .r-sub { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px; margin: 2px 0 0; }
  .r-link { font-size: 0.875rem; font-weight: 700; }
  .r-ans { margin-left: auto; font-family: var(--font-num); font-weight: 600; font-size: 1.05rem; white-space: nowrap; }
  .r-al { font-family: var(--font); font-size: 0.75rem; font-weight: 700; color: var(--ink-2); margin-right: 6px; }
  .r-link b { font-family: var(--font-num); font-weight: 600; margin: 0 1px; }
  .r-note { margin: 0; font-size: 0.8125rem; color: var(--ink-2); }
  @media (max-width: 640px) {
    .ladder { padding: 2px 14px; }
    .rung { grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 12px 0; }
    .r-sub { column-gap: 8px; }
    .r-ans { font-size: 1rem; }
    .r-al { font-size: 0.6875rem; margin-right: 4px; }
  }
</style>
