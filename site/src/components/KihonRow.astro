---
// 将来像のページの基本施策の1行（親は ul.row-list）。基本施策の名前の下に、主要指標と主な取組の行を、左に何の行かを書いて並べる。
// 主要指標がこの行の主役で、主な取組の棒は細く控えめにする（docs/design.md の1章「3つの段」。基本施策をはかる物差しは主要指標）。
// - 主要指標（基本施策の最終的な成果をはかる指標。県の概要版の表の順）: 名前と県の達成率、その下に「スタート → いま → ゴール」の道のり
//   （components/ShuyouRoad.astro。いまの位置を達成率で置いた線と、線の上下の値）。
//   いまの値が何年の値かはまちまち（基準値と同じ年のままのものもある）なので、どの値にも年・年度を括弧で添える（lib/data.ts の eraRef。「（R3）」）。
//   年ごとの動きは基本施策のページの図に任せる（名前がそのカードへのリンク）。
//   達成率はこの行でいちばん大事な数なので、右に大きく、概要版の区分（目標値に到達・前進・横ばい・後退・比べられない）の色と形を付けて置く。
//   数の字の大きさは値によらずそろえる（-639% のような極端な値も同じ大きさ。道のりの線では端で止める）。
//   札は数だけにし（成果指標の達成率の札と同じ）、区分の言葉は数にマウスを乗せる・タップすると出す（scripts/tooltip.ts）。
//   主な取組の割合と取り違えないよう「達成率」と添え、それを押すと達成率の説明と区分の一覧を出す（凡例の代わり。ページの KeyBrief kind="shuyou"）。
//   数でない印字（「達成」「後退」）は、大きな字だと強く見えるので小さくする
// - 主な取組: 進捗状況の区分の内訳の細い棒と「順調」の割合（トップ・5つの将来像のページの棒と同じ形。ここでは主要指標より細く短く、字も小さくする）。
//   「順調」を押すと進捗状況の説明と区分の一覧を出す（components/KeyNum.astro。ページの KeyBrief kind="status"）。
//   区分ごとの件数は、棒の区間にマウスを乗せる・タップすると出る（StatusBar）
// 主要指標の名前は、基本施策の名前（太字）の下の項目なので、太字にせず字の色と下線だけでリンクと分かるようにする
import StatusBar from './StatusBar.astro';
import Icon from './Icon.astro';
import Term from './Term.astro';
import KeyNum from './KeyNum.astro';
import ShuyouRoad from './ShuyouRoad.astro';
import { STATUSES, shuyouRateText, shuyouBinOf, type ShuyouStatus } from '../lib/data.ts';
import { pct } from '../lib/format.ts';

interface Measure { n: number; ok: number; counts: Record<string, number> }
interface Props { kihon: { id: string; name: string; code: string }; shuyou: ShuyouStatus[]; tori: Measure }
const { kihon: k, shuyou, tori } = Astro.props;
// 「※」（概要版の印。lib/data.ts の revised）の意味は、ページに注意書きを置かず、印にマウスを乗せる・タップすると出す（読み上げでは読む）
const REVISED = '統計の基準改定にあわせて県が試算し直した基準値・目標値';
// 達成率の札の字。数は大きく、数でない印字（達成・後退）と — は小さく
const rateOf = (r: ShuyouStatus) => {
  const t = shuyouRateText(r);
  return { t, word: !/\d/.test(t) };
};
---
<li class="k-item">
  <div class="k-name"><a class="name-link" href={`/kihon/${k.id}/`}>{k.name}</a> <span class="code-no">{k.code}</span></div>
  {shuyou.map((r, i) => (
    <div class="k-row k-shuyou">
      <span class="k-l">{i === 0 && '主要指標'}</span>
      <div class="k-main">
        <a class="s-name name-link" href={r.href}>{r.name}</a>{r.revised && <span class="mark" data-tip-value={REVISED} data-tip-label="※"><span aria-hidden="true">※</span><span class="sr-only">（{REVISED}）</span></span>}
        <ShuyouRoad r={r} />
      </div>
      <div class="k-rate">
        <span class="k-rl"><Term word="主要指標の達成率" label="達成率" brief="key-shuyou" /></span>
        <span class:list={['k-rv', rateOf(r).word && 'word']} data-tip-value={shuyouBinOf(r.bin).label} data-tip-label={`達成率 ${rateOf(r).t}`}><Icon tone={shuyouBinOf(r.bin).tone} size={14} />{rateOf(r).t === '—' ? <b aria-hidden="true">—</b> : <b>{rateOf(r).t}</b>}</span>
        <span class="sr-only">（{shuyouBinOf(r.bin).label}）</span>
      </div>
    </div>
  ))}
  {tori.n > 0 && (
    <div class="k-row k-bar">
      <span class="k-l">主な取組</span>
      <div class="k-viz"><StatusBar categories={STATUSES} counts={tori.counts} context={`${k.name} 主な取組 `} size="mini" /></div>
      <KeyNum class="k-num" word="進捗状況" label="順調" brief="key-status" value={pct(tori.ok, tori.n)} />
    </div>
  )}
</li>

<style>
  .k-item { display: grid; gap: 12px; padding: 14px 18px; }
  .k-name { font-size: 1.0625rem; line-height: 1.5; }
  /* PC は「何の行か | 中身 | 右の数」。主要指標は名前と道のりの右に達成率を置き、主な取組の棒は道のりと同じ幅までにする。
     右の数の列は幅を決めておき、どの行でも道のりの長さをそろえる */
  .k-row { display: grid; grid-template-columns: 4.6em minmax(0, 1fr) 7.5rem; column-gap: 16px; }
  .k-shuyou { grid-template-areas: "lab main rate"; align-items: start; }
  .k-bar { grid-template-areas: "lab viz num"; align-items: center; }
  .k-l { grid-area: lab; font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); line-height: 1.6; }
  .k-shuyou .k-l { padding-top: 2px; }
  .k-main { grid-area: main; min-width: 0; max-width: 40rem; line-height: 1.6; }
  .s-name { font-size: 0.9375rem; font-weight: 400; }
  .mark { font-size: 0.8125rem; color: var(--ink-2); margin-left: 1px; padding: 0 3px; cursor: help; }
  /* 達成率は名前と道のりの右に、言葉を上・数を下にして大きく置く */
  .k-rate { grid-area: rate; align-self: center; display: grid; justify-items: end; white-space: nowrap; line-height: 1.2; }
  .k-rl { font-size: 0.75rem; font-weight: 700; color: var(--ink-2); }
  .k-rv { display: inline-flex; align-items: center; gap: 6px; }
  .k-rv b { font-family: var(--font-num); font-weight: 600; font-size: 1.6rem; }
  .k-rv.word b { font-family: var(--font); font-weight: 700; font-size: 1.05rem; }
  /* 主な取組は控えめに: 棒を細くし、言葉と割合の字も小さくする */
  .k-bar .k-l { font-size: 0.75rem; }
  .k-bar :global(.k-num) { font-size: 0.8125rem; }
  .k-viz { grid-area: viz; min-width: 0; max-width: 40rem; }
  .k-viz :global(.sbar) { height: 10px; padding: 1px; border-width: 1px; gap: 1px; }
  .k-bar :global(.k-num) { grid-area: num; justify-self: end; color: var(--ink-2); }
  /* 720px 以下は、道のりを全幅にするため「主要指標」を上の行に置き、達成率を道のりの下に「言葉｜値」の2列で置く */
  @media (max-width: 720px) {
    .k-item { padding: 12px 14px; }
    .k-name { font-size: 1rem; }
    .k-row { grid-template-columns: 4.2em minmax(0, 1fr); column-gap: 10px; }
    .k-shuyou { grid-template-columns: minmax(0, 1fr); grid-template-areas: "lab" "main" "rate"; row-gap: 4px; }
    .k-shuyou .k-l:empty { display: none; }
    .k-rate { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); column-gap: 8px; align-items: center; justify-items: start; }
    .k-rv b { font-size: 1.35rem; }
    .k-rv.word b { font-size: 1rem; }
    .k-bar { grid-template-columns: 4.2em minmax(0, 1fr) auto; }
  }
</style>
