---
// 将来像のページの基本施策の1行（親は ul.row-list）。基本施策の名前の下に、主要指標と主な取組の行を、左に何の行かを書いて並べる。
// 主要指標がこの行の主役で、主な取組の棒は細く控えめにする（docs/design.md の1章「3つの段」。基本施策をはかる物差しは主要指標）。
// - 主要指標（基本施策の最終的な成果をはかる指標。県の概要版の表の順）: 名前の後ろに達成状況の札（「前進 37%」。5つの将来像のページと同じ
//   components/ShuyouTags.astro）、その下に「スタート → いま → ゴール」の値を1行で。図は置かない（札が達成率をそのまま示すので、
//   道のりを線にしても同じことを2回見せるだけになるため）。年ごとの動きは基本施策のページの図に任せる（名前がそのカードへのリンク）。
//   いまの値が何年の値かはまちまち（基準値と同じ年のままのものもある）なので、どの値にも年・年度を括弧で添える（lib/data.ts の eraRef。「（R3）」）。
//   値の全角の数字などは半角にし（halfWidth。「％」もこの行では「%」に）、位は1つの指標の中でそろえる（sameScale。「3兆4,517億円」→「34,517億円」）。
//   スマホは「言葉｜値」の2列に積み、数の左端をそろえる
// - 主な取組: 進捗状況の区分の内訳の細い棒と「順調」の割合（ここでは主要指標より細く、字も小さくする）。
//   「順調」を押すと進捗状況の説明と区分の一覧を出す（components/KeyNum.astro。ページの KeyBrief kind="status"）。
//   区分ごとの件数は、棒の区間にマウスを乗せる・タップすると出る（StatusBar）。棒と割合は、主要指標の値の行と同じくらいの幅にまとめる
//   （棒だけが行の右端まで伸びて割合が離れると、主要指標のまとまりと大きさがちぐはぐに見えるため）
// 主要指標の名前は、基本施策の名前（太字）の下の項目なので、太字にせず字の色と下線だけでリンクと分かるようにする
import StatusBar from './StatusBar.astro';
import KeyNum from './KeyNum.astro';
import ShuyouTags from './ShuyouTags.astro';
import { STATUSES, eraRef, halfWidth, sameScale, type ShuyouStatus } from '../lib/data.ts';
import { pct } from '../lib/format.ts';

interface Measure { n: number; ok: number; counts: Record<string, number> }
interface Props { kihon: { id: string; name: string; code: string }; shuyou: ShuyouStatus[]; tori: Measure }
const { kihon: k, shuyou, tori } = Astro.props;
const half = (raw: string) => halfWidth(raw).replace(/％/g, '%');
// 「※」（概要版の印。lib/data.ts の revised）の意味は、ページに注意書きを置かず、印にマウスを乗せる・タップすると出す（読み上げでは読む）
const REVISED = '統計の基準改定にあわせて県が試算し直した基準値・目標値';
const vals = (r: ShuyouStatus) => {
  const [b, a, t] = sameScale([half(r.base_raw), half(r.actual_raw), half(r.target_raw)]);
  return [
    { label: 'スタート', v: b, y: eraRef(r.base_ref) },
    { label: 'いま', v: a, y: eraRef(r.actual_ref), now: true },
    { label: 'ゴール', v: t, y: eraRef(r.target_ref) },
  ];
};
---
<li class="k-item">
  <div class="k-name"><a class="name-link" href={`/kihon/${k.id}/`}>{k.name}</a> <span class="code-no">{k.code}</span></div>
  {shuyou.map((r, i) => (
    <div class="k-row k-shuyou">
      <span class="k-l">{i === 0 && '主要指標'}</span>
      <div class="k-main">
        <a class="s-name name-link" href={r.href}>{r.name}</a>{r.revised && <span class="mark" data-tip-value={REVISED} data-tip-label="※"><span aria-hidden="true">※</span><span class="sr-only">（{REVISED}）</span></span>} <ShuyouTags items={[r]} named={false} />
        <p class="k-vals">
          {vals(r).map((x, j) => (
            <>
              {j > 0 && <span class="arrow" aria-hidden="true">→</span>}
              <span class:list={['v', x.now && 'now']}><span class="v-l">{x.label}</span> <span class="v-n">{x.v}{x.y && <span class="v-y">（{x.y}）</span>}</span></span>
            </>
          ))}
        </p>
      </div>
    </div>
  ))}
  {tori.n > 0 && (
    <div class="k-row k-bar">
      <span class="k-l">主な取組</span>
      <div class="k-viz"><StatusBar categories={STATUSES} counts={tori.counts} context={`${k.name} 主な取組 `} size="mini" /><KeyNum class="k-num" word="進捗状況" label="順調" brief="key-status" value={pct(tori.ok, tori.n)} /></div>
    </div>
  )}
</li>

<style>
  .k-item { display: grid; gap: 12px; padding: 14px 18px; }
  .k-name { font-size: 1.0625rem; line-height: 1.5; }
  /* 「何の行か | 中身」の2列。左の言葉は主要指標・主な取組とも同じ大きさ */
  .k-row { display: grid; grid-template-columns: 4.6em minmax(0, 1fr); column-gap: 16px; }
  .k-shuyou { grid-template-areas: "lab main"; align-items: start; }
  .k-bar { grid-template-areas: "lab viz"; align-items: center; }
  .k-l { grid-area: lab; font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); line-height: 1.6; }
  .k-shuyou .k-l { padding-top: 3px; }
  .k-main { grid-area: main; min-width: 0; line-height: 1.7; }
  .s-name { font-size: 0.9375rem; font-weight: 400; }
  .mark { font-size: 0.8125rem; color: var(--ink-2); margin-left: 1px; padding: 0 3px; cursor: help; }
  /* スタート → いま → ゴールの値を1行で（入らなければ値の切れ目で折り返す）。いまだけ濃い太字 */
  .k-vals { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 10px; margin: 2px 0 0; font-size: 0.875rem; color: var(--ink-2); line-height: 1.6; }
  .v-l { font-size: 0.75rem; font-weight: 700; }
  .v-y { display: inline-block; font-size: 0.75rem; white-space: nowrap; font-variant-numeric: tabular-nums; } /* 年度は値の後ろにひとまとまりで */
  .now .v-n { color: var(--ink); font-weight: 700; font-size: 0.9375rem; }
  .now .v-y { font-weight: 400; color: var(--ink-2); }
  .arrow { color: var(--muted); }
  /* 主な取組は控えめに: 細い棒のすぐ後ろに「順調」の割合を置き、主要指標の値の行と同じくらいの幅にまとめる */
  .k-viz { grid-area: viz; min-width: 0; max-width: 28rem; display: flex; align-items: center; gap: 12px; }
  .k-viz :global(.sbar) { flex: 1; height: 10px; padding: 1px; border-width: 1px; gap: 1px; }
  .k-viz :global(.k-num) { flex: none; font-size: 0.8125rem; color: var(--ink-2); }
  /* 720px 以下は、スタート・いま・ゴールを「言葉｜値」の2列で1行ずつ積む（言葉の列の幅を決めて、数の左端をそろえる） */
  @media (max-width: 720px) {
    .k-item { padding: 12px 14px; }
    .k-name { font-size: 1rem; }
    .k-row { grid-template-columns: 4.2em minmax(0, 1fr); column-gap: 10px; }
    .k-vals { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); column-gap: 8px; row-gap: 2px; margin-top: 4px; }
    .v { display: contents; }
    .arrow { display: none; }
  }
</style>
