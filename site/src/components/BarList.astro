---
// 1系列の横棒（件数・金額の比較）。色は1色で、行のラベルに状態の印を付けられる。棒ではタブで止めない（値は棒の右に出す）
import Chip from './Chip.astro';
import { fmt } from '../lib/format.js';

interface Item { label: string; tone?: string; shape?: string; n: number; href?: string; note?: string }
interface Props { title: string; caption?: string; items: Item[]; unit?: string }
const { title, caption, items, unit = '件' } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.n));
---
<figure class="chart-card sticker">
  <figcaption>
    <div class="chart-title">{title}</div>
    {caption && <div class="chart-caption">{caption}</div>}
  </figcaption>
  <ul class="bars">
    {items.map((i) => (
      <li>
        <div class="bar-label">
          {i.tone ? <Chip tone={i.tone} text={i.label} shape={i.shape} /> : i.label}
          {i.note && <span class="bar-note">{i.note}</span>}
        </div>
        <div class="bar-track">
          <span class="bar" style={`width:${(i.n / max) * 100}%`} data-tip-value={`${fmt(i.n)}${unit}`} data-tip-label={i.label} aria-hidden="true"></span>
          <span class="bar-value num">{i.href && i.n > 0 ? <a href={i.href}>{fmt(i.n)}{unit}</a> : `${fmt(i.n)}${unit}`}</span>
        </div>
      </li>
    ))}
  </ul>
</figure>

<style>
  .chart-card { margin-top: 16px; }
  .chart-title { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; }
  .chart-caption { font-size: 0.875rem; color: var(--ink-2); }
  .bars { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 12px; }
  .bars li { display: grid; grid-template-columns: minmax(0, 20em) 1fr; gap: 4px 12px; align-items: center; }
  .bar-label { font-size: 0.9375rem; line-height: 1.4; }
  .bar-label :global(.chip) { white-space: normal; }
  .bar-note { display: block; font-size: 0.8125rem; color: var(--ink-2); padding-left: 18px; }
  .bar-track { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .bar { display: block; height: 18px; min-width: 3px; background: var(--pop); border: 2px solid var(--line); border-radius: 0 999px 999px 0; }
  .bar:hover { filter: brightness(1.1); }
  .bar-value { font-family: var(--font-num); font-size: 0.9375rem; white-space: nowrap; }
  @media (max-width: 560px) {
    .bars li { grid-template-columns: 1fr; }
  }
</style>
