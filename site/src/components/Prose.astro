---
// 県の分析などの長い文章。「[主な取組]」などの行を小見出しにする
import { sections } from '../lib/text.js';

interface Props { text: string; level?: 'h4' | 'h5' }
const { text, level = 'h4' } = Astro.props;
const H = level;
---
{sections(text).map((p) => (
  <>
    {p.head && <H class="prose-head">{p.head}</H>}
    <p class="prose">{p.body}</p>
  </>
))}

<style>
  .prose-head { font-size: 0.98rem; margin: 1em 0 0.2em; }
  p.prose { margin: 0 0 6px; }
</style>
