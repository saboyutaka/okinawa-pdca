---
// 100%積み上げの横棒1本。区切りは2pxのすき間。棒全体を1つの画像として読み上げ、区間ごとにタブでは止めない（値は表やラベルにもある）
// cells を付けると、1件を1マスにして区分ごとにまとめて並べる「マス目の棒」にする（主要指標。数が少ないので、割合ではなく何個のうち何個かを見せ、
// 主な取組のつながった棒と見た目を分ける。docs/design.md の1章「3つの段」）。マスのあいだのすき間は、区分の変わり目も同じ幅
import { fmt, pct } from '../lib/format.ts';
import type { Tone } from '../lib/icons.ts';

interface Props {
  categories: { key: string; tone: Tone; hatch?: boolean }[];
  counts: Record<string, number>;
  unit?: string;
  context?: string;
  /** 棒の中に割合を書く区分（入りきるときだけ） */
  labelKey?: string;
  size?: 'normal' | 'mini';
  cells?: boolean;
}
const { categories, counts, unit = '件', context = '', labelKey = categories[0]?.key, size = 'normal', cells = false } = Astro.props;
const total = categories.reduce((s, c) => s + (counts[c.key] || 0), 0);
const segs = categories.filter((c) => counts[c.key] > 0).map((c) => ({ ...c, n: counts[c.key] }));
const aria = `${context}${segs.map((s) => `${s.key} ${fmt(s.n)}${unit}（${pct(s.n, total)}）`).join('、')}`;
const tip = (s: (typeof segs)[number]) => ({ 'data-tip-value': `${fmt(s.n)}${unit}（${pct(s.n, total)}）`, 'data-tip-label': `${context}${s.key}` });
---
<div class:list={['sbar', size, cells && 'cells']} role="img" aria-label={aria}>
  {cells
    ? segs.flatMap((s) => Array.from({ length: s.n }, () => (
      <span class:list={['seg', `tone-${s.tone}`, s.hatch && 'hatch']} {...tip(s)}></span>
    )))
    : segs.map((s) => (
      <span class:list={['seg', `tone-${s.tone}`, s.hatch && 'hatch']} style={`flex-grow:${s.n}`} {...tip(s)}>
        {size === 'normal' && s.key === labelKey && s.n / total >= 0.18 && <span class="seg-label">{pct(s.n, total)}</span>}
      </span>
    ))}
</div>

<style>
  .sbar { display: flex; gap: 2px; height: 24px; width: 100%; padding: 2px; border: 2px solid var(--line); border-radius: 999px; background: var(--paper); }
  .sbar.mini { height: 14px; padding: 1.5px; border-width: 1.5px; gap: 1.5px; }
  /* 地との差が 3:1 未満の色の区間には、内側に縁を付けて、すき間（地の色）と見分けられるようにする（styles/global.css の --*-edge） */
  .seg {
    flex-basis: 0; min-width: 3px; background-color: var(--tone); box-shadow: inset 0 0 0 1.5px var(--tone-edge, var(--tone));
    display: flex; align-items: center; padding-left: 8px; container-type: inline-size;
  }
  .mini .seg { min-width: 2px; padding: 0; box-shadow: inset 0 0 0 1px var(--tone-edge, var(--tone)); }
  .seg:first-child { border-radius: 999px 0 0 999px; }
  .seg:last-child { border-radius: 0 999px 999px 0; }
  .seg:only-child { border-radius: 999px; }
  .seg:hover { filter: brightness(1.1); }
  /* マス目の棒: どのマスも同じ幅・同じすき間。マスの角を少し丸める */
  .cells .seg { flex-grow: 1; min-width: 2px; padding: 0; border-radius: 2px; }
  .cells .seg:first-child { border-radius: 999px 2px 2px 999px; }
  .cells .seg:last-child { border-radius: 2px 999px 999px 2px; }
  /* 塗りの上の文字は塗りの明るさで決める（青緑・黄・橙は濃い文字が読める） */
  .seg-label { color: var(--on-fill); font-family: var(--font-num); font-size: 0.8125rem; font-weight: 600; white-space: nowrap; }
  /* 棒が短い（スマホで名前と同じ行に置いたときなど）と割合の文字が隣の区間にはみ出すので、区間の幅が足りなければ書かない */
  @container (max-width: 40px) { .seg-label { display: none; } }
</style>
