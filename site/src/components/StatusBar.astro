---
// 100%積み上げの横棒1本。区切りは2pxのすき間。棒全体を1つの画像として読み上げ、区間ごとにタブでは止めない（値は表やラベルにもある）
import { fmt, pct } from '../lib/format.ts';
import type { Tone } from '../lib/icons.ts';

interface Props {
  categories: { key: string; tone: Tone; hatch?: boolean }[];
  counts: Record<string, number>;
  unit?: string;
  context?: string;
  /** 棒の中に割合を書く区分（入りきるときだけ） */
  labelKey?: string;
  size?: 'normal' | 'mini';
}
const { categories, counts, unit = '件', context = '', labelKey = categories[0]?.key, size = 'normal' } = Astro.props;
const total = categories.reduce((s, c) => s + (counts[c.key] || 0), 0);
const segs = categories.filter((c) => counts[c.key] > 0).map((c) => ({ ...c, n: counts[c.key] }));
const aria = `${context}${segs.map((s) => `${s.key} ${fmt(s.n)}${unit}（${pct(s.n, total)}）`).join('、')}`;
---
<div class:list={['sbar', size]} role="img" aria-label={aria}>
  {segs.map((s) => (
    <span
      class:list={['seg', `tone-${s.tone}`, s.hatch && 'hatch']}
      style={`flex-grow:${s.n}`}
      data-tip-value={`${fmt(s.n)}${unit}（${pct(s.n, total)}）`}
      data-tip-label={`${context}${s.key}`}
    >
      {size === 'normal' && s.key === labelKey && s.n / total >= 0.18 && <span class="seg-label">{pct(s.n, total)}</span>}
    </span>
  ))}
</div>

<style>
  .sbar { display: flex; gap: 2px; height: 24px; width: 100%; padding: 2px; border: 2px solid var(--line); border-radius: 999px; background: var(--paper); }
  .sbar.mini { height: 14px; padding: 1.5px; border-width: 1.5px; gap: 1.5px; }
  .seg { flex-basis: 0; min-width: 3px; background-color: var(--tone); display: flex; align-items: center; padding-left: 8px; }
  .mini .seg { min-width: 2px; padding: 0; }
  .seg:first-child { border-radius: 999px 0 0 999px; }
  .seg:last-child { border-radius: 0 999px 999px 0; }
  .seg:only-child { border-radius: 999px; }
  .seg:hover { filter: brightness(1.1); }
  /* 塗りの上の文字は塗りの明るさで決める（青緑・黄・橙は濃い文字が読める） */
  .seg-label { color: var(--on-fill); font-family: var(--font-num); font-size: 0.8125rem; font-weight: 600; white-space: nowrap; }
</style>
