---
// くらしのテーマのページに出す、県の分野別の計画（個別計画）の要約の枠。いまは観光ロードマップ（テーマ「観光」）だけ。
// テーマ（このサイト独自の分類）とは別の県の計画なので、淡い紫の札で分け、テーマの数字には混ぜない。
// 主な取組の進捗状況と、成果指標の基準値との比較（前進・横ばい・後退）の内訳だけを出す（良い・悪いのどちらかの指標を選んで並べない）
import StatusBar from './StatusBar.astro';
import Term from './Term.astro';
import SecHead from './SecHead.astro';
import { STATUSES, statusOf, countBy, yearLabel } from '../lib/data.ts';
import { KANKO, KANKO_TORIKUMI_HREF, RM_LATEST, RM_JUDGEMENTS, kankoTorikumi, kankoSeika } from '../lib/plans.ts';
import { fmt } from '../lib/format.ts';

const tori = kankoTorikumi(RM_LATEST);
const toriCounts = countBy(tori, statusOf, STATUSES.map((s) => s.key));
const seika = kankoSeika(RM_LATEST);
const judgeCounts = countBy(seika, (s) => s.judgement || 'その他', RM_JUDGEMENTS.map((j) => j.key));
---
<section class="sticker plan-sum" aria-labelledby="keikaku">
  <div><span class="plan-tag">個別計画</span></div>
  <SecHead id="keikaku" class="ps-h">県の観光の計画でも評価しています</SecHead>
  <p class="small">「<a href={KANKO.href}>{KANKO.name}</a>」（{KANKO.basis}の実施計画）は、このテーマとは別の、県の<Term word="観光ロードマップ" label="計画" />です。</p>
  <div class="ps-nums">
    <div class="inset">
      <div class="tile-label">主な取組（{yearLabel(RM_LATEST)}）</div>
      <div><b class="big">{fmt(toriCounts['順調'] || 0)}/{fmt(tori.length)}</b> 件が順調</div>
      <StatusBar categories={STATUSES} counts={toriCounts} context={`観光ロードマップの${yearLabel(RM_LATEST)}の主な取組 `} size="mini" />
    </div>
    <div class="inset">
      <div class="tile-label">成果指標（{yearLabel(RM_LATEST)}）</div>
      <div><b class="big">{fmt(judgeCounts['前進'] || 0)}/{fmt(seika.length)}</b> が基準値より前進</div>
      <StatusBar categories={RM_JUDGEMENTS} counts={judgeCounts} unit="指標" context={`観光ロードマップの${yearLabel(RM_LATEST)}の成果指標 `} size="mini" />
    </div>
  </div>
  <p class="small ps-links">
    <a href={KANKO.href}>観光ロードマップを見る</a>・<a href={`${KANKO.href}#seika-list`}>成果指標の一覧</a>・<a href={KANKO_TORIKUMI_HREF}>観光ロードマップの取組をさがす</a>
  </p>
</section>

<style>
  .plan-sum { margin-top: 18px; display: grid; gap: 8px; }
  .ps-h { margin: 0; font-size: 1.15rem; }
  .plan-sum p { margin: 0; }
  .ps-nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
  .ps-nums > div { display: grid; gap: 4px; padding: 10px 12px; }
  .ps-nums .big { font-size: 1.3rem; }
</style>
