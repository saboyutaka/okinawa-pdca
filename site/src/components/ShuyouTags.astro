---
// 主要指標の達成状況の札（「後退 -6%」「到達 131%」）を、報告書の順（概要版の表の順。良い・悪いで並べ替えない）に並べる
// （5つの将来像のページと将来像のページの基本施策の行の、指標の名前の後ろ）。
// 札には県の概要版の区分の言葉（SHUYOU_BINS の word）と達成率の数を書き、地と縁を区分の色にする。状態は言葉で読めるので、形の印は付けない
// （形は取組の進捗状況の並びから来ていて、「前進（60%未満）」が「やや遅れ」と同じ▲になり、前に進んでいるのに遅れに見えるため。docs/design.md の2章）。
// 数でない印字（「達成」「後退」）と比べられないものは、言葉だけにする。札にマウスを乗せる・タップすると、指標の名前と達成率と区分が出る（scripts/tooltip.ts）。
// どの区分の札も同じ大きさ・同じ強さにする（1章）
import { shuyouRateText, shuyouBinOf, type ShuyouStatus } from '../lib/data.ts';

// named={false} は、指標の名前が札のすぐ前に見えているとき（読み上げで名前をくり返さない）
interface Props { items: ShuyouStatus[]; named?: boolean }
const { items, named = true } = Astro.props;
const rows = items.map((r) => {
  const bin = shuyouBinOf(r.bin);
  const rate = shuyouRateText(r);
  return { r, bin, rate, num: /\d/.test(rate) ? rate : null };
});
---
<ul class="s-tags">
  {rows.map((x) => (
    <li class:list={['s-tag', `tone-${x.bin.tone}`]} data-tip-label={x.r.name} data-tip-value={`達成率 ${x.rate}（${x.bin.label}）`}>
      <span class="w">{x.bin.word}</span>{x.num && <span class="n">{x.num}</span>}{named && <span class="sr-only">（{x.r.name}）</span>}
    </li>
  ))}
</ul>

<style>
  /* 札は名前と同じ流れに置き、名前に続けて折り返す */
  .s-tags { display: inline; list-style: none; margin: 0; padding: 0; }
  .s-tag {
    display: inline-flex; align-items: center; gap: 5px; vertical-align: 2px; margin: 2px 6px 2px 0; padding: 0 9px 0 8px; white-space: nowrap; cursor: default;
    border: 1.5px solid var(--tone-edge, var(--tone)); border-radius: 999px; background: color-mix(in oklab, var(--tone) 20%, var(--paper));
    font-size: 0.8125rem; font-weight: 400; line-height: 1.6; color: var(--ink);
  }
  .s-tag:last-child { margin-right: 0; }
  /* 比べられないものは、空の印と同じく点線の縁にして地を塗らない */
  .s-tag.tone-blank { border-style: dashed; border-color: var(--ink-2); background: transparent; }
  .w { font-weight: 700; }
  .n { font-family: var(--font-num); font-weight: 600; font-size: 0.875rem; }
</style>
