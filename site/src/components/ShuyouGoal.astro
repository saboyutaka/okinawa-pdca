---
// 主要指標の部分1つの「県の見通し」（1行）と「スタート → いま → ゴール」の数字。成果指標の SeikaGoal と同じ形（数字は components/GoalSteps.astro）。
// 主要指標には達成率と年度ごとの計画値がないので、1行目は県の見通しにする。男性・女性のように1つの欄に並ぶ指標は部分ごと（ShuyouCard）
import Chip from './Chip.astro';
import Term from './Term.astro';
import GoalSteps from './GoalSteps.astro';
import { LATEST, yearLabel, refText, toneOfJudgement, judgesOf, type ShuyouPart } from '../lib/data.ts';

interface Props { part: ShuyouPart }
const { part: p } = Astro.props;
const now = p.latest;
const yl = yearLabel(now.year);
const judges = judgesOf(now.judgement);
const ref = refText(now.a.note);
// 図の位が1でない指標（万t-CO₂ など）は、位の書かれていない数に単位を添えない（どの位の数か分からないため）
const unit = p.scale === 1 ? p.unit : '';
---
{now.judgement && (
  <p class="verdict">
    <span class="small secondary">県の<Term word="見通し" /></span>
    {judges
      ? judges.map((j) => <span class="vj">{j.label && <span class="small">{j.label}</span>}<Chip tone={toneOfJudgement(j.key)} text={j.key} /></span>)
      : <span class="prose small">{now.judgement}</span>}
  </p>
)}
<GoalSteps values={[now.b.text, now.a.text, now.t.text]} unit={unit} nowLabel={now.year === LATEST ? 'いま' : `${yl}の報告`}>
  <Fragment slot="start"><Term word="基準値" />{now.b.note}</Fragment>
  <Fragment slot="now"><Term word="実績値" note={ref ? `この指標の${yl}の報告の実績値は、${ref}です。` : undefined} /></Fragment>
  <Fragment slot="goal"><Term word="目標値" />（{now.target_year}）{now.t.note}</Fragment>
</GoalSteps>

<style>
  .vj { display: inline-flex; align-items: center; gap: 6px; }
  .vj :global(.chip) { white-space: normal; }
</style>
