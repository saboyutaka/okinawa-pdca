---
// 成果指標の「ゴールまでの道のり」。左がスタート（基準値）、右がゴール（目標値）。下がるほど良い指標でも同じ向きにする
// 青い丸が実績値、白い丸がその年度の計画値。基準値より悪い・目標値を超えたは、棒の外にはみ出す色と文で伝える
import { yearLabel, withUnit } from '../lib/data.js';

interface Props { x: any; plan?: number | null; planRaw?: string | null; unit?: string }
const { x, plan = null, planRaw = null, unit = '' } = Astro.props;
const { base, actual, target } = x;
const ok = [base, actual, target].every((v) => v != null && Number.isFinite(v)) && base !== target;
const f = (v) => (v - base) / (target - base);
const fa = ok ? f(actual) : 0;
const fp = ok && plan != null && Number.isFinite(plan) ? f(plan) : null;
const lo = Math.min(0, fa, fp ?? 0) - 0.05;
const hi = Math.max(1, fa, fp ?? 1) + 0.05;
const pct = (v) => ((v - lo) / (hi - lo)) * 100;
const pos = (v) => `${pct(v)}%`;
// 「いまここ」の札は、丸の位置に合わせて左寄せ・中央・右寄せを選び、カードからはみ出さないようにする
const hereSide = ok ? (pct(fa) < 30 ? 'start' : pct(fa) > 70 ? 'end' : 'mid') : 'mid';
const w = (a, b) => `${((b - a) / (hi - lo)) * 100}%`;
const actualText = withUnit(x.actual_raw, unit);
const where = fa < 0 ? '基準値より悪い位置' : fa >= 1 ? '目標値に届いた位置' : `基準値から目標値までの${Math.round(fa * 100)}%の位置`;
const label = `基準値 ${withUnit(x.base_raw, unit)} から目標値 ${withUnit(x.target_raw, unit)}（${x.target_year}）までの道のりで、実績値 ${actualText} は${where}。${fp != null ? `${yearLabel(x.year)}の計画値は ${withUnit(planRaw, unit)}。` : ''}`;
---
{ok && (
  <div class="road" role="img" aria-label={label}>
    <div class="road-track" aria-hidden="true">
      <span class="road-line" style={`left:${pos(0)};width:${w(0, 1)}`}></span>
      {fa > 0 && <span class="road-fill" style={`left:${pos(0)};width:${w(0, Math.min(1, fa))}`}></span>}
      {fa < 0 && <span class="road-worse" style={`left:${pos(fa)};width:${w(fa, 0)}`}></span>}
      {fa > 1 && <span class="road-over" style={`left:${pos(1)};width:${w(1, fa)}`}></span>}
      <span class="flag" style={`left:${pos(0)}`}></span>
      <span class="flag goal" style={`left:${pos(1)}`}></span>
      {fp != null && <span class="planmk" style={`left:${pos(fp)}`} data-tip-value={withUnit(planRaw, unit)} data-tip-label={`${yearLabel(x.year)}の計画値`}></span>}
      <span class="runner" style={`left:${pos(fa)}`}></span>
      <span class:list={['here', hereSide]} style={`left:${pos(fa)}`}>いまここ {actualText}</span>
    </div>
    <div class="road-ends" aria-hidden="true">
      <span>スタート（基準値）<b>{withUnit(x.base_raw, unit)}</b></span>
      <span>ゴール（目標値・{x.target_year}）<b>{withUnit(x.target_raw, unit)}</b>{target < base && <small>　※下がるほど良い指標</small>}</span>
    </div>
    <ul class="chart-key" aria-hidden="true">
      <li><span class="k-dot" style="--k:var(--pop)"></span>実績値 {actualText}{x.actual_ref_year && `（${x.actual_ref_year}の値）`}</li>
      {fp != null && <li><span class="k-ring"></span>{yearLabel(x.year)}の計画値 {withUnit(planRaw, unit)}</li>}
      {fa < 0 && <li><span class="k-sq" style="--k:var(--critical)"></span>基準値より悪化</li>}
      {fa > 1 && <li><span class="k-sq" style="--k:var(--good)"></span>目標値を超えた</li>}
    </ul>
  </div>
)}

<style>
  .road { margin: 14px 4px 6px; }
  .road-track { position: relative; height: 66px; }
  .road-line, .road-fill, .road-worse, .road-over { position: absolute; top: 36px; height: 14px; border-radius: 999px; border: 2.5px solid var(--line); }
  .road-line { background: var(--grid); }
  .road-fill { background: var(--pop); }
  .road-worse { background: var(--critical); }
  .road-over { background: var(--good); }
  .flag { position: absolute; top: 8px; width: 2.5px; height: 46px; background: var(--line); transform: translateX(-1px); }
  .flag::after { content: ""; position: absolute; left: 2px; top: 0; width: 18px; height: 12px; background: var(--paper); border: 2px solid var(--line); border-left: 0; border-radius: 0 3px 3px 0; }
  .flag.goal::after { background: var(--pink); }
  .runner { position: absolute; top: 30px; width: 26px; height: 26px; border-radius: 50%; background: var(--pop); border: 3px solid var(--line); transform: translateX(-13px); box-shadow: 2px 2px 0 var(--shadow); }
  .here { position: absolute; top: 0; transform: translateX(-50%); font-family: var(--font-display); font-size: 0.8125rem; font-weight: 700; background: var(--paper); border: 2px solid var(--line); border-radius: 999px; padding: 0 9px; white-space: nowrap; }
  .here.start { transform: translateX(-16px); }
  .here.end { transform: translateX(calc(-100% + 16px)); }
  .planmk { position: absolute; top: 35px; width: 16px; height: 16px; border-radius: 50%; background: var(--paper); border: 3px solid var(--ink-2); transform: translateX(-8px); }
  .road-ends { display: flex; justify-content: space-between; gap: 12px; font-size: 0.875rem; color: var(--ink-2); }
  .road-ends b { color: var(--ink); font-family: var(--font-num); font-weight: 600; margin-left: 4px; }
  .road-ends span:last-child { text-align: right; }
</style>
