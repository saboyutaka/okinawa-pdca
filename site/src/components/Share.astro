---
// SNS のシェアパネル。「シェア」の文字と、Facebook・LINE・X・Threads・Bluesky のアイコンだけのボタンを1つの枠にまとめる。
// X・Threads・Bluesky は #okinawa_miraima（lib/iken.ts の HASHTAG）を付けた投稿画面を開く（lib/share.ts）。
// アイコンだけなので、名前は読み上げ用の文字と、マウスを乗せたときのツールチップ（scripts/tooltip.ts）で出す。
// 外のサイトを別のタブで開くが、パネルとしてまとめるため ExtLink の外部リンクの印は付けない。ツールチップは「〇〇 でシェア」だけにし、
// 「別のタブで開きます」は読み上げの文字にだけ付ける。
// link="page" は見ているページ、link="top" はサイトのトップの URL を、ビルド時に本番のドメイン（lib/links.ts の SITE.url）で入れる。
// path を渡すと、そのページ（指標のシェア用のページなど。components/ShareMenu.astro）の URL を入れる。
// compact はシェアの枠（ShareBox.astro）用。スマホ（520px 以下）では、いいねと1行に並ぶように「シェア」の文字を隠してアイコンだけにする。
import { SNS, shareHref } from '../lib/share.ts';
import { SHARE_ICONS } from '../lib/share-icons.ts';
import { absUrl } from '../lib/seo.ts';

interface Props { text?: string; link?: 'page' | 'top'; path?: string; label?: string; compact?: boolean }
const { text = '', link = 'page', path, label = 'SNS でシェア', compact = false } = Astro.props;
const url = absUrl(path ?? (link === 'top' ? '/' : Astro.url.pathname));
---
<div class:list={['share-panel', { compact }]} role="group" aria-label={label}>
  <span class="share-label" aria-hidden="true">シェア</span>
  <ul class="share-list">
    {SNS.map((s) => (
      <li>
        <a class="share-ic" href={shareHref(s.id, { text, url })} target="_blank" rel="noopener" data-tip-value={`${s.label} でシェア`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d={SHARE_ICONS[s.id]} /></svg>
          <span class="sr-only">{s.label} でシェア（別のタブで開きます）</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* 白い枠に「シェア」と丸いアイコンを並べる。狭い画面では「シェア」の下にアイコンの列を折り返す */
  .share-panel {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; max-width: 100%;
    background: var(--paper); border: 2px solid var(--line); border-radius: 26px; padding: 4px 5px 4px 16px;
  }
  .share-label { font-family: var(--font-display); font-weight: 700; font-size: 0.875rem; color: var(--ink-2); }
  .share-list { list-style: none; padding: 0; margin: 0; display: flex; gap: 4px; }
  .share-ic { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: var(--ink); background: var(--bg); }
  .share-ic:hover { background: var(--sky); }
  .share-ic:active { transform: translate(1px, 1px); }
  .share-ic svg { fill: currentColor; }
  /* 320px 前後の狭い画面では、折り返したアイコンの列が枠に収まるように丸を小さくする */
  @media (max-width: 360px) { .share-ic { width: 38px; height: 38px; } }
  /* 「シェア」の文字は aria-hidden（読み上げは枠の aria-label）なので、隠しても読み上げは変わらない */
  @media (max-width: 520px) {
    .compact { padding: 3px; }
    .compact .share-label { display: none; }
  }
</style>
