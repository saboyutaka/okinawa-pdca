---
// 用語。押すと短い説明を出す（説明は lib/terms.ts、動きは scripts/terms.ts）。
// note はその場所だけの一言（例: この指標の実績値が何年度の値か）で、説明の下に足す。
// class は見た目を変えるとき（「このサイト独自の分類」の印 .own を、押すと「くらしのテーマ」の説明が出るボタンにするなど）。
// extra はページに置いた <template> の id で、その中身（区分の一覧など）を説明の下に出す（将来像のページの、凡例の代わりの「達成率」「順調」）
interface Props { word: string; label?: string; note?: string; class?: string; extra?: string }
const { word, label, note, class: className, extra } = Astro.props;
---
<button type="button" class:list={['term', className]} data-term={word} data-term-note={note || undefined} data-term-extra={extra} aria-expanded="false" aria-controls="termpop">{label ?? word}</button>
