---
// 用語。押すと短い説明を出す（説明は lib/terms.ts、動きは scripts/terms.ts）。
// note はその場所だけの一言（例: この指標の実績値が何年度の値か）で、説明の下に足す。
// class は見た目を変えるとき（「このサイト独自の分類」の印 .own を、押すと「くらしのテーマ」の説明が出るボタンにするなど）。
// brief はページに置いた <template> の id で、用語の説明（lib/terms.ts）の代わりにその中身（短い説明と区分の一覧など）を出す。
// 将来像のページの、凡例の代わりの「達成率」「順調」（説明の全文は吹き出しの「用語の一覧」から）
// Tab では止まらない（説明の全文は「用語の一覧」で読める）
interface Props { word: string; label?: string; note?: string; class?: string; brief?: string }
const { word, label, note, class: className, brief } = Astro.props;
---
<button type="button" class:list={['term', className]} data-term={word} data-term-note={note || undefined} data-term-brief={brief} aria-expanded="false" aria-controls="termpop" tabindex="-1">{label ?? word}</button>
