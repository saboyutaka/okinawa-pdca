---
// 施策・基本施策・主な取組・成果指標・部局・将来像・くらしのテーマのページの終わり（出典の前）に置く、シェアの枠。
// 「シェアしよう」の言葉とシェアパネルだけを置く（説明は書かない。県に意見を届ける方法は /iken/ とフッターで案内する）。
// SNS には、そのページの名前と URL（と #okinawa_miraima。lib/iken.ts の HASHTAG）を入れて投稿できる
import Share from './Share.astro';
import { shareText } from '../lib/iken.ts';

interface Props { kind: string; name: string }
const { kind, name } = Astro.props;
---
<section class="sticker share-box" aria-labelledby="share-h">
  <h2 id="share-h" class="anchor">この{kind}のページをシェアしよう</h2>
  <Share text={shareText(kind, name)} label={`この${kind}を SNS でシェア`} />
</section>

<style>
  .share-box { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; margin-top: 2.2em; background: var(--lilac); }
  h2 { margin: 0; font-size: 1.08rem; }
</style>
