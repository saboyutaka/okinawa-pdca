---
// 指標（成果指標・主要指標・活動指標）のカードの右上に置く、その指標のシェアのボタン。押すと、SNS のシェアパネル（Share.astro）とリンクのコピーを入れた小さな枠を開く。
// シェアするのは指標のシェア用のページの URL（lib/routes.ts の SHARE_ROUTES）で、SNS には指標のカードの画像が出て、開いた人はこの指標の場所に着く。
// 開け閉めは details（キーボードと読み上げでもそのまま使える）。ほかの場所を押す・Esc で閉じ、1つ開くとほかは閉じる。コピーのボタンはスクリプトで動く
// （scripts/indicator-share.ts。スクリプトが動かないときはボタンを出さず、リンクの欄から写せる）。印刷では出さない
import Share from './Share.astro';
import { absUrl } from '../lib/seo.ts';
import { shareText } from '../lib/iken.ts';

// path はシェア用のページの URL、kind は「成果指標」など、name は指標の名前
interface Props { path: string; kind: string; name: string }
const { path, kind, name } = Astro.props;
const url = absUrl(path);
---
<details class="ishare" data-ishare>
  <summary class="ishare-btn">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
    シェア<span class="sr-only">: {kind}「{name}」</span>
  </summary>
  <div class="ishare-pop">
    <p class="ishare-h">この{kind}をシェア</p>
    <Share text={shareText(kind, name)} path={path} label={`${kind}「${name}」を SNS でシェア`} />
    <div class="ishare-copy">
      <input type="text" readonly value={url} aria-label={`${kind}「${name}」のリンク`} />
      <button type="button" class="ishare-copy-btn" data-copy={url}>リンクをコピー</button>
    </div>
    <span class="sr-only" role="status"></span>
  </div>
</details>

<style>
  .ishare { position: relative; flex: none; }
  /* 小さな白い札（カードの中なので影は付けない）。開いているあいだは地の色を付ける */
  .ishare-btn {
    list-style: none; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px 0 11px; margin: 0;
    font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem; color: var(--ink); background: var(--paper);
    border: 2px solid var(--line); border-radius: 999px; white-space: nowrap;
  }
  .ishare-btn::-webkit-details-marker { display: none; }
  .ishare-btn:hover, .ishare[open] > .ishare-btn { background: var(--sky); }
  .ishare-btn svg { fill: none; stroke: currentColor; stroke-width: 2; }
  .ishare[open] > .ishare-btn { margin-bottom: 0; }
  /* 枠はボタンの下に、右の端をそろえて出す（左に入らないときは、スクリプトが left を付けて左の端をそろえる） */
  .ishare-pop {
    position: absolute; z-index: 40; right: 0; top: calc(100% + 8px); display: grid; gap: 10px; width: max-content; max-width: min(380px, calc(100vw - 32px));
    padding: 12px 14px; background: var(--paper); border: 2.5px solid var(--line); border-radius: 16px; box-shadow: 4px 4px 0 var(--shadow);
  }
  .ishare-pop.left { right: auto; left: 0; }
  .ishare-h { margin: 0; font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; }
  /* 枠の中のシェアパネルは、枠と見出しがあるので、パネルの線と「シェア」の文字を外してアイコンだけにする */
  .ishare-pop :global(.share-panel) { border: 0; padding: 0; background: none; }
  .ishare-pop :global(.share-label) { display: none; }
  .ishare-copy { display: flex; gap: 6px; }
  .ishare-copy input {
    flex: 1; min-width: 0; font: inherit; font-size: 0.8125rem; color: var(--ink-2); background: var(--bg);
    border: 1.5px solid var(--hair); border-radius: 8px; padding: 6px 8px;
  }
  .ishare-copy-btn {
    flex: none; min-height: 36px; padding: 0 12px; font: inherit; font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem;
    color: var(--ink); background: var(--paper); border: 2px solid var(--line); border-radius: 999px; cursor: pointer;
  }
  .ishare-copy-btn:hover { background: var(--sky); }
  :global(html:not(.js)) .ishare-copy-btn { display: none; }
</style>
