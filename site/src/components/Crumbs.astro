---
// パンくず。計画の体系（将来像 › 施策 › 取組）でたどる。トップはヘッダーのタイトルから戻れるので入れない（上の階層の無いページにはパンくずを置かない）。
// いまのページ（href なし）は最後に置き、長い名前は1行で省略する。将来像（sz）は、いまのページでも番号の印の付いた札にする（リンクではないので押せる見た目の変化は付けない）。スマホでは折り返さず、長い名前を縮めて1行に収める。
// 検索エンジン向けに、同じ項目を構造化データ（BreadcrumbList。lib/seo.ts）でも出す
import Sz from './Sz.astro';
import { breadcrumbLd, ldJson } from '../lib/seo.ts';

interface Item { href?: string; label: string; sz?: number | string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="パンくず">
  <ol>
    {items.map((it, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">›</span>}
        {it.href
          ? <a href={it.href} class:list={[it.sz && ['crumb-sz', `sz-${it.sz}`]]} title={it.sz ? undefined : it.label}>{it.sz && <Sz id={it.sz} sr={false} />}{it.label}</a>
          : <span class:list={['here', it.sz && ['crumb-sz', `sz-${it.sz}`]]} aria-current="page" title={it.label}>{it.sz && <Sz id={it.sz} sr={false} />}{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={ldJson(breadcrumbLd(items, Astro.url.pathname))} />

<style>
  ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; min-width: 0; }
  li { display: inline-flex; align-items: center; gap: 6px; min-width: 0; max-width: 100%; }
  .crumb-sz { display: inline-flex; align-items: center; gap: 4px; padding-left: 3px !important; background: var(--szw) !important; }
  .crumb-sz :global(.badge-sz) { width: 1.45em; height: 1.45em; font-size: 0.75rem; border-width: 1.5px; }
  span.crumb-sz { padding-right: 10px; border: 2px solid var(--line); border-radius: 999px; color: var(--ink); }
  .here { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: min(28em, 100%); }
  a:not(.crumb-sz) { display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 16em; vertical-align: bottom; }
  /* スマホでは、いまのページの名前はすぐ下の見出しと同じなので見せない（読み上げには残す）。
     折り返さずに1行に並べ、入りきらないときは名前のリンクを縮めて「…」で省略する（将来像の印の付いたリンクは縮めない） */
  @media (max-width: 640px) {
    li:has(.here) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    ol { flex-wrap: nowrap; }
    li { flex: 0 1 auto; }
    li:has(.crumb-sz) { flex: none; }
    .sep { flex: none; }
    a:not(.crumb-sz) { max-width: none; min-width: 0; }
  }
</style>
