---
// パンくず。計画の体系（将来像 › 施策 › 取組）でたどる。いまのページ（href なし）は最後に置き、長い名前は1行で省略する
import Sz from './Sz.astro';

interface Item { href?: string; label: string; sz?: number | string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="パンくず">
  <ol>
    {items.map((it, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">›</span>}
        {it.href
          ? <a href={it.href} class:list={[it.sz && ['crumb-sz', `sz-${it.sz}`]]}>{it.sz && <Sz id={it.sz} sr={false} />}{it.label}</a>
          : <span class="here" aria-current="page" title={it.label}>{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; min-width: 0; }
  li { display: inline-flex; align-items: center; gap: 6px; min-width: 0; max-width: 100%; }
  .crumb-sz { display: inline-flex; align-items: center; gap: 4px; padding-left: 3px !important; background: var(--szw) !important; }
  .crumb-sz :global(.badge-sz) { width: 1.45em; height: 1.45em; font-size: 0.75rem; border-width: 1.5px; }
  .here { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: min(28em, 100%); }
</style>
