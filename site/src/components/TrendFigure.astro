---
// 4年間の推移の節の中身（トップ・将来像・くらしのテーマ・部局のページ）。頭の文（割合の幅）・図・「表で見る」。数は lib/data.ts の trendPoints。
// 節の見出しはページに置く。name は図の題の後ろに添える名前（部局のページ）
import TrendChart from './TrendChart.astro';
import { yearLong, periodName, type TrendRow } from '../lib/data.ts';
import { band, fmt } from '../lib/format.ts';

interface Props { points: TrendRow[]; name?: string }
const { points, name } = Astro.props;
---
<p class="small secondary lead">この4年、主な取組の「順調」は{band(points.map((p) => p.a))}、計画値に届いた成果指標は{band(points.map((p) => p.b))}で推移しています。</p>
<figure class="sticker trend">
  <figcaption>
    <div class="chart-title">「順調」の取組と、計画値に届いた成果指標の割合{name && `（${name}）`}</div>
  </figcaption>
  <TrendChart points={points} />
  <details>
    <summary>表で見る</summary>
    <div class="table-wrap">
      <table>
        <thead><tr><th>年度</th><th class="num">主な取組</th><th class="num">うち順調</th><th class="num">成果指標</th><th class="num">うち計画値に到達</th></tr></thead>
        <tbody>
          {points.map((p) => (
            <tr>
              <th>{yearLong(p.y)}（{periodName(p.y)}）</th>
              <td class="num">{fmt(p.aN)}</td><td class="num">{fmt(p.aOk)}（{p.a.toFixed(1)}%）</td>
              <td class="num">{fmt(p.bN)}</td><td class="num">{fmt(p.bOk)}（{p.b.toFixed(1)}%）</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .trend { margin-top: 0; }
</style>
