---
// くらしのテーマのラベル（このサイト独自の分類）。押すとテーマのページを開く。カードの中など、リンクを重ねられない所では link={false}
import { getThemes } from '../lib/themes.js';

interface Props { ids: string[]; link?: boolean; label?: boolean }
const { ids, link = true, label = true } = Astro.props;
const byId = new Map(getThemes().map((t) => [t.id, t]));
const items = ids.map((id) => byId.get(id)).filter(Boolean);
---
{items.length > 0 && (
  <span class="ttags">
    {label ? <span class="ttags-l" title="このサイト独自の分類です（県の計画の分類ではありません）">テーマ</span> : <span class="sr-only">くらしのテーマ（このサイト独自の分類）:</span>}
    {items.map((t) => (link ? <a class="ttag" href={`/theme/${t.id}/`}>{t.label}</a> : <span class="ttag">{t.label}</span>))}
  </span>
)}
