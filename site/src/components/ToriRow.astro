---
// 主な取組の一覧の1行（施策のページ。親は ul.row-list）。名前と、最新の年度の進捗状況の印（形と色）・活動指標の計画と実績、活動指標の名前。
// 印は名前の前に置き、どの行も同じ位置に縦に並べる。計画・実績は指標の名前の行の右端（スマホは指標の名前の下）。
// 印の言葉（順調など）と区分の説明は、印にマウスを乗せる・タップすると出す（棒の区間と同じツールチップ）。行と一覧の上には書かず、読み上げでは行ごとに読む。
// その年にやったことは畳む。4年分の進捗状況・予算・県の検証と改善案は取組のページで見せる（施策のページでは経年を出さず、一覧を短くする）。
// 所管課・くらしのテーマは取組のページに任せる。対応する成果指標は出さない（施策のページではどの行も成果指標の節と同じになる。docs/site.md の 1章の seikaOfTorikumi）
import Icon from './Icon.astro';
import { LATEST, STATUSES, yearLabel, statusOf, toneOfStatus, torikumiHref, type YearGroup } from '../lib/data.ts';
import type { TorikumiRow } from '../lib/types.ts';

interface Props { row: YearGroup<TorikumiRow>; shisakuId: string }
const { row, shisakuId } = Astro.props;
const t = row.latest;
const href = torikumiHref(shisakuId, row.key);
// 最新の年度の報告に無い取組（終了・名前の変更など）は、最後に報告された年度の進捗状況（読み上げでは年度も読む）
const status = statusOf(t);
const statusText = t.year === LATEST ? status : `${yearLabel(t.year)} ${status}`;
const note = STATUSES.find((c) => c.key === status)?.note;
// 目標・実績が2行以上に印字されている取組（北部と西表、件数と回数など）は、組ごとに並べる
const values = t.indicator ? (t.lines ? t.lines.map((l) => ({ target: l.target, actual: l.actual })) : [{ target: t.target, actual: t.actual }]) : [];
---
<li class="tr">
  <span class="tr-st" data-tip-value={status} data-tip-label={`${yearLabel(t.year)}の進捗状況${note ? `（${note}）` : ''}`}><Icon tone={toneOfStatus(status)} size={13} /><span class="sr-only">{statusText}: </span></span>
  <a class="tr-name name-link" href={href}>{t.name}</a>
  {t.indicator && <div class="tr-ind small secondary">{t.indicator}</div>}
  {values.length > 0 && <div class="tr-v small">{values.map((v) => <span>計画 <b>{v.target || '—'}</b> → 実績 <b>{v.actual || '—'}</b></span>)}</div>}
  {t.summary && (
    <details class="tr-did small">
      <summary>{yearLabel(t.year)}にやったこと</summary>
      <p>{t.summary}</p>
    </details>
  )}
</li>

<style>
  /* PC: 印 → 名前、その下に指標の名前と右端に計画・実績。読み上げは 進捗状況 → 名前 → 指標の名前 → 計画・実績 の順 */
  .tr { display: grid; grid-template-columns: 1em minmax(0, 1fr) auto; grid-template-areas: "st name name" ". ind v" ". did did"; gap: 2px 10px; align-items: start; }
  .tr-name { grid-area: name; }
  /* 印は小さいので、押せる範囲を周りに広げる */
  .tr-st { grid-area: st; display: flex; padding: calc(0.45em + 6px) 6px 6px; margin: -6px; cursor: help; }
  .tr-ind { grid-area: ind; }
  .tr-v { grid-area: v; display: grid; justify-items: end; text-align: right; max-width: 24em; margin-left: 14px; }
  .tr-v b { font-weight: 700; color: var(--ink); }
  .tr-did { grid-area: did; margin-top: 2px; }
  .tr-did > summary { font-size: 0.8125rem; padding: 0; }
  .tr-did[open] > summary { margin-bottom: 2px; }
  .tr-did p { margin: 0 0 4px; line-height: 1.7; }
  /* スマホ: 印 → 名前、その下に指標の名前、計画・実績 */
  @media (max-width: 560px) {
    .tr { grid-template-columns: 1em minmax(0, 1fr); grid-template-areas: "st name" ". ind" ". v" ". did"; gap: 2px 8px; }
    .tr-v { max-width: none; margin-left: 0; justify-items: start; text-align: left; }
  }
</style>
