---
// 主な取組の一覧の1行（施策のページ。親は ul.row-list）。名前、その下に活動指標の名前と、右端に計画・実績と最新の年度の進捗状況の札。
// 進捗状況は活動指標の計画に対する実績で決まるので、札は計画・実績のすぐ後ろに置く（取組のページの頭の 進捗状況の札 → 活動指標 と同じ組）。
// 状態は形と色に加えて言葉でも出す（docs/design.md の2章）。区分の説明（「計画の90%以上」など）は札にマウスを乗せると出す。
// その年にやったことは畳む。4年分の進捗状況・予算・県の検証と改善案は取組のページで見せる（施策のページでは経年を出さず、一覧を短くする）。
// 所管課・くらしのテーマは取組のページに任せる。対応する成果指標は出さない（施策のページではどの行も成果指標の節と同じになる。docs/site.md の 1章の seikaNameMatches・torikumiOfSeika）
import Chip from './Chip.astro';
import NewTag from './NewTag.astro';
import { LATEST, STATUSES, PATTERNS, yearLabel, statusOf, statusesOf, toneOfStatus, torikumiHref, type YearGroup } from '../lib/data.ts';
import type { TorikumiRow } from '../lib/types.ts';

interface Props { row: YearGroup<TorikumiRow>; shisakuId: string }
const { row, shisakuId } = Astro.props;
const t = row.latest;
const href = torikumiHref(shisakuId, row.key);
// 最新の年度の報告に無い取組（終了・名前の変更など）は、最後に報告された年度の進捗状況を年度つきで出す
const status = statusOf(t);
const old = t.year !== LATEST;
// 最新の年度の報告から新しく載った取組は、名前の後ろに札を付ける
const isNew = PATTERNS.new(statusesOf(row));
const note = STATUSES.find((c) => c.key === status)?.note;
// 目標・実績が2行以上に印字されている取組（北部と西表、件数と回数など）は、組ごとに並べる
const values = t.indicator ? (t.lines ? t.lines.map((l) => ({ target: l.target, actual: l.actual })) : [{ target: t.target, actual: t.actual }]) : [];
---
<li class:list={['tr', old && 'old']}>
  <div class="tr-name"><a class="name-link" href={href}>{t.name}</a>{isNew && <> <NewTag /></>}</div>
  {t.indicator && <div class="tr-ind small secondary">{t.indicator}</div>}
  <div class="tr-v small">
    {values.length > 0 && <span class="tr-n">{values.map((v) => <span>計画 <b>{v.target || '—'}</b> → 実績 <b>{v.actual || '—'}</b></span>)}</span>}
    <span class="tr-st"><Chip tone={toneOfStatus(status)} text={old ? `${yearLabel(t.year)} ${status}` : status} title={`${yearLabel(t.year)}の進捗状況${note ? `（${note}）` : ''}`} /></span>
  </div>
  {t.summary && (
    <details class="tr-did small">
      <summary>{yearLabel(t.year)}にやったこと</summary>
      <p>{t.summary}</p>
    </details>
  )}
</li>

<style>
  /* PC: 名前の下に指標の名前、その行の右端に 計画・実績 → 札。読み上げも 名前 → 指標の名前 → 計画・実績 → 進捗状況 の順 */
  .tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name name" "ind v" "did did"; gap: 2px 24px; align-items: start; }
  .tr-name { grid-area: name; }
  .tr-ind { grid-area: ind; }
  .tr-v { grid-area: v; display: flex; align-items: flex-start; gap: 14px; }
  .tr-n { display: grid; justify-items: end; text-align: right; max-width: 22em; }
  .tr-n b { font-weight: 700; color: var(--ink); }
  /* 札の幅をそろえ、どの行も印の位置を縦にそろえる（「大幅遅れ」が入る幅。報告に無い取組は「R6 大幅遅れ」が入る幅） */
  .tr-st { flex: none; width: 5.6em; }
  .old .tr-st { width: 7.6em; }
  .tr-st :global(.chip) { white-space: nowrap; }
  .tr-did { grid-area: did; margin-top: 2px; }
  .tr-did > summary { font-size: 0.8125rem; padding: 0; }
  .tr-did[open] > summary { margin-bottom: 2px; }
  .tr-did p { margin: 0 0 4px; line-height: 1.7; }
  /* スマホ: 名前 → 指標の名前 → 計画・実績と札 */
  @media (max-width: 560px) {
    .tr { grid-template-columns: minmax(0, 1fr); grid-template-areas: "name" "ind" "v" "did"; }
    .tr-v { flex-wrap: wrap; gap: 2px 12px; }
    .tr-n { justify-items: start; text-align: left; max-width: none; }
    .tr-st, .old .tr-st { width: auto; }
  }
</style>
