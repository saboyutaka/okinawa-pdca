---
// 成果指標1つの「計画値に届いたか」（1行）と「スタート → いま → ゴール」の数字（時間の順。components/GoalSteps.astro）。施策ページのカード（SeikaCard）と成果指標のページの頭で使う。
// 同じ数字を何度も並べない。数字はここに1回だけ出し、図（SeikaRoute）は形（計画の道すじとのずれ）を見せる
import Chip from './Chip.astro';
import Term from './Term.astro';
import GoalSteps from './GoalSteps.astro';
import { LATEST, yearLabel, planIndex, withUnit, refText, toneOfJudgement, seikaVerdict, type SeikaGroup } from '../lib/data.ts';

interface Props { row: SeikaGroup }
const { row } = Astro.props;
const x = row.latest;
const u = x.unit;
const yl = yearLabel(x.year);
const pi = planIndex(x.year);
// 計画値の欄が空・「―」の指標は、計画値の行を出さない
const planRaw = /[^\s\-－―—‐]/.test(x.plan_raw?.[pi] || '') ? x.plan_raw[pi] : null;
// 計画値に届いたか（lib/data.ts の seikaVerdict。SNS のカードの画像と同じ文）
const verdict = seikaVerdict(x);
const ref = refText(x.actual_ref_year);
---
<p class="verdict"><Chip tone={verdict.tone} text={verdict.chip} /><span>{verdict.text}</span></p>

<GoalSteps values={[x.base_raw, x.actual_raw, x.target_raw]} unit={u} nowLabel={x.year === LATEST ? 'いま' : `${yl}の報告`}>
  <Fragment slot="start"><Term word="基準値" />{x.base_fix && '（部局の検証票の値）'}</Fragment>
  <Fragment slot="now"><Term word="実績値" note={ref ? `この指標の${yl}の報告の実績値は、${ref}です。` : undefined} /></Fragment>
  {planRaw && <span slot="now-more" class="gs-s">{yl}の<Term word="計画値" /> <b class="num">{withUnit(planRaw, u)}</b></span>}
  <Fragment slot="goal"><Term word="目標値" />（{x.target_year}）{verdict.down && '・基準値より低い目標値'}</Fragment>
  {x.judgement && <span slot="goal-more" class="gs-s judge">県の見通し <Chip tone={toneOfJudgement(x.judgement)} text={x.judgement} /></span>}
</GoalSteps>
