---
// 主要指標の達成率を、1指標を1つの印にして報告書の順（概要版の表の順。良い・悪いで並べ替えない）に並べる。
// 印の色と形は概要版の区分（SHUYOU_BINS）。印にマウスを乗せる・タップすると、名前と達成率と区分が出る（scripts/tooltip.ts）。
// - 印だけ（トップの将来像の行）: 並び全体を1つの画像として、名前と達成率を順に読み上げる
// - tags（5つの将来像のページの基本施策の行）: 印に達成率の数を添えた小さな札（「■ -6%」）。数は見えているので、読み上げでは名前と区分を足す
import Icon from './Icon.astro';
import { shuyouRateText, shuyouBinOf, type ShuyouStatus } from '../lib/data.ts';

interface Props { items: ShuyouStatus[]; tags?: boolean; context?: string }
const { items, tags = false, context = '' } = Astro.props;
const rows = items.map((r) => ({ r, bin: shuyouBinOf(r.bin), rate: shuyouRateText(r) }));
const aria = `${context}主要指標 ${rows.length}指標の達成率: ${rows.map((x) => `${x.r.name}${x.rate === '—' ? '' : ` ${x.rate}`}（${x.bin.label}）`).join('、')}`;
---
{tags ? (
  <ul class="s-tags">
    {rows.map((x) => (
      <li class="s-tag" data-tip-label={x.r.name} data-tip-value={`達成率 ${x.rate}（${x.bin.label}）`}>
        <Icon tone={x.bin.tone} size={12} /><b aria-hidden={x.rate === '—' ? 'true' : undefined}>{x.rate}</b><span class="sr-only">（{x.r.name}・{x.bin.label}）</span>
      </li>
    ))}
  </ul>
) : (
  <span class="s-marks" role="img" aria-label={aria}>
    {rows.map((x) => <span class="s-mk" data-tip-label={x.r.name} data-tip-value={`達成率 ${x.rate}（${x.bin.label}）`}><Icon tone={x.bin.tone} size={14} /></span>)}
  </span>
)}

<style>
  /* 印・札は文字と同じ流れに置き、前の言葉（「達成率」）に続けて折り返す */
  .s-marks, .s-tags { display: inline; }
  .s-mk { display: inline-flex; vertical-align: middle; padding: 1px; margin-right: 3px; cursor: default; }
  .s-tags { list-style: none; margin: 0; padding: 0; }
  .s-tag { display: inline-flex; vertical-align: middle; align-items: center; gap: 4px; margin-right: 12px; white-space: nowrap; cursor: default; }
  .s-tag:last-child { margin-right: 0; }
  .s-tag b { font-family: var(--font-num); font-weight: 600; font-size: 0.9375rem; }
</style>
