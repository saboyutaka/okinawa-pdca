---
// 主要指標の一覧（/shihyou/shuyou/）の1行。親は ul.row-list。成果指標の一覧の行（SeikaRow）と同じ形で、
// 左に名前と基本施策の2行、右に達成率の札とゴールまでの道のりの小さな図（SeikaSpark）。
// 行は県の概要版の表の1指標（男性・女性なども1行ずつ。トップ・将来像のページの主要指標と同じ49指標。lib/data.ts の getShuyouStatus）で、
// 札は概要版の達成率（数だけ。色と形は区分 SHUYOU_BINS。区分の言葉は読み上げの文と絞り込みにある）。「達成率」と図の凡例は一覧の上に1回だけ書く（SeikaKey）。
// 図は付属資料のその指標の部分で描き（ShuyouStatus の part）、付属資料の欄を部分に分けられない指標（2-(8) など）は図を出さない。
// 県の見通しは基本施策のページのカードに任せる。基準値・実績値・目標値は図に任せ、読み上げ用の文にだけ残す
import Chip from './Chip.astro';
import SeikaSpark from './SeikaSpark.astro';
import { eraRef, shuyouBinOf, shuyouRateText, type ShuyouStatus } from '../lib/data.ts';
import { oneLine } from '../lib/text.ts';

interface Props { r: ShuyouStatus; attrs?: Record<string, string> }
const { r, attrs = {} } = Astro.props;
const bin = shuyouBinOf(r.bin);
// 「※」（概要版の印）の意味は、印にマウスを乗せる・タップすると出す（将来像のページの基本施策の行と同じ）
const REVISED = '統計の基準改定にあわせて県が試算し直した基準値・目標値';
const value = (raw: string, ref: string | null) => (eraRef(ref) ? `${oneLine(raw)}（${eraRef(ref)}）` : oneLine(raw));
const srText = `達成率 ${shuyouRateText(r)}（${bin.label}）。基準値 ${value(r.base_raw, r.base_ref)}、実績値 ${value(r.actual_raw, r.actual_ref)}、目標値 ${value(r.target_raw, r.target_ref)}`;
---
<li class="m-row" {...attrs}>
  <div class="m-head">
    <a class="name-link" href={r.href}>{r.name}</a>{r.revised && <span class="mark" data-tip-value={REVISED} data-tip-label="※"><span aria-hidden="true">※</span><span class="sr-only">（{REVISED}）</span></span>}{r.part?.unit && <small class="secondary">（{r.part.unit}）</small>}
  </div>
  <div class="sub small secondary">基本施策 <a class="sub-link" href={`/kihon/${r.kihon.id}/`}>{r.kihon.name}</a> <span class="code-no">{r.kihon.code}</span></div>
  <div class="m-viz" aria-hidden="true">
    <Chip tone={bin.tone} text={shuyouRateText(r)} title={`達成率（${bin.label}）`} />
    {r.part && <SeikaSpark part={r.part} />}
  </div>
  <span class="sr-only">{srText}</span>
</li>

<style>
  /* 並びは成果指標の一覧の行（SeikaRow）と同じ。札と図の列の幅はどの行も同じにして、図の無い行でも印の位置をそろえる */
  .m-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "head viz" "sub viz"; gap: 2px 20px; align-items: center; }
  .m-head { grid-area: head; min-width: 0; }
  .sub { grid-area: sub; }
  .mark { font-size: 0.8125rem; color: var(--ink-2); margin-left: 1px; padding: 0 3px; cursor: help; }
  .m-viz { grid-area: viz; display: grid; grid-template-columns: 6.5em 120px; gap: 12px; align-items: center; }
  .m-viz :global(.spark) { width: 100%; height: auto; }
  /* スマホでは右の列を細くし、札の下に図を置く */
  @media (max-width: 640px) {
    .m-row { grid-template-columns: minmax(0, 1fr) 96px; gap: 2px 12px; align-items: start; }
    .m-viz { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
