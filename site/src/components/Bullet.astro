---
// 成果指標の目盛り: 基準値・計画値・目標値に対して実績値がどこにあるか。数値が読めない指標は描かない
interface Props {
  base: number | null;
  actual: number | null;
  plan?: number | null;
  target: number | null;
  labels: { base: string; actual: string; plan?: string; target: string };
}
const { base, actual, plan, target, labels } = Astro.props;
const vals = [base, actual, plan, target].filter((v): v is number => v != null && Number.isFinite(v));
const drawable = base != null && actual != null && target != null;
let lo = Math.min(...vals), hi = Math.max(...vals);
if (hi === lo) { hi += 1; lo -= 1; }
const pad = (hi - lo) * 0.08;
lo -= pad; hi += pad;
const W = 600, H = 44, L = 8, R = 8, Y = 22;
const x = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
---
{drawable && (
  <div class="bullet">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`基準値 ${labels.base}、実績値 ${labels.actual}、目標値 ${labels.target}`}>
      <line x1={L} x2={W - R} y1={Y} y2={Y} class="track" />
      <line x1={x(base!)} x2={x(actual!)} y1={Y} y2={Y} class="progress" />
      <g tabindex="0" data-tip-value={labels.base} data-tip-label="基準値">
        <rect x={x(base!) - 12} y={Y - 14} width="24" height="28" fill="transparent" />
        <rect x={x(base!) - 4} y={Y - 4} width="8" height="8" class="m-base" />
      </g>
      <g tabindex="0" data-tip-value={labels.target} data-tip-label="目標値">
        <rect x={x(target!) - 12} y={Y - 14} width="24" height="28" fill="transparent" />
        <line x1={x(target!)} x2={x(target!)} y1={Y - 11} y2={Y + 11} class="m-target" />
      </g>
      {plan != null && labels.plan && (
        <g tabindex="0" data-tip-value={labels.plan} data-tip-label="この年度の計画値">
          <rect x={x(plan) - 12} y={Y - 14} width="24" height="28" fill="transparent" />
          <circle cx={x(plan)} cy={Y} r="5" class="m-plan" />
        </g>
      )}
      <g tabindex="0" data-tip-value={labels.actual} data-tip-label="実績値">
        <rect x={x(actual!) - 12} y={Y - 14} width="24" height="28" fill="transparent" />
        <circle cx={x(actual!)} cy={Y} r="6" class="m-actual" />
      </g>
    </svg>
    <ul class="bullet-legend" aria-hidden="true">
      <li><span class="k k-base"></span>基準値</li>
      {plan != null && <li><span class="k k-plan"></span>計画値</li>}
      <li><span class="k k-actual"></span>実績値</li>
      <li><span class="k k-target"></span>目標値</li>
    </ul>
  </div>
)}

<style>
  .bullet svg { width: 100%; height: auto; display: block; overflow: visible; }
  .track { stroke: var(--baseline); stroke-width: 1; }
  .progress { stroke: var(--accent); stroke-width: 2; stroke-linecap: round; opacity: 0.45; }
  .m-base { fill: var(--muted); }
  .m-target { stroke: var(--ink); stroke-width: 2; stroke-linecap: round; }
  .m-plan { fill: var(--surface); stroke: var(--ink-2); stroke-width: 2; }
  .m-actual { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }
  .bullet-legend { list-style: none; padding: 0; margin: 2px 0 0; display: flex; flex-wrap: wrap; gap: 2px 14px; font-size: 0.75rem; color: var(--ink-2); }
  .bullet-legend li { display: inline-flex; align-items: center; gap: 5px; }
  .k { display: inline-block; }
  .k-base { width: 8px; height: 8px; background: var(--muted); }
  .k-plan { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--ink-2); }
  .k-actual { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .k-target { width: 2px; height: 12px; background: var(--ink); }
</style>
