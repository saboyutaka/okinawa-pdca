---
// ページ内の目次。画面の上に固定する（styles/global.css の .toc）。いま読んでいる節のリンクには印を付ける（scripts/toc.ts。layouts/Base.astro が読み込む）。
// head を渡すと、目次が画面の上に貼り付いたあと（ページの頭が見えなくなったあと）、リンクの上に何のページか（区分・名前と、slot="status" の判定など）を1行で出す（scripts/toc.ts）。
// 中身はページの頭（h1 と判定の札）と同じなので、読み上げでは読まない
import Sz from './Sz.astro';

interface Link { href: string; label: string; title?: string }
// tag: 区分の札の色。くらしのテーマ（このサイト独自の分類）はピンクの ttag、個別計画は淡い紫の plan-tag。sz: 将来像の番号の印を区分の前に置く
interface Head { kind?: string; tag?: 'ttag' | 'plan-tag'; sz?: number; title: string }
interface Props {
  links: (Link | false | null | undefined)[];
  label?: string;
  head?: Head;
}
const { links, label = 'このページの内容', head } = Astro.props;
const items = links.filter((l): l is Link => Boolean(l));
const status = Astro.slots.has('status');
---
{/* 目次のもとの位置の目印。これが画面の上から出たら、目次が貼り付いている */}
<div class="toc-mark" aria-hidden="true"></div>
<nav class="toc" aria-label={label}>
  {head && (
    <div class="toc-head" aria-hidden="true">
      <div class="toc-head-in">
        {head.kind && <span class:list={['toc-kind', head.tag]}>{head.sz && <Sz id={head.sz} sr={false} />}{head.kind}</span>}
        <span class="toc-title">{head.title}</span>
        {status && <span class="toc-st"><slot name="status" /></span>}
      </div>
    </div>
  )}
  <div class="toc-links" data-scroll-hint>
    {items.map((l) => <a href={l.href} title={l.title}>{l.label}</a>)}
  </div>
</nav>
