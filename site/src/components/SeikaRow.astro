---
// 成果指標の一覧の1行（成果指標をさがす・部局のページ・くらしのテーマのページ。親は ul.row-list）。
// 左に名前と施策の2行、右に達成率の札とゴールまでの道のりの小さな図（SeikaSpark）。札は施策の一覧の行の成果指標の札と同じ形（数字だけ）で、
// 「達成率」「何年度か」と図の凡例は一覧の上に1回だけ書く（SeikaKey）。
// 見通し（県の見立て）は達成率の区分とほぼ重なるので行に出さず、絞り込みと施策ページのカードに任せる。基準値・実績値・目標値は図に任せ、読み上げ用の文にだけ残す。
// 担当・くらしのテーマも絞り込みと施策ページのカードに任せる。名前は施策ページのその指標のカード（href）へのリンク
import Chip from './Chip.astro';
import SeikaSpark from './SeikaSpark.astro';
import YearTag from './YearTag.astro';
import { LATEST, yearLabel, withUnit, refText, rateText, rateTone, type SeikaGroup, type Shisaku } from '../lib/data.ts';
import type { SeikaRow as SeikaRecord } from '../lib/types.ts';

// x はその年度の成果指標の行、row は年度をまたいだまとまり
interface Props { x: SeikaRecord; row: SeikaGroup; shisaku: Shisaku | undefined; href: string; attrs?: Record<string, string> }
const { x, row, shisaku: s, href, attrs = {} } = Astro.props;
const past = x.year !== LATEST;
const rateLabel = `${yearLabel(x.year)}の達成率`;
const ref = refText(x.actual_ref_year);
const srText = `${rateLabel} ${rateText(x)}。基準値 ${withUnit(x.base_raw, x.unit)}、実績値 ${withUnit(x.actual_raw, x.unit)}${ref ? `（${ref}）` : ''}、目標値 ${withUnit(x.target_raw, x.unit)}（${x.target_year}）`;
---
<li class="m-row" {...attrs}>
  <div class="m-head">
    <a class="name-link" href={href}>{row.name}</a>{x.unit && <small class="secondary">（{x.unit}）</small>}
    {past && <> <YearTag kind="ended" year={x.year} what="指標" /></>}
  </div>
  {s && <div class="m-sub small secondary">施策 <a class="sub-link" href={`/shisaku/${s.id}/`}>{s.name}</a> <span class="code-no">{s.code}</span></div>}
  <div class="m-viz" aria-hidden="true">
    <Chip tone={rateTone(x)} text={rateText(x)} title={rateLabel} />
    <SeikaSpark row={row} />
  </div>
  <span class="sr-only">{srText}</span>
</li>
