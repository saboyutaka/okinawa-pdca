---
import '../styles/global.css';
import { LINKS } from '../lib/links.js';

interface Props { title?: string; description?: string }
const SITE = '沖縄県PDCAダッシュボード';
const { title, description = '沖縄県が毎年公表している「沖縄県PDCA実施結果」を、施策ごとに見やすく整理した非公式サイトです。' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : SITE;
const path = Astro.url.pathname;
// サイト内のナビ。計画の体系（将来像 → 施策 → 取組）の順に並べる。also のページ（基本施策・遅れが続いている取組）にいるときも、その項目をいまの場所にする
const NAV = [
  { href: '/', label: 'トップ' },
  { href: '/theme/', label: 'くらしのテーマ' },
  { href: '/future/', label: '将来像', also: ['/kihon/'] },
  { href: '/shisaku/', label: '施策' },
  { href: '/torikumi/', label: '取組', also: ['/okure/'] },
  { href: '/shihyou/', label: '成果指標' },
  { href: '/bukyoku/', label: '部局' },
  { href: '/yosan/', label: '予算' },
  { href: '/about/', label: 'データについて' },
];
const inItem = (n) => (n.href === '/' ? path === '/' : [n.href, ...(n.also || [])].some((h) => path.startsWith(h)));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <script is:inline>
      // 選んだ配色を最初に反映する（scripts/theme.js が切り替えと記憶を受け持つ）
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/fredoka-num.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/"><span class="mark" aria-hidden="true">PDCA</span><span>{SITE}<small>（非公式）</small></span></a>
        <button type="button" class="theme-toggle" id="theme-toggle" hidden>配色</button>
        <nav class="site-nav" aria-label="サイト内">
          {NAV.map((n) => <a href={n.href} aria-current={inItem(n) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <script is:inline>
          // スマホでナビが横にはみ出すとき、いまいるページの項目が見えるようにナビだけを横にずらす（ページは動かさない）
          (() => {
            const nav = document.currentScript.previousElementSibling;
            const cur = nav && nav.querySelector('[aria-current="page"]');
            if (cur && nav.scrollWidth > nav.clientWidth) nav.scrollLeft = cur.offsetLeft - (nav.clientWidth - cur.offsetWidth) / 2;
          })();
        </script>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>出典: 沖縄県「<a href={LINKS.kekka} rel="noopener">沖縄県PDCA実施結果</a>」（令和4〜7年度対象）をもとに、PDFから読み取って再構成しています。県の公式サイトではありません。数値は必ず元の報告書で確認してください（各ページに元のPDFへのリンクがあります）。</p>
        <p>「くらしのテーマ」は、このサイトが独自にまとめた分類です。県の計画の分類ではありません。</p>
      </div>
    </footer>
    <script src="../scripts/tooltip.js"></script>
    <script src="../scripts/theme.js"></script>
    <script src="../scripts/terms.js"></script>
    <script src="../scripts/disclosure.js"></script>
    <script src="../scripts/charts.js"></script>
  </body>
</html>
