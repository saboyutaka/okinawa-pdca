---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import { PROJECT, SITE } from '../lib/links.ts';
import { LATEST, yearLong } from '../lib/data.ts';
import { OG_IMAGE, absUrl, websiteLd } from '../lib/seo.ts';
import { scriptJson } from '../lib/html.ts';
import { ERA_JS_PATH } from '../lib/era.ts';
import { CARD_SIZE, cardMeta } from '../lib/card.ts';
// 数字のフォント。styles/global.css の @font-face と同じファイル（/_astro/ にハッシュ付きの名前で書き出す。astro.config.ts の assetsInlineLimit）
import fontUrl from '../fonts/fredoka-num.woff2?url';
// favicon。src/assets から読み、/_astro/ にハッシュ付きの名前で書き出す（ずっとキャッシュさせる。public/_headers）。
// HTML を読まずに /favicon.ico を取りに来るところ向けの根元の ICO は、astro.config.ts の rootFavicon が置く
import faviconSvg from '../assets/favicon.svg';
import faviconIco from '../assets/favicon.ico';
import appleTouchIcon from '../assets/apple-touch-icon.png';

// canonical: false は、どの URL にも出る 404 のページのためのもの（canonical と og:url を出さない）
// ogType: 'article' は、1つのもの（施策・取組・指標・基本施策・将来像・くらしのテーマ・部局・観光ロードマップ）を見せるページ。一覧・トップ・サイトの説明は 'website'
// jump はシェア用のページ（lib/routes.ts の SHARE_ROUTES）の、指標を見せる場所の URL。検索に載せず（noindex）、開いた人をすぐにそこへ移す。
// SNS がリンクのカードを作るときはスクリプトを動かさないので、このページの og:image（指標のカード）が使われる。og:url と canonical もこのページの URL のままにする
// （Facebook は og:url の URL を読み直すため）
interface Props { title?: string; description?: string; canonical?: boolean; ogType?: 'website' | 'article'; jump?: string }
const { title, description = '沖縄県が毎年公表している「沖縄県PDCA実施結果」を、施策ごとに見やすく整理した非公式サイトです。', canonical = true, ogType = 'website', jump } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const path = Astro.url.pathname;
// 本番のドメインでのこのページの URL（クエリを除く）。プレビュー（workers.dev）・絞り込みのクエリ付きの URL も、このページとして扱ってもらう
const url = absUrl(path);
// SNS のカードの画像。施策・基本施策・将来像・くらしのテーマ・部局・主な取組のページと指標のシェア用のページは、そのページの名前と様子を入れた画像（lib/card.ts）、
// ほかのページはサイト共通の画像（lib/seo.ts の OG_IMAGE）
const card = canonical ? cardMeta(path) : null;
const ogImage = card
  ? { url: absUrl(card.image), ...CARD_SIZE, alt: `${card.alt}（${SITE.name}・非公式）` }
  : { url: absUrl(OG_IMAGE.path), width: OG_IMAGE.width, height: OG_IMAGE.height, alt: OG_IMAGE.alt };
// サイト内のナビ。トップはヘッダーのタイトルから戻れるので置かない。県民がふだんの言葉から入れるくらしのテーマ（このサイト独自の分類。一覧 /theme/ のページの頭でそう書く）を先に、
// 計画の3つの段（docs/design.md の1章）を上から、段ごとに「もの」とそれをはかる物差しを隣にしてまとめ（将来像 → 施策・成果指標 → 取組）、
// その後ろに部局・予算、3つの段をまとめて見る計画の目次と指標のマップを置く。
// まとまりのあいだには区切りの線を置く。基本施策と主要指標は5つの将来像のページに、活動指標は取組のページの中にあるので、項目を置かない。
// 個別計画（観光ロードマップ）は計画が1つのうちはナビに置かず、くらしのテーマ・施策・取組のページとフッターから入る。
// 最後に、県の仕組み（沖縄県PDCAについて）とこのサイトの説明を置く。データについて（出典・数え方・注意点）は、このサイトについての中のページとして扱う。
// also のページ（基本施策）にいるときも、その項目をいまの場所にする
const NAV: { href: string; label: string; also?: string[] }[][] = [
  [{ href: '/theme/', label: 'テーマ' }],
  [{ href: '/future/', label: '将来像', also: ['/kihon/'] }],
  [{ href: '/shisaku/', label: '施策' }, { href: '/shihyou/', label: '成果指標' }],
  [{ href: '/torikumi/', label: '取組' }],
  [{ href: '/bukyoku/', label: '部局' }, { href: '/yosan/', label: '予算' }],
  [{ href: '/mokuji/', label: '目次' }, { href: '/map/', label: '指標マップ' }],
  [{ href: '/pdca/', label: '沖縄県PDCAについて' }, { href: '/about/', label: 'このサイトについて', also: ['/data/'] }],
];
const inItem = (n: (typeof NAV)[number][number]) => [n.href, ...(n.also || [])].some((h) => path.startsWith(h));
// ヘッダーの版の木の板。いつの報告書までのデータかを、最新の対象年度で示す（「令和7年度版」。公表の年と取り違えないよう年度で書く）
const EDITION = `${yearLong(LATEST)}版`;
// ページの先読み（Speculation Rules）。サイトの中のリンクにマウスを乗せたとき・押し始めたときに、行き先の HTML を先に取っておく。
// ブラウザが読むだけでスクリプトは要らない（いまは Chrome・Edge が読む。Safari・Firefox は読まず、これまでどおり押してから取る）。
// 先読みしかしない（行き先のスクリプトまで動かす prerender はしない）。外のサイト（別のタブで開く）と同じページの # は除く。
// <script type="speculationrules"> も CSP のハッシュが合わないと読まれないので、下の is:inline と同じくハッシュを足す（中身は SPECULATION_RULES の文字列そのまま）
const SPECULATION = {
  prefetch: [{
    where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[target="_blank"], [href^="#"]' } }] },
    eagerness: 'moderate',
  }],
};
const SPECULATION_RULES = JSON.stringify(SPECULATION);
// <script is:inline> の中身。CSP（astro.config.ts の security.csp）はハッシュが合うものしか動かさず、Astro は is:inline のハッシュを足さないので、中身を文字列にしてここで足す
// 選んだ配色を最初に反映する（scripts/theme.ts が切り替えと記憶を受け持つ）。
// 年を西暦で表示すると選んでいれば、書き換えのスクリプト（lib/era.ts）を読み込む。読み終えるまでページを読み進めないので、最初の描画から西暦で出る
// （和暦のままの人は読まない。書き換えは、ページを読みながらそのスクリプトが行う）。
// あわせて html に js を付ける。スクリプトでしか動かない年の書き方と配色のボタン（フッター）を、最初の描画から出すため（あとから出すと、そのぶんずれる。styles/global.css の .foot-toggles）。
// 地の波（styles/global.css の「地の波」）の位置は時計から決める（1時間の中の秒数を --wave-t に入れる）。同じ時刻ならどのページでも同じ位置なので、ページを移っても波が始まりに戻らない
const THEME_INIT = `document.documentElement.classList.add('js');
document.documentElement.style.setProperty('--wave-t', String(Date.now() / 1000 % 3600));
try {
  const t = localStorage.getItem('theme');
  if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  if (localStorage.getItem('era') === 'seireki') document.write('<script src="${ERA_JS_PATH}"><\\/script>');
} catch {}`;
// スマホでナビが横にはみ出すとき、ナビだけを横にずらす（ページは動かさない）。
// 前のページのナビの位置を引き継ぎ（sessionStorage）、ページを移るたびにナビが横に跳ばないようにする。いまいるページの項目が
// 見えていないとき（本文のリンクから来たときなど）は、見えるところまでだけずらす（端のぼかしの幅を空ける。styles/global.css の scroll-padding-inline）。
// 初めて開いたときは、その項目を真ん中に寄せる。端のぼかし（more-l・more-r。scripts/scroll-hint.ts と同じ決め方）もここで付け、最初の描画から出す
const NAV_SCROLL = `(() => {
  const nav = document.currentScript.previousElementSibling;
  const max = nav.scrollWidth - nav.clientWidth;
  if (max <= 1) return;
  let x = null;
  try { x = sessionStorage.getItem('nav-x'); } catch {}
  const cur = nav.querySelector('[aria-current="page"]');
  if (x !== null) {
    nav.scrollLeft = Number(x);
    if (cur) cur.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  } else if (cur) {
    const n = nav.getBoundingClientRect(), c = cur.getBoundingClientRect();
    nav.scrollLeft += c.left - n.left - (n.width - c.width) / 2;
  }
  nav.classList.toggle('more-l', nav.scrollLeft > 4);
  nav.classList.toggle('more-r', nav.scrollLeft < max - 4);
  const save = () => { try { sessionStorage.setItem('nav-x', String(nav.scrollLeft)); } catch {} };
  save();
  nav.addEventListener('scroll', save, { passive: true });
})();`;
// スマホの幅で、ページの階層（components/Hierarchy.astro）のあるページをリンクから開いたときは、ページの頭が画面の上にくる位置から始める
// （ヘッダーと階層で、ページの頭が画面の半分近くまで下がるため）。戻る・進む・再読み込みはブラウザが位置を戻すので動かさず、# の付いた URL も動かさない。
// main を読み終えたところで動かし（CSS が届くまで待つので位置が決まっている）、最初の描画からその位置で出す。html の scroll-behavior: smooth を使わず、すぐに移す
const HEAD_SCROLL = `(() => {
  const head = document.querySelector('#main > .hier + *');
  if (!head || location.hash || !matchMedia('(max-width: 640px)').matches) return;
  const nav = performance.getEntriesByType('navigation')[0];
  if (nav && nav.type !== 'navigate') return;
  scrollTo({ top: head.getBoundingClientRect().top + scrollY - 10, behavior: 'instant' });
})();`;
// 地の波（下の .bg-waves）の形。viewBox（2400×100）に、真ん中の高さ c・振れ幅 a の波を横に2つ分描き、下を塗る（山の頂は c - a、谷の底は c + a）。
// 3次ベジェの2つの制御点を c から 4a/3 離すと、山と谷の高さがちょうど a になる。スマホの幅は1つの波が短く、山と谷が急に見えるので、
// 山の頂は同じ高さのまま谷を浅くした形（narrow）を使う（切り替えは styles/global.css の「地の波」）。
// 塗りのグラデーションは、山の頂で透明にし、谷の底より少し下で波の色になるようにする
const WAVE_SHAPES = [{ fit: 'wide', c: 34, a: 24 }, { fit: 'narrow', c: 23, a: 13 }].map(({ fit, c, a }) => {
  const up = c - (a * 4) / 3, down = c + (a * 4) / 3;
  return { fit, top: c - a, fade: c + a + 9, d: `M0 ${c} C200 ${up} 400 ${up} 600 ${c} S1000 ${down} 1200 ${c} S1600 ${up} 1800 ${c} S2200 ${down} 2400 ${c} V100 H0 Z` };
});
// シェア用のページの移り先は、スクリプトの data-to に入れる（中身を同じにして、CSP のハッシュを1つにする）。戻るで戻ったときにまた移らないよう replace にする
const JUMP = 'location.replace(document.currentScript.dataset.to);';
for (const code of [THEME_INIT, NAV_SCROLL, HEAD_SCROLL, SPECULATION_RULES, ...(jump ? [JUMP] : [])]) Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(code).digest('base64')}`);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {jump && <script is:inline data-to={jump} set:html={JUMP}></script>}
    {jump && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light" />
    <script is:inline set:html={THEME_INIT}></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={url} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={url} />}
    {/* SNS のカードの画像（上の ogImage）。X も og:image を読む。画像の説明は X 向けに twitter:image:alt にも書く */}
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    <meta name="author" content={PROJECT.org} />
    {/* SVG を読まないブラウザは ICO（sizes を付けると、SVG を読むブラウザが ICO より SVG を選ぶ）。iPhone のホーム画面は PNG。ICO と PNG は make icons で favicon.svg から書き出す */}
    <link rel="icon" href={faviconIco} sizes="32x32" />
    <link rel="icon" href={faviconSvg.src} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    {path === '/' && <script type="application/ld+json" is:inline set:html={scriptJson(websiteLd(description))} />}
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
    {/* ブラウザのスクリプトは scripts/site.ts の1つだけ。<head> に置くと CSS と並んで早めに取りに行く（body の終わりに置くと、CSS が届くまで後回しにされていた）。
        type="module" なので、動くのはこれまでどおりページを読み終えてから */}
    <script src="../scripts/site.ts"></script>
    <slot name="head" />
  </head>
  <body>
    {/* 地の波（docs/design.md の8章の例外）。淡い色の大きな波を3枚重ね、画面いっぱいにゆっくり流す。どの波も横に2つ分の山と谷を描き、
        半分（1つ分）ずらすと元の形に戻るので、つなぎ目なく流れ続ける。形は上の WAVE_SHAPES（PC とスマホの幅で2つ）。
        塗りは、山の頂で透明、下へ行くほど波の色になるグラデーションにする（文字の行の後ろに、波の縁のくっきりした線を作らないため）。
        色と動きは styles/global.css の「地の波」 */}
    <div class="bg-waves" aria-hidden="true">
      {[1, 2, 3].map((n) => (
        <svg class={`wave w${n}`} viewBox="0 0 2400 100" preserveAspectRatio="none">
          {WAVE_SHAPES.map((s) => (
            <>
              <linearGradient id={`wave-fade-${n}-${s.fit}`} gradientUnits="userSpaceOnUse" x1="0" y1={s.top} x2="0" y2={s.fade}>
                <stop offset="0" stop-opacity="0" /><stop offset="1" />
              </linearGradient>
              <path class={s.fit} fill={`url(#wave-fade-${n}-${s.fit})`} d={s.d} />
            </>
          ))}
        </svg>
      ))}
    </div>
    <a class="skip" href="#main">本文へスキップ</a>
    {/* 外部リンク（components/ExtLink.astro）が aria-describedby で指す、読み上げ用の説明。画面には出さず、コピーにも入らない */}
    <span id="newtab-note" hidden>別のタブで開きます</span>
    <header class="site-header">
      <div class="wrap">
        <div class="site-id">
          <a class="site-title" href="/">
            {/* ロゴ: 星空の丘で、まるい子（いま）がみらいの白い星を見上げる。色は styles/global.css の --logo-*。favicon は src/assets/favicon.svg */}
            <span class="mark" aria-hidden="true"><svg viewBox="0 0 36 36">
              <path d="M6 3.4 Q6 6 8.6 6 Q6 6 6 8.6 Q6 6 3.4 6 Q6 6 6 3.4 Z M17.5 5.7 Q17.5 7.5 19.3 7.5 Q17.5 7.5 17.5 9.3 Q17.5 7.5 15.7 7.5 Q17.5 7.5 17.5 5.7 Z M32.5 16 Q32.5 18 34.5 18 Q32.5 18 32.5 20 Q32.5 18 30.5 18 Q32.5 18 32.5 16 Z M4.5 11.7 Q4.5 13 5.8 13 Q4.5 13 4.5 14.3 Q4.5 13 3.2 13 Q4.5 13 4.5 11.7 Z M12 2 Q12 3.2 13.2 3.2 Q12 3.2 12 4.4 Q12 3.2 10.8 3.2 Q12 3.2 12 2 Z M28 20.8 Q28 22 29.2 22 Q28 22 28 23.2 Q28 22 26.8 22 Q28 22 28 20.8 Z" fill="var(--logo-twinkle)" />
              <path d="M-1 27.5 Q18 23 37 27.5 V37 H-1 Z" fill="var(--logo-hill)" stroke="var(--logo-ink)" stroke-width="2" />
              <circle cx="14.5" cy="23" r="11.5" fill="var(--logo-body)" stroke="var(--logo-ink)" stroke-width="2.2" />
              <ellipse cx="12.4" cy="20" rx="2.7" ry="3.3" fill="var(--logo-eye)" stroke="var(--logo-ink)" stroke-width="1.6" />
              <ellipse cx="19.2" cy="19" rx="2.7" ry="3.3" fill="var(--logo-eye)" stroke="var(--logo-ink)" stroke-width="1.6" />
              <circle cx="13.4" cy="18.8" r="1.35" fill="var(--logo-ink)" />
              <circle cx="20.2" cy="17.8" r="1.35" fill="var(--logo-ink)" />
              <path d="M28.5 3 L29.9 6.1 L33.3 6.5 L30.7 8.7 L31.4 12 L28.5 10.3 L25.6 12 L26.3 8.7 L23.7 6.5 L27.1 6.1 Z" fill="var(--logo-star)" stroke="var(--logo-ink)" stroke-width="1.5" stroke-linejoin="round" />
            </svg></span><span>{SITE.name}</span>
          </a>
          <span class="edition">{EDITION}</span>
          <span class="site-sub"><small>（非公式）</small><a class="site-by" href="/about/#code-for-okinawa">by <b>{PROJECT.org}</b></a></span>
        </div>
        <nav class="site-nav" aria-label="サイト内" data-scroll-hint>
          {NAV.map((g, i) => (
            <>
              {i > 0 && <span class="nav-sep" aria-hidden="true"></span>}
              {g.map((n) => <a href={n.href} aria-current={inItem(n) ? 'page' : undefined}>{n.label}</a>)}
            </>
          ))}
        </nav>
        <script is:inline set:html={NAV_SCROLL}></script>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <script is:inline set:html={HEAD_SCROLL}></script>
    <footer class="site-footer">
      <div class="wrap">
        {/* ナビに無いページへのリンクと、年の書き方・配色のボタン、作り手の1行（著作権の表示の代わりに、いちばん下に小さく） */}
        <div class="foot-row">
          <ul class="foot-links">
            <li><a href="/iken/">意見を伝えたい人へ</a></li>
            <li><a href="/keikaku/">個別計画</a></li>
            <li><a href="/data/">データについて</a></li>
          </ul>
          <div class="foot-toggles">
            {/* 年の書き方の切り替え（scripts/era.ts。data-src は書き換えのスクリプト）。文字は、いまの書き方でないほうを styles/global.css が選ぶ */}
            <button type="button" class="foot-toggle era-toggle" id="era-toggle" data-src={ERA_JS_PATH}>
              <span class="to-seireki">西暦で表示</span><span class="to-wareki">令和で表示</span>
            </button>
            <button type="button" class="foot-toggle theme-toggle" id="theme-toggle" aria-label="ダークモードに切り替える">
              <span class="to-dark" aria-hidden="true">☾</span><span class="theme-label to-dark">ダーク</span>
              <span class="to-light" aria-hidden="true">☀</span><span class="theme-label to-light">ライト</span>
            </button>
            <span class="sr-only" role="status" id="theme-status"></span>
          </div>
        </div>
        <p class="foot-by">このサイトは、<a href="/about/#code-for-okinawa">{PROJECT.org}</a> の<a href="/about/#civictech">シビックテック</a>の取り組みとして作っています。</p>
      </div>
    </footer>
  </body>
</html>
