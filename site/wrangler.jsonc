// Cloudflare Workers の静的アセットとして site/dist をそのまま置く（Worker のコードは無い）。
// GitHub 連携（Workers Builds）で main に push するたびに、ビルド後に `npx wrangler deploy` で公開される
{
  "name": "okinawa-pdca",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // 無いページには Astro が書き出した 404.html を返す
    "not_found_handling": "404-page",
    // /shisaku/1-1-a-1 → /shisaku/1-1-a-1/ のように末尾のスラッシュに揃える（astro.config.mjs の trailingSlash: 'always' と同じ）
    "html_handling": "auto-trailing-slash"
  }
}
