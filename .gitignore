# 県から取得した原本（台帳の manifest.jsonl / pages.jsonl だけコミットする）
data/raw/*/
data/interim/
*.part
*.tmp
__pycache__/
.DS_Store

# 公開サイト（Astro）
site/node_modules/
site/dist/
site/.astro/

# 画面の確認（make shot）の依存パッケージとスクリーンショット
scripts/shot/node_modules/
tmp/

# Cloudflare のツールが作るキャッシュ（アカウント情報を含む）
.cloudflare/
.wrangler/

# 秘密の値を置くファイル（いまは使っていないが、置いたときにコミットしないように）
.env
.env.*
.dev.vars*

# Claude Code の作業用 worktree（別のチェックアウトなのでコミットしない）
.claude/worktrees/
